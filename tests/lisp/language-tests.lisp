;;;; language-tests.lisp -- FORMAT directives, logical blocks, pathnames, readtables, complex numbers,
;;;; multi-dimensional arrays.

(in-package :cl)

(defun cl-user::zz-fmt-hook (s arg colon at &rest params) (format s "<~A ~A ~A ~A>" arg colon at params))

(deftest format-number-directives
  (dolist (c '(("      3.14" "~10,2F" 3.14159) ("0.667" "~,3F" 2/3) ("1.5" "~F" 1.5) (" 0.1" "~4,1F" 0.05)
               ("10000000000.00" "~,2F" 1e10) ("3.142" "~5F" 3.14159) ("+2.5" "~@F" 2.5) ("***" "~3,1,,'*F" 1234.5)
               ("1.2345e+3" "~E" 1234.5) ("1.235e+3" "~,3E" 1234.56) (" 1.235e+03" "~10,3,2E" 1234.56)
               ("0.31e-1" "~,2,,0E" 0.0314) ("0.0e+0" "~E" 0.0) ("-1.23e-4" "~,2E" -0.000123)
               ("3.5    " "~G" 3.5) ("1.0000000e+20" "~G" 1e20)
               ("3.14" "~$" 3.14159) ("    001.50" "~2,3,10$" 1.5) ("+2.00" "~@$" 2) ("-   1.00" "~,,8:$" -1)
               ("one thousand two hundred thirty-four" "~R" 1234) ("twenty-second" "~:R" 22) ("MCMXCIX" "~@R" 1999)
               ("MDCCCCLXXXXVIIII" "~:@R" 1999) ("1010" "~2R" 10) ("000000FF" "~16,8,'0R" 255) ("1 02 01" "~3,,,' ,2:R" 100)
               ("1,234,567" "~:D" 1234567) ("1234.5678" "~,,'.,4:D" 12345678) ("+5" "~@D" 5)))
    (is-equal (car c) (apply #'format nil (cadr c) (cddr c))))
  (is (handler-case (progn (format nil "~,99999F" 1.5) nil) (error () t)))   ; absurd digit counts are refused
  (is (handler-case (progn (format nil "~<~/b~") nil) (error () t))))         ; and an unclosed ~< is an error, not a loop

(deftest format-padding-tabs-justification
  (dolist (c '(("ab        |" "~10A|" "ab") ("        ab|" "~10@A|" "ab") ("ab****|" "~5,3,1,'*A|" "ab") ("()" "~:A" nil)
               ("ab        c" "ab~10Tc") ("   x" "~3@Tx")
               ("foo    bar" "~10<foo~;bar~>") ("  foo  bar" "~10:<foo~;bar~>") ("  foobar  " "~10:@<foobar~>")
               ("    foobar" "~10<foobar~>") ("            FOO" "~15<~S~;~^~S~;~^~S~>" foo) ("FOO         BAR" "~15<~S~;~^~S~;~^~S~>" foo bar)
               ("<5 NIL NIL NIL>" "~/zz-fmt-hook/" 5) ("<5 T T (3)>" "~3:@/zz-fmt-hook/" 5) ("(1 \"a\")" "~W" (1 "a"))))
    (is-equal (car c) (apply #'format nil (cadr c) (cddr c)))))

(deftest logical-blocks
  (is-equal "A B" (format nil "~<~A ~A~:>" '(a b)))
  (is-equal "(X)" (format nil "~:<~A~:>" '(x)))
  (is-equal (format nil ";; A~%;; B") (format nil "~<;; ~@;~A~:@_~A~:>" '(a b)))
  (let ((*print-right-margin* 20) (*print-miser-width* nil))
    (is-equal (format nil "AAAA BBBB CCCC DDDD~%EEEE FFFF") (format nil "~<~@{~A~^ ~:_~}~:>" '(aaaa bbbb cccc dddd eeee ffff)))
    (is-equal (format nil "AAAA BBBB CCCC DDDD~%EEEE FFFF") (format nil "~<~A ~A ~A ~A ~A ~A~:@>" '(aaaa bbbb cccc dddd eeee ffff)))
    (is-equal (format nil "(DEFUN FOOBARBAZ~%       (X Y Z W))") (format nil "~<(~;~A ~:I~@_~A ~_~A~;)~:>" '(defun foobarbaz (x y z w))))
    (is-equal (format nil "xx [ALPHA~%    BETA~%    GAMMA]") (format nil "xx ~<[~;~@{~A~^ ~_~}~;]~:>" '(alpha beta gamma))))
  (is-equal (format nil "(AAA~% BBB~% CCC~% DDD)")
            (with-output-to-string (s)
              (let ((*print-right-margin* 10))
                (pprint-logical-block (s '(aaa bbb ccc ddd) :prefix "(" :suffix ")")
                  (loop (write (pprint-pop) :stream s) (pprint-exit-if-list-exhausted) (write-char #\Space s) (pprint-newline :linear s))))))
  (is-equal "(AAA BBB)" (with-output-to-string (s)
                          (pprint-logical-block (s '(aaa bbb) :prefix "(" :suffix ")")
                            (loop (write (pprint-pop) :stream s) (pprint-exit-if-list-exhausted) (write-char #\Space s) (pprint-newline :linear s)))))
  (let ((*print-right-margin* 30) (*print-miser-width* nil))
    (is-equal (format nil "(ALPHA BETA GAMMA DELTA~% EPSILON ZETA ETA THETA IOTA)")
              (with-output-to-string (s) (pprint-fill s '(alpha beta gamma delta epsilon zeta eta theta iota))))
    (is-equal (format nil "(ALPHA~% BETA~% GAMMA~% DELTA~% EPSILON~% ZETA~% ETA~% THETA~% IOTA)")
              (with-output-to-string (s) (pprint-linear s '(alpha beta gamma delta epsilon zeta eta theta iota)))))
  (is-equal "(A     BB    CCC   DDDD  E     F)" (with-output-to-string (s) (pprint-tabular s '(a bb ccc dddd e f) t nil 6)))
  (is-equal "(1 2 3 ...)" (with-output-to-string (s) (let ((*print-length* 3)) (pprint-fill s '(1 2 3 4 5)))))
  (is-equal "(1 2 . 3)" (with-output-to-string (s) (pprint-fill s '(1 2 . 3))))
  (is-equal "5" (with-output-to-string (s) (pprint-logical-block (s 5) (write-string "x" s))))
  (is-equal (format nil "x~%  y") (with-output-to-string (s) (pprint-logical-block (s nil) (write-string "x" s) (pprint-indent :block 2 s) (pprint-newline :mandatory s) (write-string "y" s)))))

(deftest readtables-and-reader-macros
  (is-equal '(a) (read-from-string "(a #|x|#)"))                         ; comments and skipped features before )
  (is-equal '(a) (read-from-string "(a #+nil b)"))
  (is (readtablep *readtable*))
  (is-equal :upcase (readtable-case *readtable*))
  (let ((*readtable* (copy-readtable)))
    (set-macro-character #\[ (lambda (s c) (declare (ignore c)) (cons 'vec (read-delimited-list #\] s t))))
    (set-macro-character #\] (get-macro-character #\)))
    (is-equal '(vec 1 2 (vec 3)) (read-from-string "[1 2 [3]]"))
    (is-equal '(a (vec b) c) (read-from-string "(a [b]c)"))                 ; ] and [ end tokens
    (set-macro-character #\! (lambda (s c) (declare (ignore c)) (read-line s) (values)))
    (is-equal '(a b) (read-from-string (format nil "(a ! comment~% b)")))
    (set-dispatch-macro-character #\# #\? (lambda (s c n) (declare (ignore c)) (list :q n (read s t nil t))))
    (is-equal '(:q 3 foo) (read-from-string "#3?foo"))
    (is-equal '(:q nil (x)) (read-from-string "#?(x)"))
    (make-dispatch-macro-character #\$)
    (set-dispatch-macro-character #\$ #\x (lambda (s c n) (declare (ignore c n)) (list :dollar (read s t nil t))))
    (is-equal '((:dollar a) b) (read-from-string "($xa b)"))
    (set-macro-character #\{ (lambda (s c) (declare (ignore c)) (list 'quote (read-delimited-list #\} s t))))
    (set-syntax-from-char #\} #\))
    (is-equal '(a 1 2 (b c)) (eval (read-from-string "`(a ,@(list 1 2) ,{b c})")))   ; recursive reads keep backquote
    (setf (readtable-case *readtable*) :preserve)
    (is-equal "FooBar" (symbol-name (read-from-string "FooBar")))
    (setf (readtable-case *readtable*) :invert)
    (is-equal '("FOO" "foo" "Foo") (mapcar #'symbol-name (read-from-string "(foo FOO Foo)")))
    (setf (readtable-case *readtable*) :downcase)
    (is-equal "foo" (symbol-name (read-from-string "Foo"))))
  (is-equal :upcase (readtable-case *readtable*))                         ; the binding is undone
  (is-equal nil (get-macro-character #\[))
  (is-equal '(1 2) (funcall (get-macro-character #\() (make-string-input-stream "1 2)") #\())
  (is (handler-case (progn (set-macro-character (code-char 955) #'identity nil (copy-readtable)) nil) (error () t)))
  (is (handler-case (progn (set-dispatch-macro-character #\a #\b #'identity (copy-readtable)) nil) (error () t)))
  (is-equal 'car (with-standard-io-syntax (read-from-string "car"))))

(deftest pathnames
  (let ((p (pathname "/usr/lib/foo.tar.gz")))
    (is (pathnamep p))
    (is-equal '(:absolute "usr" "lib") (pathname-directory p))
    (is-equal "foo.tar" (pathname-name p))
    (is-equal "gz" (pathname-type p))
    (is-equal "/usr/lib/foo.tar.gz" (namestring p))
    (is-equal "#P\"/usr/lib/foo.tar.gz\"" (prin1-to-string p))
    (is-equal "/usr/lib/foo.tar.gz" (princ-to-string p)))
  (is-equal ".profile" (pathname-name ".profile"))
  (is-equal nil (pathname-type ".profile"))
  (is-equal "a/b/c.lisp" (namestring (make-pathname :directory '(:relative "a" "b") :name "c" :type "lisp")))
  (is-equal "/x/c.fasl" (namestring (make-pathname :type "fasl" :defaults "/x/c.lisp")))
  (is-equal #P"/home/me/src/foo.lisp" (merge-pathnames "foo.lisp" "/home/me/src/"))
  (is-equal #P"/a/b/x/y.txt" (merge-pathnames "../x/y.txt" "/a/b/c/"))
  (is-equal #P"src/foo.fasl" (merge-pathnames (make-pathname :type "fasl") "src/foo.lisp"))
  (is-equal "src/a/b.lisp" (enough-namestring "/home/me/src/a/b.lisp" "/home/me/"))
  (is (equal #P"/a/b.c" (pathname "/a/b.c")))
  (is (not (equal #P"/a/b.c" #P"/a/b.d")))
  (is-equal "c.d" (file-namestring "/a/b/c.d"))
  (is-equal "/a/b/" (directory-namestring "/a/b/c.d"))
  (is-equal #P"/tmp/x.y" (read-from-string "#P\"/tmp/x.y\""))
  ;; wildcards
  (is (wild-pathname-p "lisp/**/*.lisp"))
  (is (not (wild-pathname-p "lisp/core/x.lisp")))
  (is (pathname-match-p "lisp/core/00-base.lisp" "lisp/**/*.lisp"))
  (is (not (pathname-match-p "lisp/core/00-base.txt" "lisp/**/*.lisp")))
  (is (pathname-match-p "foo-bar.lisp" "foo-*.lisp"))
  (is-equal #P"/build/foo/bar.fasl" (translate-pathname "/src/foo/bar.lisp" "/src/**/*.lisp" "/build/**/*.fasl"))
  (is-equal #P"/x/old-a.txt" (translate-pathname "/x/a.txt" "/x/*.txt" "/x/old-*.txt"))
  ;; the file system
  (is (member #P"lisp/core/00-base.lisp" (directory "lisp/core/*.lisp") :test #'equal))
  (is (every (lambda (p) (string= (pathname-type p) "lisp")) (directory "lisp/**/*.lisp")))
  (is (> (length (directory "lisp/**/*.lisp")) (length (directory "lisp/core/*.lisp"))))
  (is (probe-file #P"lisp/core/00-base.lisp"))
  (is (null (probe-file "/no/such/file/here")))
  (is (eq (car (pathname-directory (truename "lisp/core/00-base.lisp"))) :absolute))
  (is-equal ";;;; 00-base.lisp -- bootstrap macros and list utilities." (with-open-file (s #P"lisp/core/00-base.lisp") (read-line s)))
  (let ((dir (format nil "/tmp/ng-pn-~D/" (get-universal-time))))
    (is (nth-value 1 (ensure-directories-exist (%string-concat dir "a/b/"))))
    (is (probe-file (%string-concat dir "a/b/")))
    (with-open-file (s (%string-concat dir "a/f.txt") :direction :output) (write-string "hi" s))
    (rename-file (%string-concat dir "a/f.txt") "g.txt")
    (is (probe-file (%string-concat dir "a/g.txt")))
    (is (delete-file (pathname (%string-concat dir "a/g.txt"))))
    (%run-program "rm" (list "-r" dir)))
  ;; logical pathnames
  (setf (logical-pathname-translations "NGTEST") (list (list "**;*.*" (%string-concat (namestring (truename "lisp/")) "**/*.*"))))
  (is (logical-pathname-p (pathname "NGTEST:CORE;00-BASE.LISP")))
  (is-equal "NGTEST:CORE;00-BASE.LISP" (namestring (logical-pathname "ngtest:core;00-base.lisp")))
  (is-equal (truename "lisp/core/00-base.lisp") (translate-logical-pathname "NGTEST:CORE;00-BASE.LISP"))
  (is (probe-file "NGTEST:CORE;00-BASE.LISP"))
  (is (handler-case (progn (logical-pathname "/not/logical") nil) (error () t))))

(deftest complex-numbers-native
  (is-equal 1 (complex 1 0))                                             ; an exact zero imaginary part gives a real
  (is (complexp (complex 1.0 0)))                                          ; a float one does not
  (is-equal "#C(1 2)" (prin1-to-string (complex 1 2)))
  (is-equal #C(1 2) (read-from-string "#c(1 2)"))
  (is-equal #C(1/2 3) (read-from-string "#C(1/2 3)"))
  (is-equal 4 (+ #C(1 2) #C(3 -2)))
  (is-equal -1 (* #C(0 1) #C(0 1)))
  (is-equal #C(11/25 2/25) (/ #C(1 2) #C(3 4)))
  (is-equal #C(-1 -2) (- #C(1 2)))
  (is-equal #C(2 4) (* 2 #C(1 2)))
  (is-equal #C(1.5 2.0) (+ 0.5 #C(1 2)))
  (is-equal 1 (expt #C(0 1) 4))
  (is-equal #C(0 -1/2) (expt #C(1 1) -2))
  (is-equal #C(0.0 2.0) (sqrt -4))
  (is-equal 5.0 (abs #C(3 4)))
  (is-equal #C(0.0 3.141592653589793) (log -1))
  (is (< (abs (- (exp (complex 0 pi)) -1)) 1e-12))
  (is (< (abs (- (expt (expt -8 1/3) 3) -8)) 1e-9))
  (is-equal #C(1 -2) (conjugate #C(1 2)))
  (is-equal 1 (realpart #C(1 2))) (is-equal 2 (imagpart #C(1 2))) (is-equal 0 (imagpart 5))
  (is (= #C(1 2) #C(1 2))) (is (not (= #C(1 2) 1))) (is (/= #C(1 2) #C(1 3)))
  (is (eql #C(1 2) (complex 1 2))) (is (not (eql #C(1 2) #C(1.0 2.0)))) (is (equalp #C(1 2) #C(1.0 2.0)))
  (is (zerop #C(0.0 0.0)))
  (is (handler-case (progn (< #C(1 2) 3) nil) (type-error () t)))
  (is (handler-case (progn (float #C(1 2)) nil) (type-error () t)))
  (is (typep #C(1 2) 'complex)) (is (typep #C(1 2) 'number)) (is (not (typep #C(1 2) 'real))) (is (not (realp #C(1 2))))
  (is (typep #C(1 2) '(complex integer))) (is (not (typep #C(1.0 2.0) '(complex integer))))
  (is-equal 'complex (type-of #C(1 2)))
  (is (< (abs (- (phase #C(0 1)) (/ pi 2))) 1e-12))
  (is-equal #C(1.0 0.0) (cis 0))
  (let ((h (make-hash-table :test 'eql))) (setf (gethash #C(1 2) h) :yes) (is-equal :yes (gethash (complex 1 2) h)))
  (is (funcall (compile nil '(lambda (a b) (= a b))) #C(1 2) #C(1 2))))

(deftest multi-dimensional-arrays
  (let ((a (make-array '(2 3) :initial-contents '((1 2 3) (4 5 6)))))
    (is-equal "#2A((1 2 3) (4 5 6))" (prin1-to-string a))
    (is-equal 6 (aref a 1 2))
    (setf (aref a 0 0) 99)
    (is-equal 99 (aref a 0 0))
    (is-equal '(2 3) (array-dimensions a)) (is-equal 2 (array-rank a)) (is-equal 6 (array-total-size a)) (is-equal 3 (array-dimension a 1))
    (is-equal 4 (array-row-major-index a 1 1))
    (is-equal 5 (row-major-aref a 4))
    (setf (row-major-aref a 5) :x)
    (is-equal :x (aref a 1 2))
    (is (handler-case (progn (aref a 2 0) nil) (error () t)))
    (is (handler-case (progn (aref a 0) nil) (error () t)))
    (is (array-in-bounds-p a 1 2)) (is (not (array-in-bounds-p a 2 0)))
    (is (typep a 'array)) (is (typep a '(array t (2 3)))) (is (typep a '(array * 2))) (is (not (typep a '(array * (3 2)))))
    (is (not (typep a 'vector))) (is (arrayp a)) (is-equal 'array (type-of a))
    (is-equal 4 (funcall (compile nil '(lambda (a i j) (aref a i j))) a 1 0)))
  (is-equal "#2A((0 0) (0 0))" (prin1-to-string (make-array '(2 2) :initial-element 0)))
  (is-equal 7 (aref (make-array '() :initial-element 7)))
  (is-equal "#0A7" (prin1-to-string (make-array '() :initial-element 7)))
  (is-equal "#2A(() () ())" (prin1-to-string (make-array '(3 0))))
  (is (simple-vector-p (make-array '(3))))                                   ; rank 1 is a vector, as before
  (is (equalp (read-from-string "#2A((1 2) (3 4))") (make-array '(2 2) :initial-contents '((1 2) (3 4)))))
  (is (not (equalp #2A((1 2) (3 4)) #2A((1 2) (3 5)))))
  (is (equalp #(1 2 3) (read-from-string "#1A(1 2 3)")))
  (is (handler-case (progn (make-array '(2 2) :initial-contents '((1 2) (3))) nil) (error () t)))
  (is (handler-case (progn (read-from-string "#A(1 2)") nil) (error () t)))
  (is-equal "#2A((1 2 0) (3 4 0) (0 0 0))" (prin1-to-string (adjust-array #2A((1 2) (3 4)) '(3 3) :initial-element 0)))
  (let ((c (make-array '(2 2) :element-type 'character :initial-contents '("ab" "cd"))))
    (is-equal #\c (aref c 1 0)) (is-equal 'character (array-element-type c)))
  (let ((m (make-array '(3 3) :initial-element 0)))
    (dotimes (i 3) (setf (aref m i i) 1))
    (is-equal "#2A((1 0 0) (0 1 0) (0 0 1))" (prin1-to-string m))))

(deftest character-strings
  ;; strings hold characters: length, char and setf char count characters, not bytes
  (let ((s "日本語"))
    (is-equal 3 (length s))
    (is-equal #x65E5 (char-code (char s 0)))
    (is-equal "本" (subseq s 1 2))
    (is-equal 1 (position (code-char #x672C) s)))
  (let ((s (make-string 3 :initial-element #\a)))
    (setf (char s 1) (code-char #x3BB))                   ; storing a wide character widens the string in place
    (is-equal 3 (length s))
    (is-equal #x3BB (char-code (char s 1)))
    (is-equal "aλa" s)
    (setf (char s 2) #\z)
    (is-equal "aλz" s)
    (is-equal "AΛZ" (string-upcase s)))
  (let ((s (make-string 2 :initial-element (code-char #x1F600))))
    (is-equal 2 (length s))
    (is-equal #x1F600 (char-code (char s 1))))
  (is-equal "aé日😀" (concatenate 'string "a" "é" "日" (string (code-char #x1F600))))
  (is-equal "olleh日" (reverse "日hello"))
  (is (string= "λx" (coerce (list (code-char #x3BB) #\x) 'string)))
  (is (string-equal "ÄRGER" "ärger"))
  (is (equal "日本" (copy-seq "日本")))
  (is-equal (sxhash "日本") (sxhash (copy-seq "日本")))
  ;; printing and reading
  (is-equal "\"λ\"" (prin1-to-string "λ"))
  (is-equal 4 (length (format nil "~A~A" "日本" "語x")))
  (is-equal #\λ (read-from-string "#\\λ"))
  (is-equal "日本" (read-from-string "\"日本\""))
  (with-input-from-string (in "λa")
    (is-equal #\λ (read-char in))
    (is-equal #\a (read-char in)))
  (is-equal "λ日" (with-output-to-string (o) (write-char #\λ o) (write-string "日" o)))
  ;; symbols with non-ASCII names
  (let ((sym (intern "ΛΑΜΒΔΑ-ÜBER")))
    (is-equal 11 (length (symbol-name sym)))
    (is (eq sym (read-from-string "λαμβδα-über"))))
  ;; files are UTF-8
  (let ((path "/tmp/neogenera-string-test.txt"))
    (with-open-file (o path :direction :output :if-exists :supersede) (write-line "aλ日😀" o))
    (with-open-file (in path) (let ((l (read-line in))) (is-equal 4 (length l)) (is-equal "aλ日😀" l)))
    (delete-file path)))

;;; Weak objects are made inside helper functions so that no stack slot of the test still holds them.
(defun %wk-pointer-to-garbage () (make-weak-pointer (list 1 2 3)))
(defun %wk-fill (h n) (dotimes (i n) (setf (gethash (list i) h) (list :v i))) h)
(defun %wk-finalized-garbage (box) (finalize (list 'garbage) (lambda () (push :finalized (car box)))) nil)

(deftest weak-pointers
  (let* ((kept (list :kept)) (wp (make-weak-pointer kept)))
    (is (weak-pointer-p wp))
    (gc)
    (is-equal (list kept t) (multiple-value-list (weak-pointer-value wp))))
  (let ((wp (%wk-pointer-to-garbage)))
    (gc)
    (is-equal '(nil nil) (multiple-value-list (weak-pointer-value wp))))
  (is (weak-pointer-p (make-weak-pointer 42)))
  (let ((wp (make-weak-pointer 42))) (gc) (is-equal 42 (weak-pointer-value wp))))   ; immediates are never collected

(deftest weak-hash-tables
  ;; :key -- entries go when nothing else holds the key
  (let* ((h (make-hash-table :test 'eq :weakness :key)) (k1 (list 'a)) (k2 (list 'b)))
    (is-equal :key (hash-table-weakness h))
    (setf (gethash k1 h) 1 (gethash k2 h) 2)
    (%wk-fill h 50)                                     ; (a collection may already have removed some)
    (gc)
    (is-equal 2 (hash-table-count h))
    (is-equal 1 (gethash k1 h))
    (is-equal 2 (gethash k2 h))
    (setf (gethash k1 h) 10) (is-equal 10 (gethash k1 h))
    (is (remhash k2 h)) (is-equal 1 (hash-table-count h))
    (is-equal (list k1) (hash-table-keys h)))
  ;; a value that refers to its own key does not keep the entry (an ephemeron)
  (let ((h (make-hash-table :test 'eq :weakness :key)))
    (dotimes (i 10) (let ((k (list i))) (setf (gethash k h) (list :owner k))))
    (gc)
    (is-equal 0 (hash-table-count h)))
  ;; chains: one entry's value is the key of the next
  (let* ((h (make-hash-table :test 'eq :weakness :key)) (root (list :root)))
    (let ((k root)) (dotimes (i 20) (let ((n (list i))) (setf (gethash k h) n) (setq k n))))
    (gc)
    (is-equal 20 (hash-table-count h)))
  ;; :value
  (let* ((h (make-hash-table :weakness :value)) (v (list :v)))
    (setf (gethash 1 h) v (gethash 2 h) (list :garbage))
    (gc)
    (is-equal '(1) (hash-table-keys h))
    (is-equal v (gethash 1 h)))
  ;; :key-and-value and :key-or-value
  (let* ((ha (make-hash-table :test 'eq :weakness :key-and-value)) (ho (make-hash-table :test 'eq :weakness :key-or-value))
         (k (list :k)) (v (list :v)))
    (setf (gethash k ha) (list :x) (gethash k ho) (list :x) (gethash (list :y) ho) v)
    (gc)
    (is-equal 0 (hash-table-count ha))
    (is-equal 2 (hash-table-count ho)))
  ;; a nursery collection breaks entries too, and keeps the ones the old generation holds
  (let ((h (make-hash-table :test 'equal :weakness :key)) (k (copy-seq "keep")))
    (gc)                                                ; H and K are now old
    (setf (gethash k h) :kept)
    (%wk-fill h 30)
    (dotimes (i 20000) (cons i i))                      ; minor collections
    (gc)
    (is-equal 1 (hash-table-count h))
    (is-equal :kept (gethash "keep" h)))
  (is (handler-case (progn (make-hash-table :weakness :sideways) nil) (error () t))))

(deftest finalization
  (let ((box (list nil)))
    (%wk-finalized-garbage box)
    (gc)
    (run-pending-finalizers)
    (is-equal '(:finalized) (car box)))
  ;; a live object is not finalized; cancelled finalizers never run
  (let* ((box (list nil)) (obj (list :live)))
    (finalize obj (lambda () (push :wrong (car box))))
    (gc) (run-pending-finalizers)
    (is-equal nil (car box))
    (is (cancel-finalization obj))
    (is (not (cancel-finalization obj)))
    (setq obj nil)
    (gc) (run-pending-finalizers)
    (is-equal nil (car box)))
  ;; finalizers run on their own at the next safe point, and an error in one is reported, not signalled
  (let ((box (list nil)))
    (let ((*error-output* (make-string-output-stream)))
      (finalize (list :a) (lambda () (error "boom")))
      (%wk-finalized-garbage box)
      (gc)
      (identity 1)
      (dotimes (i 3) (list i))
      (is-equal '(:finalized) (car box)))))

;;; ---- CLOS ---------------------------------------------------------------------------------------------

(defclass cl-shared () ((count :allocation :class :initform 0 :accessor cl-count) (own :initarg :own :accessor cl-own)))
(defclass cl-shared-sub (cl-shared) ())

(deftest clos-class-allocation
  (let ((a (make-instance 'cl-shared :own 1)) (b (make-instance 'cl-shared-sub :own 2)))
    (setf (cl-count a) 5)
    (is-equal 5 (cl-count b))                                   ; shared with subclasses
    (is-equal '(1 2) (list (cl-own a) (cl-own b)))
    (defclass cl-shared () ((count :allocation :class :initform 0 :accessor cl-count) (own :initarg :own :accessor cl-own)))
    (is-equal 5 (cl-count (make-instance 'cl-shared)))          ; redefinition keeps the shared value
    (is-equal :class (slot-definition-allocation (find 'count (class-slots (find-class 'cl-shared)) :key #'slot-definition-name)))))

(defclass cl-point () ((x :initarg :x :accessor cl-x) (y :initarg :y :accessor cl-y)))
(defmethod update-instance-for-redefined-class :after ((p cl-point) added discarded plist &rest initargs)
  (declare (ignore initargs))
  (when (and (member 'rho added) (member 'x discarded))
    (setf (slot-value p 'rho) (+ (getf plist 'x) (getf plist 'y)))))

(deftest clos-redefinition-updates-instances
  (defclass cl-point () ((x :initarg :x :accessor cl-x) (y :initarg :y :accessor cl-y)))
  (let ((p (make-instance 'cl-point :x 3 :y 4)) (q (make-instance 'cl-point :x 1)))
    (defclass cl-point () ((x :initarg :x :accessor cl-x) (y :initarg :y :accessor cl-y) (z :initform 9 :accessor cl-z)))
    (is-equal '(3 4 9) (list (cl-x p) (cl-y p) (cl-z p)))       ; new slot gets its initform
    (is (not (slot-boundp q 'y)))
    (defclass cl-point () ((rho :accessor cl-rho)))
    (is-equal 7 (cl-rho p))                                     ; the method converted the old data
    (is (not (slot-exists-p p 'x)))
    (defclass cl-point () ((x :initarg :x :accessor cl-x) (y :initarg :y :accessor cl-y)))))

(defclass cl-person () ((name :initarg :name :accessor cl-name)))
(defclass cl-employee (cl-person) ((salary :initform 100 :initarg :salary :accessor cl-salary)))

(deftest clos-change-class
  (let ((p (make-instance 'cl-person :name "Ann")))
    (change-class p 'cl-employee :salary 200)
    (is (typep p 'cl-employee))
    (is-equal "Ann" (cl-name p))
    (is-equal 200 (cl-salary p))
    (change-class p 'cl-person)
    (is-equal 'cl-person (type-of p))
    (is (not (slot-exists-p p 'salary))))
  (let ((p (make-instance 'cl-person :name "Bo")))
    (change-class p (find-class 'cl-employee))
    (is-equal 100 (cl-salary p))
    (reinitialize-instance p :salary 5)
    (is-equal 5 (cl-salary p))
    (is-equal "Bo" (cl-name p))))

(defgeneric cl-total (x) (:method-combination +))
(defmethod cl-total + ((x integer)) 1)
(defmethod cl-total + ((x number)) 10)
(defmethod cl-total + ((x t)) 100)
(defgeneric cl-names (x) (:method-combination list :most-specific-last))
(defmethod cl-names list ((x integer)) 'integer)
(defmethod cl-names list ((x number)) 'number)
(defmethod cl-names :around ((x integer)) (cons :around (call-next-method)))
(defgeneric cl-check (x) (:method-combination and))
(defmethod cl-check and ((x integer)) (> x 0))
(defmethod cl-check and ((x number)) (error "not reached for negative integers"))

(define-method-combination cl-firstly (&optional (order :most-specific-first))
  ((around (:around)) (primary () :order order :required t))
  (let ((form `(call-method ,(first primary) ,(rest primary))))
    (if around `(call-method ,(first around) (,@(rest around) (make-method ,form))) form)))
(defgeneric cl-fl (x) (:method-combination cl-firstly :most-specific-last))
(defmethod cl-fl ((x integer)) (list :integer (if (next-method-p) (call-next-method) :none)))
(defmethod cl-fl ((x number)) (list :number (if (next-method-p) (call-next-method) :none)))
(defmethod cl-fl :around ((x integer)) (list :around (call-next-method)))

(define-method-combination cl-concat :operator concatenate-strings :identity-with-one-argument nil)
(defun concatenate-strings (&rest s) (apply #'concatenate 'string s))
(defgeneric cl-greet (x) (:method-combination cl-concat))
(defmethod cl-greet cl-concat ((x integer)) "int ")
(defmethod cl-greet cl-concat ((x number)) "num")

(deftest clos-method-combinations
  (is-equal 111 (cl-total 3))
  (is-equal 110 (cl-total 2.5))
  (is-equal 100 (cl-total "x"))
  (is-equal '(:around number integer) (cl-names 1))
  (is-equal nil (cl-check -1))
  (is-equal '(:around (:number (:integer :none))) (cl-fl 1))
  (is-equal '(:number :none) (cl-fl 1.5))
  (is-equal "int num" (cl-greet 1))
  (is (handler-case (progn (defmethod cl-total ((x string)) 0) (cl-total "s") nil) (error () t)))
  (remove-method #'cl-total (find-method #'cl-total nil (list (find-class 'string))))
  (is (handler-case (progn (cl-fl "nope") nil) (error () t))))

(defstruct cl-st a)
(defclass cl-counted-class (standard-class) ((instances :initform 0 :accessor cl-instances) (label :initarg :label :accessor cl-label)))
(defclass cl-widget () ((w :initform 1)) (:metaclass cl-counted-class) (:label "widget"))
(defmethod make-instance :after ((c cl-counted-class) &rest initargs)
  (declare (ignore initargs))
  (setf (cl-instances c) (+ 1 (cl-instances c))))

(deftest clos-metaclasses
  (let ((c (find-class 'cl-widget)))
    (is-equal 'cl-counted-class (class-name (class-of c)))
    (is-equal "widget" (cl-label c))
    (make-instance 'cl-widget) (make-instance 'cl-widget)
    (is-equal 2 (cl-instances c))
    (is (typep c 'standard-class))
    (is (typep c 'class)))
  (is-equal 'standard-class (class-name (class-of (find-class 'cl-person))))
  (is-equal 'built-in-class (class-name (class-of (find-class 'integer))))
  (is-equal 'built-in-class (class-name (class-of (find-class 'hash-table))))
  (is-equal 'structure-class (class-name (class-of (find-class 'cl-st))))
  (is (handler-case (progn (eval '(defclass cl-bad () () (:metaclass cl-person))) nil) (error () t)))
  (ensure-class 'cl-made :direct-slots '((:name a :initargs (:a) :initform 3)))
  (is-equal 3 (slot-value (make-instance 'cl-made) 'a))
  (is-equal 4 (slot-value (make-instance 'cl-made :a 4) 'a))
  (is (eq (find-class 'cl-made) (setf (find-class 'cl-made-alias) (find-class 'cl-made)))))

;;; ---- restarts and frames ------------------------------------------------------------------------------

(deftest condition-restarts
  ;; restarts made around ERROR belong to its condition
  (let ((outer nil))
    (handler-bind ((error (lambda (c)
                            (setq outer (mapcar #'restart-name (compute-restarts c)))
                            (invoke-restart 'cr-use 7))))
      (is-equal 7 (restart-case (error "boom") (cr-use (v) v))))
    (is (member 'cr-use outer)))
  (let ((c1 (make-condition 'simple-error :format-control "one")) (c2 (make-condition 'simple-error :format-control "two")))
    (restart-case
        (let ((r (find-restart 'cr-mine)))
          (with-condition-restarts c1 (list r)
            (is (find-restart 'cr-mine c1))
            (is (null (find-restart 'cr-mine c2)))              ; associated with another condition
            (is (find-restart 'cr-mine)))
          (is (find-restart 'cr-mine c2)))                      ; the association ends with the form
      (cr-mine () nil)))
  ;; interactive restarts
  (is-equal '(1 2) (restart-case (invoke-restart-interactively 'cr-two)
                     (cr-two (a b) :interactive (lambda () (list 1 2)) (list a b))))
  (is-equal :none (restart-case (invoke-restart-interactively 'cr-none) (cr-none () :none)))
  (is-equal 5 (block cr-block
                (restart-bind ((cr-b (lambda (x) (return-from cr-block x)) :interactive-function (lambda () (list 5))))
                  (invoke-restart-interactively 'cr-b)))))

(defvar *fr-calls* 0)
(defvar *fr-special* :outer)
(defun fr-inner (x) (incf *fr-calls*) (when (= *fr-calls* 1) (error "fr-inner failed")) (* x 10))   ; (not a tail call)
(defun fr-middle (x) (let ((*fr-special* :inner)) (+ 1 (fr-inner x))))
(defun fr-outer (x) (list :result (fr-middle x) *fr-special*))
(defvar *fr-tries* 0)
(defun fr-boxed (n) (let ((f (lambda () (setq n (+ n 1))))) (incf *fr-tries*) (funcall f) (when (< *fr-tries* 2) (error "again")) n))
(dolist (f '(fr-inner fr-middle fr-outer fr-boxed)) (compile f))           ; (loaded code is interpreted: no VM frames)
(defun fr-frame (name) (find name (%capture-backtrace) :key #'cadr))

(deftest debugger-frame-return-and-retry
  ;; returning a value from a frame: its caller continues; bindings made above it are undone; cleanups run
  (let* ((cleaned nil)
         (r (handler-bind ((error (lambda (c) (declare (ignore c)) (debugger-return-from-frame (fr-frame 'fr-inner) 41))))
              (setq *fr-calls* 0)
              (unwind-protect (fr-outer 5) (setq cleaned t)))))
    (is-equal '(:result 42 :outer) r)
    (is cleaned))
  ;; several values
  (is-equal '(1 2) (handler-bind ((error (lambda (c) (declare (ignore c)) (debugger-return-from-frame (fr-frame 'fr-inner) 1 2))))
                     (setq *fr-calls* 0)
                     (multiple-value-list (fr-inner 1))))
  ;; retrying a frame runs it again
  (is-equal '(:result 51 :outer)
            (handler-bind ((error (lambda (c) (declare (ignore c)) (debugger-restart-frame (fr-frame 'fr-inner)))))
              (setq *fr-calls* 0)
              (fr-outer 5)))
  (is-equal 2 *fr-calls*)
  ;; a frame whose parameter is captured and changed is retried with the parameter's value
  (setq *fr-tries* 0)
  (is-equal 4 (handler-bind ((error (lambda (c) (declare (ignore c)) (debugger-restart-frame (fr-frame 'fr-boxed)))))
                (fr-boxed 2)))
  (is (handler-case (progn (debugger-return-from-frame (list nil 'nothing nil 999999) 1) nil) (error () t))))
