;;;; phase4-tests.lisp -- bignums/ratios, CLOS, conditions and restarts, streams.

(in-package :cl)

;;; ---- numeric tower ------------------------------------------------------------------

(deftest bignums
  (is-equal "1267650600228229401496703205376" (princ-to-string (expt 2 100)))
  (is-equal 0 (- (expt 2 100) (expt 2 100)))
  (is-equal (expt 2 101) (* 2 (expt 2 100)))
  (is-equal 2 (floor (expt 2 100) (expt 2 99)))
  (is-equal '(-5 3) (multiple-value-list (floor -17 4)))
  (is-equal '(142857142857142857142857142857 1) (multiple-value-list (floor (expt 10 30) 7)))
  (is-equal 30 (length (princ-to-string (expt 10 29))))
  (is-equal 2432902008176640000 (let ((f 1)) (dotimes (i 20) (setq f (* f (+ i 1)))) f))
  (is-equal "265252859812191058636308480000000" (princ-to-string (let ((f 1)) (dotimes (i 30) (setq f (* f (+ i 1)))) f)))
  (is-equal 100 (isqrt (expt 10 4)))
  (is-equal (expt 10 20) (isqrt (expt 10 40)))
  (is-equal 101 (integer-length (expt 2 100)))
  (is-equal (expt 2 70) (ash 1 70))
  (is-equal 1 (ash (expt 2 70) -70))
  (is-equal -1 (ash -1 -100))
  (is (bignump (expt 2 70)))
  (is (fixnump 5))
  (is (= (expt 2 100) (* (expt 2 50) (expt 2 50))))
  (is (< (expt 2 100) (expt 2 101)))
  (is (eql (expt 2 100) (expt 2 100)))
  (is-equal t (equal (expt 2 100) (expt 2 100)))
  (is-equal 1125899906842624 (gcd (expt 2 90) (expt 6 50)))
  (is-equal (expt 2 100) (parse-integer "1267650600228229401496703205376"))
  (is-equal "FF" (format nil "~X" 255))
  (is-equal "1267650600228229401496703205376" (format nil "~D" (expt 2 100)))
  (is-equal "1,000,000" (format nil "~:D" 1000000))
  (is-equal (expt 10 30) (read-from-string "1000000000000000000000000000000"))
  (is-equal (logand (expt 2 70) (- (expt 2 71) 1)) (expt 2 70))
  (is-equal -36893488147419103233 (logxor -1 (expt 2 65)))
  (is-equal (- (expt 2 64)) (- 0 (expt 2 64)))
  (is-equal 25 (mod (expt 10 20) 31))
  (signals-error (floor 1 0)))

(deftest ratios
  (is-equal 1/2 (/ 1 2))
  (is-equal "1/3" (princ-to-string (/ 1 3)))
  (is-equal 1 (+ 1/3 2/3))
  (is-equal 5/6 (+ 1/2 1/3))
  (is-equal 1/6 (- 1/2 1/3))
  (is-equal 2/9 (* 2/3 1/3))
  (is-equal 3/2 (/ 6 4))
  (is-equal 3 (numerator 3/2))
  (is-equal 2 (denominator 3/2))
  (is-equal 3 (denominator 1/3))
  (is-equal 1/8 (expt 2 -3))
  (is-equal 9/4 (expt 3/2 2))
  (is-equal 0.5 (float 1/2))
  (is-equal '(3 1/2) (multiple-value-list (floor 7/2)))
  (is-equal 4 (round 7/2))
  (is-equal 2 (round 5/2))
  (is-equal 3 (ceiling 5/2))
  (is-equal 1/2 (rational 0.5))
  (is (ratiop 1/3))
  (is (not (ratiop 2)))
  (is (< 1/3 1/2))
  (is (< 1/3 0.34))
  (is (= 1/2 0.5))
  (is-equal -1/2 (- 1/2))
  (is-equal 1/2 (abs -1/2))
  (is-equal 1/4 (/ 1 4))
  (is-equal '(1/2 1/3) (read-from-string "(1/2 2/6)"))
  (signals-error (/ 1 0))
  (signals-error (/ 1/2 0)))

;;; ---- CLOS ---------------------------------------------------------------------------------

(defclass animal ()
  ((name :initarg :name :accessor animal-name :initform "unnamed")
   (legs :initarg :legs :reader animal-legs :initform 4)
   (tags :initform nil :accessor animal-tags)))
(defclass dog (animal) ((tricks :initform nil :accessor dog-tricks) (breed :initarg :breed :initform :mutt)))
(defclass cat (animal) () (:default-initargs :legs 4 :name "cat"))
(defclass robot () ((id :initarg :id :reader robot-id)))
(defclass robot-dog (robot dog) ())

(defgeneric speak (animal))
(defmethod speak ((a animal)) "...")
(defmethod speak ((d dog)) "woof")
(defmethod speak ((c cat)) "meow")
(defmethod speak ((r robot-dog)) (concatenate 'string "beep-" (call-next-method)))

(defgeneric describe-it (x))
(defmethod describe-it ((x integer)) "integer")
(defmethod describe-it ((x fixnum)) (concatenate 'string "fixnum/" (call-next-method)))
(defmethod describe-it ((x number)) "number")
(defmethod describe-it ((x string)) "string")
(defmethod describe-it ((x symbol)) "symbol")
(defmethod describe-it ((x null)) (concatenate 'string "null/" (call-next-method)))
(defmethod describe-it ((x list)) "list")
(defmethod describe-it ((x (eql 42))) (concatenate 'string "forty-two/" (call-next-method)))
(defmethod describe-it (x) "other")

(defgeneric combine (a b))
(defmethod combine ((a integer) (b integer)) :int-int)
(defmethod combine ((a integer) (b string)) :int-string)
(defmethod combine ((a number) b) :number-any)
(defmethod combine (a b) :default)

(defvar *trace* nil)
(defgeneric hooked (x))
(defmethod hooked ((x integer)) (push :primary *trace*) :result)
(defmethod hooked :before ((x integer)) (push :before *trace*))
(defmethod hooked :after ((x integer)) (push :after *trace*))
(defmethod hooked :around ((x integer)) (push :around-in *trace*) (prog1 (call-next-method) (push :around-out *trace*)))
(defmethod hooked :before ((x number)) (push :before-number *trace*))

(deftest clos-classes
  (let ((d (make-instance 'dog :name "Rex" :breed :lab)))
    (is-equal "Rex" (animal-name d))
    (is-equal 4 (animal-legs d))
    (is-equal :lab (slot-value d 'breed))
    (is-equal nil (dog-tricks d))
    (setf (animal-name d) "Max")
    (is-equal "Max" (animal-name d))
    (push :sit (dog-tricks d))
    (is-equal '(:sit) (dog-tricks d))
    (setf (slot-value d 'legs) 3)
    (is-equal 3 (animal-legs d))
    (is (typep d 'dog)) (is (typep d 'animal)) (is (not (typep d 'cat)))
    (is (slot-boundp d 'name)) (is (slot-exists-p d 'tricks)) (is (not (slot-exists-p d 'nope)))
    (is-equal 'dog (class-name (class-of d)))
    (is-equal "#<DOG>" (princ-to-string d)))
  (is-equal "unnamed" (animal-name (make-instance 'animal)))
  (is-equal "cat" (animal-name (make-instance 'cat)))
  (is-equal "Tom" (animal-name (make-instance 'cat :name "Tom")))
  (is-equal :mutt (slot-value (make-instance 'dog) 'breed))
  (is-equal '(robot-dog robot dog animal standard-object t)
            (mapcar #'class-name (class-precedence-list (find-class 'robot-dog))))
  (is-equal '(animal) (mapcar #'class-name (class-direct-superclasses (find-class 'dog))))
  (is (member (find-class 'dog) (class-direct-subclasses (find-class 'animal))))
  (is-equal '(name legs tags tricks breed) (mapcar #'slot-definition-name (class-slots (find-class 'dog))))
  (signals-error (make-instance 'no-such-class))
  (signals-error (slot-value (make-instance 'robot) 'id))
  (signals-error (slot-value (make-instance 'dog) 'nope))
  (is-equal 7 (with-slots (id) (make-instance 'robot :id 7) id))
  (is-equal '(1 2) (let ((o (make-instance 'robot :id 1))) (with-slots ((x id)) o (list x 2))))
  (is-equal "Q" (let ((a (make-instance 'animal :name "Q"))) (with-accessors ((n animal-name)) a n)))
  (is-equal 9 (let ((o (make-instance 'robot :id 1))) (with-slots (id) o (setf id 9)) (slot-value o 'id))))

(deftest clos-dispatch
  (is-equal "..." (speak (make-instance 'animal)))
  (is-equal "woof" (speak (make-instance 'dog)))
  (is-equal "meow" (speak (make-instance 'cat)))
  (is-equal "beep-woof" (speak (make-instance 'robot-dog)))
  (is-equal "fixnum/integer" (describe-it 5))
  (is-equal "integer" (describe-it (expt 2 100)))
  (is-equal "number" (describe-it 1.5))
  (is-equal "number" (describe-it 1/2))
  (is-equal "string" (describe-it "x"))
  (is-equal "symbol" (describe-it 'foo))
  (is-equal "null/symbol" (describe-it nil))
  (is-equal "list" (describe-it '(1)))
  (is-equal "forty-two/fixnum/integer" (describe-it 42))
  (is-equal "other" (describe-it #\a))
  (is-equal :int-int (combine 1 2))
  (is-equal :int-string (combine 1 "a"))
  (is-equal :number-any (combine 1.5 "a"))
  (is-equal :number-any (combine 1 'x))
  (is-equal :default (combine "a" 1))
  (setq *trace* nil)
  (is-equal :result (hooked 1))
  (is-equal '(:around-in :before :before-number :primary :after :around-out) (reverse *trace*))
  (signals-error (speak 42))
  ;; redefining a method replaces it
  (defmethod speak ((c cat)) "purr")
  (is-equal "purr" (speak (make-instance 'cat)))
  (is (typep (find-method 'speak nil '(cat)) '%method))
  (is-equal 4 (length (generic-function-methods (symbol-function 'speak))))
  (is-equal 2 (length (compute-applicable-methods 'speak (list (make-instance 'dog))))))

(defclass counter () ((n :initform 0 :accessor counter-n)))
(defmethod initialize-instance :after ((c counter) &rest args)
  (declare (ignore args))
  (setf (counter-n c) 100))
(defmethod print-object ((c counter) stream) (format stream "#<COUNTER ~D>" (counter-n c)))
(defgeneric (setf label) (value obj))
(defvar *labels* nil)
(defmethod (setf label) (value (c counter)) (push value *labels*) value)

(deftest clos-protocol
  (let ((c (make-instance 'counter)))
    (is-equal 100 (counter-n c))
    (is-equal "#<COUNTER 100>" (prin1-to-string c))
    (setf (label c) :x)
    (is-equal '(:x) *labels*))
  ;; redefining a class in place keeps its identity and methods
  (let ((before (find-class 'counter)))
    (eval '(defclass counter () ((n :initform 5 :accessor counter-n) (extra :initform :e))))
    (is (eq before (find-class 'counter)))
    (is-equal :e (slot-value (make-instance 'counter) 'extra)))
  (is (typep (class-of 1) '%class))
  (is-equal '(fixnum integer rational real number t) (mapcar #'class-name (class-precedence-list (class-of 1))))
  (is-equal 'string (class-name (class-of "x")))
  (is-equal 'null (class-name (class-of nil)))
  (is-equal 'cons (class-name (class-of '(1))))
  (is (subtypep 'dog 'animal))
  (is (typep 5 'integer)) (is (typep 5 '(integer 0 10))) (is (not (typep 50 '(integer 0 10))))
  (is (typep 1/2 'ratio)) (is (typep 1.5 'float)) (is (typep nil 'null)) (is (typep "x" 'sequence))
  (is (typep 5 '(or string integer))) (is (typep 5 '(and number (not string))))
  (is-equal "#S(PT3D :X 1 :Y 2)" (progn (defstruct pt3d x y) (prin1-to-string (make-pt3d :x 1 :y 2))))
  (defmethod print-object ((p pt3d) s) (format s "<~D,~D>" (pt3d-x p) (pt3d-y p)))
  (is-equal "<1,2>" (prin1-to-string (make-pt3d :x 1 :y 2)))
  (is-equal "(<1,2> 5)" (prin1-to-string (list (make-pt3d :x 1 :y 2) 5))))

;;; ---- conditions & restarts ---------------------------------------------------------------------

(define-condition my-error (error)
  ((code :initarg :code :reader my-error-code :initform 0))
  (:report (lambda (c s) (format s "my-error code ~D" (my-error-code c)))))
(define-condition my-warning (warning) ())

(deftest conditions
  (is-equal 7 (handler-case (error 'my-error :code 7) (my-error (e) (my-error-code e))))
  (is-equal "my-error code 3" (handler-case (error 'my-error :code 3) (error (e) (princ-to-string e))))
  (is-equal :caught (handler-case (error "x") (error () :caught)))
  (is-equal :fine (handler-case :fine (error () :bad)))
  (is-equal '(1 2) (multiple-value-list (handler-case (values 1 2) (error () :bad))))
  (is-equal 6 (handler-case 5 (error () :bad) (:no-error (v) (+ v 1))))
  (is-equal "boom 5" (handler-case (error "boom ~D" 5) (simple-error (e) (princ-to-string e))))
  (is-equal :arith (handler-case (/ 1 0) (division-by-zero () :arith)))
  (is-equal :type (handler-case (car 5) (type-error () :type)))
  (is-equal :unbound (handler-case (symbol-value 'surely-unbound-xyz) (unbound-variable () :unbound)))
  (is-equal :undef (handler-case (funcall 'surely-undefined-fn-xyz) (undefined-function () :undef)))
  (is-equal :prog (handler-case (funcall (lambda (a) a)) (program-error () :prog)))
  (is-equal :serious (handler-case (error "x") (serious-condition () :serious)))
  (is-equal :first (handler-case (error "x") (error () :first) (condition () :second)))
  (is-equal :outer (handler-case (handler-case (error "x") (type-error () :inner)) (error () :outer)))
  (is-equal "x" (let ((e (nth-value 1 (ignore-errors (error "x"))))) (princ-to-string e)))
  (is-equal nil (ignore-errors (error "x")))
  (is-equal 3 (ignore-errors 3))
  ;; handler-bind runs at the signal point and may decline
  (is-equal '(:a :b :caught)
            (let ((log nil))
              (handler-case
                  (handler-bind ((error (lambda (c) (declare (ignore c)) (push :a log)))
                                 (error (lambda (c) (declare (ignore c)) (push :b log))))
                    (error "z"))
                (error () (push :caught log)))
              (reverse log)))
  (is-equal :handled (handler-case (handler-bind ((error (lambda (c) (declare (ignore c)) nil))) (error "x")) (error () :handled)))
  ;; signal returns nil when nobody handles it
  (is-equal nil (signal 'my-warning))
  (is-equal :sig (handler-case (signal 'my-error) (my-error () :sig)))
  ;; unwind-protect cleanup runs on handler-case exit
  (is-equal :cleaned (let ((r nil)) (handler-case (unwind-protect (error "x") (setq r :cleaned)) (error () nil)) r))
  (is (typep (make-condition 'simple-error :format-control "a") 'error))
  (is-equal "a 1" (princ-to-string (make-condition 'simple-error :format-control "a ~D" :format-arguments '(1))))
  (is-equal "#<MY-ERROR \"my-error code 0\">" (prin1-to-string (make-condition 'my-error))))

(deftest restarts
  (is-equal 11 (restart-case (+ 1 (invoke-restart 'use-it 10)) (use-it (v) (+ v 1))))
  (is-equal :done (restart-case (progn (invoke-restart 'skip) :not-reached) (skip () :done)))
  (is-equal 42 (handler-bind ((error (lambda (c) (declare (ignore c)) (invoke-restart 'use-value 42))))
                 (restart-case (error "x") (use-value (v) v))))
  (is-equal :resumed
            (handler-bind ((my-warning (lambda (c) (declare (ignore c)) (invoke-restart 'resume))))
              (restart-case (progn (signal 'my-warning) :not-resumed) (resume () :resumed))))
  (is-equal '(use-it skip) (restart-case (mapcar #'restart-name (compute-restarts))
                             (use-it () nil)
                             (skip () nil)))
  (is (restart-case (find-restart 'r1) (r1 () nil)))
  (is (not (find-restart 'no-such-restart)))
  (is-equal "Do it" (restart-case (restart-report-string (find-restart 'r2)) (r2 () :report "Do it" nil)))
  (is-equal '(nil t) (multiple-value-list (with-simple-restart (my-r "hello") (invoke-restart 'my-r))))
  (is-equal 5 (restart-bind ((r (lambda () 5))) (invoke-restart 'r)))
  (is-equal :continued (handler-bind ((error (lambda (c) (declare (ignore c)) (continue))))
                         (cerror "go on" "oops") :continued))
  (is-equal :muffled (handler-bind ((warning (lambda (c) (declare (ignore c)) (muffle-warning))))
                       (warn "careful") :muffled))
  (is-equal 5 (let ((x "no")) (handler-bind ((error (lambda (c) (declare (ignore c)) (store-value 5)))) (check-type x integer)) x))
  (signals-error (invoke-restart 'definitely-not-here))
  (signals-error (abort))
  ;; restarts are only active inside their dynamic extent
  (restart-case nil (r3 () nil))
  (is (not (find-restart 'r3))))

;;; ---- streams ---------------------------------------------------------------------------------------

(defclass upcase-stream (fundamental-character-output-stream)
  ((target :initarg :target)))
(defmethod stream-write-char ((s upcase-stream) ch)
  (write-char (char-upcase ch) (slot-value s 'target)))

(defclass counting-input (fundamental-character-input-stream)
  ((chars :initarg :chars) (pos :initform 0)))
(defmethod stream-read-char ((s counting-input))
  (with-slots (chars pos) s
    (if (>= pos (length chars)) :eof (prog1 (char chars pos) (incf pos)))))
(defmethod stream-unread-char ((s counting-input) ch) (declare (ignore ch)) (decf (slot-value s 'pos)) nil)

(deftest gray-streams
  (is-equal "HELLO 5"
            (let ((out (make-string-output-stream)))
              (format (make-instance 'upcase-stream :target out) "hello ~D" 5)
              (get-output-stream-string out)))
  (is-equal "ABC" (let ((out (make-string-output-stream)))
                    (write-string "abc" (make-instance 'upcase-stream :target out))
                    (get-output-stream-string out)))
  (is-equal "(1 \"X\")" (let ((out (make-string-output-stream)))
                          (prin1 '(1 "x") (make-instance 'upcase-stream :target out))
                          (get-output-stream-string out)))
  (is-equal "AB" (let ((out (make-string-output-stream)))
                   (let ((*standard-output* (make-instance 'upcase-stream :target out)))
                     (write-string "ab") (finish-output))
                   (get-output-stream-string out)))
  (is-equal #\a (read-char (make-instance 'counting-input :chars "abc")))
  (is-equal '(#\a #\b #\a) (let ((s (make-instance 'counting-input :chars "abc")))
                             (list (read-char s) (read-char s) (progn (unread-char #\b s) (peek-char nil s) #\a))))
  (is-equal :end (read-char (make-instance 'counting-input :chars "") nil :end))
  (is-equal "hello" (read-line (make-instance 'counting-input :chars "hello
world")))
  (is (streamp (make-instance 'upcase-stream :target nil)))
  (is-equal 3 (let ((s (make-instance 'upcase-stream :target (make-string-output-stream))))
                (write-string "abc" s) (stream-line-column s))))

(deftest composite-streams
  (is-equal '("x1" "x1")
            (let ((a (make-string-output-stream)) (b (make-string-output-stream)))
              (format (make-broadcast-stream a b) "x~D" 1)
              (list (get-output-stream-string a) (get-output-stream-string b))))
  (is-equal "via-synonym"
            (let ((out (make-string-output-stream)) (*test-sink* nil))
              (declare (ignorable *test-sink*))
              (setq *test-sink-stream* out)
              (write-string "via-synonym" (make-synonym-stream '*test-sink-stream*))
              (get-output-stream-string out)))
  (is-equal "abcdef" (let ((s (make-concatenated-stream (make-string-input-stream "abc") (make-string-input-stream "def")))
                           (acc nil) (c nil))
                       (loop (setq c (read-char s nil nil)) (unless c (return)) (push c acc))
                       (coerce (nreverse acc) 'string)))
  (is-equal "out" (let ((tw (make-two-way-stream (make-string-input-stream "in") (make-string-output-stream))))
                    (write-string "out" tw)
                    (get-output-stream-string (two-way-stream-output-stream tw))))
  (is-equal #\i (read-char (make-two-way-stream (make-string-input-stream "in") (make-string-output-stream))))
  (is-equal "ab" (let* ((out (make-string-output-stream))
                        (e (make-echo-stream (make-string-input-stream "ab") out)))
                   (read-char e) (read-char e)
                   (get-output-stream-string out))))

(defvar *test-sink-stream* nil)
(defvar *test-sink* nil)

(defgeneric %t-dispatch-probe (x))
(defmethod %t-dispatch-probe ((x t)) :t)
(defmethod %t-dispatch-probe ((x restart)) :restart)

(deftest classes-share-one-t
  ;; the self-hosting build loads the system twice; built-in classes must survive the second load, or structure
  ;; classes made by the first one fall outside methods specialized on T
  (let ((tc (find-class t)) (bad nil))
    (dolist (p (list-all-packages))
      (dolist (s (%package-symbols p nil))
        (let ((c (and (symbolp s) (get s '%class))))
          (when (and c (not (eq (car (last (%cls-cpl c))) tc))) (setq bad (cons s bad))))))
    (is-equal nil bad))
  (is-equal :t (%t-dispatch-probe (current-process)))   ; a structure from the system image
  (is-equal :t (%t-dispatch-probe (make-lock)))
  (is-equal :t (%t-dispatch-probe 42)))
