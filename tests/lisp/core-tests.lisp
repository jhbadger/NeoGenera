;;;; core-tests.lisp -- tests for the core library (Phase 2).

(in-package :cl)

(deftest macros
  (is-equal 3 (let ((x 1)) (incf x 2) x))
  (is-equal '(3 2 1) (let ((l nil)) (dolist (x '(1 2 3) l) (push x l))))
  (is-equal 10 (let ((s 0)) (dotimes (i 5 s) (incf s i))))
  (is-equal '(1 2 3) (do ((i 1 (+ i 1)) (acc nil (cons i acc))) ((> i 3) (nreverse acc))))
  (is-equal :b (case 2 (1 :a) ((2 3) :b) (t :c)))
  (is-equal :c (case 9 (1 :a) ((2 3) :b) (t :c)))
  (is-equal 6 (multiple-value-bind (a b) (values 2 3) (* a b)))
  (is-equal '(1 2) (multiple-value-list (values 1 2)))
  (is-equal '(1 (2 3)) (destructuring-bind (a (b c)) '(1 (2 3)) (list a (list b c))))
  (is-equal '(1 2 (3 4)) (destructuring-bind (a &optional (b 2) &rest r) '(1 2 3 4) (list a b r)))
  (is-equal '(1 9) (destructuring-bind (&key a (b 9)) '(:a 1) (list a b)))
  (is-equal 5 (prog1 5 (+ 1 1)))
  (is-equal 7 (let ((x 3)) (psetq x 7) x))
  (is-equal '(2 1) (let ((a 1) (b 2)) (rotatef a b) (list a b))))

(deftest setf-places
  (is-equal '(9 2) (let ((l (list 1 2))) (setf (car l) 9) l))
  (is-equal 5 (let ((v (vector 1 2 3))) (setf (aref v 1) 5) (aref v 1)))
  (is-equal '(1 7 3) (let ((l (list 1 2 3))) (setf (nth 1 l) 7) l))
  (is-equal 2 (let ((l (list 1 2 3))) (pop l) (pop l)))
  (is-equal '(0 1 2) (let ((l (list 1 2))) (push 0 l) l))
  (is-equal '(a b) (let ((l (list 'a))) (pushnew 'b l :test #'eq) (pushnew 'a l) (reverse l)))
  (is-equal 11 (let ((h (make-hash-table))) (setf (gethash 'k h) 11) (gethash 'k h)))
  (is-equal :v (progn (setf (get 'tsym 'ind) :v) (get 'tsym 'ind))))

(deftest lists
  (is-equal '(2 4 6) (mapcar (lambda (x) (* 2 x)) '(1 2 3)))
  (is-equal '(5 7 9) (mapcar #'+ '(1 2 3) '(4 5 6)))
  (is-equal '(1 3) (remove-if #'evenp '(1 2 3 4)))
  (is-equal '(1 2 3) (remove 9 '(1 9 2 9 3)))
  (is-equal 3 (find 3 '(1 2 3 4)))
  (is-equal 2 (position 3 '(1 2 3)))
  (is-equal 6 (reduce #'+ '(1 2 3)))
  (is-equal '(3 2 1) (reduce (lambda (acc x) (cons x acc)) '(1 2 3) :initial-value nil))
  (is-equal '(1 2 3 4) (sort (list 3 1 4 2) #'<))
  (is-equal '("a" "b" "c") (sort (list "c" "a" "b") #'string<))
  (is-equal '(1 2 3) (remove-duplicates '(1 2 1 3 2)))
  (is-equal '(3 2 1) (union '(1 2) '(3 2 1) :test #'eql) )
  (is (every #'numberp '(1 2 3)))
  (is (some #'evenp '(1 2 3)))
  (is-equal 3 (count-if #'oddp '(1 2 3 4 5)))
  (is-equal '(a . 1) (assoc 'a '((b . 2) (a . 1))))
  (is-equal '(1 2) (butlast '(1 2 3)))
  (is-equal '(3) (last '(1 2 3)))
  (is-equal '(0 1 2) (iota 3)))

(deftest strings
  (is-equal "HELLO" (string-upcase "hello"))
  (is-equal "ab" (concatenate 'string "a" "b"))
  (is-equal "bc" (subseq "abcd" 1 3))
  (is-equal "hi" (string-trim " " "  hi  "))
  (is (string< "a" "b"))
  (is-equal 12 (parse-integer "12"))
  (is-equal -5 (parse-integer " -5 "))
  (is-equal 2 (search "cd" "abcd"))
  (is-equal "3.5" (princ-to-string 3.5))
  (is-equal "(1 2)" (prin1-to-string '(1 2)))
  (is-equal "\"x\"" (prin1-to-string "x"))
  (is-equal '(#\a #\b) (coerce "ab" 'list))
  (is-equal #\A (char-upcase #\a))
  (is-equal "abc" (coerce '(#\a #\b #\c) 'string)))

(deftest format-directives
  (is-equal "x=5" (format nil "x=~D" 5))
  (is-equal "(1 2) \"s\"" (format nil "~A ~S" '(1 2) "s"))
  (is-equal "a
b" (format nil "a~%b"))
  (is-equal "   42" (format nil "~5D" 42))
  (is-equal "ff" (string-downcase (format nil "~X" 255)))
  (is-equal "101" (format nil "~B" 5))
  (is-equal "1, 2, 3" (format nil "~{~A~^, ~}" '(1 2 3)))
  (is-equal "3.14" (format nil "~,2F" 3.14159))
  (is-equal "~" (format nil "~~"))
  (is-equal "x  " (format nil "~3A" "x"))
  (is-equal "HELLO" (format nil "~:@(~A~)" "hello")))

(deftest hash-tables
  (let ((h (make-hash-table :test 'equal)))
    (setf (gethash "a" h) 1)
    (setf (gethash "b" h) 2)
    (is-equal 1 (gethash "a" h))
    (is-equal 2 (hash-table-count h))
    (is-equal nil (gethash "zz" h))
    (is-equal '(:d nil) (multiple-value-list (gethash "zz" h :d)))
    (remhash "a" h)
    (is-equal 1 (hash-table-count h))
    (dotimes (i 200) (setf (gethash i h) (* i i)))
    (is-equal 144 (gethash 12 h))
    (is-equal 201 (hash-table-count h))))

(defstruct point x y)
(defstruct (point3 (:include point)) z)
(defstruct (node (:constructor mk-node (val &optional next))) val next)

(deftest structs
  (let ((p (make-point :x 1 :y 2)))
    (is-equal 1 (point-x p))
    (setf (point-y p) 10)
    (is-equal 10 (point-y p))
    (is (point-p p))
    (is (not (point-p 5)))
    (is-equal "#S(POINT :X 1 :Y 10)" (prin1-to-string p)))
  (let ((q (make-point3 :x 1 :y 2 :z 3)))
    (is (point-p q))
    (is-equal 3 (point3-z q))
    (is-equal 1 (point-x q)))
  (is-equal 5 (node-val (mk-node 5)))
  (signals-error (point-x 42)))

(deftest loop-macro
  (is-equal '(1 2 3) (loop for x in '(1 2 3) collect x))
  (is-equal 6 (loop for x in '(1 2 3) sum x))
  (is-equal '(0 1 2 3) (loop for i from 0 to 3 collect i))
  (is-equal '(0 2 4) (loop for i from 0 below 6 by 2 collect i))
  (is-equal '(3 2 1) (loop for i from 3 downto 1 collect i))
  (is-equal '(a b) (loop for x across #(a b) collect x))
  (is-equal 3 (loop for x in '(1 2 3) count (> x 0)))
  (is-equal 9 (loop for x in '(3 9 2) maximize x))
  (is-equal '(2 4) (loop for x in '(1 2 3 4) when (evenp x) collect x))
  (is-equal :found (loop for x in '(1 2 3) when (= x 2) return :found))
  (is-equal '(1 2) (loop repeat 2 for i from 1 collect i))
  (is-equal t (loop for x in '(2 4) always (evenp x)))
  (is-equal '((1 . 2)) (loop for (a . b) in '((1 . 2)) collect (cons a b)))
  (is-equal 10 (loop with s = 0 for i from 1 to 4 do (incf s i) finally (return s)))
  (is-equal '(1 4 9) (loop for i from 1 to 3 collect (* i i))))

(deftest errors
  (is-equal "boom" (handler-case (error "boom") (error (e) (princ-to-string e))))
  (is-equal "x 5" (handler-case (error "x ~D" 5) (error (e) (princ-to-string e))))
  (is-equal :ok (handler-case :ok (error (e) e)))
  (signals-error (car 5))
  (signals-error (undefined-function-xyz))
  (is-equal :cleanup (let ((r nil)) (ignore-errors (unwind-protect (error "x") (setq r :cleanup))) r))
  (is-equal 3 (catch 'k (throw 'k 3)))
  (is-equal 7 (block b (unwind-protect (return-from b 7) 1))))

(deftest numbers
  (is-equal 7 (+ 3 4))
  (is-equal 2 (floor 7 3))
  (is-equal '(2 1) (multiple-value-list (floor 7 3)))
  (is-equal '(-3 2) (multiple-value-list (floor -7 3)))
  (is-equal '(-2 -1) (multiple-value-list (truncate -7 3)))
  (is-equal 1 (mod -7 4))
  (is-equal 1024 (expt 2 10))
  (is-equal 2.0 (sqrt 4))
  (is-equal 1/2 (/ 1 2))
  (is-equal 3 (/ 9 3))
  (is-equal 4 (ash 1 2))
  (is-equal 8 (logand 12 10))
  (is-equal 1152921504606846975 most-positive-fixnum)
  (is-equal 1152921504606846976 (+ most-positive-fixnum 1))
  (is (bignump (+ most-positive-fixnum 1)))
  (is-equal most-positive-fixnum (- (+ most-positive-fixnum 1) 1))
  (is (= 1 1.0))
  (is-equal 2 (round 2.5))
  (is-equal 4 (round 3.5)))

(deftest closures-and-dynamic
  (is-equal 1 (funcall (let ((n 0)) (lambda () (incf n)))))
  (is-equal '(1 2 3) (let ((c (let ((n 0)) (lambda () (incf n))))) (list (funcall c) (funcall c) (funcall c))))
  (let ((fs nil))
    (dotimes (i 3) (push (lambda () i) fs))
    (is-equal '(2 1 0) (mapcar #'funcall fs)))
  (is-equal 120 (labels ((f (n) (if (<= n 1) 1 (* n (f (- n 1)))))) (f 5)))
  (is-equal 1 (flet ((g () 1)) (g))))

(defvar *dyn* :global)
(defun read-dyn () *dyn*)
(deftest specials
  (is-equal :global (read-dyn))
  (is-equal :bound (let ((*dyn* :bound)) (read-dyn)))
  (is-equal :global (progn (let ((*dyn* :tmp)) nil) (read-dyn)))
  (is-equal :global (progn (ignore-errors (let ((*dyn* :tmp)) (error "x"))) (read-dyn))))
