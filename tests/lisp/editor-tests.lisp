;;;; editor-tests.lisp -- regular expressions, search and replace, views, keyboard macros, completion,
;;;; arglist hints, syntax colouring and Unicode text.  Uses the helpers in tools-tests.lisp and ui-tests.lisp.

(in-package :cl)

(defun rx (pattern string &rest opts)
  "The first match of PATTERN in STRING as a list of the whole match and each group (NIL when none)."
  (multiple-value-bind (s e groups) (regex-find (apply #'regex-compile pattern opts) string)
    (declare (ignore e))
    (and s (map 'list (lambda (g) (and g (subseq string (car g) (cdr g)))) groups))))

(defun ed-type-codes (wm &rest codes) (dolist (c codes) (wm-handle-event wm (list :key c 0))) (wm-draw wm))
(defun ed-set (ed text) (buffer-set-text (ed-buffer ed) text))
(defun ed-point (ed) (cons (point-line (ed-buffer ed)) (point-col (ed-buffer ed))))
(defun count-screen-rows (wm text)
  (let ((n 0)) (dotimes (r (scr-rows (wm-screen wm)) n) (when (%string-search text (screen-row-string (wm-screen wm) r) 0) (setq n (+ n 1))))))
(defun ed-lisp-wm ()
  (multiple-value-bind (wm ed) (make-editor-wm)
    (setf (buffer-mode (ed-buffer ed)) 'lisp-mode)
    (values wm ed)))

(deftest regex-engine
  (is-equal '("bbb") (rx "b+" "aabbbc"))
  (is-equal '("abc") (rx "a.c" "xxabcx"))
  (is-equal '("joe@example.com" "joe" "example") (rx "(\\w+)@(\\w+)\\.com" "mail joe@example.com now"))
  (is-equal nil (rx "^ab" "cab"))
  (is-equal '("ab") (rx "ab$" "cab"))
  (is-equal '("cat") (rx "\\bcat\\b" "concat cat"))
  (is-equal '("ababc" "b") (rx "(a|b)*c" "zzababc"))
  (is-equal '("aaa") (rx "a{2,3}" "aaaa"))
  (is-equal '("aa") (rx "a{2}" "aaaa"))
  (is-equal '("xxxy") (rx "x*?y" "xxxy"))
  (is-equal '("a") (rx "a+?" "aaa"))
  (is-equal '("def") (rx "[^a-c]+" "abcdef"))
  (is-equal '("123") (rx "[[:digit:]]+" "ab 123 c"))
  (is-equal '("123") (rx "\\d+" "ab 123 c"))
  (is-equal '(" ") (rx "\\s" "ab c"))
  (is-equal '("cc" "c") (rx "(\\w)\\1" "abccd"))
  (is-equal '("ab" nil) (rx "ab|(x)" "ab"))
  (is-equal '("color") (rx "colou?r" "colr color"))
  (is-equal '("a.b") (rx "a\\.b" "axb a.b"))
  (is-equal '("{x}") (rx "{x}" "a{x}"))                                    ; a brace that is not a repetition is literal
  (is-equal '("ab") (rx "(?:a)b" "ab"))
  ;; UTF-8: . and classes take whole characters; case folding is Unicode-aware
  (is-equal '("λλ") (rx "λ+" "αλλβ"))
  (is-equal '("日") (rx "." "日本"))
  (is-equal '("αβγ") (rx "[α-ω]+" "xx αβγ yy"))
  (is-equal '("ärger") (rx "ÄRGER" "ärger" :case-fold t))
  (is-equal nil (rx "ÄRGER" "ärger"))
  (is-equal '("Straße") (rx "straße" "Die Straße" :case-fold t))
  ;; backward search, replacement and errors
  (is-equal '(3 5) (multiple-value-bind (s e) (regex-find-backward (regex-compile "ab") "ab ab ab" 7) (list s e)))
  (is-equal "bar_foo qux_baz" (regex-replace-all (regex-compile "(\\w+)-(\\w+)") "foo-bar baz-qux" "\\2_\\1"))
  (is-equal "[ab]" (regex-replace-all (regex-compile "ab") "ab" "[\\&]"))
  (is-equal "-a-b-c-" (regex-replace-all (regex-compile "x*") "abc" "-"))
  (is (string-match-p "^\\d{3}-\\d{4}$" "555-1234"))
  (is (not (string-match-p "^\\d{3}-\\d{4}$" "555-12345")))
  (dolist (bad '("(ab" "ab)" "*a" "[ab" "a{3,1}" "x\\" "[[:nope:]]"))
    (is (handler-case (progn (regex-compile bad) nil) (regex-syntax-error () t))))
  ;; no deep recursion for a long run of one character
  (let ((long (make-string 20000 :initial-element #\a)))
    (is-equal 20000 (nth-value 1 (regex-find (regex-compile "a*") long)))
    (is-equal nil (regex-find (regex-compile "a*b") (subseq long 0 2000)))))

(deftest unicode-properties
  (is-equal '(1 2 0 2 1 0 2) (mapcar #'char-display-width '(97 #x65E5 #x301 #x1F600 #xE9 #x200D #xAC00)))
  (is-equal 5 (string-display-width "日本a"))
  (is-equal 1 (string-display-width (utf8-from-codes '(101 #x301))))
  (is-equal "STRASSE" (utf8-upcase "STRASSE"))
  (is-equal "ÄRGER ΑΒΓ ПРИВЕТ ŁÓDŹ" (utf8-upcase "ärger αβγ привет łódź"))
  (is-equal "ärger αβγ привет łódź" (utf8-downcase "ÄRGER ΑΒΓ ПРИВЕТ ŁÓDŹ"))
  (is-equal "Élan Vital Ωμέγα" (utf8-capitalize "élan VITAL ωμέγα"))
  (is-equal #x3C3 (unicode-fold #x3C2))                                    ; final sigma folds to sigma
  (is (unicode-word-char-p #x3BB))
  (is (not (unicode-word-char-p #x2014)))                                  ; an em dash is punctuation
  (is (not (unicode-word-char-p #x1F600)))
  (is-equal '(97 #x3BB #x65E5) (utf8-codes "aλ日"))
  (is-equal "aλ日" (utf8-from-codes '(97 #x3BB #x65E5))))

(deftest screen-wide-and-combining
  (let ((s (make-screen 3 10)))
    (screen-draw-string s 0 0 "日本x" -1 -1 0)
    (is-equal (list #x65E5 +wide-cont+ #x672C +wide-cont+ 120) (mapcar (lambda (c) (car (screen-cell s 0 c))) '(0 1 2 3 4)))
    (is-equal "日本x" (screen-row-string s 0))
    (is-equal '(0 . 4) (screen-find-text s "x"))
    (is-equal '(0 . 2) (screen-find-text s "本"))
    ;; writing over half of a wide character blanks the other half
    (screen-put s 0 1 97 -1 -1 0)
    (is-equal " a本x" (screen-row-string s 0))
    ;; a wide character that does not fit in the last column becomes a space
    (screen-put s 1 9 #x65E5 -1 -1 0)
    (is-equal 32 (car (screen-cell s 1 9)))
    ;; a combining mark joins the character before it
    (screen-draw-string s 2 0 (utf8-from-codes '(101 #x301 120)) -1 -1 0)
    (is-equal (utf8-from-codes '(101 #x301 120)) (screen-row-string s 2))
    (is-equal 120 (car (screen-cell s 2 1)))
    ;; the output never sends the second half; the cursor position after a wide character is two columns on
    (let* ((t1 (make-screen 1 6)))
      (screen-draw-string t1 0 0 "日a" -1 -1 0)
      (let ((out (coerce (screen-flush t1 nil :mono) 'list)))
        (is (member #x65E5 out))
        (is (not (member +wide-cont+ out)))
        (is (member 97 out)))
      (screen-put t1 0 2 98 -1 -1 0)
      (let ((out (coerce (screen-flush t1 nil :mono) 'list)))     ; only the changed cell, no repositioning before it
        (is (member 98 out)) (is (not (member #x65E5 out))))))
  ;; Listener text is laid out by display width
  (is-equal 4 (utf8-length "日本"))
  (is-equal 1 (utf8-prefix-end "日本" 0 3))
  (is-equal 0 (utf8-prefix-end "日本" 0 0))
  (is-equal 1 (utf8-prefix-end "日本" 0 1)))                                ; at least one character

(deftest editor-unicode-text
  (multiple-value-bind (wm ed) (make-editor-wm)
    (ed-set ed "日本語abc")
    (ed-keys wm "C-f")
    (is-equal '(0 . 1) (ed-point ed))
    (ed-keys wm "C-e")
    (is (screen-has wm "C10"))                                             ; column counts wide characters twice
    (is (screen-has wm "日本語abc"))
    ;; combining marks stay with their character
    (ed-set ed (utf8-from-codes '(101 #x301 120)))
    (ed-keys wm "C-f")
    (is-equal 2 (point-col (ed-buffer ed)))
    (ed-keys wm "C-b")
    (is-equal 0 (point-col (ed-buffer ed)))
    ;; transposing, word case and word motion work on characters
    (ed-set ed "aλ")
    (ed-keys wm "C-e C-t")
    (is-equal "λa" (ed-text ed))
    (ed-set ed "ärger élan")
    (ed-keys wm "M-u")
    (is-equal "ÄRGER élan" (ed-text ed))
    (ed-keys wm "M-c")
    (is-equal "ÄRGER Élan" (ed-text ed))
    (ed-set ed (utf8-from-codes (append (utf8-codes "foo") (list #x2014) (utf8-codes "bar"))))
    (ed-keys wm "M-f")
    (is-equal 3 (point-col (ed-buffer ed)))
    (ed-set ed "x λ")
    (ed-keys wm "M-< C-f C-f C-x =")
    (is (screen-has wm "Char: λ (U+03BB, 2 bytes, width 1)"))
    (ed-keys wm "C-e C-x 8 RET") (ed-type wm "1F600") (ed-keys wm "RET")
    (is-equal (utf8-from-codes '(120 32 #x3BB #x1F600)) (ed-text ed))
    (ed-keys wm "C-x 8 RET") (ed-type wm "zz") (ed-keys wm "RET")
    (is (screen-has wm "Not a code point: zz"))
    ;; region case
    (ed-set ed "αβγ δεζ")
    (ed-keys wm "C-SPC C-e C-x C-u")
    (is-equal "ΑΒΓ ΔΕΖ" (ed-text ed))
    (ed-keys wm "M-< C-SPC C-e C-x C-l")
    (is-equal "αβγ δεζ" (ed-text ed))))

(deftest editor-regexp-search-and-case-folding
  (multiple-value-bind (wm ed) (make-editor-wm)
    (ed-type wm "Foo foo a1 b22 c333")
    (ed-keys wm "M-< C-s") (ed-type wm "foo")
    (is-equal '(0 . 3) (ed-point ed))                                      ; lower case: matches "Foo"
    (ed-keys wm "RET M-< C-s") (ed-type wm "Fo")
    (ed-keys wm "C-s")
    (is (screen-has wm "Failing I-search: Fo"))                            ; an upper-case letter: exact case
    (ed-keys wm "C-g M-< C-M-s") (ed-type wm "[0-9]+")
    (is (screen-has wm "Regexp I-search: [0-9]+"))
    (is-equal '(0 . 10) (ed-point ed))
    (ed-keys wm "C-s")
    (is-equal '(0 . 14) (ed-point ed))
    (ed-keys wm "C-s")
    (is-equal '(0 . 19) (ed-point ed))
    (ed-keys wm "RET M-< C-M-s") (ed-type wm "(")
    (is (screen-has wm "[incomplete input]"))
    (ed-type wm "b|c)2")
    (is-equal '(0 . 13) (ed-point ed))                                    ; "b2"
    (ed-keys wm "M-r")                                                     ; now literal: "(b|c)2" is not in the text
    (is (screen-has wm "Failing I-search: (b|c)2"))
    (ed-keys wm "C-g")
    ;; C-r with a regexp
    (ed-keys wm "M-> C-M-r") (ed-type wm "\\d\\d")
    (is-equal '(0 . 17) (ed-point ed))
    (ed-keys wm "RET")
    ;; occur and count-matches
    (ed-set ed (format nil "alpha 1~%beta~%gamma 22"))
    (ed-keys wm "M-x") (ed-type wm "count-matches") (ed-keys wm "RET") (ed-type wm "[0-9]") (ed-keys wm "RET")
    (is (screen-has wm "3 occurrences"))
    (ed-keys wm "M-x") (ed-type wm "occur") (ed-keys wm "RET") (ed-type wm "[0-9]") (ed-keys wm "RET")
    (is-equal "*Possibilities*" (buffer-name (ed-buffer ed)))
    (is (screen-has wm "3: gamma 22"))
    (ed-keys wm "C-n C-n RET")
    (is-equal "work" (buffer-name (ed-buffer ed)))
    (is-equal '(2 . 6) (ed-point ed))))

(deftest editor-query-replace
  (multiple-value-bind (wm ed) (make-editor-wm)
    (ed-type wm "cat dog cat cat")
    (ed-keys wm "M-< M-%") (ed-type wm "cat") (ed-keys wm "RET") (ed-type wm "bird") (ed-keys wm "RET")
    (is (screen-has wm "Query replacing cat with bird"))
    (ed-keys wm "y")
    (ed-keys wm "n")
    (ed-keys wm "!")
    (is-equal "bird dog cat bird" (ed-text ed))
    (is (screen-has wm "Replaced 2 occurrences"))
    (is (not (ed-query ed)))
    ;; folding keeps the case of each match
    (ed-set ed "Cat CAT cat")
    (ed-keys wm "M-< M-%") (ed-type wm "cat") (ed-keys wm "RET") (ed-type wm "dog") (ed-keys wm "RET")
    (ed-keys wm "!")
    (is-equal "Dog DOG dog" (ed-text ed))
    ;; . replaces one and stops; q stops; another key stops and runs
    (ed-set ed "a a a")
    (ed-keys wm "M-< M-%") (ed-type wm "a") (ed-keys wm "RET") (ed-type wm "b") (ed-keys wm "RET .")
    (is-equal "b a a" (ed-text ed))
    (ed-keys wm "M-< M-%") (ed-type wm "a") (ed-keys wm "RET") (ed-type wm "c") (ed-keys wm "RET q")
    (is-equal "b a a" (ed-text ed))
    (ed-keys wm "M-< M-%") (ed-type wm "a") (ed-keys wm "RET") (ed-type wm "c") (ed-keys wm "RET C-e")
    (is (not (ed-query ed)))
    (is-equal 5 (point-col (ed-buffer ed)))
    ;; regexps with groups, through M-x
    (ed-set ed "a=b c=d")
    (ed-keys wm "M-x") (ed-type wm "query-replace-regexp") (ed-keys wm "RET")
    (ed-type wm "(\\w)=(\\w)") (ed-keys wm "RET") (ed-type wm "\\2=\\1") (ed-keys wm "RET !")
    (is-equal "b=a d=c" (ed-text ed))
    (ed-set ed "x1 y22")
    (ed-keys wm "M-x") (ed-type wm "replace-regexp") (ed-keys wm "RET") (ed-type wm "[0-9]+") (ed-keys wm "RET") (ed-type wm "<\\&>") (ed-keys wm "RET")
    (is-equal "x<1> y<22>" (ed-text ed))
    ;; each replacement is one undo step
    (ed-keys wm "C-/")
    (is-equal "x<1> y22" (ed-text ed))
    ;; an empty match does not loop
    (ed-set ed "ab")
    (ed-keys wm "M-x") (ed-type wm "replace-regexp") (ed-keys wm "RET") (ed-type wm "x*") (ed-keys wm "RET") (ed-type wm "-") (ed-keys wm "RET")
    (is-equal "-a-b-" (ed-text ed))
    (ed-keys wm "M-x") (ed-type wm "replace-regexp") (ed-keys wm "RET") (ed-type wm "(") (ed-keys wm "RET") (ed-type wm "x") (ed-keys wm "RET")
    (is (screen-has wm "Invalid regexp"))))

(deftest editor-views
  (multiple-value-bind (wm ed) (make-editor-wm)
    (ed-type wm (format nil "first line~%second line~%third line"))
    (ed-keys wm "M-<")
    (ed-keys wm "C-x 2")
    (is-equal 2 (length (ed-views ed)))
    (is-equal 2 (count-screen-rows wm "work   ("))                         ; two mode lines
    ;; each view has its own point
    (ed-keys wm "C-x o M->")
    (is-equal '(2 . 10) (ed-point ed))
    (ed-keys wm "C-x o")
    (is-equal '(0 . 0) (ed-point ed))
    ;; an edit shows in both views of the buffer
    (ed-type wm "NEW ")
    (wm-draw wm)
    (is-equal 2 (count-screen-rows wm "NEW first line"))
    ;; another buffer in the other view
    (ed-keys wm "C-x 4 b") (ed-type wm "notes") (ed-keys wm "RET")
    (is-equal "notes" (buffer-name (ed-buffer ed)))
    (is-equal 1 (position (ed-selected ed) (ed-views ed)))
    (is (screen-has wm "Editor: notes"))
    (ed-keys wm "C-x 3")
    (is-equal 3 (length (ed-views ed)))
    (is (screen-has wm (utf8-from-codes (list #x2502))))
    ;; clicking selects a view
    (let* ((v (first (ed-views ed))) (x (+ 1 (view-rx v) 2)) (y (+ 1 (view-ry v) 1)))
      (wm-feed wm (mouse-bytes :press (+ (window-x ed) x) (+ (window-y ed) y)))
      (is (eq (ed-selected ed) v))
      (is-equal "work" (buffer-name (ed-buffer ed))))
    (ed-keys wm "C-x 0")
    (is-equal 2 (length (ed-views ed)))
    (ed-keys wm "C-x 1")
    (is-equal 1 (length (ed-views ed)))
    (ed-keys wm "C-x 0")
    (is (screen-has wm "Attempt to delete the only view"))
    ;; C-M-v scrolls the other view; killing a buffer replaces it in every view
    (ed-keys wm "C-x 2")
    (ed-keys wm "C-x b") (ed-type wm "doomed") (ed-keys wm "RET C-x k")
    (is (every (lambda (v) (not (string= "doomed" (buffer-name (view-buffer v))))) (ed-views ed)))))

(deftest editor-keyboard-macros
  (multiple-value-bind (wm ed) (make-editor-wm)
    (ed-keys wm "C-x (")
    (is (screen-has wm "Defining kbd macro"))
    (ed-type wm "ab")
    (is (screen-has wm "Def)"))
    (ed-keys wm "C-x )")
    (is-equal 2 (length (ed-macro ed)))
    (ed-keys wm "C-x e")
    (is-equal "abab" (ed-text ed))
    (ed-keys wm "e e")                                                     ; e repeats right after C-x e
    (is-equal "abababab" (ed-text ed))
    (ed-keys wm "C-u 3 C-x e")
    (is-equal "ababababababab" (ed-text ed))
    ;; a macro stops at a failing command; C-u 0 repeats until then
    (ed-set ed "x x x x")
    (ed-keys wm "M-< C-x (")
    (ed-keys wm "C-s") (ed-type wm "x") (ed-keys wm "RET")
    (ed-type wm "!")
    (ed-keys wm "C-x )")
    (is-equal "x! x x x" (ed-text ed))
    (ed-keys wm "C-u 0 C-x e")
    (is-equal "x! x! x! x!" (ed-text ed))
    ;; F3 / F4, and naming a macro
    (ed-set ed "")
    (ed-keys wm "<f3>") (ed-type wm "z") (ed-keys wm "<f4> <f4>")
    (is-equal "zz" (ed-text ed))
    (ed-keys wm "M-x") (ed-type wm "name-last-kbd-macro") (ed-keys wm "RET") (ed-type wm "insert-zed") (ed-keys wm "RET")
    (ed-keys wm "M-x") (ed-type wm "insert-zed") (ed-keys wm "RET")
    (is-equal "zzz" (ed-text ed))
    (ed-keys wm "C-x )")
    (is (screen-has wm "Not defining a keyboard macro"))))

(deftest editor-completion
  (multiple-value-bind (wm ed) (ed-lisp-wm)
    (ed-type wm "(multiple-value-bi")
    (ed-keys wm "M-<tab>")
    (is-equal "(multiple-value-bind" (ed-text ed))
    (ed-type wm " (x) (mapc")
    (ed-keys wm "M-<tab>")
    (is (screen-has wm "mapcan"))
    (is (screen-has wm "mapcar"))
    (ed-keys wm "C-a C-k")
    (ed-type wm "(destructuring-b")
    (ed-keys wm "TAB")                                                     ; indented already: TAB completes
    (is-equal "(destructuring-bind" (ed-text ed))
    (ed-keys wm "C-a C-k")
    (ed-type wm "(list :tes")
    (ed-keys wm "M-<tab>")
    (is (%string-search ":test" (ed-text ed) 0))
    (ed-keys wm "C-a C-k")
    (ed-type wm "(cl:mapc")
    (ed-keys wm "M-<tab>")
    (is (screen-has wm "cl:mapcar"))
    (ed-keys wm "C-a C-k")
    (ed-type wm "(zzqq-no")
    (ed-keys wm "M-<tab>")
    (is (screen-has wm "No match")))
  ;; dabbrev: words from the buffer, nearest first, cycling with M-/
  (multiple-value-bind (wm ed) (make-editor-wm)
    (ed-type wm (format nil "foobar fooqux~%fo"))
    (ed-keys wm "M-/")
    (is-equal (format nil "foobar fooqux~%fooqux") (ed-text ed))
    (ed-keys wm "M-/")
    (is-equal (format nil "foobar fooqux~%foobar") (ed-text ed))
    (dotimes (i 10) (unless (ed-message ed) (ed-keys wm "M-/")))            ; then words from other buffers, then the end
    (is-equal (format nil "foobar fooqux~%fo") (ed-text ed))
    (is (screen-has wm "No further expansions of fo"))))

(deftest editor-arglist-hint
  (multiple-value-bind (wm ed) (ed-lisp-wm)
    (flet ((hl () (let ((h (ed-hint ed))) (and h (cadr h) (subseq (car h) (cadr h) (caddr h))))))
      (ed-type wm "(mapcar ")
      (is (screen-has wm "(mapcar fn list &rest more)"))
      (is-equal "fn" (hl))
      (ed-type wm "#'car ")
      (is-equal "list" (hl))
      (ed-type wm "x y ")
      (is-equal "more" (hl))
      (ed-keys wm "C-a C-k")
      (ed-type wm "(position 1 '(1 2) :test ")
      (is-equal "test" (hl))
      (ed-keys wm "C-a C-k")
      (ed-type wm "(position 1 '(1 2) :start 0 :e")
      (is (null (hl)))
      (ed-keys wm "C-a C-k")
      (ed-type wm "(list (position 1 ")                                     ; the innermost call
      (is (%string-search "(position" (car (ed-hint ed)) 0))
      (ed-keys wm "C-a C-k")
      (ed-type wm "(no-such-function-zz ")
      (is (null (ed-hint ed)))
      (ed-keys wm "C-a C-k")
      (ed-type wm "\"(mapcar ")                                            ; inside a string: nothing
      (is (null (ed-hint ed))))))

(deftest editor-syntax-colouring
  (multiple-value-bind (spans state) (lisp-line-syntax "(defun foo (x &key y) \"doc\" #\\a :kw nil) ; note" nil)
    (is-equal nil state)
    (is-equal '((1 6 :builtin) (7 10 :defname) (14 18 :keyword) (22 27 :string) (28 31 :constant) (32 35 :keyword) (36 39 :constant) (41 47 :comment))
              spans))
  (is-equal :string (nth-value 1 (lisp-line-syntax "(f \"open" nil)))
  (is-equal '((0 6 :string) (7 9 :comment)) (lisp-line-syntax "close\" ;x" :string))
  (is-equal '(:block . 1) (nth-value 1 (lisp-line-syntax "#| a #| b |#" nil)))
  (is-equal nil (nth-value 1 (lisp-line-syntax "|# (" '(:block . 1))))
  (multiple-value-bind (wm ed) (ed-lisp-wm)
    (ed-set ed (format nil "(a~%b~%c)"))
    (is-equal nil (%syntax-state-at (ed-buffer ed) 2))
    (ed-keys wm "M-< C-f") (ed-type wm "\"")                                ; a string opened on line 1 spans the rest
    (is-equal :string (%syntax-state-at (ed-buffer ed) 2))
    (ed-keys wm "C-/")
    (is-equal nil (%syntax-state-at (ed-buffer ed) 2))
    ;; the colours reach the screen
    (ed-set ed "(defun f () \"str\")")
    (wm-draw wm)
    (let* ((pos (screen-has wm "\"str\"")) (cell (screen-cell (wm-screen wm) (car pos) (+ 1 (cdr pos)))))
      (is-equal (syntax-face :string) (cadr cell)))
    (let* ((pos (screen-has wm "defun")) (cell (screen-cell (wm-screen wm) (car pos) (cdr pos))))
      (is-equal (syntax-face :builtin) (cadr cell))
      (is-equal +bold+ (cadddr cell)))))
