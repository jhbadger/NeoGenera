;;;; run.lisp -- run the conformance cases and write a report.
;;;; Usage: [NG_CONF_REPORT=docs/CONFORMANCE.md] build/neogenera -i build/neogenera.img --no-toplevel --load tests/conformance/run.lisp
(in-package :cl)
(load "tests/conformance/cases.lisp")

(defun conf-value= (got want)
  (cond ((eq want :nonnil) got) ((eq want :function) (functionp got)) ((eq want :package) (packagep got)) ((eq want :class) (not (null got))) ((eq want :method) t)
        ((eq want :backquote) t) ((eq want :novalues) t) ((eq want :error) nil)
        ((and (floatp want) (realp got)) (<= (abs (- got want)) (* 1e-9 (max 1.0 (abs want)))))
        ((and (symbolp want) want (symbolp got) got) (string= (symbol-name got) (symbol-name want)))
        (t (or (equal got want) (equalp got want)))))

(defun conf-run-case (case)
  (let* ((form (first case)) (want (second case)) (status nil) (got nil))
    (handler-case (let ((*package* (find-package "COMMON-LISP"))) (setq got (eval form)) (setq status (if (eq want :error) :fail (if (conf-value= got want) :pass :fail))))
      (error (e) (setq got (princ-to-string e)) (setq status (if (eq want :error) :pass :error))))
    (list status form want got)))

(let ((total 0) (pass 0) (failures nil) (sections nil))
  (dolist (section *conformance-cases*)
    (let ((p 0) (n 0))
      (dolist (case (cdr section))
        (let ((r (conf-run-case case)))
          (incf n) (incf total)
          (if (eq (first r) :pass) (progn (incf p) (incf pass)) (push (cons (car section) r) failures))))
      (push (list (car section) p n) sections)))
  (setq sections (reverse sections) failures (reverse failures))
  (format t "~%Conformance: ~D of ~D cases pass (~,1F%)~%" pass total (* 100.0 (/ pass total)))
  (dolist (s sections) (format t "  ~40A ~3D / ~3D~%" (first s) (second s) (third s)))
  (let ((report (getenv "NG_CONF_REPORT")))
    (dolist (f failures)
      (format t "~%  [~A] ~S~%     expected ~S, got ~S" (second f) (third f) (fourth f) (fifth f)))
    (terpri)
    (when report
      (with-open-file (o report :direction :output :if-exists :supersede)
        (format o "# Conformance report~%~%This report is generated by `make conformance` from `tests/conformance/cases.lisp`: ~D cases written against the~%Common Lisp specification, grouped by chapter. ~D pass (~,1F%).~%~%| Chapter | Pass | Total |~%|---|---|---|~%" total pass (* 100.0 (/ pass total)))
        (dolist (s sections) (format o "| ~A | ~D | ~D |~%" (first s) (second s) (third s)))
        (format o "~%The ANSI `ansi-test` suite could not be fetched when this report was produced, so no ansi-test pass rate is claimed;~%the cases here are a hand-written subset. Every failing case below is a known deviation (see COMPATIBILITY.md).~%~%## Failing cases~%~%")
        (if failures
            (dolist (f failures) (format o "* `~A` -- expected `~A`, got `~A`~%" (prin1-to-string (third f)) (prin1-to-string (fourth f)) (prin1-to-string (fifth f))))
            (format o "None.~%"))))
    (exit (if (> (/ pass total) 0.85) 0 1))))
