;;;; 00-asm-instructions.lisp -- the bytecode instruction reference for the assembler.
;;;;
;;;; One entry per VM instruction (the table *OPCODES* in lisp/compiler/00-defs.lisp supplies numbers and operand
;;;; counts; src/vm.c is the authority on what each does).  The same table drives the editor's instruction help,
;;;; the assembler's checks and the instruction reference in docs/manual/bytecode-manual.md (a test checks that the
;;;; manual mentions every entry).

(in-package :cl)

(defparameter *asm-instruction-info*
  ;; (mnemonic operands stack-effect group description)
  '((const "datum" "( -- x )" :stack "Push the literal datum.  The operand is data, not a form: (const foo) pushes the symbol FOO.")
    (lref "slot" "( -- x )" :stack "Push the value of frame slot SLOT.  A slot is a number or a name bound by a parameter or by (:var name).")
    (lset "slot" "( x -- )" :stack "Pop the top of the stack into frame slot SLOT.")
    (fref "index" "( -- x )" :stack "Push captured variable INDEX of the running closure (only in a (:lambda ...) with (:free ...)).")
    (gref "symbol" "( -- x )" :global "Push the global (special) value of SYMBOL; an error if it is unbound.")
    (gset "symbol" "( x -- )" :global "Pop the top of the stack into the global value of SYMBOL; an error for a constant.")
    (gfun "symbol" "( -- f )" :global "Push the global function named SYMBOL; an error if it is undefined or a macro.")
    (pop "" "( x -- )" :stack "Discard the top of the stack.")
    (dup "" "( x -- x x )" :stack "Duplicate the top of the stack.")
    (slide "n" "( x1 ... xn y -- y )" :stack "Drop the N values below the top of the stack, keeping the top.")
    (jmp "label" "( -- )" :control "Jump to LABEL.  A backward jump is a safe point where the process may be switched.")
    (jnil "label" "( x -- )" :control "Pop X; jump to LABEL if it is NIL.")
    (jnnil "label" "( x -- )" :control "Pop X; jump to LABEL if it is not NIL.")
    (call "n" "( f a1 ... an -- r )" :control "Call the function F with the N arguments above it; push its first value.")
    (tailcall "n" "( f a1 ... an -- )" :control "Call F with N arguments and return its values as this function's values; the frame is reused.")
    (ret "" "( x -- )" :control "Return X as the single value of the function.")
    (retv "" "( x -- )" :control "Return X and keep the multiple values the preceding call left behind.")
    (closure "(:lambda ...) n" "( v1 ... vn -- fn )" :closure "Make a closure of the nested (:lambda ...) capturing the N values on the stack.")
    (box "" "( x -- box )" :closure "Wrap X in a fresh one-cell box (a cons); the way mutated captured variables are held.")
    (unbox "" "( box -- x )" :closure "Read the contents of a box.  The operand must be known to be a cons.")
    (boxset "" "( box x -- x )" :closure "Store X in BOX and leave X.  BOX must be known to be a cons.")
    (bind "symbol" "( x -- )" :global "Pop X and bind SYMBOL dynamically to it until a matching UNBIND.")
    (unbind "n" "( -- )" :global "Undo the N most recent dynamic bindings of this function.")
    (car "" "( x -- y )" :list "CAR of a list (an error for an atom other than NIL).")
    (cdr "" "( x -- y )" :list "CDR of a list.")
    (cons "" "( a d -- c )" :list "Make a cons.")
    (carx "" "( c -- a )" :list "CAR of a value known to be a cons, with no check.")
    (cdrx "" "( c -- d )" :list "CDR of a value known to be a cons, with no check.")
    (eq "" "( a b -- bool )" :compare "T if A and B are the same object, else NIL.")
    (not "" "( x -- bool )" :compare "T if X is NIL, else NIL.")
    (add "" "( a b -- sum )" :arith "A + B with a fixnum fast path; any numbers.")
    (sub "" "( a b -- diff )" :arith "A - B with a fixnum fast path; any numbers.")
    (mul "" "( a b -- prod )" :arith "A * B with a fixnum fast path; any numbers.")
    (lt "" "( a b -- bool )" :compare "T if A < B (any reals).")
    (gt "" "( a b -- bool )" :compare "T if A > B (any reals).")
    (le "" "( a b -- bool )" :compare "T if A <= B (any reals).")
    (ge "" "( a b -- bool )" :compare "T if A >= B (any reals).")
    (numeq "" "( a b -- bool )" :compare "T if A = B (any numbers).")
    (addfx "" "( a b -- sum )" :fixnum "Fixnum A + B, no tests; wraps modulo 2^61.  Both operands must be known fixnums.")
    (subfx "" "( a b -- diff )" :fixnum "Fixnum A - B; wraps modulo 2^61.  Both operands must be known fixnums.")
    (mulfx "" "( a b -- prod )" :fixnum "Fixnum A * B; wraps modulo 2^61.  Both operands must be known fixnums.")
    (incfx "" "( a -- a+1 )" :fixnum "Fixnum A + 1; wraps modulo 2^61.  A must be a known fixnum.")
    (decfx "" "( a -- a-1 )" :fixnum "Fixnum A - 1; wraps modulo 2^61.  A must be a known fixnum.")
    (ltfx "" "( a b -- bool )" :fixnum "Fixnum A < B.  Both operands must be known fixnums.")
    (gtfx "" "( a b -- bool )" :fixnum "Fixnum A > B.  Both operands must be known fixnums.")
    (lefx "" "( a b -- bool )" :fixnum "Fixnum A <= B.  Both operands must be known fixnums.")
    (gefx "" "( a b -- bool )" :fixnum "Fixnum A >= B.  Both operands must be known fixnums.")
    (numeqfx "" "( a b -- bool )" :fixnum "Fixnum A = B.  Both operands must be known fixnums.")
    (logandfx "" "( a b -- r )" :fixnum "Bitwise AND of two known fixnums.")
    (logiorfx "" "( a b -- r )" :fixnum "Bitwise inclusive OR of two known fixnums.")
    (logxorfx "" "( a b -- r )" :fixnum "Bitwise exclusive OR of two known fixnums.")
    (remfx "" "( a b -- r )" :fixnum "REM of two known fixnums; \"Division by zero\" if B is 0.")
    (modfx "" "( a b -- r )" :fixnum "MOD of two known fixnums; \"Division by zero\" if B is 0.")
    (ashfx "shift" "( a -- r )" :fixnum "Shift the known fixnum A by the constant SHIFT bits (negative: right).")
    (addfl "" "( a b -- sum )" :flonum "Flonum A + B.  Both operands must be known flonums.")
    (subfl "" "( a b -- diff )" :flonum "Flonum A - B.  Both operands must be known flonums.")
    (mulfl "" "( a b -- prod )" :flonum "Flonum A * B.  Both operands must be known flonums.")
    (divfl "" "( a b -- quot )" :flonum "Flonum A / B; \"Division by zero\" if B is 0.0.  Both operands must be known flonums.")
    (ltfl "" "( a b -- bool )" :flonum "Flonum A < B.  Both operands must be known flonums.")
    (gtfl "" "( a b -- bool )" :flonum "Flonum A > B.  Both operands must be known flonums.")
    (lefl "" "( a b -- bool )" :flonum "Flonum A <= B.  Both operands must be known flonums.")
    (gefl "" "( a b -- bool )" :flonum "Flonum A >= B.  Both operands must be known flonums.")
    (numeqfl "" "( a b -- bool )" :flonum "Flonum A = B.  Both operands must be known flonums.")
    (fixtofl "" "( a -- f )" :flonum "Convert a known fixnum to a flonum.")
    (svref "" "( v i -- x )" :array "AREF of a vector and one subscript; a simple vector in range takes the fast path, anything else generic AREF.")
    (svset "" "( v i x -- x )" :array "Store X at subscript I of V (the generic (setf aref) when V is not a simple vector in range); leave X.")
    (schar "" "( s i -- c )" :array "The character at subscript I of the string S.")
    (svrefx "" "( v i -- x )" :array "SVREF with the vector, the index and the range all trusted.  Only in a routine declared (:unsafe).")
    (svsetx "" "( v i x -- x )" :array "SVSET with everything trusted.  Only in a routine declared (:unsafe).")
    (chkfix "" "( x -- x )" :check "Signal a type error unless X is a fixnum.  Afterwards the assembler knows X is a fixnum.")
    (chktype "type" "( x -- x )" :check "Signal a type error unless X has TYPE: fixnum integer double-float real number cons list symbol null string simple-vector character.")
    (chkrange "lo hi" "( x -- x )" :check "Signal a type error unless X is a fixnum between LO and HI.  Afterwards X is a known fixnum.")))

(defparameter *asm-instruction-groups*
  '((:stack "Stack and variables") (:global "Global variables, functions and dynamic binding")
    (:control "Control transfer") (:closure "Closures and boxes") (:list "Lists")
    (:compare "Comparison and equality") (:arith "Generic arithmetic") (:fixnum "Fixnum operations")
    (:flonum "Floating-point operations") (:array "Vectors and strings") (:check "Type checks"))
  "The groups of instructions in the reference, in order: (group title).")

(defvar *asm-mnemonics* (make-hash-table :test 'equal)
  "Instruction names (upper-case strings) mapped to their opcode keywords.")
(dolist (e *opcodes*) (setf (gethash (symbol-name (car e)) *asm-mnemonics*) (car e)))

(defun asm-mnemonics ()
  "The names of all the instructions, as lower-case strings in opcode order."
  (mapcar (lambda (e) (string-downcase (symbol-name (car e)))) *opcodes*))

(defun %asm-info-entry (name)
  (let ((s (string-upcase (if (symbolp name) (symbol-name name) name))))
    (find-if (lambda (e) (string= (symbol-name (car e)) s)) *asm-instruction-info*)))

(defun asm-instruction-help (name)
  "A one-line description of the instruction NAME: its operands, its stack effect and what it does; NIL if there is no such instruction."
  (let ((e (%asm-info-entry name)))
    (and e (format nil "~(~A~)~:[ ~A~;~*~] ~A  ~A" (car e) (string= (cadr e) "") (cadr e) (caddr e) (car (last e))))))
