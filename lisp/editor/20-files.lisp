;;;; 20-files.lisp -- files, backups, Dired, version control, definitions, editor integration.

(in-package :cl)

(defvar *source-root* nil)
(defvar *backup-keep* 3)

(defun run-program (program args &optional input)
  "Run PROGRAM with ARGS (no shell).  Returns (values output exit-status); stderr is merged into output."
  (%run-program program args input))

;;; ---- file access ---------------------------------------------------------------------------------

(defun source-root ()
  "The directory holding the NeoGenera sources (lisp/, docs/), used to find system source files: the variable
*SOURCE-ROOT*, else the environment variable NG_SOURCE_ROOT (set by bin/neogenera), else NIL."
  (or *source-root* (getenv "NG_SOURCE_ROOT")))

(defun resolve-source-path (file)
  (let ((root (source-root)))
    (cond ((probe-file file) file)
          ((and root (probe-file (%string-concat root "/" file))) (%string-concat root "/" file))
          (t file))))

(defun read-file-lines (path)
  (with-open-file (s path)
    (let ((acc nil) (eof (list nil)))
      (loop (multiple-value-bind (line missing) (read-line s nil eof)
              (declare (ignore missing))
              (when (eq line eof) (return))
              (setq acc (cons line acc))))
      (or (nreverse acc) (list "")))))

(defun write-file-lines (path lines)
  (with-open-file (s path :direction :output)
    (dolist (l lines) (write-string l s) (write-char #\Newline s))))

(defun path-directory (path) (let ((p (position #\/ path :from-end t))) (if p (subseq path 0 (+ p 1)) "./")))
(defun path-filename (path) (let ((p (position #\/ path :from-end t))) (if p (subseq path (+ p 1)) path)))

(defun file-mode-for (path)
  (let ((n (path-filename path)))
    (cond ((or (%ends-with n ".lisp") (%ends-with n ".lsp") (%ends-with n ".cl") (%ends-with n ".asd")) 'lisp-mode)
          ((or (%ends-with n ".txt") (%ends-with n ".md")) 'text-mode)
          (t 'fundamental-mode))))

;;; ---- numbered backups ("version-aware save") -----------------------------------------------------------

(defun backup-versions (path)
  "Existing numbered backups of PATH as a sorted list of version numbers."
  (let* ((dir (path-directory path)) (name (path-filename path)) (prefix (%string-concat name ".~")) (acc nil))
    (dolist (e (%directory dir))
      (let ((n (car e)))
        (when (and (> (length n) (+ (length prefix) 1)) (string= (subseq n 0 (length prefix)) prefix) (%ends-with n "~"))
          (let ((v (parse-integer (subseq n (length prefix) (- (length n) 1)) :junk-allowed t)))
            (when v (setq acc (cons v acc)))))))
    (sort acc #'<)))

(defun backup-file (path)
  "Copy the existing PATH to PATH.~N~ and prune old versions.  Returns the backup name."
  (when (probe-file path)
    (let* ((versions (backup-versions path)) (next (+ 1 (if versions (car (last versions)) 0)))
           (name (format nil "~A.~~~D~~" path next)))
      (write-file-lines name (read-file-lines path))
      (let ((all (append versions (list next))))
        (loop (when (<= (length all) *backup-keep*) (return))
              (delete-file (format nil "~A.~~~D~~" path (car all)))
              (setq all (cdr all))))
      name)))

;;; ---- buffers and files ----------------------------------------------------------------------------------

(defun ed-visit-file (ed path)
  "Find or create the buffer visiting PATH; returns it."
  (let ((b (find path (ed-buffers ed) :key #'buffer-file :test #'equal)))
    (unless b
      (setq b (make-buffer (path-filename path)))
      (setf (buffer-file b) path)
      (if (probe-file path)
          (buffer-set-text b (join-lines (read-file-lines path)))
          nil)
      (setf (buffer-mode b) (file-mode-for path))
      (when (find (buffer-name b) (ed-buffers ed) :key #'buffer-name :test #'string=)
        (setf (buffer-name b) path))
      (setf (ed-buffers ed) (append (ed-buffers ed) (list b))))
    (ed-switch-to-buffer ed b)
    b))

(defun file-completions (input)
  (let* ((dir (path-directory input)) (prefix (path-filename input)) (acc nil))
    (dolist (e (%directory dir))
      (let ((n (car e)))
        (when (and (>= (length n) (length prefix)) (string= (subseq n 0 (length prefix)) prefix))
          (setq acc (cons (%string-concat (if (string= dir "./") (if (and (> (length input) 1) (string= (subseq input 0 2) "./")) "./" "") dir) n (if (eq (cadr e) :directory) "/" "")) acc)))))
    (sort acc #'string<)))

(defun ed-save-buffer (ed &optional b)
  (let ((b (or b (ed-buffer ed))))
    (unless (buffer-file b) (error "Buffer ~A is not visiting a file" (buffer-name b)))
    (let ((backup (and (not (buffer-backed-up b)) (backup-file (buffer-file b)))))
      (write-file-lines (buffer-file b) (coerce (buffer-lines b) 'list))
      (setf (buffer-modified b) nil (buffer-backed-up b) t)
      (ed-message* ed "Wrote ~A~A" (buffer-file b) (if backup (format nil " (backup ~A)" (path-filename backup)) "")))))

(defcmd find-file (ed arg)
  (ed-read-string ed "Find file: "
                  (lambda (path)
                    (if (eq (car (%file-attrs path)) :directory)
                        (open-dired ed path)
                        (progn (ed-visit-file ed path) (ed-message* ed "~A" path))))
                  :completer #'file-completions :initial (let ((f (buffer-file (ed-buffer ed)))) (if f (path-directory f) "./"))))
(defcmd save-buffer (ed arg) (ed-save-buffer ed))
(defcmd write-file (ed arg)
  (ed-read-string ed "Write file: " (lambda (path) (setf (buffer-file (ed-buffer ed)) path (buffer-name (ed-buffer ed)) (path-filename path)) (ed-save-buffer ed))
                  :completer #'file-completions))
(defcmd revert-buffer (ed arg)
  (with-b (b ed) (when (buffer-file b) (buffer-set-text b (join-lines (read-file-lines (buffer-file b)))) (ed-message* ed "Reverted"))))
(defcmd switch-to-buffer (ed arg)
  (ed-read-string ed "Switch to buffer: "
                  (lambda (name) (ed-switch-to-buffer ed (ed-get-buffer ed (if (string= name "") "*scratch*" name) t)))
                  :completer (lambda (s) (sort (remove-if-not (lambda (n) (%word-prefix-p s n)) (ed-buffer-names ed)) #'string<))))
(defcmd kill-buffer (ed arg)
  (let ((b (ed-buffer ed)))
    (setf (ed-buffers ed) (remove b (ed-buffers ed)))
    (ed-switch-to-buffer ed (or (car (ed-buffers ed)) (ed-get-buffer ed "*scratch*" t)))))
(defcmd list-buffers (ed arg)
  (let ((b (ed-get-buffer ed "*Buffer List*" t)))
    (setf (buffer-read-only b) nil)
    (buffer-set-text b (join-lines (mapcar (lambda (x) (format nil "~A ~20A ~A" (if (buffer-modified x) "*" " ") (buffer-name x) (or (buffer-file x) ""))) (ed-buffers ed))))
    (setf (buffer-read-only b) t)
    (ed-switch-to-buffer ed b)))
(defcmd undo-tree-visualize (ed arg)
  (let ((src (ed-buffer ed)) (b (ed-get-buffer ed "*undo-tree*" t)))
    (setf (buffer-read-only b) nil)
    (buffer-set-text b (join-lines (undo-tree-lines src)))
    (setf (buffer-read-only b) t)
    (ed-switch-to-buffer ed b)))
(defcmd quit-editor (ed arg) (wm-close-window (window-wm ed) ed))

(bind "C-x C-f" 'find-file) (bind "C-x C-s" 'save-buffer) (bind "C-x C-w" 'write-file) (bind "C-x b" 'switch-to-buffer)
(bind "C-x k" 'kill-buffer) (bind "C-x C-b" 'list-buffers) (bind "C-x C-c" 'quit-editor)

;;; ---- definitions ("M-.") ---------------------------------------------------------------------------------------

(defun ed-goto-location (ed file pos)
  (push-mark ed)
  (let ((b (ed-visit-file ed (resolve-source-path file))))
    (goto-offset b pos)
    (setf (ed-top ed) (max 0 (- (point-line b) 3)))
    b))

(defun edit-definition-locations (ed locs name)
  (cond ((null locs) (ed-message* ed "No source recorded for ~A" name))
        ((null (cdr locs)) (ed-goto-location ed (cadr (car locs)) (caddr (car locs))) (ed-message* ed "~A: ~A" (string-downcase (symbol-name (car (car locs)))) name))
        (t (wm-popup-menu (window-wm ed)
                          (mapcar (lambda (l) (cons (format nil "~A ~A" (string-downcase (symbol-name (car l))) (cadr l)) l)) locs)
                          (window-x ed) (window-y ed)
                          (lambda (l) (ed-goto-location ed (cadr l) (caddr l)))
                          :title (format nil "~A" name)))))

(defcmd find-definition (ed arg)
  (with-b (b ed)
    (let ((tok (symbol-at-point b)))
      (if (null tok)
          (ed-message* ed "No symbol at point")
          (let ((sym (%find-symbol-named tok)))
            (if sym (edit-definition-locations ed (definition-locations sym) sym) (ed-message* ed "No symbol named ~A" tok)))))))
(bind "M-." 'find-definition)

;;; ---- Dired ---------------------------------------------------------------------------------------------------------

(defun %format-size (n) (cond ((< n 1024) (format nil "~D" n)) ((< n 1048576) (format nil "~DK" (floor n 1024))) (t (format nil "~DM" (floor n 1048576)))))

(defun dired-refresh (ed b)
  (let* ((dir (buf-local b 'dired-dir)) (entries (sort (copy-list (%directory dir))
                                                       (lambda (x y) (let ((dx (eq (cadr x) :directory)) (dy (eq (cadr y) :directory)))
                                                                       (if (eq dx dy) (string< (car x) (car y)) dx))))))
    (setf (buf-local b 'dired-entries) entries)
    (setf (buffer-read-only b) nil)
    (buffer-set-text b (join-lines (cons (%string-concat "  " dir ":")
                                         (mapcar (lambda (e) (format nil "  ~A  ~8A ~A~A" " " (if (eq (cadr e) :directory) "<dir>" (%format-size (caddr e))) (car e) (if (eq (cadr e) :directory) "/" ""))) entries))))
    (setf (buffer-read-only b) t (buffer-mode b) 'dired-mode (buffer-modified b) nil)
    (when (> (buf-nlines b) 1) (buf-goto b 1 4))
    (ed-switch-to-buffer ed b)))

(defun open-dired (ed dir)
  (let* ((dir (if (%ends-with dir "/") dir (%string-concat dir "/"))) (b (ed-get-buffer ed (%string-concat "dired:" dir) t)))
    (setf (buf-local b 'dired-dir) dir)
    (dired-refresh ed b)
    b))

(defun dired-entry-at-point (b)
  (let ((i (- (point-line b) 1)) (entries (buf-local b 'dired-entries))) (and (>= i 0) (< i (length entries)) (nth i entries))))
(defun dired-path (b e) (%string-concat (buf-local b 'dired-dir) (car e)))
(defun dired-mark-line (b ch)
  (let ((l (point-line b)))
    (when (and (>= l 1) (dired-entry-at-point b))
      (setf (buffer-read-only b) nil)
      (let ((line (buf-line b l)))
        (setf (aref (buffer-lines b) l) (%string-concat (subseq line 0 2) (string ch) (subseq line 3))))
      (setf (buffer-read-only b) t (buffer-modified b) nil))))

(defcmd dired (ed arg)
  (ed-read-string ed "Dired (directory): " (lambda (dir) (open-dired ed (if (string= dir "") "./" dir))) :completer #'file-completions :initial "./"))
(defcmd dired-next-line (ed arg) (with-b (b ed) (buf-move-vertically b 1) (when (< (point-line b) 1) (buf-goto b 1 4))))
(defcmd dired-previous-line (ed arg) (with-b (b ed) (buf-move-vertically b -1) (when (< (point-line b) 1) (buf-goto b 1 4))))
(defcmd dired-open (ed arg)
  (with-b (b ed) (let ((e (dired-entry-at-point b)))
                   (when e (if (eq (cadr e) :directory) (open-dired ed (dired-path b e))
                               (ed-visit-file ed (dired-path b e)))))))
(defcmd dired-flag-delete (ed arg) (with-b (b ed) (dired-mark-line b #\D) (buf-move-vertically b 1)))
(defcmd dired-unflag (ed arg) (with-b (b ed) (dired-mark-line b #\Space) (buf-move-vertically b 1)))
(defcmd dired-execute (ed arg)
  (with-b (b ed)
    (let ((victims nil) (i 1))
      (dolist (e (buf-local b 'dired-entries))
        (when (and (< i (buf-nlines b)) (char= (char (buf-line b i) 2) #\D)) (setq victims (cons e victims)))
        (setq i (+ i 1)))
      (if (null victims)
          (ed-message* ed "No files flagged")
          (ed-read-string ed (format nil "Delete ~D file~:P? (yes or no) " (length victims))
                          (lambda (ans)
                            (if (string= ans "yes")
                                (progn (dolist (e victims) (delete-file (dired-path b e)))
                                       (dired-refresh ed b) (ed-message* ed "Deleted ~D" (length victims)))
                                (ed-message* ed "Cancelled"))))))))
(defcmd dired-rename (ed arg)
  (with-b (b ed) (let ((e (dired-entry-at-point b)))
                   (when e (ed-read-string ed (format nil "Rename ~A to: " (car e))
                                           (lambda (new) (%rename-file (dired-path b e) (if (%string-position-char new #\/ 0) new (%string-concat (buf-local b 'dired-dir) new)))
                                             (dired-refresh ed b))
                                           :initial (car e))))))
(defcmd dired-create-directory (ed arg)
  (with-b (b ed) (ed-read-string ed "Create directory: " (lambda (n) (%make-directory (%string-concat (buf-local b 'dired-dir) n)) (dired-refresh ed b)))))
(defcmd dired-refresh-command (ed arg) (with-b (b ed) (dired-refresh ed b)))
(defcmd dired-up (ed arg)
  (with-b (b ed) (let* ((d (buf-local b 'dired-dir)) (trimmed (subseq d 0 (max 1 (- (length d) 1)))) (p (position #\/ trimmed :from-end t)))
                   (open-dired ed (if p (subseq trimmed 0 (max 1 p)) "./")))))
(defcmd dired-quit (ed arg) (run-editor-command ed 'kill-buffer nil))

(dolist (b '(("n" dired-next-line) ("p" dired-previous-line) ("<down>" dired-next-line) ("<up>" dired-previous-line)
             ("<return>" dired-open) ("f" dired-open) ("d" dired-flag-delete) ("u" dired-unflag) ("x" dired-execute)
             ("R" dired-rename) ("+" dired-create-directory) ("g" dired-refresh-command) ("^" dired-up) ("q" dired-quit)))
  (define-key *dired-mode-map* (car b) (cadr b)))
(bind "C-x d" 'dired)

;;; ---- version control (git) -------------------------------------------------------------------------------------------

(defun %vc-run (ed &rest args)
  (let* ((f (buffer-file (ed-buffer ed))) (dir (if f (path-directory f) "./")))
    (multiple-value-bind (out status) (run-program "git" (append (list "-C" dir) args))
      (values out status dir))))

(defun %show-text-buffer (ed name text &optional (mode 'fundamental-mode))
  (let ((b (ed-get-buffer ed name t)))
    (setf (buffer-read-only b) nil)
    (buffer-set-text b text)
    (setf (buffer-read-only b) t (buffer-mode b) mode)
    (ed-switch-to-buffer ed b)))

(defcmd vc-status (ed arg)
  (multiple-value-bind (out status) (%vc-run ed "status" "--short" "--branch")
    (%show-text-buffer ed "*vc-status*" (if (= status 0) out (format nil "git failed (~D):~%~A" status out)))))
(defcmd vc-diff (ed arg)
  (let ((f (buffer-file (ed-buffer ed))))
    (multiple-value-bind (out status) (if f (%vc-run ed "diff" "--" (path-filename f)) (%vc-run ed "diff"))
      (%show-text-buffer ed "*vc-diff*" (if (= (length out) 0) (if (= status 0) "No changes." out) out) 'diff-mode))))
(defcmd vc-log (ed arg)
  (multiple-value-bind (out status) (%vc-run ed "log" "--oneline" "-n" "30")
    (%show-text-buffer ed "*vc-log*" (if (= status 0) out (format nil "git failed (~D):~%~A" status out)))))
(defcmd vc-commit (ed arg)
  (let ((f (buffer-file (ed-buffer ed))))
    (unless f (error "Buffer is not visiting a file"))
    (ed-read-string ed "Commit message: "
                    (lambda (msg)
                      (when (buffer-modified (ed-buffer ed)) (ed-save-buffer ed))
                      (%vc-run ed "add" "--" (path-filename f))
                      (multiple-value-bind (out status) (%vc-run ed "commit" "-m" msg)
                        (ed-message* ed "~A" (substitute #\Space #\Newline (%abbrev out 70)))
                        (when (/= status 0) (ed-message* ed "git commit failed: ~A" (%abbrev (substitute #\Space #\Newline out) 60))))))))
(bind "C-x v s" 'vc-status) (bind "C-x v =" 'vc-diff) (bind "C-x v l" 'vc-log) (bind "C-x v c" 'vc-commit)

;;; ---- opening the editor from the window system ----------------------------------------------------------------------

(defun find-editor-window (wm)
  (dolist (w (wm-windows wm) nil) (when (typep w 'editor-window) (return w))))

(defun open-editor (wm &key file position line)
  "Open (or reuse) an editor window; visit FILE and go to POSITION (a character offset) or LINE."
  (let ((ed (or (find-editor-window wm)
                (wm-add-window wm (make-instance 'editor-window :title "Editor" :x 4 :y 1 :w (max 40 (- (wm-cols wm) 8)) :h (max 10 (- (wm-area-height wm) 2)))))))
    (wm-raise wm ed)
    (when file
      (let ((b (ed-visit-file ed (resolve-source-path file))))
        (cond (position (goto-offset b position) (setf (ed-top ed) (max 0 (- (point-line b) 3))))
              (line (buf-goto b (- line 1) 0) (setf (ed-top ed) (max 0 (- line 4)))))))
    ed))

(defun edit-definition (name &optional (wm *wm*))
  "Open the editor on the definition of NAME (a symbol); returns the editor or NIL."
  (let ((locs (definition-locations name)))
    (if (and wm locs)
        (let ((l (car locs))) (open-editor wm :file (cadr l) :position (caddr l)))
        nil)))
