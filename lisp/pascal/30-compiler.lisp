;;;; 30-compiler.lisp -- the Pascal Tool Kit: checking and code generation.
;;;;
;;;; Each compilation unit becomes Lisp forms, which are then compiled by the system compiler like any Lisp:
;;;;   * a main program P becomes a program object (run by PASCAL-EXECUTE) whose variables are special variables
;;;;     named X<-P, bound afresh for each run;
;;;;   * each top-level routine F of P becomes a global function F<-P, so it can be recompiled by itself
;;;;     (incremental compilation) and called from Lisp; nested routines are local functions (LABELS) of the
;;;;     routine that contains them, so they see its variables as closures;
;;;;   * a unit's routines become functions F<-U and its variables special variables V<-U.
;;;; VAR parameters are passed as references, (getter . setter) closures.  Statements set *PASCAL-LINE* so that run-time
;;;; errors can name the source line.

(in-package :cl)

(defvar *pascal-init-to-zero* nil
  "When true, the compiler initialises local variables to zero (false, empty) instead of leaving them undefined.")
(defvar *pascal-check-undefined* t "When true, compiled code checks every variable read for an undefined value.")
(defvar *pascal-debug-info* t "When true, compiled code records the routine and source line being executed.")
(defvar *pascal-units* (make-hash-table :test 'equal) "Compiled unit specifications, by \"PACKAGE:NAME\".")

;;; ---- types ------------------------------------------------------------------------------------------------

(defstruct (ptype (:conc-name pt-) (:constructor %make-ptype) (:copier %copy-ptype))
  kind name lo hi base elem index fields size tag names maxlen packed target target-env textp params result)

(defmethod print-object ((p ptype) s) (format s "#<Pascal type ~A>" (%pt-describe p)))

(defun %mk-type (kind &rest args) (apply #'%make-ptype :kind kind args))

(defparameter +pt-integer+ (%mk-type :integer :name "integer"))
(defparameter +pt-real+ (%mk-type :real :name "real"))
(defparameter +pt-shortreal+ (%mk-type :real :name "shortreal"))
(defparameter +pt-boolean+ (%mk-type :boolean :name "boolean" :lo 0 :hi 1))
(defparameter +pt-char+ (%mk-type :char :name "char" :lo 0 :hi 255))
(defparameter +pt-text+ (%mk-type :file :name "text" :textp t :elem nil))
(defparameter +pt-lisp+ (%mk-type :lispobject :name "lispobject"))
(defparameter +pt-nil+ (%mk-type :nil :name "nil"))
(defparameter +pt-empty-set+ (%mk-type :set :name "empty set" :base nil))
(defparameter +pt-vs-string+ (%mk-type :string :name "string" :maxlen nil))

(defun %pt-describe (p)
  (cond ((pt-name p) (pt-name p))
        (t (case (pt-kind p)
             (:integer (format nil "~A..~A" (pt-lo p) (pt-hi p)))
             (:char (format nil "'~A'..'~A'" (code-char (pt-lo p)) (code-char (pt-hi p))))
             (:enum (if (and (pt-lo p) (pt-names p)) (format nil "(~{~A~^, ~})" (mapcar #'string-downcase (pt-names p))) "enumeration"))
             (:array (format nil "array [~A] of ~A" (%pt-describe (pt-index p)) (%pt-describe (pt-elem p))))
             (:record "record")
             (:set (if (pt-base p) (format nil "set of ~A" (%pt-describe (pt-base p))) "set"))
             (:pointer (format nil "^~A" (string-downcase (or (pt-target p) "?"))))
             (:file (if (pt-textp p) "text" (format nil "file of ~A" (%pt-describe (pt-elem p)))))
             (:string (format nil "string(~A)" (pt-maxlen p)))
             (:strlit (format nil "string of ~D characters" (pt-size p)))
             (t (string-downcase (symbol-name (pt-kind p))))))))

(defun %pt-ordinal-p (p) (member (pt-kind p) '(:integer :char :boolean :enum)))
(defun %pt-numeric-p (p) (member (pt-kind p) '(:integer :real)))
(defun %pt-structured-p (p) (member (pt-kind p) '(:array :record)))
(defun %pt-char-array-p (p)
  (and (eq (pt-kind p) :array) (eq (pt-kind (pt-elem p)) :char) (eq (pt-kind (pt-index p)) :integer)))
(defun %pt-stringish-p (p) (or (member (pt-kind p) '(:string :strlit :char)) (%pt-char-array-p p)))
(defun %pt-same-ordinal (a b)
  (and (eq (pt-kind a) (pt-kind b)) (or (not (eq (pt-kind a) :enum)) (eq (pt-names a) (pt-names b)))))

(defun %pt-same (a b)
  (or (eq a b)
      (and (eq (pt-kind a) (pt-kind b))
           (case (pt-kind a)
             ((:integer :char :boolean) t)
             (:enum (eq (pt-names a) (pt-names b)))
             (:real t)
             (:array (and (eql (pt-lo (pt-index a)) (pt-lo (pt-index b))) (eql (pt-hi (pt-index a)) (pt-hi (pt-index b)))
                          (%pt-same (pt-elem a) (pt-elem b))))
             (:record (eq (pt-fields a) (pt-fields b)))
             (:set (or (null (pt-base a)) (null (pt-base b)) (%pt-same-ordinal (pt-base a) (pt-base b))))
             (:pointer (equal (pt-target a) (pt-target b)))
             (:string t) (:lispobject t)
             (:file (and (eq (pt-textp a) (pt-textp b)) (or (pt-textp a) (%pt-same (pt-elem a) (pt-elem b)))))
             (t nil)))))

(defun %pt-desc (p)
  "The run-time description of type P that %PMAKE uses to build its values."
  (case (pt-kind p)
    (:array (list :array (pt-size p) (%pt-desc (pt-elem p))))
    (:record (list :record (pt-tag p) (mapcar (lambda (f) (%pt-desc (caddr f))) (sort (copy-list (pt-fields p)) #'< :key #'cadr))))
    (:file (list :file (pt-textp p) (and (pt-elem p) (%pt-desc (pt-elem p))) nil))
    (t (pt-kind p))))

;;; ---- compilation state --------------------------------------------------------------------------------------

(defvar *pc-package* nil)
(defvar *pc-dialect* :iso)
(defvar *pc-errors* nil)
(defvar *pc-source* "")
(defvar *pc-line-starts* nil)
(defvar *pc-temp* 0)
(defvar *pc-unit* nil "The name of the program or unit being compiled.")
(defvar *pc-routine* nil "The PRINFO of the routine being compiled, or NIL in a main program body.")
(defvar *pc-file* nil)
(defvar *pc-zero* nil)
(defvar *pc-labels* nil "Alist of declared labels in scope: (name . tag).")
(defvar *pc-in-loop* nil)
(defvar *pc-constant-context* nil "True while a constant expression is compiled.")
(defvar *pc-pending-pointers* nil)

(defstruct (penv (:constructor %make-penv (parent &optional kind)) (:copier nil))
  parent kind (table (make-hash-table :test 'equal)) imports)

(defstruct (prinfo (:copier nil))
  name kind params result lisp-sym nested directive lisp-fn result-sym node defined unit)

(defun %pc-line-of (offset)
  "(values line column) of the byte OFFSET in the source being compiled."
  (let* ((v *pc-line-starts*) (lo 0) (hi (- (length v) 1)))
    (if (null v) (values 1 1)
        (progn
          (loop (when (>= lo hi) (return))
                (let ((mid (ceiling (+ lo hi) 2))) (if (<= (svref v mid) offset) (setq lo mid) (setq hi (- mid 1)))))
          (values (+ lo 1) (+ 1 (- offset (svref v lo))))))))

(defun %pc-compute-line-starts (s)
  (let ((acc (list 0)))
    (dotimes (i (length s)) (when (char= (char s i) #\Newline) (push (+ i 1) acc)))
    (coerce (nreverse acc) 'vector)))

(defun %pc-error (node fmt &rest args)
  (let ((start (if node (pnode-start node) 0)) (end (if node (pnode-end node) 0)))
    (multiple-value-bind (line col) (%pc-line-of start)
      (error 'pascal-syntax-error :message (apply #'format nil fmt args) :start start :end (max end (+ start 1))
                                  :line line :col col :file *pc-file*))))

(defmacro %pc-collecting (&body body)
  "Run BODY; a compile error is recorded and BODY's value is NIL."
  `(handler-case (progn ,@body)
     (pascal-syntax-error (c) (push c *pc-errors*) nil)))

(defun %psym (name &optional suffix)
  "The Lisp symbol for the Pascal NAME (with -SUFFIX) in the target package, never an inherited Lisp symbol."
  (let* ((full (if suffix (%string-concat name "<-" suffix) name))
         (s (intern full *pc-package*)))
    (if (eq (symbol-package s) *pc-package*) s (intern (%string-concat full "%") *pc-package*))))

(defun %ptemp (base)
  (setq *pc-temp* (+ *pc-temp* 1))
  (intern (format nil "%~A~D" base *pc-temp*) *pc-package*))

(defun %pc-lookup (env name)
  (loop
    (when (null env) (return nil))
    (multiple-value-bind (e found) (gethash name (penv-table env))
      (when found (return e)))
    (dolist (imp (penv-imports env))
      (let ((e (%pc-lookup-imported imp name))) (when e (return-from %pc-lookup e))))
    (setq env (penv-parent env))))

(defun %pc-lookup-imported (env name)
  (multiple-value-bind (e found) (gethash name (penv-table env))
    (if found e (dolist (imp (penv-imports env) nil) (let ((x (%pc-lookup-imported imp name))) (when x (return x)))))))

(defun %pc-define (env name entry node)
  (multiple-value-bind (old found) (gethash name (penv-table env))
    (declare (ignore old))
    (when found (%pc-error node "~A is already declared in this scope" (string-downcase name))))
  (setf (gethash name (penv-table env)) entry))

;;; ---- the standard identifiers --------------------------------------------------------------------------------

(defparameter *pascal-standard-procedures*
  '("READ" "READLN" "WRITE" "WRITELN" "RESET" "REWRITE" "GET" "PUT" "PAGE" "NEW" "DISPOSE" "PACK" "UNPACK" "HALT" "CLOSE"))
(defparameter *pascal-standard-functions*
  '("ABS" "SQR" "SIN" "COS" "EXP" "LN" "SQRT" "ARCTAN" "TRUNC" "ROUND" "ORD" "CHR" "SUCC" "PRED" "ODD" "EOF" "EOLN"
    "SINGLE" "DOUBLE" "CLOCK"))
(defparameter *pascal-vs-functions* '("LENGTH" "MAXLENGTH" "SUBSTR" "INDEX" "TRIM" "LTRIM" "COMPRESS" "STR"))

(defun pascal-predeclared-identifiers (&optional (dialect *pascal-default-dialect*))
  "The names of the predeclared Pascal types, constants, variables, procedures and functions of DIALECT."
  (append '("INTEGER" "REAL" "SHORTREAL" "BOOLEAN" "CHAR" "TEXT" "LISPOBJECT" "TRUE" "FALSE" "MAXINT" "INPUT" "OUTPUT")
          (if (eq dialect :vs) '("STRING") nil)
          *pascal-standard-procedures* *pascal-standard-functions*
          (if (eq dialect :vs) *pascal-vs-functions* nil)))

(defun %pc-standard-env (dialect)
  (let ((env (%make-penv nil :standard)) (tab nil))
    (setq tab (penv-table env))
    (dolist (ty (list +pt-integer+ +pt-real+ +pt-shortreal+ +pt-boolean+ +pt-char+ +pt-text+ +pt-lisp+))
      (setf (gethash (string-upcase (pt-name ty)) tab) (list :type ty)))
    (when (eq dialect :vs) (setf (gethash "STRING" tab) (list :type (%mk-type :string :name "string" :maxlen 255))))
    (setf (gethash "TRUE" tab) (list :const t +pt-boolean+)
          (gethash "FALSE" tab) (list :const nil +pt-boolean+)
          (gethash "MAXINT" tab) (list :const 2147483647 +pt-integer+)
          (gethash "INPUT" tab) (list :var :std '(%pstd-input) +pt-text+ "INPUT")
          (gethash "OUTPUT" tab) (list :var :std '(%pstd-output) +pt-text+ "OUTPUT"))
    (dolist (n (append *pascal-standard-procedures* *pascal-standard-functions* (if (eq dialect :vs) *pascal-vs-functions* nil)))
      (setf (gethash n tab) (list :std n)))
    env))

;;; ---- ordinals and constants -----------------------------------------------------------------------------------

(defun %pc-ord-form (form type)
  (case (pt-kind type)
    (:char (if (characterp form) (char-code form) `(char-code ,form)))
    (:boolean (cond ((eq form t) 1) ((null form) 0) (t `(if ,form 1 0))))
    (t form)))
(defun %pc-from-ord-form (form type)
  (case (pt-kind type)
    (:char (if (integerp form) (code-char form) `(code-char ,form)))
    (:boolean (if (integerp form) (/= form 0) `(/= ,form 0)))
    (t form)))
(defun %pc-ord-value (v)
  (cond ((characterp v) (char-code v)) ((eq v t) 1) ((null v) 0) (t v)))

(defun %pc-literal (v)
  "A form whose value is the constant V."
  (if (or (numberp v) (characterp v) (stringp v) (eq v t) (null v)) v (list 'quote v)))

(defun %pc-constant (node env)
  "Evaluate the constant expression NODE: (values value type)."
  (multiple-value-bind (form type) (let ((*pc-constant-context* t)) (%pc-expr node env))
    (handler-case (values (eval form) type)
      (error (e) (%pc-error node "Not a constant expression: ~A" e)))))

;;; ---- types from declarations -------------------------------------------------------------------------------

(defun %pc-type (node env)
  (let ((kind (pnode-kind node)) (args (pnode-args node)))
    (case kind
      (:named (let ((e (%pc-lookup env (car args))))
                (unless (and e (eq (car e) :type)) (%pc-error node "~A is not a type" (string-downcase (car args))))
                (when (and (eq (pt-kind (cadr e)) :string) (not (eq *pc-dialect* :vs)))
                  (%pc-error node "The STRING type belongs to the Pascal/VS dialect"))
                (cadr e)))
      (:subrange
       (multiple-value-bind (lo lt) (%pc-constant (car args) env)
         (multiple-value-bind (hi ht) (%pc-constant (cadr args) env)
           (unless (and (%pt-ordinal-p lt) (%pt-same-ordinal lt ht)) (%pc-error node "The bounds of a subrange must be ordinals of one type"))
           (let ((l (%pc-ord-value lo)) (h (%pc-ord-value hi)))
             (when (> l h) (%pc-error node "The subrange ~A..~A is empty" lo hi))
             (%mk-type (pt-kind lt) :lo l :hi h :base lt :names (pt-names lt))))))
      (:enum (let* ((names (car args)) (ty (%mk-type :enum :lo 0 :hi (- (length names) 1))) (i 0))
               (setf (pt-names ty) names)
               (dolist (n names) (%pc-define env n (list :const i ty) node) (setq i (+ i 1)))
               ty))
      (:array (let ((elem (%pc-type (cadr args) env)))
                (dolist (ix (reverse (car args)) elem)
                  (let ((it (%pc-type ix env)))
                    (unless (%pt-ordinal-p it) (%pc-error ix "An array index type must be an ordinal type"))
                    (unless (and (pt-lo it) (pt-hi it)) (%pc-error ix "An array index type must be a subrange, not ~A" (%pt-describe it)))
                    (when (> (- (pt-hi it) (pt-lo it)) 50000000) (%pc-error ix "The array index type ~A is too large" (%pt-describe it)))
                    (setq elem (%mk-type :array :index it :elem elem :size (+ 1 (- (pt-hi it) (pt-lo it)))))))))
      (:packed (let ((ty (%pc-type (car args) env)))
                 (if (member (pt-kind ty) '(:array :record :set :file))
                     (let ((c (%copy-ptype ty))) (setf (pt-packed c) t) c)
                     ty)))
      (:record (%pc-record-type node env))
      (:set (let ((b (%pc-type (car args) env)))
              (unless (%pt-ordinal-p b) (%pc-error node "The base type of a set must be an ordinal type"))
              (%mk-type :set :base b)))
      (:file (if (car args)
                 (let ((e (%pc-type (car args) env)))
                   (when (eq (pt-kind e) :file) (%pc-error node "A file cannot contain files"))
                   (%mk-type :file :elem e :textp nil))
                 (%pc-error node "Untyped files are not supported; use FILE OF type or TEXT")))
      (:pointer (let ((ty (%mk-type :pointer :target (car args) :target-env env)))
                  (push (cons ty node) *pc-pending-pointers*)
                  ty))
      (:string (unless (eq *pc-dialect* :vs) (%pc-error node "The STRING type belongs to the Pascal/VS dialect"))
       (multiple-value-bind (n nt) (%pc-constant (car args) env)
         (unless (and (eq (pt-kind nt) :integer) (> n 0)) (%pc-error node "A string length must be a positive integer"))
         (%mk-type :string :maxlen n)))
      (:template (%pc-error node "The template item ~A has not been filled in" (car args)))
      (t (%pc-error node "Unknown type")))))

(defun %pc-record-type (node env)
  (let ((fields nil) (index 0) (tag (%ptemp "R")))
    (labels ((add (name ty n)
               (when (assoc name fields :test #'string=) (%pc-error n "The field ~A is declared twice" (string-downcase name)))
               (setq index (+ index 1))
               (push (list name index ty) fields))
             (field-list (fs variant)
               (dolist (f fs)
                 (let ((ty (%pc-type (cadr (pnode-args f)) env)))
                   (dolist (n (car (pnode-args f))) (add n ty f))))
               (when variant
                 (destructuring-bind (tag-name tag-type cases other) (pnode-args variant)
                   (let ((tt (let ((e (%pc-lookup env tag-type)))
                               (unless (and e (eq (car e) :type)) (%pc-error variant "~A is not a type" (string-downcase tag-type)))
                               (cadr e))))
                     (when tag-name (add tag-name tt variant))
                     (dolist (c cases) (field-list (cadr c) (caddr c)))
                     (when other (field-list (car other) (cadr other))))))))
      (destructuring-bind (fs variant) (pnode-args node) (field-list fs variant)))
    (%mk-type :record :fields (nreverse fields) :size index :tag (intern (symbol-name tag) *pc-package*))))

(defun %pc-resolve-pointers ()
  (dolist (p *pc-pending-pointers*)
    (let* ((ty (car p)) (e (%pc-lookup (pt-target-env ty) (pt-target ty))))
      (unless (and e (eq (car e) :type)) (%pc-error (cdr p) "The pointer target ~A is not a type" (string-downcase (pt-target ty))))
      (setf (pt-elem ty) (cadr e))))
  (setq *pc-pending-pointers* nil))

(defun %pt-pointee (ty node)
  (or (pt-elem ty)
      (let ((e (%pc-lookup (pt-target-env ty) (pt-target ty))))
        (if (and e (eq (car e) :type)) (setf (pt-elem ty) (cadr e)) (%pc-error node "The pointer target ~A is not a type" (pt-target ty))))))

;;; ---- coercion ---------------------------------------------------------------------------------------------------

(defun %pc-coerce (form from to node &optional fresh)
  "FORM (of type FROM) converted for a variable of type TO, with range checks; signals a compile error when the
types are not assignment-compatible."
  (flet ((bad () (%pc-error node "Type mismatch: ~A cannot be assigned to ~A" (%pt-describe from) (%pt-describe to))))
    (case (pt-kind to)
      (:real (case (pt-kind from)
               (:real form)
               (:integer (if (integerp form) (float form 1d0) `(float ,form 1d0)))
               (t (bad))))
      ((:integer :char :boolean :enum)
       (unless (%pt-same-ordinal from to) (bad))
       (let ((lo (pt-lo to)) (hi (pt-hi to)))
         (cond ((or (eq (pt-kind to) :boolean) (and (null lo) (null hi))) form)
               ((and (pt-lo from) (pt-hi from) (or (null lo) (>= (pt-lo from) lo)) (or (null hi) (<= (pt-hi from) hi))) form)
               ((and (eq (pt-kind to) :char) (= lo 0) (= hi 255)) form)
               ((or (integerp form) (characterp form))
                (let ((v (%pc-ord-value form)))
                  (when (or (and lo (< v lo)) (and hi (> v hi)))
                    (%pc-error node "The value ~A is out of the range ~A" form (%pt-describe to)))
                  form))
               ((eq (pt-kind to) :char) `(%prange-char ,form ,lo ,hi))
               (t `(%prange ,form ,lo ,hi)))))
      (:string (cond ((member (pt-kind from) '(:string :strlit))
                      (if (and (stringp form) (or (null (pt-maxlen to)) (<= (length form) (pt-maxlen to)))) form `(%pvs ,form ,(pt-maxlen to))))
                     ((eq (pt-kind from) :char) (if (characterp form) (string form) `(string ,form)))
                     ((%pt-char-array-p from) `(%pvs ,form ,(pt-maxlen to)))
                     (t (bad))))
      (:array (cond ((and (%pt-char-array-p to) (eq (pt-kind from) :strlit))
                     (when (> (pt-size from) (pt-size to)) (%pc-error node "The string is longer than ~D characters" (pt-size to)))
                     `(%pstring->chars ,form ,(pt-size to)))
                    ((and (%pt-char-array-p to) (eq (pt-kind from) :string)) `(%pstring->chars ,form ,(pt-size to)))
                    ((and (%pt-char-array-p to) (eq (pt-kind from) :char) (= (pt-size to) 1)) `(vector ,form))
                    ((%pt-same from to) (if fresh form `(%pcopy ,form)))
                    (t (bad))))
      (:record (if (%pt-same from to) (if fresh form `(%pcopy ,form)) (bad)))
      (:set (if (and (eq (pt-kind from) :set)
                     (or (null (pt-base from)) (null (pt-base to)) (%pt-same-ordinal (pt-base from) (pt-base to))))
                form (bad)))
      (:pointer (if (or (eq (pt-kind from) :nil) (and (eq (pt-kind from) :pointer) (equal (pt-target from) (pt-target to)))) form (bad)))
      (:lispobject (if (member (pt-kind from) '(:lispobject :nil)) form (bad)))
      (:file (%pc-error node "Files cannot be assigned"))
      (t (if (%pt-same from to) form (bad))))))

;;; ---- expressions -------------------------------------------------------------------------------------------

(defun %pc-check-read (form type name)
  (if (and *pascal-check-undefined* (not (%pt-structured-p type)) (not (member (pt-kind type) '(:set :lispobject :file)))
           (or (symbolp form) (consp form)) (not (member form (quote (t nil)))))
      `(%pchk ,form ,(intern (string-downcase (string name)) *pc-package*))
      form))

(defun %pc-expr (node env)
  "Compile the expression NODE: (values form type)."
  (let ((args (pnode-args node)))
    (case (pnode-kind node)
      (:int (values (car args) +pt-integer+))
      (:real (values (car args) +pt-real+))
      (:str (let ((s (car args)))
              (if (= (length s) 1) (values (char s 0) +pt-char+) (values s (%mk-type :strlit :size (length s))))))
      (:nil (values nil +pt-nil+))
      (:paren (%pc-expr (car args) env))
      (:template (%pc-error node "The template item ~A has not been filled in" (car args)))
      (:setcons (%pc-set-constructor node env))
      (:unop (destructuring-bind (op x) args
               (multiple-value-bind (f ty) (%pc-expr x env)
                 (case op
                   (- (unless (%pt-numeric-p ty) (%pc-error node "Unary minus needs a number, not ~A" (%pt-describe ty)))
                    (values (if (numberp f) (- f) `(- ,f)) (if (eq (pt-kind ty) :integer) +pt-integer+ ty)))
                   (not (unless (eq (pt-kind ty) :boolean) (%pc-error node "NOT needs a boolean, not ~A" (%pt-describe ty)))
                    (values `(not ,f) +pt-boolean+))))))
      (:binop (%pc-binop node env))
      ((:id :call :index :field :deref) (%pc-designator-value node env))
      (:fmt (%pc-error node "A field width is allowed only in WRITE and WRITELN"))
      (t (%pc-error node "Not an expression")))))

(defun %pc-set-constructor (node env)
  (let ((parts nil) (base nil))
    (dolist (e (car (pnode-args node)))
      (if (eq (pnode-kind e) :range)
          (multiple-value-bind (lf lt) (%pc-expr (car (pnode-args e)) env)
            (multiple-value-bind (hf ht) (%pc-expr (cadr (pnode-args e)) env)
              (unless (and (%pt-ordinal-p lt) (%pt-same-ordinal lt ht)) (%pc-error e "Set members must be ordinals of one type"))
              (setq base lt)
              (push `(%pset-range ,(%pc-ord-form lf lt) ,(%pc-ord-form hf ht)) parts)))
          (multiple-value-bind (f ty) (%pc-expr e env)
            (unless (%pt-ordinal-p ty) (%pc-error e "Set members must be ordinals, not ~A" (%pt-describe ty)))
            (when (and base (not (%pt-same-ordinal base ty))) (%pc-error e "Set members must be ordinals of one type"))
            (setq base ty)
            (push (if (or (integerp f) (characterp f) (eq f t) (null f)) (ash 1 (%pc-ord-value f)) `(%pset-elt ,(%pc-ord-form f ty))) parts))))
    (setq parts (nreverse parts))
    (values (cond ((null parts) 0) ((every #'integerp parts) (apply #'logior parts)) ((null (cdr parts)) (car parts)) (t `(logior ,@parts)))
            (if base (%mk-type :set :base (or (pt-base base) base)) +pt-empty-set+))))

(defun %pc-binop (node env)
  (destructuring-bind (op l r) (pnode-args node)
    (multiple-value-bind (lf lt) (%pc-expr l env)
      (multiple-value-bind (rf rt) (%pc-expr r env)
        (let ((lk (pt-kind lt)) (rk (pt-kind rt)))
          (flet ((bad () (%pc-error node "The operator ~(~A~) cannot be applied to ~A and ~A" op (%pt-describe lt) (%pt-describe rt))))
            (case op
              ((+ - *)
               (cond ((and (%pt-numeric-p lt) (%pt-numeric-p rt))
                      (values (list op lf rf) (if (and (eq lk :integer) (eq rk :integer)) +pt-integer+ +pt-real+)))
                     ((and (eq lk :set) (eq rk :set))
                      (values (case op (+ `(logior ,lf ,rf)) (* `(logand ,lf ,rf)) (- `(logand ,lf (lognot ,rf))))
                              (if (pt-base lt) lt rt)))
                     ((and (eq op '+) (eq *pc-dialect* :vs) (%pt-stringish-p lt) (%pt-stringish-p rt))
                      (values `(%pvs-concat ,lf ,rf) +pt-vs-string+))
                     (t (bad))))
              (/ (unless (and (%pt-numeric-p lt) (%pt-numeric-p rt)) (bad)) (values `(%prdiv ,lf ,rf) +pt-real+))
              (div (unless (and (eq lk :integer) (eq rk :integer)) (bad)) (values `(%pdivi ,lf ,rf) +pt-integer+))
              (mod (unless (and (eq lk :integer) (eq rk :integer)) (bad)) (values `(%pmod ,lf ,rf) +pt-integer+))
              ((and or) (unless (and (eq lk :boolean) (eq rk :boolean)) (bad)) (values (list op lf rf) +pt-boolean+))
              (xor (unless (and (eq lk :boolean) (eq rk :boolean)) (bad)) (values `(not (eq ,lf ,rf)) +pt-boolean+))
              (concat (unless (and (%pt-stringish-p lt) (%pt-stringish-p rt)) (bad))
               (values `(%pvs-concat ,lf ,rf) +pt-vs-string+))
              (in (unless (and (%pt-ordinal-p lt) (eq rk :set)) (bad))
               (when (and (pt-base rt) (not (%pt-same-ordinal lt (pt-base rt)))) (bad))
               (values `(%pin ,(%pc-ord-form lf lt) ,rf) +pt-boolean+))
              (t (%pc-comparison op lf lt rf rt node)))))))))

(defun %pc-comparison (op lf lt rf rt node)
  (let ((lk (pt-kind lt)) (rk (pt-kind rt)))
    (flet ((bad () (%pc-error node "~A and ~A cannot be compared" (%pt-describe lt) (%pt-describe rt)))
           (rel (fn a b) (if (eq op '<>) `(not (,fn ,a ,b)) (list fn a b))))
      (values
       (cond ((and (%pt-numeric-p lt) (%pt-numeric-p rt))
              (case op (= `(= ,lf ,rf)) (<> `(/= ,lf ,rf)) (t (list op lf rf))))
             ((and (%pt-ordinal-p lt) (%pt-same-ordinal lt rt))
              (if (eq lk :char)
                  (case op (= `(char= ,lf ,rf)) (<> `(char/= ,lf ,rf)) (< `(char< ,lf ,rf)) (> `(char> ,lf ,rf))
                        (<= `(char<= ,lf ,rf)) (>= `(char>= ,lf ,rf)))
                  (let ((a (%pc-ord-form lf lt)) (b (%pc-ord-form rf rt)))
                    (case op (= `(eql ,a ,b)) (<> `(not (eql ,a ,b))) (t (list op a b))))))
             ((and (%pt-stringish-p lt) (%pt-stringish-p rt) (not (and (eq lk :char) (eq rk :char))))
              (let ((c `(%pstr-compare ,lf ,rf)))
                (case op (= `(= ,c 0)) (<> `(/= ,c 0)) (t (list op c 0)))))
             ((and (eq lk :set) (eq rk :set))
              (case op (= `(= ,lf ,rf)) (<> `(/= ,lf ,rf)) (<= `(%psubset ,lf ,rf)) (>= `(%psubset ,rf ,lf)) (t (bad))))
             ((and (member lk '(:pointer :nil :lispobject)) (member rk '(:pointer :nil :lispobject)) (member op '(= <>)))
              (rel 'eq lf rf))
             ((and (%pt-structured-p lt) (%pt-same lt rt) (member op '(= <>))) (rel 'equalp lf rf))
             (t (bad)))
       +pt-boolean+))))

;;; ---- designators: variables, fields, elements, calls ----------------------------------------------------------

(defun %pc-enclosing-function (name)
  "The PRINFO of the function NAME if its body is being compiled (here or in an enclosing routine)."
  (let ((r *pc-routine*))
    (loop (when (null r) (return nil))
          (when (and (string= (prinfo-name r) name) (eq (prinfo-kind r) :function)) (return r))
          (setq r (prinfo-nested r)))))

(defun %pc-designator-value (node env)
  "(values form type) for a designator used as a value."
  (case (pnode-kind node)
    (:id (let* ((name (car (pnode-args node))) (e (%pc-lookup env name)))
           (unless e (%pc-error node "~A is not declared" (string-downcase name)))
           (when (and *pc-constant-context* (not (eq (car e) :const)))
             (%pc-error node "~A is not a constant" (string-downcase name)))
           (case (car e)
             (:const (values (%pc-literal (cadr e)) (caddr e)))
             (:var (multiple-value-bind (reader writer type) (%pc-place node env)
                     (declare (ignore writer))
                     (values (%pc-check-read reader type name) type)))
             (:routine (let* ((ri (cadr e)) (f (%pc-enclosing-function name)))
                         (if (and f (eq f ri) (prinfo-params ri))
                             ;; inside a function with parameters, its name without arguments is its result so far
                             (values (%pc-check-read (prinfo-result-sym ri) (prinfo-result ri) name) (prinfo-result ri))
                             (progn (unless (eq (prinfo-kind ri) :function) (%pc-error node "The procedure ~A has no value" (string-downcase name)))
                                    (%pc-call ri nil node env)))))
             (:std (%pc-std node name nil env t))
             (:type (%pc-error node "The type ~A is not a value" (string-downcase name)))
             (t (%pc-error node "~A is not a value" (string-downcase name))))))
    (:call (let* ((name (car (pnode-args node))) (e (%pc-lookup env name)))
             (unless e (%pc-error node "~A is not declared" (string-downcase name)))
             (case (car e)
               (:routine (unless (eq (prinfo-kind (cadr e)) :function) (%pc-error node "The procedure ~A has no value" (string-downcase name)))
                (%pc-call (cadr e) (cadr (pnode-args node)) node env))
               (:std (%pc-std node name (cadr (pnode-args node)) env t))
               (t (%pc-error node "~A is not a function" (string-downcase name))))))
    (t (multiple-value-bind (reader writer type) (%pc-place node env)
         (declare (ignore writer))
         (values (%pc-check-read reader type (%pc-designator-name node)) type)))))

(defun %pc-designator-name (node)
  (case (pnode-kind node)
    (:id (car (pnode-args node)))
    (:field (format nil "~A.~A" (%pc-designator-name (car (pnode-args node))) (cadr (pnode-args node))))
    (:index (format nil "~A[]" (%pc-designator-name (car (pnode-args node)))))
    (:deref (format nil "~A^" (%pc-designator-name (car (pnode-args node)))))
    (t "value")))

(defun %pc-place (node env)
  "A variable designator: (values reader-form writer type), WRITER a function from a value form to a form."
  (let ((args (pnode-args node)))
    (case (pnode-kind node)
      (:id
       (let* ((name (car args)) (e (%pc-lookup env name)))
         (unless e (%pc-error node "~A is not declared" (string-downcase name)))
         (case (car e)
           (:var (destructuring-bind (kind sym type &rest more) (cdr e)
                   (declare (ignore more))
                   (case kind
                     ((:special :lexical) (values sym (lambda (v) `(setq ,sym ,v)) type))
                     (:ref (values `(%rget ,sym) (lambda (v) `(%rset ,sym ,v)) type))
                     (:std (values sym (lambda (v) (declare (ignore v)) (%pc-error node "~A cannot be assigned" (string-downcase name))) type))
                     (:readonly (values sym (lambda (v) (declare (ignore v)) (%pc-error node "~A cannot be assigned" (string-downcase name))) type))
                     (:field (let ((tmp sym) (idx (nth 5 e)))
                               (values `(svref ,tmp ,idx) (lambda (v) `(setf (svref ,tmp ,idx) ,v)) type))))))
           (:routine (let ((f (%pc-enclosing-function name)))
                       (unless (and f (eq f (cadr e))) (%pc-error node "~A is not a variable" (string-downcase name)))
                       (let ((sym (prinfo-result-sym f)))
                         (values sym (lambda (v) `(setq ,sym ,v)) (prinfo-result f)))))
           (t (%pc-error node "~A is not a variable" (string-downcase name))))))
      (:index
       (multiple-value-bind (reader writer type) (%pc-place (car args) env)
         (dolist (ix (cadr args))
           (multiple-value-bind (ifo ity) (%pc-expr ix env)
             (case (pt-kind type)
               (:array
                (let ((it (pt-index type)))
                  (unless (and (%pt-ordinal-p ity) (%pt-same-ordinal ity it))
                    (%pc-error ix "The subscript of ~A must be ~A, not ~A" (%pc-designator-name (car args)) (%pt-describe it) (%pt-describe ity)))
                  (let* ((cont reader) (k (let ((o (%pc-ord-form ifo ity)))
                                            (cond ((eq (pt-hi it) :conformant) `(%pidx ,o ,(pt-target it) ,(pt-tag it)))
                                                  ((integerp o)
                                                   (unless (<= (pt-lo it) o (pt-hi it)) (%pc-error ix "The subscript ~A is out of the bounds ~A" o (%pt-describe it)))
                                                   (- o (pt-lo it)))
                                                  (t `(%pidx ,o ,(pt-lo it) ,(pt-hi it)))))))
                    (setq reader `(svref ,cont ,k)
                          writer (lambda (v) `(setf (svref ,cont ,k) ,v))
                          type (pt-elem type)))))
               (:string
                (unless (eq (pt-kind ity) :integer) (%pc-error ix "A string subscript must be an integer"))
                (let ((base reader) (bw writer))
                  (setq reader `(%pvs-char ,base ,ifo)
                        writer (lambda (v) (funcall bw `(%pvs-set-char ,base ,ifo ,v)))
                        type +pt-char+)))
               (t (%pc-error node "~A is not an array" (%pc-designator-name (car args)))))))
         (values reader writer type)))
      (:field
       (multiple-value-bind (reader writer type) (%pc-place (car args) env)
         (declare (ignore writer))
         (unless (eq (pt-kind type) :record) (%pc-error node "~A is not a record" (%pc-designator-name (car args))))
         (let ((f (assoc (cadr args) (pt-fields type) :test #'string=)))
           (unless f (%pc-error node "The record has no field ~A" (string-downcase (cadr args))))
           (let ((idx (cadr f)) (rec reader))
             (values `(svref ,rec ,idx) (lambda (v) `(setf (svref ,rec ,idx) ,v)) (caddr f))))))
      (:deref
       (multiple-value-bind (reader writer type) (%pc-place (car args) env)
         (declare (ignore writer))
         (case (pt-kind type)
           (:pointer (let ((p reader))
                       (values `(pbox-value (%pderef ,p)) (lambda (v) `(setf (pbox-value (%pderef ,p)) ,v)) (%pt-pointee type node))))
           (:file (let ((f reader))
                    (values `(%pfile-buf ,f) (lambda (v) `(%pfile-set-buf ,f ,v)) (if (pt-textp type) +pt-char+ (pt-elem type)))))
           (t (%pc-error node "~A is not a pointer or a file" (%pc-designator-name (car args)))))))
      (:call (multiple-value-bind (f ty) (%pc-designator-value node env)
               (values f (lambda (v) (declare (ignore v)) (%pc-error node "A function value cannot be assigned")) ty)))
      (:paren (%pc-place (car args) env))
      (t (%pc-error node "A variable is expected here")))))

(defun %pc-ref (node env)
  "A form making a reference (getter . setter) to the variable NODE, for a VAR parameter: (values form type)."
  (when (eq (pnode-kind node) :id)
    (let ((e (%pc-lookup env (car (pnode-args node)))))
      (when (and e (eq (car e) :var) (eq (cadr e) :ref))
        (return-from %pc-ref (values (caddr e) (cadddr e))))))
  (unless (member (pnode-kind node) '(:id :index :field :deref)) (%pc-error node "A VAR parameter needs a variable"))
  ;; evaluate the containers and subscripts once, then close over them
  (let ((bindings nil))
    (progn
      (multiple-value-bind (reader writer type) (%pc-place node env)
        (let ((v (%ptemp "V")))
          (when (and (consp reader) (member (car reader) '(svref pbox-value %pfile-buf %pvs-char)))
            ;; bind the container (and the index) to temporaries
            (let ((c (%ptemp "C")))
              (push (list c (cadr reader)) bindings)
              (if (eq (car reader) 'svref)
                  (let ((k (%ptemp "K")))
                    (push (list k (caddr reader)) bindings)
                    (setq reader `(svref ,c ,k) writer (lambda (x) `(setf (svref ,c ,k) ,x))))
                  (case (car reader)
                    (pbox-value (setq reader `(pbox-value ,c) writer (lambda (x) `(setf (pbox-value ,c) ,x))))
                    (%pfile-buf (setq reader `(%pfile-buf ,c) writer (lambda (x) `(%pfile-set-buf ,c ,x))))
                    (t (%pc-error node "A character of a string cannot be passed as a VAR parameter"))))))
          (values `(let* ,(reverse bindings) (cons (lambda () ,reader) (lambda (,v) ,(funcall writer v)))) type))))))

;;; ---- calls ----------------------------------------------------------------------------------------------------

(defun %pc-call (ri args node env)
  "A call of the routine RI with the argument nodes ARGS: (values form result-type)."
  (let ((params (prinfo-params ri)) (forms nil))
    (unless (= (length args) (%pc-param-count params))
      (%pc-error node "~A takes ~D argument~:P, not ~D" (string-downcase (prinfo-name ri)) (%pc-param-count params) (length args)))
    (let ((as args))
      (dolist (p params)
        (case (car p)
          (:value (dolist (n (cadr p))
                    (declare (ignore n))
                    (let ((a (pop as)))
                      (multiple-value-bind (f ty) (%pc-expr a env)
                        (push (if (eq (prinfo-directive ri) :lisp)
                                  (if (%pt-structured-p ty) `(%plisp-value ,f) f)
                                  (%pc-coerce f ty (caddr p) a (%pc-fresh-p a)))
                              forms)))))
          (:var (dolist (n (cadr p))
                  (declare (ignore n))
                  (let ((a (pop as)))
                    (if (eq (prinfo-directive ri) :lisp)
                        (multiple-value-bind (f ty) (%pc-expr a env)
                          (push (if (%pt-structured-p ty) `(%plisp-value ,f) f) forms))
                        (multiple-value-bind (ref ty) (%pc-ref a env)
                          (unless (%pt-same ty (caddr p))
                            (%pc-error a "The VAR parameter ~A needs ~A, not ~A" (string-downcase (car (cadr p))) (%pt-describe (caddr p)) (%pt-describe ty)))
                          (push ref forms))))))
          (:conformant (dolist (n (cadr p))
                         (declare (ignore n))
                         (let ((a (pop as)))
                           (multiple-value-bind (f ty) (if (eq (cadddr p) :var) (%pc-ref a env) (%pc-expr a env))
                             (let ((bounds (%pc-conformant-bounds ty (caddr p) a)))
                               (push (if (eq (cadddr p) :var) f (if (%pc-fresh-p a) f `(%pcopy ,f))) forms)
                               (dolist (b bounds) (push b forms)))))))
          ((:proc :func) (let ((a (pop as)))
                           (push (%pc-routine-object a env (car p)) forms))))))
    (setq forms (nreverse forms))
    (values (case (prinfo-directive ri)
              (:lisp (let ((call (cons (prinfo-lisp-fn ri) forms)))
                       (if (and (prinfo-result ri) (eq (pt-kind (prinfo-result ri)) :boolean)) `(%pbool ,call) call)))
              (:param (cons 'funcall (cons (prinfo-lisp-sym ri) forms)))
              (t (cons (prinfo-lisp-sym ri) forms)))
            (prinfo-result ri))))

(defun %pc-param-count (params)
  (let ((n 0)) (dolist (p params n) (setq n (+ n (if (member (car p) '(:proc :func)) 1 (length (cadr p))))))))

(defun %pc-fresh-p (node) (member (pnode-kind node) '(:call :str :setcons :binop)))

(defun %pc-conformant-bounds (ty schema node)
  "Forms giving the actual bounds of the array of type TY for the conformant SCHEMA (a list of index types)."
  (let ((forms nil) (ty ty))
    (dolist (s (car schema))
      (declare (ignore s))
      (unless (eq (pt-kind ty) :array) (%pc-error node "A conformant array parameter needs an array"))
      (let ((it (pt-index ty)))
        (if (eq (pt-hi it) :conformant)
            (progn (push (pt-target it) forms) (push (pt-tag it) forms))
            (progn (push (pt-lo it) forms) (push (pt-hi it) forms))))
      (setq ty (pt-elem ty)))
    (nreverse forms)))

(defun %pc-routine-object (node env kind)
  "The function object for a routine passed as a procedural or functional parameter."
  (unless (eq (pnode-kind node) :id) (%pc-error node "A procedure or function name is expected"))
  (let ((e (%pc-lookup env (car (pnode-args node)))))
    (unless (and e (eq (car e) :routine)) (%pc-error node "~A is not a procedure or function" (string-downcase (car (pnode-args node)))))
    (let ((ri (cadr e)))
      (unless (eq (prinfo-kind ri) (if (eq kind :func) :function :procedure))
        (%pc-error node "~A is not a ~:[procedure~;function~]" (string-downcase (prinfo-name ri)) (eq kind :func)))
      (case (prinfo-directive ri)
        (:param (prinfo-lisp-sym ri))
        (:lisp `(lambda (&rest a) (apply ',(prinfo-lisp-fn ri) a)))
        (t `(function ,(prinfo-lisp-sym ri)))))))

;;; ---- standard procedures and functions ---------------------------------------------------------------------------

(defun %pc-file-arg (args env)
  "If the first argument is a file: (values file-form file-type remaining-args), else the default."
  (when args
    (let ((a (car args)))
      (when (member (pnode-kind a) '(:id :index :field :deref))
        (let ((ty (ignore-errors (nth-value 2 (%pc-place a env)))))
          (when (and ty (eq (pt-kind ty) :file))
            (return-from %pc-file-arg (values (nth-value 0 (%pc-place a env)) ty (cdr args))))))))
  (values nil nil args))

(defun %pc-std (node name args env value-wanted)
  "A call of the standard routine NAME; for functions (values form type), for procedures a form."
  (flet ((nargs (n) (unless (= (length args) n) (%pc-error node "~A takes ~D argument~:P" (string-downcase name) n)))
         (arg (i) (%pc-expr (nth i args) env))
         (fn (form type) (if value-wanted (values form type) (%pc-error node "~A is a function, not a procedure" (string-downcase name))))
         (proc (form) (if value-wanted (%pc-error node "~A is a procedure, not a function" (string-downcase name)) form)))
    (cond
      ((member name '("WRITE" "WRITELN") :test #'string=) (proc (%pc-write node name args env)))
      ((member name '("READ" "READLN") :test #'string=) (proc (%pc-read node name args env)))
      ((member name '("RESET" "REWRITE") :test #'string=)
       (unless (<= 1 (length args) 2) (%pc-error node "~A takes a file and an optional options string" (string-downcase name)))
       (multiple-value-bind (f w ty) (%pc-place (car args) env)
         (declare (ignore w))
         (unless (eq (pt-kind ty) :file) (%pc-error node "~A needs a file" (string-downcase name)))
         (proc (list (if (string= name "RESET") '%preset '%prewrite) f (if (cdr args) (nth-value 0 (arg 1)) nil)))))
      ((member name '("GET" "PUT" "PAGE" "CLOSE") :test #'string=)
       (multiple-value-bind (f w ty) (if args (%pc-place (car args) env) (values '(%pstd-output) nil +pt-text+))
         (declare (ignore w))
         (unless (eq (pt-kind ty) :file) (%pc-error node "~A needs a file" (string-downcase name)))
         (proc (list (cdr (assoc name '(("GET" . %pget) ("PUT" . %pput) ("PAGE" . %ppage) ("CLOSE" . %pclose)) :test #'string=)) f))))
      ((string= name "NEW")
       (when (null args) (nargs 1))
       (multiple-value-bind (r w ty) (%pc-place (car args) env)
         (declare (ignore r))
         (unless (eq (pt-kind ty) :pointer) (%pc-error node "new needs a pointer variable"))
         (proc (funcall w `(%pnew ',(%pt-desc (%pt-pointee ty node)) ,*pc-zero*)))))
      ((string= name "DISPOSE")
       (when (null args) (nargs 1))
       (multiple-value-bind (r w ty) (%pc-place (car args) env)
         (unless (eq (pt-kind ty) :pointer) (%pc-error node "dispose needs a pointer variable"))
         (proc `(progn (%pdispose ,r) ,(funcall w ''pascal-undefined)))))
      ((member name '("PACK" "UNPACK") :test #'string=)
       (nargs 3)
       (let ((packp (string= name "PACK")))
         (multiple-value-bind (ar aw at) (%pc-place (nth (if packp 0 1) args) env)
           (declare (ignore aw))
           (multiple-value-bind (zr zw zt) (%pc-place (nth (if packp 2 0) args) env)
             (declare (ignore zw))
             (multiple-value-bind (i it) (%pc-expr (nth (if packp 1 2) args) env)
               (unless (and (eq (pt-kind at) :array) (eq (pt-kind zt) :array) (%pt-same-ordinal it (pt-index at)))
                 (%pc-error node "~A needs two arrays and a subscript" (string-downcase name)))
               (let ((k `(%pidx ,(%pc-ord-form i it) ,(pt-lo (pt-index at)) ,(pt-hi (pt-index at)))))
                 (proc (if packp `(replace ,zr ,ar :start2 ,k) `(replace ,ar ,zr :start1 ,k)))))))))
      ((string= name "HALT") (proc `(throw '%pascal-halt nil)))
      ;; functions
      ((member name '("EOF" "EOLN") :test #'string=)
       (let ((f (if args (multiple-value-bind (r w ty) (%pc-place (car args) env)
                           (declare (ignore w))
                           (unless (eq (pt-kind ty) :file) (%pc-error node "~A needs a file" (string-downcase name))) r)
                    '(%pstd-input))))
         (fn (list (if (string= name "EOF") '%peof '%peoln) f) +pt-boolean+)))
      ((string= name "CLOCK") (nargs 0)
       (fn '(values (floor (* 1000 (get-internal-real-time)) internal-time-units-per-second)) +pt-integer+))
      ((string= name "MAXLENGTH") (nargs 1)
       (multiple-value-bind (f ty) (arg 0) (declare (ignore f))
         (unless (eq (pt-kind ty) :string) (%pc-error node "maxlength needs a string"))
         (fn (pt-maxlen ty) +pt-integer+)))
      (t
       (let ((n (length args)))
         (cond
           ((member name '("SUBSTR") :test #'string=)
            (unless (<= 2 n 3) (%pc-error node "substr takes 2 or 3 arguments"))
            (fn `(%pvs-substr ,@(mapcar (lambda (a) (nth-value 0 (%pc-expr a env))) args)) +pt-vs-string+))
           ((string= name "INDEX") (nargs 2) (fn `(%pvs-index ,(nth-value 0 (arg 0)) ,(nth-value 0 (arg 1))) +pt-integer+))
           (t
            (nargs 1)
            (multiple-value-bind (x ty) (arg 0)
              (let ((k (pt-kind ty)))
                (flet ((need (ok what) (unless ok (%pc-error node "~A needs ~A, not ~A" (string-downcase name) what (%pt-describe ty)))))
                  (cond
                    ((string= name "ABS") (need (%pt-numeric-p ty) "a number") (fn `(abs ,x) (if (eq k :integer) +pt-integer+ +pt-real+)))
                    ((string= name "SQR") (need (%pt-numeric-p ty) "a number")
                     (let ((v (%ptemp "X"))) (fn `(let ((,v ,x)) (* ,v ,v)) (if (eq k :integer) +pt-integer+ +pt-real+))))
                    ((member name '("SIN" "COS" "ARCTAN") :test #'string=) (need (%pt-numeric-p ty) "a number")
                     (fn `(,(cdr (assoc name '(("SIN" . sin) ("COS" . cos) ("ARCTAN" . atan)) :test #'string=)) (float ,x 1d0)) +pt-real+))
                    ((string= name "EXP") (need (%pt-numeric-p ty) "a number") (fn `(%pexp ,x) +pt-real+))
                    ((string= name "LN") (need (%pt-numeric-p ty) "a number") (fn `(%pln ,x) +pt-real+))
                    ((string= name "SQRT") (need (%pt-numeric-p ty) "a number") (fn `(%psqrt ,x) +pt-real+))
                    ((string= name "TRUNC") (need (%pt-numeric-p ty) "a number") (fn `(%ptrunc ,x) +pt-integer+))
                    ((string= name "ROUND") (need (%pt-numeric-p ty) "a number") (fn `(%pround ,x) +pt-integer+))
                    ((string= name "SINGLE") (need (%pt-numeric-p ty) "a number") (fn `(%psingle ,x) +pt-shortreal+))
                    ((string= name "DOUBLE") (need (%pt-numeric-p ty) "a number") (fn `(float ,x 1d0) +pt-real+))
                    ((string= name "ORD") (need (or (%pt-ordinal-p ty) (eq k :pointer)) "an ordinal") (fn (%pc-ord-form x ty) +pt-integer+))
                    ((string= name "CHR") (need (eq k :integer) "an integer") (fn (if (integerp x) (code-char x) `(%pchr ,x)) +pt-char+))
                    ((string= name "ODD") (need (eq k :integer) "an integer") (fn `(oddp ,x) +pt-boolean+))
                    ((member name '("SUCC" "PRED") :test #'string=) (need (%pt-ordinal-p ty) "an ordinal")
                     (let* ((base (or (pt-base ty) ty)) (o `(,(if (string= name "SUCC") '+ '-) ,(%pc-ord-form x ty) 1)))
                       (fn (%pc-from-ord-form (if (or (pt-lo base) (pt-hi base)) `(%prange ,o ,(pt-lo base) ,(pt-hi base)) o) ty) ty)))
                    ((string= name "LENGTH") (need (%pt-stringish-p ty) "a string")
                     (fn (if (%pt-char-array-p ty) (pt-size ty) `(length (%pchars->string ,x))) +pt-integer+))
                    ((member name '("TRIM" "LTRIM" "COMPRESS") :test #'string=) (need (%pt-stringish-p ty) "a string")
                     (fn `(,(cdr (assoc name '(("TRIM" . %pvs-trim) ("LTRIM" . %pvs-ltrim) ("COMPRESS" . %pvs-compress)) :test #'string=)) ,x) +pt-vs-string+))
                    ((string= name "STR") (fn `(%pvs-str ,x) +pt-vs-string+))
                    (t (%pc-error node "~A is not implemented" (string-downcase name))))))))))))))

(defun %pc-write (node name args env)
  (multiple-value-bind (f fty rest) (%pc-file-arg args env)
    (let ((file (or f '(%pstd-output))) (textp (or (null fty) (pt-textp fty))) (forms nil))
      (dolist (a rest)
        (let* ((fmt (eq (pnode-kind a) :fmt)) (e (if fmt (car (pnode-args a)) a))
               (w (and fmt (%pc-width (cadr (pnode-args a)) env))) (d (and fmt (caddr (pnode-args a)) (%pc-width (caddr (pnode-args a)) env))))
          (multiple-value-bind (x ty) (%pc-expr e env)
            (push (if (not textp)
                      `(%pwrite-elem ,file ,(%pc-coerce x ty (pt-elem fty) e (%pc-fresh-p e)))
                      (progn
                        (when (and d (not (eq (pt-kind ty) :real))) (%pc-error a "Only reals can be written with decimals"))
                        (case (pt-kind ty)
                          (:integer `(%pwrite-int ,file ,x ,@(and w (list w))))
                          (:real `(%pwrite-real ,file ,x ,@(cond (d (list w d)) (w (list w)))))
                          (:char `(%pwrite-char ,file ,x ,@(and w (list w))))
                          (:boolean `(%pwrite-bool ,file ,x ,@(and w (list w))))
                          (:enum `(%pwrite-str ,file (svref ,(coerce (mapcar #'string-downcase (pt-names ty)) 'vector) ,x) ,@(and w (list w))))
                          ((:strlit :string) `(%pwrite-str ,file ,x ,@(and w (list w))))
                          (:lispobject `(%pwrite-any ,file ,x ,@(and w (list w))))
                          (t (if (%pt-char-array-p ty)
                                 `(%pwrite-str ,file ,x ,@(and w (list w)))
                                 (%pc-error e "~A cannot be written to a text file" (%pt-describe ty)))))))
                  forms))))
      (when (string= name "WRITELN")
        (unless textp (%pc-error node "writeln needs a text file"))
        (push `(%pwriteln ,file) forms))
      (if (and (null (cdr forms)) forms) (car forms) `(progn ,@(nreverse forms) nil)))))

(defun %pc-width (node env)
  (multiple-value-bind (f ty) (%pc-expr node env)
    (unless (eq (pt-kind ty) :integer) (%pc-error node "A field width must be an integer"))
    f))

(defun %pc-read (node name args env)
  (multiple-value-bind (f fty rest) (%pc-file-arg args env)
    (let ((file (or f '(%pstd-input))) (textp (or (null fty) (pt-textp fty))) (forms nil))
      (dolist (a rest)
        (multiple-value-bind (r w ty) (%pc-place a env)
          (declare (ignore r))
          (push (funcall w
                         (if (not textp)
                             (%pc-coerce `(%pread-elem ,file) (pt-elem fty) ty a t)
                             (case (pt-kind ty)
                               (:integer (%pc-coerce `(%pread-int ,file) +pt-integer+ ty a))
                               (:real `(%pread-real ,file))
                               (:char (%pc-coerce `(%pread-char ,file) +pt-char+ ty a))
                               (:string `(%pread-line-string ,file ,(pt-maxlen ty)))
                               (t (if (%pt-char-array-p ty)
                                      `(%pread-chars ,file ,(pt-size ty))
                                      (%pc-error a "~A cannot be read from a text file" (%pt-describe ty)))))))
                forms)))
      (when (string= name "READLN")
        (unless textp (%pc-error node "readln needs a text file"))
        (push `(%preadln ,file) forms))
      `(progn ,@(nreverse forms) nil))))

;;; ---- statements --------------------------------------------------------------------------------------------------

(defun %pc-line-form (node)
  (if *pascal-debug-info* `(setq *pascal-line* ,(%pc-line-of (pnode-start node))) nil))

(defun %pc-statements (nodes env)
  "Compile a statement sequence: a list of forms (a TAGBODY when it holds labels)."
  (let ((forms nil) (labelled nil))
    (dolist (n nodes)
      (%pc-collecting
        (let ((n n))
          (loop (unless (eq (pnode-kind n) :labeled) (return))
                (let ((tag (cdr (assoc (car (pnode-args n)) *pc-labels* :test #'string=))))
                  (unless tag (%pc-error n "The label ~A is not declared" (car (pnode-args n))))
                  (push tag forms) (setq labelled t))
                (setq n (cadr (pnode-args n))))
          (let ((f (%pc-statement n env))) (when f (push f forms))))))
    (setq forms (nreverse forms))
    (if labelled (list `(tagbody ,@forms)) forms)))

(defun %pc-progn (forms) (cond ((null forms) nil) ((null (cdr forms)) (car forms)) (t `(progn ,@forms))))

(defun %pc-statement (node env)
  (let ((args (pnode-args node)) (line (%pc-line-form node)))
    (flet ((with-line (form) (if line `(progn ,line ,form) form)))
      (case (pnode-kind node)
        (:empty nil)
        (:compound (%pc-progn (%pc-statements (car args) env)))
        (:assign
         (destructuring-bind (target expr) args
           (multiple-value-bind (r w ty) (%pc-place target env)
             (declare (ignore r))
             (multiple-value-bind (f ety) (%pc-expr expr env)
               (with-line (funcall w (%pc-coerce f ety ty expr (%pc-fresh-p expr))))))))
        (:pcall
         (destructuring-bind (name cargs) args
           (let ((e (%pc-lookup env name)))
             (unless e (%pc-error node "~A is not declared" (string-downcase name)))
             (with-line
               (case (car e)
                 (:std (%pc-std node name cargs env nil))
                 (:routine (when (eq (prinfo-kind (cadr e)) :function)
                             (unless (eq (prinfo-directive (cadr e)) :lisp)
                               (%pc-error node "The function ~A is called as a procedure" (string-downcase name))))
                  (nth-value 0 (%pc-call (cadr e) cargs node env)))
                 (t (%pc-error node "~A is not a procedure" (string-downcase name))))))))
        (:if (destructuring-bind (c then else) args
               (let ((cf (%pc-condition c env)))
                 (with-line `(if ,cf ,(%pc-statement then env) ,(and else (%pc-statement else env)))))))
        (:while (destructuring-bind (c body) args
                  (let ((cf (%pc-condition c env)) (*pc-in-loop* t))
                    `(block %pleave
                       (loop ,@(and line (list line))
                             (unless ,cf (return-from %pleave nil))
                             (block %pcontinue ,(%pc-statement body env)))))))
        (:repeat (destructuring-bind (body c) args
                   (let ((*pc-in-loop* t))
                     (let ((bf (%pc-statements body env)) (cf (%pc-condition c env)))
                       `(block %pleave
                          (loop (block %pcontinue ,@bf)
                                ,@(and line (list line))
                                (when ,cf (return-from %pleave nil))))))))
        (:for (%pc-for node env))
        (:case (%pc-case node env))
        (:with (%pc-with node env))
        (:goto (let ((tag (cdr (assoc (car args) *pc-labels* :test #'string=))))
                 (unless tag (%pc-error node "The label ~A is not declared" (car args)))
                 (with-line `(go ,tag))))
        (:leave (unless *pc-in-loop* (%pc-error node "LEAVE outside a loop")) '(return-from %pleave nil))
        (:continue (unless *pc-in-loop* (%pc-error node "CONTINUE outside a loop")) '(return-from %pcontinue nil))
        (:return (if *pc-routine* '(return-from %proutine nil) '(return-from %pmain nil)))
        (:template (%pc-error node "The template item ~A has not been filled in" (car args)))
        (t (%pc-error node "Unknown statement"))))))

(defun %pc-condition (node env)
  (multiple-value-bind (f ty) (%pc-expr node env)
    (unless (eq (pt-kind ty) :boolean) (%pc-error node "A condition must be a boolean, not ~A" (%pt-describe ty)))
    f))

(defun %pc-for (node env)
  (destructuring-bind (var from dir to body) (pnode-args node)
    (let ((e (%pc-lookup env var)))
      (unless (and e (eq (car e) :var) (member (cadr e) '(:lexical :special)))
        (%pc-error node "The control variable ~A must be a simple variable declared in this routine" (string-downcase var)))
      (let ((ty (cadddr e)) (sym (caddr e)))
        (unless (%pt-ordinal-p ty) (%pc-error node "The control variable ~A must have an ordinal type" (string-downcase var)))
        (multiple-value-bind (ff ft) (%pc-expr from env)
          (multiple-value-bind (tf tt) (%pc-expr to env)
            (unless (and (%pt-same-ordinal ft ty) (%pt-same-ordinal tt ty)) (%pc-error node "The bounds of the FOR loop must be ~A" (%pt-describe ty)))
            (let* ((lo (%ptemp "FROM")) (hi (%ptemp "TO")) (i (%ptemp "I")) (up (eq dir :to))
                   (base (or (pt-base ty) ty)) (checked (and (or (pt-lo ty) (pt-hi ty)) (not (eq (pt-kind ty) :boolean))
                                                             (not (and (eq (pt-kind ty) :char) (= (pt-lo ty) 0) (= (pt-hi ty) 255)))
                                                             (not (and (eq (pt-kind ty) :enum) (eql (pt-lo ty) (pt-lo base)) (eql (pt-hi ty) (pt-hi base))))))
                   (bf (let ((*pc-in-loop* t)) (%pc-statement body env))))
              `(let ((,lo ,(%pc-ord-form ff ft)) (,hi ,(%pc-ord-form tf tt)))
                 (when (,(if up '<= '>=) ,lo ,hi)
                   ,@(when checked `((%prange ,lo ,(pt-lo ty) ,(pt-hi ty)) (%prange ,hi ,(pt-lo ty) ,(pt-hi ty))))
                   (let ((,i ,lo))
                     (block %pleave
                       (loop (setq ,sym ,(%pc-from-ord-form i ty))
                             (block %pcontinue ,bf)
                             (when (= ,i ,hi) (return-from %pleave nil))
                             (setq ,i (,(if up '+ '-) ,i 1))))))
                 (setq ,sym 'pascal-undefined)
                 nil))))))))

(defun %pc-case (node env)
  (destructuring-bind (sel arms other) (pnode-args node)
    (multiple-value-bind (sf st) (%pc-expr sel env)
      (unless (%pt-ordinal-p st) (%pc-error sel "The CASE selector must be an ordinal, not ~A" (%pt-describe st)))
      (let ((k (%ptemp "K")) (clauses nil) (seen nil))
        (dolist (arm arms)
          (let ((tests nil))
            (dolist (l (car arm))
              (if (eq (pnode-kind l) :range)
                  (multiple-value-bind (lo lt) (%pc-constant (car (pnode-args l)) env)
                    (multiple-value-bind (hi ht) (%pc-constant (cadr (pnode-args l)) env)
                      (unless (and (%pt-same-ordinal lt st) (%pt-same-ordinal ht st)) (%pc-error l "The CASE label does not match the selector"))
                      (push `(<= ,(%pc-ord-value lo) ,k ,(%pc-ord-value hi)) tests)))
                  (multiple-value-bind (v lt) (%pc-constant l env)
                    (unless (%pt-same-ordinal lt st) (%pc-error l "The CASE label ~A does not match the selector type ~A" v (%pt-describe st)))
                    (let ((o (%pc-ord-value v)))
                      (when (member o seen) (%pc-error l "The CASE label ~A appears twice" v))
                      (push o seen)
                      (push `(eql ,k ,o) tests)))))
            (push `((or ,@(nreverse tests)) ,(%pc-statement (cadr arm) env)) clauses)))
        `(let ((,k ,(%pc-ord-form sf st)))
           (cond ,@(nreverse clauses)
                 (t ,(if other (%pc-progn (%pc-statements other env))
                         `(%perror "No CASE label matches the value ~A" ,(%pc-from-ord-form k st))))))))))

(defun %pc-with (node env)
  (destructuring-bind (recs body) (pnode-args node)
    (let ((bindings nil) (env env))
      (dolist (r recs)
        (multiple-value-bind (reader w ty) (%pc-place r env)
          (declare (ignore w))
          (unless (eq (pt-kind ty) :record) (%pc-error r "WITH needs a record, not ~A" (%pt-describe ty)))
          (let ((tmp (%ptemp "W")) (inner (%make-penv env :with)))
            (push (list tmp reader) bindings)
            (dolist (f (pt-fields ty))
              (setf (gethash (car f) (penv-table inner)) (list :var :field tmp (caddr f) (car f) (cadr f))))
            (setq env inner))))
      `(let* ,(nreverse bindings) ,(%pc-statement body env)))))

;;; ---- declarations and routines -------------------------------------------------------------------------------

(defun %pc-declare-consts-and-types (decls env)
  (dolist (c (getf decls :consts))
    (%pc-collecting
      (destructuring-bind (name expr) (pnode-args c)
        (multiple-value-bind (v ty) (%pc-constant expr env)
          (%pc-define env name (list :const v ty) c)))))
  (dolist (d (getf decls :types))
    (%pc-collecting
      (destructuring-bind (name tnode) (pnode-args d)
        (let ((ty (%pc-type tnode env)))
          ;; a named type keeps its name (unless it is just another name for an existing type)
          (when (and (null (pt-name ty)) (not (eq (pnode-kind tnode) :named)))
            (setf (pt-name ty) (string-downcase name))
            (when (eq (pt-kind ty) :record) (setf (pt-tag ty) (%psym name))))
          (%pc-define env name (list :type ty) d)))))
  (%pc-collecting (%pc-resolve-pointers)))

(defun %pc-var-type (v env)
  (%pc-type (cadr (pnode-args v)) env))

(defun %pc-params (params env node)
  "Resolve formal parameter sections: a list of (:value names type) (:var names type) (:proc name sig) (:func name sig)
and (:conformant names schema mode elem)."
  (let ((out nil))
    (unless (eq params :none)
      (dolist (p params)
        (case (car p)
          ((:value :var)
           (let ((tn (caddr p)))
             (if (eq (pnode-kind tn) :conformant)
                 (push (list :conformant (cadr p) (pnode-args tn) (car p)) out)
                 (push (list (car p) (cadr p) (%pc-type tn env)) out))))
          (:proc (push (list :proc (cadr p) (%pc-params (caddr p) env node)) out))
          (:func (push (list :func (cadr p) (%pc-params (caddr p) env node) (%pc-type (cadddr p) env)) out)))))
    (nreverse out)))

(defun %pc-routine-lisp-fn (name lisp-name node)
  "The Lisp function a routine declared with the LISP directive calls."
  (let* ((text (or lisp-name (string-downcase name))) (colon (%string-position-char text #\: 0)))
    (if (null colon)
        (or (find-symbol (string-upcase text) *pc-package*) (intern (string-upcase text) *pc-package*))
        (let* ((pkg-name (string-upcase (subseq text 0 colon)))
               (sym-name (string-upcase (subseq text (if (and (< (+ colon 1) (length text)) (char= (char text (+ colon 1)) #\:)) (+ colon 2) (+ colon 1)))))
               (pkg (find-package (cond ((member pkg-name '("GLOBAL" "LISP" "CL" "SCL" "ZL" "SYS" "SI" "TV") :test #'string=) "COMMON-LISP")
                                        ((member pkg-name '("USER" "CL-USER") :test #'string=) "COMMON-LISP-USER")
                                        (t pkg-name)))))
          (unless pkg (%pc-error node "There is no Lisp package ~A" pkg-name))
          (or (find-symbol sym-name pkg) (intern sym-name pkg))))))

(defun %pc-make-routine (rnode env suffix nested spec-ri)
  "Create the PRINFO for the routine RNODE and declare it in ENV."
  (destructuring-bind (kind name params result directive lisp-name body) (pnode-args rnode)
    (declare (ignore body))
    (let ((existing (gethash name (penv-table env))))
      (cond
        ;; the body of a routine declared FORWARD, or declared in the unit specification
        ((and existing (eq (car existing) :routine) (not (prinfo-defined (cadr existing))))
         (let ((ri (cadr existing)))
           (unless (eq (prinfo-kind ri) kind) (%pc-error rnode "~A was declared as a ~(~A~)" (string-downcase name) (prinfo-kind ri)))
           (unless (or (eq params :none) (prinfo-unit ri))
             (%pc-error rnode "The parameters of ~A were given with its FORWARD declaration" (string-downcase name)))
           (unless (eq directive :forward) (setf (prinfo-node ri) rnode (prinfo-defined ri) t))
           ri))
        ((and spec-ri (not (eq directive :forward)))
         (setf (prinfo-node spec-ri) rnode (prinfo-defined spec-ri) t)
         (%pc-define env name (list :routine spec-ri) rnode)
         spec-ri)
        (t
         (let* ((ps (%pc-params params env rnode))
                (rt (and result (%pc-type result env)))
                (ri (make-prinfo :name name :kind kind :params ps :result rt
                                 :lisp-sym (if nested (%psym name) (%psym name suffix))
                                 :nested nested :directive directive :node rnode
                                 :defined (not (member directive '(:forward))))))
           (when (and (eq kind :function) (null rt)) (%pc-error rnode "The function ~A needs a result type" (string-downcase name)))
           (when (eq directive :lisp) (setf (prinfo-lisp-fn ri) (%pc-routine-lisp-fn name lisp-name rnode)))
           (%pc-define env name (list :routine ri) rnode)
           ri))))))

(defun %pc-local-init (ty zero)
  (if (or (%pt-structured-p ty) (eq (pt-kind ty) :file))
      `(%pmake ',(%pt-desc ty) ,zero)
      (%pc-literal (%pmake (%pt-desc ty) zero))))

(defun %pc-routine-body (ri env)
  "The Lisp lambda (LAMBDA-LIST . BODY) of the Pascal routine RI, whose declaration environment is ENV."
  (let* ((rnode (prinfo-node ri)) (block (car (last (pnode-args rnode))))
         (decls (car (pnode-args block))) (body (cadr (pnode-args block)))
         (renv (%make-penv env :routine)) (lambda-list nil) (locals nil)
         (*pc-routine* (progn (setf (prinfo-nested ri) *pc-routine*) ri))
         (*pc-labels* *pc-labels*))
    ;; parameters
    (dolist (p (prinfo-params ri))
      (case (car p)
        ((:value :var)
         (dolist (n (cadr p))
           (let ((s (%psym n)))
             (push s lambda-list)
             (%pc-define renv n (list :var (if (eq (car p) :var) :ref :lexical) s (caddr p) n) rnode))))
        (:conformant
         (destructuring-bind (names schema mode) (cdr p)
           ;; schema: list of (lo-name hi-name index-type-node) then the element type node
           (let* ((bounds (car schema)) (elem-node (cadr schema)) (bsyms nil))
             (dolist (b bounds)
               (let ((lo (%psym (car b))) (hi (%psym (cadr b))) (it (%pc-type (caddr b) env)))
                 (%pc-define renv (car b) (list :var :readonly lo it (car b)) rnode)
                 (%pc-define renv (cadr b) (list :var :readonly hi it (cadr b)) rnode)
                 (push (list lo hi it) bsyms)))
             (setq bsyms (nreverse bsyms))
             (let ((ty (%pc-type elem-node env)))
               (dolist (b (reverse bsyms))
                 (setq ty (%mk-type :array :index (%mk-type (pt-kind (caddr b)) :hi :conformant :target (car b) :tag (cadr b)
                                                            :names (pt-names (caddr b)))
                                    :elem ty)))
               ;; a conformant index type carries its bound variables: the low one in TARGET, the high one in TAG
               (let ((first t))
                 (dolist (n names)
                   (let ((s (%psym n)))
                     (push s lambda-list)
                     (%pc-define renv n (list :var (if (eq mode :var) :ref :lexical) s ty n) rnode)
                     ;; every array argument comes with its bounds; those of the first one are used
                     (dolist (b bsyms)
                       (push (if first (car b) (%ptemp "LO")) lambda-list)
                       (push (if first (cadr b) (%ptemp "HI")) lambda-list))
                     (setq first nil))))))))
        ((:proc :func)
         (let ((s (%psym (cadr p))))
           (push s lambda-list)
           (%pc-define renv (cadr p) (list :routine (make-prinfo :name (cadr p) :kind (if (eq (car p) :proc) :procedure :function)
                                                                :params (caddr p) :result (cadddr p) :lisp-sym s
                                                                :directive :param :defined t))
                       rnode)))))
    (setq lambda-list (nreverse lambda-list))
    ;; labels
    (dolist (l (getf decls :labels)) (push (cons l (%psym (%string-concat "%L" l) (prinfo-name ri))) *pc-labels*))
    (%pc-declare-consts-and-types decls renv)
    ;; local variables
    (dolist (v (getf decls :vars))
      (%pc-collecting
        (let ((ty (%pc-var-type v renv)))
          (dolist (n (car (pnode-args v)))
            (let ((s (%psym n)))
              (%pc-define renv n (list :var :lexical s ty n) v)
              (push (list s (%pc-local-init ty *pc-zero*)) locals))))))
    (setq locals (nreverse locals))
    (when (eq (prinfo-kind ri) :function)
      (let ((rs (%psym (%string-concat "%" (prinfo-name ri) "-RESULT"))))
        (setf (prinfo-result-sym ri) rs)
        (push (list rs ''pascal-undefined) locals)))
    ;; nested routines
    (let ((nested (%pc-routines (getf decls :routines) renv t nil)))
      (let* ((stmts (%pc-statements (car (pnode-args body)) renv))
             (rs (prinfo-result-sym ri))
             (core `(let* ,locals
                      ,@(if nested `((labels ,nested (block %proutine ,@stmts))) `((block %proutine ,@stmts)))
                      ,@(when rs `((if (eq ,rs 'pascal-undefined)
                                       (%perror "The function ~A returned without assigning its result" ',(intern (string-downcase (prinfo-name ri)) *pc-package*))
                                       ,rs))))))
        (cons lambda-list
              (if *pascal-debug-info*
                  `((let ((*pascal-routine* ',(intern (string-downcase (prinfo-name ri)) *pc-package*)) (*pascal-line* *pascal-line*)) ,core))
                  (list core)))))))

(defun %pc-routines (rnodes env nested suffix &optional spec-env only)
  "Declare the routines RNODES in ENV, then compile them: for NESTED routines a list of LABELS definitions,
otherwise a list of DEFUN forms (only for ONLY, when it is given)."
  (let ((ris nil))
    (dolist (r rnodes)
      (%pc-collecting
        (let ((spec (and spec-env (let ((e (gethash (car (cdr (pnode-args r))) (penv-table spec-env)))) (and e (eq (car e) :routine) (cadr e))))))
          (push (cons r (%pc-make-routine r env suffix nested spec)) ris))))
    (setq ris (nreverse ris))
    (let ((out nil))
      (dolist (x ris)
        (let ((r (car x)) (ri (cdr x)))
          (when (and (eq (prinfo-node ri) r) (not (member (pnode-args-directive r) '(:forward :lisp)))
                     (or nested (null only) (eq r only)))
            (%pc-collecting
              (let ((def (%pc-routine-body ri env)))
                (push (if nested (cons (prinfo-lisp-sym ri) def) `(defun ,(prinfo-lisp-sym ri) ,@def)) out))))))
      ;; every FORWARD routine needs a body
      (dolist (x ris)
        (unless (prinfo-defined (cdr x))
          (%pc-collecting (%pc-error (car x) "The routine ~A was declared FORWARD but never defined" (string-downcase (prinfo-name (cdr x)))))))
      (nreverse out))))

(defun pnode-args-directive (r) (nth 4 (pnode-args r)))

;;; ---- compilation units ------------------------------------------------------------------------------------------

(defstruct (punit (:copier nil)) name package env uses source dialect file)

(defun %punit-key (name &optional (package *pc-package*)) (%string-concat (package-name package) ":" name))

(defun %pc-uses-env (uses node std)
  "An environment importing the specifications of the units USES (and theirs)."
  (let ((env (%make-penv std :units)))
    (dolist (u uses)
      (let ((unit (gethash (%punit-key u) *pascal-units*)))
        (unless unit (%pc-error node "The unit specification ~A has not been compiled" (string-downcase u)))
        (push (punit-env unit) (penv-imports env))))
    env))

(defun %pc-global-vars (decls env suffix)
  "Declare the variables of DECLS in ENV as special variables NAME<-SUFFIX: a list of (symbol desc name)."
  (let ((out nil))
    (dolist (v (getf decls :vars))
      (%pc-collecting
        (let ((ty (%pc-var-type v env)))
          (dolist (n (car (pnode-args v)))
            (let ((s (%psym n suffix)))
              (%pc-define env n (list :var :special s ty n) v)
              (push (list s (let ((d (%pt-desc ty))) (if (and (consp d) (eq (car d) :file)) (list :file (cadr d) (caddr d) (string-downcase n)) d)) n) out))))))
    (nreverse out)))

(defun %pc-program (node std only)
  (destructuring-bind (name params uses block) (pnode-args node)
    (declare (ignore params))
    (let* ((*pc-unit* name) (env (%make-penv (%pc-uses-env uses node std) :program))
           (decls (car (pnode-args block))) (body (cadr (pnode-args block))) (*pc-labels* nil) (*pc-routine* nil))
      (dolist (l (getf decls :labels)) (push (cons l (%psym (%string-concat "%L" l) name)) *pc-labels*))
      (%pc-declare-consts-and-types decls env)
      (let* ((globals (%pc-global-vars decls env name))
             (defvars (mapcar (lambda (g) `(defvar ,(car g) 'pascal-undefined)) globals))
             ;; the globals must be special before the routines are compiled
             (dummy (dolist (d defvars) (eval d)))
             (routines (%pc-routines (getf decls :routines) env nil name nil only)))
        (declare (ignore dummy))
        (if only
            (append defvars routines)
            (let ((main (%pc-statements (car (pnode-args body)) env)))
              (append defvars routines
                      `((%pascal-define-program
                         ,name ,(package-name *pc-package*)
                         (lambda ()
                           (block %pmain
                             ,@(if *pascal-debug-info*
                                   `((let ((*pascal-routine* ',(intern (string-downcase name) *pc-package*))) ,@main))
                                   main)))
                         ',(mapcar (lambda (g) (list (car g) (cadr g))) globals)
                         ',uses ',*pc-file* ,*pc-dialect*)))))))))

(defun %pc-unit-spec (node std)
  (destructuring-bind (name uses decls) (pnode-args node)
    (let* ((*pc-unit* name) (env (%make-penv (%pc-uses-env uses node std) :unit)))
      ;; the spec's own environment imports its used units, so users of the spec see them too
      (setf (penv-imports env) (penv-imports (penv-parent env)))
      (%pc-declare-consts-and-types decls env)
      (let ((globals (%pc-global-vars decls env name)))
        (dolist (r (getf decls :routines))
          (%pc-collecting
            (destructuring-bind (kind rname params result directive lisp-name body) (pnode-args r)
              (declare (ignore directive body))
              (let ((ri (make-prinfo :name rname :kind kind :params (%pc-params params env r) :result (and result (%pc-type result env))
                                     :lisp-sym (%psym rname name) :node nil :defined nil :unit name)))
                (when lisp-name nil)
                (%pc-define env rname (list :routine ri) r)))))
        (setf (gethash (%punit-key name) *pascal-units*)
              (make-punit :name name :package *pc-package* :env env :uses uses :source *pc-source* :dialect *pc-dialect* :file *pc-file*))
        (append (mapcar (lambda (g) `(defvar ,(car g) (%pmake ',(cadr g) nil))) globals)
                `((%pascal-note-unit-spec ,name ,(package-name *pc-package*) ',uses
                                          ,(subseq *pc-source* (pnode-start node) (pnode-end node)) ,*pc-dialect* ',*pc-file*)))))))

(defun %pc-unit-impl (node std only)
  (destructuring-bind (name uses decls) (pnode-args node)
    (let* ((*pc-unit* name) (unit (gethash (%punit-key name) *pascal-units*)))
      (unless unit (%pc-error node "Compile the unit specification ~A before its implementation" (string-downcase name)))
      (let* ((uenv (%pc-uses-env uses node std))
             (env (%make-penv uenv :unit-impl)) (*pc-labels* nil) (*pc-routine* nil))
        (push (punit-env unit) (penv-imports uenv))
        (%pc-declare-consts-and-types decls env)
        (let* ((globals (%pc-global-vars decls env name))
               (defvars (mapcar (lambda (g) `(defvar ,(car g) (%pmake ',(cadr g) nil))) globals))
               (dummy (dolist (d defvars) (eval d)))
               (spec-env (punit-env unit))
               (routines (%pc-routines (getf decls :routines) env nil name spec-env only)))
          (declare (ignore dummy))
          ;; the routines of the specification must all be defined
          (unless only
            (maphash (lambda (k e)
                       (when (and (eq (car e) :routine) (not (prinfo-defined (cadr e))) (eq (prinfo-unit (cadr e)) name)
                                  (not (gethash k (penv-table env))))
                         (%pc-collecting (%pc-error node "The routine ~A of unit ~A is not implemented" (string-downcase k) (string-downcase name)))))
                     (penv-table spec-env)))
          (append defvars routines `((%pascal-note-unit-impl ,name ,(package-name *pc-package*)))))))))

;;; ---- the entry point -------------------------------------------------------------------------------------------

(defun pascal-translate (source &key (dialect *pascal-default-dialect*) (package "PASCAL-USER") file (directory "") only-at)
  "Translate the Pascal SOURCE into Lisp: (values forms errors units).  FORMS are top-level Lisp forms to be
evaluated or compiled in order; ERRORS are PASCAL-SYNTAX-ERROR conditions (if there are any, FORMS is NIL);
UNITS are the parsed compilation units.  With ONLY-AT (an offset), only the compilation unit containing that
offset is translated, and if the offset is inside a top-level routine of a program or unit implementation, only
that routine (incremental compilation)."
  (multiple-value-bind (units errors) (pascal-parse source :dialect dialect :file file :directory directory)
    (let* ((*pc-package* (pascal-ensure-package package)) (*pc-dialect* dialect) (*pc-errors* nil) (*pc-source* source)
           (*pc-line-starts* (%pc-compute-line-starts source)) (*pc-temp* 0) (*pc-file* file) (*pc-zero* *pascal-init-to-zero*)
           (*pc-pending-pointers* nil)
           (std (%pc-standard-env dialect)) (forms nil)
           (selected (if only-at
                         (remove-if-not (lambda (u) (and (<= (pnode-start u) only-at) (<= only-at (pnode-end u)))) units)
                         units)))
      (when errors (return-from pascal-translate (values nil errors units)))
      (dolist (u selected)
        (%pc-collecting
          (let ((only (and only-at (%pc-routine-at u only-at))))
            (setq forms (append forms
                                (case (pnode-kind u)
                                  (:program (%pc-program u std only))
                                  (:unit-spec (%pc-unit-spec u std))
                                  (:unit-impl (%pc-unit-impl u std only))))))))
      (let ((errs (sort (copy-list *pc-errors*) #'< :key (lambda (c) (or (pascal-error-start c) 0)))))
        (values (if errs nil forms) errs selected)))))

(defun %pc-routine-at (unit offset)
  "The top-level routine node of UNIT (a program or unit implementation) containing OFFSET, or NIL."
  (let ((decls (case (pnode-kind unit)
                 (:program (car (pnode-args (cadddr (pnode-args unit)))))
                 (:unit-impl (caddr (pnode-args unit)))
                 (t nil))))
    (dolist (r (getf decls :routines) nil)
      (when (and (<= (pnode-start r) offset) (<= offset (pnode-end r)) (not (member (pnode-args-directive r) '(:forward :lisp))))
        (return r)))))

(defun pascal-ensure-package (name)
  "The package NAME, created (using no other package) if it does not exist."
  (if (packagep name) name
      (or (find-package (string-upcase (string name))) (%make-package (string-upcase (string name)) nil nil))))

(defun package-declare-with-no-superiors (name &rest options)
  "Declare the package NAME for Pascal code: a package that inherits nothing from Lisp packages, so Pascal names
cannot clash with Lisp ones.  OPTIONS (:NICKNAMES ...) are accepted for compatibility."
  (let ((nicks (cdr (assoc :nicknames (remove-if-not #'consp options)))))
    (or (find-package (string-upcase (string name)))
        (%make-package (string-upcase (string name)) (mapcar (lambda (n) (string-upcase (string n))) nicks) nil))))
