;;;; 10-parser.lisp -- the Pascal Tool Kit: a recursive-descent parser.
;;;;
;;;; The parser turns tokens into a tree of lists, (KIND START END . ARGS), where START and END are the byte
;;;; offsets of the construct in the source (the editor's language units).  A source text is a sequence of
;;;; compilation units -- main programs, unit specifications and unit implementations -- each ending with ".".
;;;; Syntax errors are collected rather than fatal: after an error the parser skips to the next ";" or END and
;;;; goes on, so the editor can step through every error in a buffer.

(in-package :cl)

(defstruct (pparser (:conc-name pp-) (:constructor %make-pparser) (:copier nil))
  toks (pos 0) (errors nil) source dialect file)

(defvar *pp* nil "The parser in use.")

(defun %pp-cur () (svref (pp-toks *pp*) (pp-pos *pp*)))
(defun %pp-ahead (k) (let ((v (pp-toks *pp*))) (svref v (min (+ (pp-pos *pp*) k) (- (length v) 1)))))
(defun %pp-prev-end ()
  (let ((p (pp-pos *pp*))) (if (> p 0) (tok-end (svref (pp-toks *pp*) (- p 1))) 0)))
(defun %pp-advance () (let ((tk (%pp-cur))) (unless (eq (tok-kind tk) :eof) (setf (pp-pos *pp*) (+ 1 (pp-pos *pp*)))) tk))

(defun %pp-is (kind &optional value)
  (let ((tk (%pp-cur))) (and (eq (tok-kind tk) kind) (or (null value) (eq (tok-value tk) value)))))
(defun %pp-kw (word) (%pp-is :kw word))
(defun %pp-sym (s) (%pp-is :sym s))

(defun %pp-describe (tk)
  (case (tok-kind tk)
    (:eof "end of text")
    (:kw (string-downcase (symbol-name (tok-value tk))))
    (:id (format nil "identifier ~A" (tok-text tk)))
    (:template (format nil "template item ~A" (tok-text tk)))
    (t (format nil "~S" (tok-text tk)))))

(defun %pp-error-at (tk fmt &rest args)
  (error 'pascal-syntax-error :message (apply #'format nil fmt args) :start (tok-start tk) :end (max (tok-end tk) (+ 1 (tok-start tk)))
                              :line (tok-line tk) :col (tok-col tk) :file (tok-file tk)))
(defun %pp-error (fmt &rest args) (apply #'%pp-error-at (%pp-cur) fmt args))

(defparameter *pp-sym-names*
  '((:assign . ":=") (:colon . ":") (:semi . ";") (:comma . ",") (:dot . ".") (:dotdot . "..") (:lparen . "(")
    (:rparen . ")") (:lbrack . "[") (:rbrack . "]") (:caret . "^") (:eq . "=")))

(defun %pp-expect-sym (s)
  (if (%pp-sym s) (%pp-advance)
      (%pp-error "~S expected, not ~A" (or (cdr (assoc s *pp-sym-names*)) s) (%pp-describe (%pp-cur)))))
(defun %pp-expect-kw (w)
  (if (%pp-kw w) (%pp-advance)
      (%pp-error "~A expected, not ~A" (string-downcase (symbol-name w)) (%pp-describe (%pp-cur)))))
(defun %pp-ident ()
  (if (%pp-is :id) (tok-value (%pp-advance)) (%pp-error "Identifier expected, not ~A" (%pp-describe (%pp-cur)))))
(defun %pp-ident-list ()
  (let ((ids (list (%pp-ident))))
    (loop (unless (%pp-sym :comma) (return)) (%pp-advance) (push (%pp-ident) ids))
    (nreverse ids)))

(defun %pp-node (kind start &rest args) (list* kind start (%pp-prev-end) args))
(defun pnode-kind (n) (car n))
(defun pnode-start (n) (cadr n))
(defun pnode-end (n) (caddr n))
(defun pnode-args (n) (cdddr n))

(defun %pp-note-error (c)
  (setf (pp-errors *pp*) (cons c (pp-errors *pp*)))
  (when (> (length (pp-errors *pp*)) 100) (error c)))

(defun %pp-skip-to (stops)
  "Skip tokens up to one whose value is in STOPS (keywords or :SEMI), not consuming it."
  (let ((depth 0))
    (loop
      (let ((tk (%pp-cur)))
        (when (eq (tok-kind tk) :eof) (return))
        (when (and (= depth 0) (member (tok-value tk) stops) (member (tok-kind tk) '(:kw :sym))) (return))
        (cond ((and (eq (tok-kind tk) :kw) (member (tok-value tk) '(:begin :case :record :repeat))) (setq depth (+ depth 1)))
              ((and (eq (tok-kind tk) :kw) (member (tok-value tk) '(:end :until)) (> depth 0)) (setq depth (- depth 1))))
        (%pp-advance)))))

(defmacro %pp-recovering ((&rest stops) &body body)
  "Run BODY; after a syntax error, note it and skip to one of STOPS (then past a ;)."
  `(handler-case (progn ,@body)
     (pascal-syntax-error (c)
       (%pp-note-error c)
       (%pp-skip-to ',(cons :semi stops))
       (when (%pp-sym :semi) (%pp-advance)))))

;;; ---- compilation units ---------------------------------------------------------------------------------

(defun pascal-parse (source &key (dialect *pascal-default-dialect*) file (directory ""))
  "Parse the Pascal SOURCE: (values units errors), UNITS a list of :PROGRAM, :UNIT-SPEC and :UNIT-IMPL nodes and
ERRORS a list of PASCAL-SYNTAX-ERROR conditions in source order."
  (let ((toks (handler-case (pascal-tokenize source :dialect dialect :file file :directory directory)
                (pascal-syntax-error (c) (return-from pascal-parse (values nil (list c)))))))
    (let ((*pp* (%make-pparser :toks (coerce toks 'vector) :source source :dialect dialect :file file)) (units nil))
      (loop
        (when (%pp-is :eof) (return))
        (let ((before (pp-pos *pp*)))
          (handler-case (push (%pp-compilation-unit) units)
            (pascal-syntax-error (c)
              (%pp-note-error c)
              ;; resynchronise at the next compilation unit
              (loop (when (or (%pp-is :eof) (%pp-kw :program) (%pp-kw :unit_specification) (%pp-kw :unit_implementation)) (return))
                    (%pp-advance))))
          (when (= before (pp-pos *pp*)) (%pp-advance))))
      (values (nreverse units) (sort (copy-list (pp-errors *pp*)) #'< :key (lambda (c) (or (pascal-error-start c) 0)))))))

(defun %pp-compilation-unit ()
  (let ((start (tok-start (%pp-cur))))
    (cond ((%pp-kw :program) (%pp-advance) (%pp-program start))
          ((%pp-kw :unit_specification) (%pp-advance) (%pp-unit-spec start))
          ((%pp-kw :unit_implementation) (%pp-advance) (%pp-unit-impl start))
          (t (%pp-error "PROGRAM, UNIT_SPECIFICATION or UNIT_IMPLEMENTATION expected, not ~A" (%pp-describe (%pp-cur)))))))

(defun %pp-using ()
  (if (%pp-kw :using_units)
      (progn (%pp-advance) (prog1 (%pp-ident-list) (%pp-expect-sym :semi)))
      nil))

(defun %pp-final-dot ()
  (if (%pp-sym :dot) (%pp-advance) (%pp-error "\".\" expected at the end, not ~A" (%pp-describe (%pp-cur)))))

(defun %pp-program (start)
  (let ((name (%pp-ident)) (params nil))
    (when (%pp-sym :lparen) (%pp-advance) (setq params (%pp-ident-list)) (%pp-expect-sym :rparen))
    (%pp-expect-sym :semi)
    (let* ((uses (%pp-using)) (block (%pp-block)))
      (%pp-final-dot)
      (%pp-node :program start name params uses block))))

(defun %pp-unit-spec (start)
  (let ((name (%pp-ident)))
    (%pp-expect-sym :semi)
    (let ((uses (%pp-using)) (decls (%pp-declarations t)))
      (%pp-expect-kw :end) (%pp-final-dot)
      (%pp-node :unit-spec start name uses decls))))

(defun %pp-unit-impl (start)
  (let ((name (%pp-ident)))
    (%pp-expect-sym :semi)
    (let ((uses (%pp-using)) (decls (%pp-declarations nil)))
      (%pp-expect-kw :end) (%pp-final-dot)
      (%pp-node :unit-impl start name uses decls))))

;;; ---- blocks and declarations ---------------------------------------------------------------------------------

;;; A declaration part is a plist: (:labels L :consts C :types T :vars V :routines R), each a list in order.
(defun %pp-declarations (headers-only)
  (let ((labels nil) (consts nil) (types nil) (vars nil) (routines nil))
    (loop
      (let ((tk (%pp-cur)))
        (cond
          ((%pp-kw :label) (%pp-advance)
           (loop (let ((l (%pp-cur)))
                   (unless (member (tok-kind l) '(:int :id)) (%pp-error "Label expected, not ~A" (%pp-describe l)))
                   (%pp-advance) (push (%pp-label-name l) labels))
                 (if (%pp-sym :comma) (%pp-advance) (return)))
           (%pp-expect-sym :semi))
          ((%pp-kw :const) (%pp-advance)
           (loop (unless (%pp-is :id) (return))
                 (%pp-recovering (:semi)
                   (let ((s (tok-start (%pp-cur))) (name (%pp-ident)))
                     (%pp-expect-sym :eq)
                     (let ((e (%pp-expression))) (push (%pp-node :const s name e) consts)))
                   (%pp-expect-sym :semi))))
          ((%pp-kw :type) (%pp-advance)
           (loop (unless (%pp-is :id) (return))
                 (%pp-recovering (:semi)
                   (let ((s (tok-start (%pp-cur))) (name (%pp-ident)))
                     (%pp-expect-sym :eq)
                     (let ((ty (%pp-type))) (push (%pp-node :type s name ty) types)))
                   (%pp-expect-sym :semi))))
          ((%pp-kw :var) (%pp-advance)
           (loop (unless (%pp-is :id) (return))
                 (%pp-recovering (:semi)
                   (let ((s (tok-start (%pp-cur))) (names (%pp-ident-list)))
                     (%pp-expect-sym :colon)
                     (let ((ty (%pp-type))) (push (%pp-node :var s names ty) vars)))
                   (%pp-expect-sym :semi))))
          ((or (%pp-kw :procedure) (%pp-kw :function))
           (push (%pp-routine headers-only) routines))
          ((eq (tok-kind tk) :template) (%pp-advance) (when (%pp-sym :semi) (%pp-advance)))
          (t (return)))))
    (list :labels (nreverse labels) :consts (nreverse consts) :types (nreverse types) :vars (nreverse vars)
          :routines (nreverse routines))))

(defun %pp-label-name (tk) (if (eq (tok-kind tk) :int) (format nil "~D" (tok-value tk)) (tok-value tk)))

(defun %pp-block ()
  (let* ((start (tok-start (%pp-cur))) (decls (%pp-declarations nil)))
    (unless (%pp-kw :begin) (%pp-error "BEGIN expected, not ~A" (%pp-describe (%pp-cur))))
    (let ((body (%pp-compound)))
      (%pp-node :block start decls body))))

(defun %pp-routine (headers-only)
  "procedure/function heading ; then a block, FORWARD, or LISP ['name'] ;"
  (let* ((start (tok-start (%pp-cur))) (kind (if (%pp-kw :function) :function :procedure)))
    (%pp-advance)
    (let ((name (%pp-ident)) (params :none) (result nil) (body nil) (directive nil) (lisp-name nil))
      (when (%pp-sym :lparen) (setq params (%pp-formal-params)))
      (when (and (eq kind :function) (%pp-sym :colon)) (%pp-advance) (setq result (%pp-type)))
      (%pp-expect-sym :semi)
      (cond (headers-only nil)
            ((and (%pp-is :id) (string= (tok-value (%pp-cur)) "FORWARD")) (%pp-advance) (setq directive :forward))
            ((and (%pp-is :id) (member (tok-value (%pp-cur)) '("EXTERNAL" "EXTERN" "FORTRAN" "MAIN" "REENTRANT") :test #'string=))
             (%pp-error "The ~A directive is not implemented" (string-downcase (tok-value (%pp-cur)))))
            ((and (%pp-is :id) (string= (tok-value (%pp-cur)) "LISP"))
             (%pp-advance) (setq directive :lisp)
             (when (%pp-is :str) (setq lisp-name (tok-value (%pp-advance)))))
            (t (setq body (%pp-block))))
      (unless headers-only (%pp-expect-sym :semi))
      (when (and headers-only (%pp-sym :semi)) (%pp-advance))
      (%pp-node :routine start kind name params result directive lisp-name body))))

(defun %pp-formal-params ()
  "( section {; section} ) -> list of (:value names type) (:var names type) (:proc name params) (:func name params type)"
  (%pp-expect-sym :lparen)
  (let ((sections nil))
    (loop
      (cond ((%pp-kw :var) (%pp-advance)
             (let ((names (%pp-ident-list))) (%pp-expect-sym :colon) (push (list :var names (%pp-param-type)) sections)))
            ((%pp-kw :procedure) (%pp-advance)
             (let ((name (%pp-ident))) (push (list :proc name (if (%pp-sym :lparen) (%pp-formal-params) nil)) sections)))
            ((%pp-kw :function) (%pp-advance)
             (let* ((name (%pp-ident)) (ps (if (%pp-sym :lparen) (%pp-formal-params) nil)))
               (%pp-expect-sym :colon)
               (push (list :func name ps (%pp-type)) sections)))
            (t (let ((names (%pp-ident-list))) (%pp-expect-sym :colon) (push (list :value names (%pp-param-type)) sections))))
      (if (%pp-sym :semi) (%pp-advance) (return)))
    (%pp-expect-sym :rparen)
    (nreverse sections)))

(defun %pp-param-type ()
  "A parameter type: a type, or a conformant array schema  [packed] array [lo..hi : type {; ...}] of type."
  (let ((start (tok-start (%pp-cur))) (packed nil))
    (when (and (%pp-kw :packed) (eq (tok-value (%pp-ahead 1)) :array)) (%pp-advance) (setq packed t))
    (if (and (%pp-kw :array) (eq (tok-kind (%pp-ahead 1)) :sym) (eq (tok-value (%pp-ahead 1)) :lbrack)
             (eq (tok-kind (%pp-ahead 2)) :id) (eq (tok-kind (%pp-ahead 3)) :sym) (eq (tok-value (%pp-ahead 3)) :dotdot)
             (eq (tok-kind (%pp-ahead 4)) :id) (eq (tok-kind (%pp-ahead 5)) :sym) (eq (tok-value (%pp-ahead 5)) :colon))
        (progn
          (%pp-advance) (%pp-advance)
          (let ((bounds nil))
            (loop (let ((lo (%pp-ident))) (%pp-expect-sym :dotdot)
                    (let ((hi (%pp-ident))) (%pp-expect-sym :colon) (push (list lo hi (%pp-type)) bounds)))
                  (if (%pp-sym :semi) (%pp-advance) (return)))
            (%pp-expect-sym :rbrack) (%pp-expect-kw :of)
            (%pp-node :conformant start (nreverse bounds) (%pp-param-type) packed)))
        (if packed (%pp-node :packed start (%pp-type)) (%pp-type)))))

;;; ---- types --------------------------------------------------------------------------------------------------

(defun %pp-type ()
  (let ((start (tok-start (%pp-cur))))
    (cond
      ((%pp-sym :caret) (%pp-advance) (%pp-node :pointer start (%pp-ident)))
      ((%pp-kw :packed) (%pp-advance) (%pp-node :packed start (%pp-type)))
      ((%pp-kw :array) (%pp-advance) (%pp-expect-sym :lbrack)
       (let ((indexes (list (%pp-type))))
         (loop (unless (%pp-sym :comma) (return)) (%pp-advance) (push (%pp-type) indexes))
         (%pp-expect-sym :rbrack) (%pp-expect-kw :of)
         (%pp-node :array start (nreverse indexes) (%pp-type))))
      ((%pp-kw :record) (%pp-advance)
       (multiple-value-bind (fields variant) (%pp-field-list)
         (%pp-expect-kw :end)
         (%pp-node :record start fields variant)))
      ((%pp-kw :set) (%pp-advance) (%pp-expect-kw :of) (%pp-node :set start (%pp-type)))
      ((%pp-kw :file) (%pp-advance)
       (if (%pp-kw :of) (progn (%pp-advance) (%pp-node :file start (%pp-type))) (%pp-node :file start nil)))
      ((%pp-sym :lparen) (%pp-advance)
       (let ((ids (%pp-ident-list))) (%pp-expect-sym :rparen) (%pp-node :enum start ids)))
      ((and (%pp-is :id) (string= (tok-value (%pp-cur)) "STRING") (member (tok-value (%pp-ahead 1)) '(:lparen :lbrack))
            (eq (tok-kind (%pp-ahead 1)) :sym))
       (%pp-advance)
       (let ((close (if (%pp-sym :lparen) :rparen :rbrack)))
         (%pp-advance)
         (let ((len (%pp-expression))) (%pp-expect-sym close) (%pp-node :string start len))))
      ((eq (tok-kind (%pp-cur)) :template) (%pp-advance) (%pp-node :template start))
      (t
       ;; a type identifier, or a subrange lo..hi
       (let ((lo (%pp-simple-expression)))
         (cond ((%pp-sym :dotdot) (%pp-advance) (%pp-node :subrange start lo (%pp-simple-expression)))
               ((eq (car lo) :id) (%pp-node :named start (car (pnode-args lo))))
               (t (%pp-error-at (%pp-cur) "Type expected"))))))))

(defun %pp-field-list ()
  "Fixed fields then an optional variant part: (values fields variant).
FIELDS is a list of (:field s e names type); VARIANT is (:variant s e tag-name tag-type cases otherwise-fields)."
  (let ((fields nil) (variant nil))
    (loop
      (cond ((%pp-is :id)
             (let ((s (tok-start (%pp-cur))) (names (%pp-ident-list)))
               (%pp-expect-sym :colon)
               (push (%pp-node :field s names (%pp-type)) fields))
             (if (%pp-sym :semi) (%pp-advance) (return)))
            (t (return))))
    (when (%pp-kw :case)
      (let ((s (tok-start (%pp-cur))) (tag nil) (tag-type nil) (cases nil) (other nil))
        (%pp-advance)
        (let ((id (%pp-ident)))
          (if (%pp-sym :colon) (progn (%pp-advance) (setq tag id tag-type (%pp-ident))) (setq tag-type id)))
        (%pp-expect-kw :of)
        (loop
          (cond ((or (%pp-kw :end) (%pp-sym :rparen)) (return))
                ((%pp-kw :otherwise) (%pp-advance) (%pp-expect-sym :lparen)
                 (multiple-value-bind (f v) (%pp-field-list) (setq other (list f v)))
                 (%pp-expect-sym :rparen)
                 (when (%pp-sym :semi) (%pp-advance)))
                (t (let ((labels (%pp-case-labels)))
                     (%pp-expect-sym :colon) (%pp-expect-sym :lparen)
                     (multiple-value-bind (f v) (%pp-field-list)
                       (push (list labels f v) cases))
                     (%pp-expect-sym :rparen)
                     (if (%pp-sym :semi) (%pp-advance) (return))))))
        (setq variant (%pp-node :variant s tag tag-type (nreverse cases) other))))
    (values (nreverse fields) variant)))

(defun %pp-case-labels ()
  (let ((labels nil))
    (loop
      (let* ((s (tok-start (%pp-cur))) (e (%pp-expression)))
        (if (%pp-sym :dotdot)
            (progn (%pp-advance) (push (%pp-node :range s e (%pp-expression)) labels))
            (push e labels)))
      (if (%pp-sym :comma) (%pp-advance) (return)))
    (nreverse labels)))

;;; ---- statements ----------------------------------------------------------------------------------------------

(defun %pp-compound ()
  (let ((start (tok-start (%pp-cur))))
    (%pp-expect-kw :begin)
    (let ((stmts (%pp-statement-sequence '(:end))))
      (%pp-expect-kw :end)
      (%pp-node :compound start stmts))))

(defun %pp-statement-sequence (terminators)
  "Statements separated by ';' up to one of the TERMINATORS (keywords), with error recovery."
  (let ((stmts nil))
    (loop
      (handler-case
          (progn
            (push (%pp-statement) stmts)
            (cond ((%pp-sym :semi) (%pp-advance))
                  ((or (%pp-is :eof) (and (%pp-is :kw) (member (tok-value (%pp-cur)) terminators))) (return))
                  (t (%pp-error "\";\" or ~A expected, not ~A" (string-downcase (symbol-name (car terminators))) (%pp-describe (%pp-cur))))))
        (pascal-syntax-error (c)
          (%pp-note-error c)
          (%pp-skip-to (cons :semi terminators))
          (if (%pp-sym :semi) (%pp-advance) (return))))
      (when (or (%pp-is :eof) (and (%pp-is :kw) (member (tok-value (%pp-cur)) terminators))) (return)))
    (remove-if (lambda (s) (eq (car s) :empty)) (nreverse stmts))))

(defun %pp-statement ()
  (let ((start (tok-start (%pp-cur))))
    (if (and (member (tok-kind (%pp-cur)) '(:int)) (eq (tok-kind (%pp-ahead 1)) :sym) (eq (tok-value (%pp-ahead 1)) :colon))
        (let ((label (%pp-label-name (%pp-advance))))
          (%pp-advance)
          (%pp-node :labeled start label (%pp-statement)))
        (%pp-unlabeled-statement start))))

(defun %pp-unlabeled-statement (start)
  (let ((tk (%pp-cur)))
    (case (tok-kind tk)
      (:id
       (let ((target (%pp-designator)))
         (cond ((%pp-sym :assign) (%pp-advance) (%pp-node :assign start target (%pp-expression)))
               ((eq (car target) :id) (%pp-node :pcall start (car (pnode-args target)) nil))
               ((eq (car target) :call) (%pp-node :pcall start (car (pnode-args target)) (cadr (pnode-args target))))
               (t (%pp-error "\":=\" expected, not ~A" (%pp-describe (%pp-cur)))))))
      (:template (%pp-advance) (%pp-node :template start (tok-text tk)))
      (:kw
       (case (tok-value tk)
         (:begin (%pp-compound))
         (:if (%pp-advance)
          (let ((c (%pp-expression)))
            (%pp-expect-kw :then)
            (let ((then (%pp-statement)) (else nil))
              (when (%pp-kw :else) (%pp-advance) (setq else (%pp-statement)))
              (%pp-node :if start c then else))))
         (:while (%pp-advance)
          (let ((c (%pp-expression))) (%pp-expect-kw :do) (%pp-node :while start c (%pp-statement))))
         (:repeat (%pp-advance)
          (let ((body (%pp-statement-sequence '(:until))))
            (%pp-expect-kw :until)
            (%pp-node :repeat start body (%pp-expression))))
         (:for (%pp-advance)
          (let ((var (%pp-ident)))
            (%pp-expect-sym :assign)
            (let ((from (%pp-expression)) (dir (cond ((%pp-kw :to) :to) ((%pp-kw :downto) :downto)
                                                     (t (%pp-error "TO or DOWNTO expected, not ~A" (%pp-describe (%pp-cur)))))))
              (%pp-advance)
              (let ((to (%pp-expression)))
                (%pp-expect-kw :do)
                (%pp-node :for start var from dir to (%pp-statement))))))
         (:case (%pp-advance)
          (let ((sel (%pp-expression)) (arms nil) (other nil))
            (%pp-expect-kw :of)
            (loop
              (cond ((%pp-kw :end) (return))
                    ((or (%pp-kw :otherwise) (%pp-kw :else))
                     (%pp-advance) (when (%pp-sym :colon) (%pp-advance))
                     (setq other (%pp-statement-sequence '(:end)))
                     (return))
                    (t (let ((labels (%pp-case-labels)))
                         (%pp-expect-sym :colon)
                         (push (list labels (%pp-statement)) arms))
                       (cond ((%pp-sym :semi) (%pp-advance))
                             ((or (%pp-kw :otherwise) (%pp-kw :else)) nil)
                             (t (return))))))
            (%pp-expect-kw :end)
            (%pp-node :case start sel (nreverse arms) other)))
         (:with (%pp-advance)
          (let ((recs (list (%pp-designator))))
            (loop (unless (%pp-sym :comma) (return)) (%pp-advance) (push (%pp-designator) recs))
            (%pp-expect-kw :do)
            (%pp-node :with start (nreverse recs) (%pp-statement))))
         (:goto (%pp-advance)
          (let ((l (%pp-cur)))
            (unless (member (tok-kind l) '(:int :id)) (%pp-error "Label expected, not ~A" (%pp-describe l)))
            (%pp-advance)
            (%pp-node :goto start (%pp-label-name l))))
         (:leave (%pp-advance) (%pp-node :leave start))
         (:continue (%pp-advance) (%pp-node :continue start))
         (:return (%pp-advance) (%pp-node :return start))
         ((:end :until :else :otherwise) (%pp-node :empty start))
         (t (%pp-error "Statement expected, not ~A" (%pp-describe tk)))))
      (:sym (if (eq (tok-value tk) :semi) (%pp-node :empty start) (%pp-error "Statement expected, not ~A" (%pp-describe tk))))
      (:eof (%pp-node :empty start))
      (t (%pp-error "Statement expected, not ~A" (%pp-describe tk))))))

;;; ---- expressions ----------------------------------------------------------------------------------------------

(defun %pp-designator ()
  "identifier, then any of [i,j]  .field  ^  (args)"
  (let* ((start (tok-start (%pp-cur))) (name (%pp-ident)) (d (%pp-node :id start name)))
    (when (%pp-sym :lparen)
      (setq d (%pp-node :call start name (%pp-actual-params))))
    (loop
      (cond ((%pp-sym :lbrack) (%pp-advance)
             (let ((idx (list (%pp-expression))))
               (loop (unless (%pp-sym :comma) (return)) (%pp-advance) (push (%pp-expression) idx))
               (%pp-expect-sym :rbrack)
               (setq d (%pp-node :index start d (nreverse idx)))))
            ((%pp-sym :dot)
             ;; a "." followed by an identifier selects a field; otherwise it ends the program
             (if (eq (tok-kind (%pp-ahead 1)) :id)
                 (progn (%pp-advance) (setq d (%pp-node :field start d (%pp-ident))))
                 (return)))
            ((%pp-sym :caret) (%pp-advance) (setq d (%pp-node :deref start d)))
            (t (return))))
    d))

(defun %pp-actual-params ()
  "( arg {, arg} ); an argument may carry write-format widths  e:w:d."
  (%pp-expect-sym :lparen)
  (let ((args nil))
    (unless (%pp-sym :rparen)
      (loop
        (let* ((s (tok-start (%pp-cur))) (e (%pp-expression)))
          (if (%pp-sym :colon)
              (let ((w (progn (%pp-advance) (%pp-expression))) (d nil))
                (when (%pp-sym :colon) (%pp-advance) (setq d (%pp-expression)))
                (push (%pp-node :fmt s e w d) args))
              (push e args)))
        (if (%pp-sym :comma) (%pp-advance) (return))))
    (%pp-expect-sym :rparen)
    (nreverse args)))

(defparameter *pp-relops* '((:eq . =) (:ne . <>) (:lt . <) (:le . <=) (:gt . >) (:ge . >=)))

(defun %pp-expression ()
  (let* ((start (tok-start (%pp-cur))) (l (%pp-simple-expression)))
    (cond ((and (%pp-is :sym) (assoc (tok-value (%pp-cur)) *pp-relops*))
           (let ((op (cdr (assoc (tok-value (%pp-advance)) *pp-relops*))))
             (%pp-node :binop start op l (%pp-simple-expression))))
          ((%pp-kw :in) (%pp-advance) (%pp-node :binop start 'in l (%pp-simple-expression)))
          (t l))))

(defun %pp-simple-expression ()
  (let* ((start (tok-start (%pp-cur)))
         (sign (cond ((%pp-sym :plus) (%pp-advance) '+) ((%pp-sym :minus) (%pp-advance) '-) (t nil)))
         (l (%pp-term)))
    (when (eq sign '-) (setq l (%pp-node :unop start '- l)))
    (loop
      (let ((op (cond ((%pp-sym :plus) '+) ((%pp-sym :minus) '-) ((%pp-kw :or) 'or) ((%pp-sym :or) 'or)
                      ((%pp-kw :xor) 'xor) ((%pp-sym :concat) 'concat) (t nil))))
        (unless op (return))
        (%pp-advance)
        (setq l (%pp-node :binop start op l (%pp-term)))))
    l))

(defun %pp-term ()
  (let* ((start (tok-start (%pp-cur))) (l (%pp-factor)))
    (loop
      (let ((op (cond ((%pp-sym :star) '*) ((%pp-sym :slash) '/) ((%pp-kw :div) 'div) ((%pp-kw :mod) 'mod)
                      ((%pp-kw :and) 'and) ((%pp-sym :and) 'and) (t nil))))
        (unless op (return))
        (%pp-advance)
        (setq l (%pp-node :binop start op l (%pp-factor)))))
    l))

(defun %pp-factor ()
  (let* ((tk (%pp-cur)) (start (tok-start tk)))
    (case (tok-kind tk)
      (:int (%pp-advance) (%pp-node :int start (tok-value tk)))
      (:real (%pp-advance) (%pp-node :real start (tok-value tk)))
      (:str (%pp-advance) (%pp-node :str start (tok-value tk)))
      (:id (%pp-designator))
      (:template (%pp-advance) (%pp-node :template start (tok-text tk)))
      (:kw (case (tok-value tk)
             (:nil (%pp-advance) (%pp-node :nil start))
             (:not (%pp-advance) (%pp-node :unop start 'not (%pp-factor)))
             (t (%pp-error "Expression expected, not ~A" (%pp-describe tk)))))
      (:sym (case (tok-value tk)
              (:lparen (%pp-advance) (let ((e (%pp-expression))) (%pp-expect-sym :rparen) (%pp-node :paren start e)))
              (:not (%pp-advance) (%pp-node :unop start 'not (%pp-factor)))
              (:lbrack (%pp-advance)
               (let ((elems nil))
                 (unless (%pp-sym :rbrack)
                   (loop (let* ((s (tok-start (%pp-cur))) (e (%pp-expression)))
                           (if (%pp-sym :dotdot) (progn (%pp-advance) (push (%pp-node :range s e (%pp-expression)) elems)) (push e elems)))
                         (if (%pp-sym :comma) (%pp-advance) (return))))
                 (%pp-expect-sym :rbrack)
                 (%pp-node :setcons start (nreverse elems))))
              (t (%pp-error "Expression expected, not ~A" (%pp-describe tk)))))
      (t (%pp-error "Expression expected, not ~A" (%pp-describe tk))))))
