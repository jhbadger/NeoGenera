;;;; 20-codegen.lisp -- pass 2: AST -> bytecode.
;;;;
;;;; Stack discipline: GEN leaves exactly one value on the VM stack (non-tail)
;;;; or emits RET/TAILCALL itself (tail).  Locals live in frame slots; a LET
;;;; pushes its init values and refers to them by slot number.  Variables that
;;;; are both captured by a closure and assigned are boxed in a cons cell.

(in-package :cl)

(defvar *cg-items* nil)
(defvar *cg-depth* 0)
(defvar *cg-consts* nil)
(defvar *cg-nspec* 0)
(defvar *cg-lam* nil)

(defun emit (op &rest args)
  (setq *cg-items* (cons (cons op args) *cg-items*))
  (setq *cg-depth* (+ *cg-depth* (op-delta op args))))
(defun emit-label (l) (setq *cg-items* (cons (list :label l) *cg-items*)))
(defun new-label () (list nil))
(defun finish (tail)
  ;; At a tail position every dynamic binding made in this lambda is still active (*CG-NSPEC*).
  (when tail
    (when (> *cg-nspec* 0) (emit :unbind *cg-nspec*))
    (emit :ret)))

(defun const-index (v)
  (let ((i 0))
    (dolist (c *cg-consts*)
      (when (eql c v) (return-from const-index i))
      (setq i (+ i 1)))
    (setq *cg-consts* (append *cg-consts* (list v)))
    i))

(defun var-boxed-p (v) (and (cvar-captured v) (cvar-mutated v)))

(defun free-index (var)
  (or (position var (clam-free *cg-lam*))
      (error "internal compiler error: free variable ~S not found" (cvar-name var))))

(defun gen-box-ref (var)
  (if (eq (cvar-lam var) *cg-lam*)
      (emit :lref (cvar-slot var))
      (emit :fref (free-index var))))

(defun gen-var-ref (var)
  (gen-box-ref var)
  (when (var-boxed-p var) (emit :unbox)))

(defun gen (node tail)
  (case (car node)
    (:const (emit :const (const-index (cadr node))) (finish tail))
    (:lref (gen-var-ref (cadr node)) (finish tail))
    (:gref (emit :gref (const-index (cadr node))) (finish tail))
    (:gfun (emit :gfun (const-index (cadr node))) (finish tail))
    (:lset (gen-lset node) (finish tail))
    (:gset (gen (caddr node) nil) (emit :dup) (emit :gset (const-index (cadr node))) (finish tail))
    (:if (gen-if node tail))
    (:progn (gen-progn (cdr node) tail))
    (:let (gen-let node tail))
    (:flet (gen-flet node tail))
    (:labels (gen-labels node tail))
    (:lambda (gen-closure (cadr node)) (finish tail))
    (:call (gen-call node tail))
    (:ncall (gen-call (list* :call (caddr node) (cdddr node)) tail t (cadr node)))
    (:rcall (gen-call (list* :call (cadddr node) (cddddr node)) tail t (caddr node))
            (unless tail (gen-check-ops (cadr node))))
    (:op (dolist (a (cddr node)) (gen a nil))
         (apply #'emit (cadr node))
         (finish tail))
    (:check (gen (caddr node) nil) (gen-check-ops (cadr node)) (finish tail))
    (:block (gen-block node tail))
    (:return-from (gen-return-from node tail))
    (:tagbody (gen-tagbody node tail))
    (:go (gen-go node))
    (t (error "gen: unknown node ~S" (car node)))))

(defun gen-lset (node)
  (let ((var (cadr node)) (val (caddr node)))
    (if (var-boxed-p var)
        (progn (gen-box-ref var) (gen val nil) (emit :boxset))
        (progn (gen val nil) (emit :dup) (emit :lset (cvar-slot var))))))

(defun gen-progn (nodes tail)
  (do-list-tails (n nodes)
    (if (cdr n)
        (progn (gen (car n) nil) (emit :pop))
        (gen (car n) tail))))

(defun gen-if (node tail)
  (let ((test (cadr node)) (then (caddr node)) (else (cadddr node))
        (l-else (new-label)) (l-end (new-label)))
    (gen test nil)
    (emit :jnil l-else)
    (let ((d *cg-depth*))
      (gen then tail)
      (unless tail (emit :jmp l-end))
      (setq *cg-depth* d)
      (emit-label l-else)
      (gen else tail)
      (unless tail (emit-label l-end)))))

(defun gen-bind-slots (bindings base)
  ;; assign slots, box captured+assigned variables, perform dynamic bindings;
  ;; returns the number of dynamic bindings made
  (let ((k 0) (nspec 0))
    (dolist (b bindings)
      (when (cvar-p b)
        (setf (cvar-slot b) (+ base k))
        (when (var-boxed-p b)
          (emit :lref (+ base k)) (emit :box) (emit :lset (+ base k))))
      (setq k (+ k 1)))
    (setq k 0)
    (dolist (b bindings)
      (unless (cvar-p b)
        (emit :lref (+ base k))
        (emit :bind (const-index b))
        (setq nspec (+ nspec 1))
        (setq *cg-nspec* (+ *cg-nspec* 1)))
      (setq k (+ k 1)))
    nspec))

(defun last-emitted-call-p ()
  ;; True when the last value-producing instruction was a call (UNBIND/SLIDE do not disturb the
  ;; multiple values it left behind).
  (let ((items *cg-items*))
    (loop
      (cond ((null items) (return nil))
            ((member (car (car items)) '(:unbind :slide)) (setq items (cdr items)))
            (t (return (eq (car (car items)) :call)))))))

(defun gen-scope-exit (nvars nspec tail)
  ;; A tail-position scope that bound specials cannot use TAILCALL (the bindings must be undone
  ;; first).  If the body ended in a call, RETV keeps the multiple values that call left behind.
  (let ((after-call (and tail (last-emitted-call-p))))
    (when (> nspec 0)
      (emit :unbind nspec)
      (setq *cg-nspec* (- *cg-nspec* nspec)))
    (when (> nvars 0) (emit :slide nvars))
    (when tail (emit (if after-call :retv :ret)))))

(defun gen-let (node tail)
  (let ((bindings (cadr node)) (inits (caddr node)) (body (cadddr node))
        (base *cg-depth*))
    (dolist (i inits) (gen i nil))
    (let ((nspec (gen-bind-slots bindings base)) (nvars (length bindings)))
      (if tail
          (progn (gen body t) (setq *cg-nspec* (- *cg-nspec* nspec)))
          (progn (gen body nil) (gen-scope-exit nvars nspec nil))))))

(defun gen-flet (node tail)
  (let ((vars (cadr node)) (lams (caddr node)) (body (cadddr node)) (base *cg-depth*))
    (dolist (l lams) (gen-closure l))
    (gen-bind-slots vars base)
    (if tail
        (gen body t)
        (progn (gen body nil) (gen-scope-exit (length vars) 0 nil)))))

(defun gen-labels (node tail)
  (let ((vars (cadr node)) (lams (caddr node)) (body (cadddr node)) (base *cg-depth*))
    (dolist (v vars) (emit :const (const-index nil)))
    (gen-bind-slots vars base)
    (let ((ls lams))
      (dolist (v vars)
        (if (var-boxed-p v)
            (progn (gen-box-ref v) (gen-closure (car ls)) (emit :boxset) (emit :pop))
            (progn (gen-closure (car ls)) (emit :lset (cvar-slot v))))
        (setq ls (cdr ls))))
    (if tail
        (gen body t)
        (progn (gen body nil) (gen-scope-exit (length vars) 0 nil)))))

(defun gen-closure (lam)
  (let ((code (gen-lambda lam)))
    (dolist (v (clam-free lam)) (gen-box-ref v))
    (emit :closure (const-index code) (length (clam-free lam)))))

(defun inline-spec (name nargs)
  (let ((e (assq name *inline-ops*)))
    (and e (= (caddr e) nargs) e)))

(defun gen-check-ops (ty)
  "Emit the instruction that checks the value on top of the stack against the ty TY (it stays on the stack)."
  (cond ((ty-intp ty)
         (cond ((ty-full-fixnum-p ty) (emit :chkfix))
               ((and (ty-fixnum-p ty)) (emit :chkrange (const-index (cons (ty-lo ty) (ty-hi ty)))))
               (t (emit :chktype 1))))
        (t (emit :chktype (case ty (:flonum 2) (:real 3) (:number 4) (:cons 5) (:list 6) (:symbol 7) (:null 8)
                            (:string 9) (:svec 10) (:char 11)
                            (t (error "gen: no check for the type ~S" ty)))))))

(defun gen-call (node tail &optional plain notail)
  ;; PLAIN: a real call even to an open-coded function; NOTAIL: a call in tail position is not merged into a jump
  ;; (DEBUG 3), so the caller stays on the stack for the debugger.
  (let* ((fn (cadr node)) (args (cddr node)) (n (length args)))
    (cond (plain (gen-plain-call fn args n tail notail))
          ((and (eq (car fn) :gfun) (inline-spec (cadr fn) n))
           (dolist (a args) (gen a nil))
           (emit (cadr (inline-spec (cadr fn) n)))
           (finish tail))
          ((and (eq (car fn) :gfun) (memq (cadr fn) '(+ -)) (> n 2))
           ;; (+ a b c ...) => ((a + b) + c) ...
           (gen (car args) nil)
           (dolist (a (cdr args)) (gen a nil) (emit (if (eq (cadr fn) '+) :add :sub)))
           (finish tail))
          ((and (eq (car fn) :gfun) (memq (cadr fn) '(1+ 1-)) (= n 1))
           (gen (car args) nil)
           (emit :const (const-index 1))
           (emit (if (eq (cadr fn) '1+) :add :sub))
           (finish tail))
          (t (gen-plain-call fn args n tail notail)))))

(defun gen-plain-call (fn args n tail notail)
  (gen fn nil)
  (dolist (a args) (gen a nil))
  (cond ((not tail) (emit :call n))
        ((or notail (> *cg-nspec* 0))     ; cannot TAILCALL out of dynamic bindings: call, unbind, return all values
         (emit :call n)
         (when (> *cg-nspec* 0) (emit :unbind *cg-nspec*))
         (emit :retv))
        (t (emit :tailcall n))))

(defun gen-block (node tail)
  ;; A block in tail position is compiled in tail mode: a normal exit leaves via
  ;; RET/TAILCALL inside the body (keeping tail calls and multiple values), and
  ;; non-tail RETURN-FROMs jump to a join label that returns the value.
  (let ((blk (cadr node)) (body (caddr node)))
    (setf (cblock-depth blk) *cg-depth*)
    (setf (cblock-nspec blk) *cg-nspec*)
    (setf (cblock-label blk) (new-label))
    (setf (cblock-tailp blk) (and tail t))
    (gen body tail)
    (when tail (setq *cg-depth* (+ (cblock-depth blk) 1)))
    (emit-label (cblock-label blk))
    (finish tail)))

(defun gen-return-from (node tail)
  ;; Target block in tail position of its function: leave the function directly.  With no dynamic
  ;; binding made since the block was entered the value is compiled in TAIL mode (keeps tail calls and
  ;; multiple values); otherwise unbind first and use RETV/RET.  Other blocks: jump to the join label.
  (declare (ignore tail))
  (let ((blk (cadr node)) (d0 *cg-depth*))
    (cond ((and (cblock-tailp blk) (= *cg-nspec* (cblock-nspec blk)))
           (gen (caddr node) t)
           (setq *cg-depth* (+ d0 1)))
          ((cblock-tailp blk)
           (gen (caddr node) nil)
           (let ((after-call (last-emitted-call-p)))
             (when (> *cg-nspec* 0) (emit :unbind *cg-nspec*))
             (emit (if after-call :retv :ret)))
           (setq *cg-depth* (+ d0 1)))
          (t
           (gen (caddr node) nil)
           (when (> *cg-nspec* (cblock-nspec blk))
             (emit :unbind (- *cg-nspec* (cblock-nspec blk))))
           (let ((extra (- *cg-depth* 1 (cblock-depth blk))))
             (when (> extra 0) (emit :slide extra)))
           (emit :jmp (cblock-label blk))
           (setq *cg-depth* (+ d0 1))))))

(defun gen-tagbody (node tail)
  (let ((tb (cadr node)) (items (cddr node)))
    (setf (ctb-depth tb) *cg-depth*)
    (setf (ctb-nspec tb) *cg-nspec*)
    (dolist (it items)
      (when (ctag-p it) (setf (ctag-label it) (new-label))))
    (dolist (it items)
      (if (ctag-p it)
          (emit-label (ctag-label it))
          (progn (gen it nil) (emit :pop))))
    (emit :const (const-index nil))
    (finish tail)))

(defun gen-go (node)
  (let ((tb (cadr node)) (tag (caddr node)) (d0 *cg-depth*))
    (when (> *cg-nspec* (ctb-nspec tb))
      (emit :unbind (- *cg-nspec* (ctb-nspec tb))))
    (dotimes (i (- d0 (ctb-depth tb))) (emit :pop))
    (emit :jmp (ctag-label tag))
    (setq *cg-depth* (+ d0 1))))

;;; ---- lambda ----------------------------------------------------------------------------

(defun gen-lambda (lam)
  (let ((*cg-items* nil) (*cg-depth* 0) (*cg-consts* nil) (*cg-nspec* 0) (*cg-lam* lam))
    (let ((i 0))
      (dolist (p (clam-params lam))
        (setf (cvar-slot p) i)
        (setq i (+ i 1))))
    (setq *cg-depth* (length (clam-params lam)))
    (dolist (c (clam-checks lam))            ; declared parameter types are checked on entry (before any boxing)
      (emit :lref (cvar-slot (car c))) (gen-check-ops (cdr c)) (emit :pop))
    (dolist (p (clam-params lam))
      (when (var-boxed-p p)
        (emit :lref (cvar-slot p)) (emit :box) (emit :lset (cvar-slot p))))
    (gen (clam-body lam) t)
    (assemble-code (clam-name lam) lam (reverse *cg-items*) *cg-consts*)))

(defun assemble-code (name lam items consts)
  (let ((addr 0) (labels nil))
    ;; pass 1: label addresses
    (dolist (it items)
      (if (eq (car it) :label)
          (setq labels (cons (cons (cadr it) addr) labels))
          (setq addr (+ addr 1 (op-nargs (car it))))))
    ;; pass 2: emit words
    (let ((words nil))
      (dolist (it items)
        (unless (eq (car it) :label)
          (setq words (cons (op-code (car it)) words))
          (dolist (a (cdr it))
            (setq words (cons (if (and (consp a) (null (car a)))
                                  (cdr (assq a labels))
                                  a)
                              words)))))
      (%make-code (if (and (symbolp name) name (null (symbol-package name))) nil name)
                  (clam-nreq lam) (clam-nopt lam) (clam-rest lam)
                  (nreverse words) (%list-to-vector consts) (clam-arglist lam)))))
