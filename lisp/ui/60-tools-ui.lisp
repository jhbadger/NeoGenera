;;;; 60-tools-ui.lisp -- report windows, Inspector, browsers, cross-reference UI, tool commands.
;;;;
;;;; A REPORT-WINDOW is a read-only window whose contents are produced by a function that writes
;;;; to a presentation stream, so everything it prints is mouse-sensitive.  The Inspector,
;;;; the browsers and the cross-reference windows are report windows with different producers.

(in-package :cl)

(defclass report-window (listener-window)
  ((producer :initarg :producer :accessor rw-producer)
   (back :initform nil :accessor rw-back)
   (entries :initform nil :accessor rw-entries)
   (subject :initarg :subject :initform nil :accessor rw-subject))
  (:default-initargs :read-only t))

(defgeneric report-refreshed (window))
(defmethod report-refreshed ((w report-window)) nil)

(defun report-refresh (w)
  (ob-clear (lw-obuf w))
  (setf (rw-entries w) nil)
  (let ((*current-listener* w))
    (handler-case (funcall (rw-producer w) w (lw-stream w))
      (error (e) (format (lw-stream w) "Error: ~A~%" e))))
  (setf (lw-scroll-back w) 0)
  (report-refreshed w))

(defmethod initialize-instance :after ((w report-window) &rest args)
  (declare (ignore args))
  (report-refresh w))

(defun report-navigate (w producer subject &optional title)
  (setf (rw-back w) (cons (list (rw-producer w) (rw-subject w) (window-title w)) (rw-back w)))
  (setf (rw-producer w) producer (rw-subject w) subject)
  (when title (setf (window-title w) title))
  (report-refresh w))

(defun report-back (w)
  (let ((prev (car (rw-back w))))
    (when prev
      (setf (rw-back w) (cdr (rw-back w)) (rw-producer w) (car prev) (rw-subject w) (cadr prev) (window-title w) (caddr prev))
      (report-refresh w))))

(defmethod window-key ((w report-window) key)
  (let ((c (key-code key)) (m (key-mods key)))
    (cond ((and (eql c 113) (zerop m)) (wm-close-window (window-wm w) w) t)
          ((and (eql c 103) (zerop m)) (report-refresh w) t)
          ((or (eq c :backspace) (and (eql c 108) (zerop m))) (report-back w) t)
          ((eq c :up) (window-scroll-by w 1) t) ((eq c :down) (window-scroll-by w -1) t)
          ((eq c :pgup) (window-scroll-by w (max 1 (- (window-h w) 4))) t)
          ((eq c :pgdn) (window-scroll-by w (- (max 1 (- (window-h w) 4)))) t)
          (t nil))))

(defun open-report (wm title producer &key (class 'report-window) subject (w 74) (h 20))
  (let ((win (make-instance class :title title :producer producer :subject subject :x 3 :y 2 :w (min w (wm-cols wm)) :h (min h (wm-area-height wm)))))
    (wm-add-window wm win)
    win))

;;; ---- presentation types and commands for source-aware objects ---------------------------------------------

(define-presentation-type 'function-name '(symbol))
(defun %fname (sym) (let ((*package* (find-package "COMMON-LISP"))) (prin1-to-string sym)))

(defun present-symbol (sym out &optional (type 'symbol))
  (with-output-as-presentation (out sym type) (write-string (%fname sym) out)))

(defun report-symbols (w out title syms)
  (declare (ignore w))
  (with-style (out :bold) (format out "~A~%" title))
  (if (null syms)
      (format out "  (none)~%")
      (dolist (s syms)
        (write-string "  " out)
        (present-symbol s out)
        (let ((ll (and (symbolp s) (multiple-value-list (symbol-arglist s)))))
          (when (and ll (cadr ll)) (with-style (out :dim) (format out "  ~A" (or (arglist-string s) "")))))
        (terpri out))))

(defun %open-symbol-report (title syms)
  (when *wm* (open-report *wm* title (lambda (w out) (report-symbols w out title syms)))))

(define-presentation-command (edit-definition symbol :documentation "Edit definition") (sym)
  (cond ((and *wm* (edit-definition sym)) nil) ((definition-locations sym) (format t "~&Defined at ~S~%" (definition-locations sym)))
        (t (format t "~&No source recorded for ~S~%" sym))))
(define-presentation-command (who-calls symbol :documentation "Who calls") (sym)
  (%open-symbol-report (format nil "Callers of ~A" (%fname sym)) (who-calls sym)))
(define-presentation-command (who-references symbol :documentation "Who references") (sym)
  (%open-symbol-report (format nil "References to ~A" (%fname sym)) (who-references sym)))
(define-presentation-command (callees symbol :documentation "Callees") (sym)
  (%open-symbol-report (format nil "Functions called by ~A" (%fname sym)) (callees sym)))
(define-presentation-command (trace-function symbol :documentation "Trace") (sym) (trace-function sym) (format t "~&Tracing ~S~%" sym))
(define-presentation-command (untrace-function symbol :documentation "Untrace") (sym) (untrace-function sym) (format t "~&Untraced ~S~%" sym))
(define-presentation-command (inspect t :documentation "Inspect") (obj) (open-inspector *wm* obj))
(define-presentation-command (edit-frame-definition frame :documentation "Edit definition") (f)
  (let ((name (cadr f)))
    (if (and name *wm* (edit-definition name)) nil (format t "~&No source recorded for ~S~%" name))))
(define-presentation-command (edit-test test-failure :documentation "Edit test" :default t) (f)
  (let ((name (car f))) (if (and *wm* (edit-definition name)) nil (format t "~&No source recorded for ~S~%" name))))
(define-presentation-command (browse-class %class :documentation "Browse class" :default t) (c) (open-class-browser *wm* c))
(define-presentation-command (browse-package package :documentation "Browse package" :default t) (p) (open-package-browser *wm* p))
(define-presentation-command (describe-function-name function-name :documentation "Describe") (sym) (describe sym))

;;; ---- Inspector ------------------------------------------------------------------------------------------------

(defclass inspector-window (report-window) ())

(defun inspector-entries (obj)
  "List of (label value setter-or-nil) describing OBJ."
  (cond
    ((consp obj)
     (let ((acc nil) (i 0) (l obj))
       (loop (when (or (not (consp l)) (>= i 200)) (return))
             (let ((cell l) (idx i))
               (setq acc (cons (list (format nil "~D" idx) (car cell) (lambda (v) (rplaca cell v))) acc)))
             (setq l (cdr l)) (setq i (+ i 1)))
       (when (and l (not (consp l))) (let ((last (last obj))) (setq acc (cons (list "cdr (dotted tail)" l (lambda (v) (rplacd last v))) acc))))
       (nreverse acc)))
    ((and (vectorp obj) (not (stringp obj)))
     (let ((acc nil)) (dotimes (i (min 200 (length obj))) (let ((idx i)) (setq acc (cons (list (format nil "~D" idx) (aref obj idx) (lambda (v) (%aset obj idx v))) acc)))) (nreverse acc)))
    ((%hash-table-p obj)
     (mapcar (lambda (e) (let ((cell e)) (list (prin1-to-string (car e)) (cdr e) (lambda (v) (setf (gethash (car cell) obj) v))))) (subseq (%ht-pairs obj) 0 (min 200 (hash-table-count obj)))))
    ((and (symbolp obj) obj)
     (append (list (list "name" (symbol-name obj) nil) (list "package" (symbol-package obj) nil))
             (when (boundp obj) (list (list "value" (symbol-value obj) (lambda (v) (set obj v)))))
             (when (fboundp obj) (list (list "function" (symbol-function obj) nil)))
             (when (documentation obj 'function) (list (list "documentation" (documentation obj 'function) nil)))
             (when (documentation obj 'variable) (list (list "variable documentation" (documentation obj 'variable) nil)))
             (list (list "plist" (symbol-plist obj) (lambda (v) (%set-symbol-plist obj v))))))
    ((functionp obj)
     (let ((parts (and (compiled-function-p obj) (%code-parts obj))))
       (append (list (list "name" (%function-name obj) nil))
               (when parts (list (list "lambda list" (nth 6 parts) nil) (list "required args" (nth 1 parts) nil)))
               (when (and (%function-name obj) (symbolp (%function-name obj)) (definition-locations (%function-name obj)))
                 (list (list "defined" (definition-locations (%function-name obj)) nil))))))
    ((packagep obj)
     (let ((syms (%package-symbols obj t)))
       (list (list "name" (package-name obj) nil) (list "uses" (package-use-list obj) nil)
             (list "external symbols" (length syms) nil) (list "all symbols" (length (%package-symbols obj nil)) nil))))
    ((and (structp obj) (classp obj))
     (list (list "name" (%cls-name obj) nil) (list "superclasses" (%cls-supers obj) nil) (list "subclasses" (%cls-subclasses obj) nil)
           (list "precedence list" (%cls-cpl obj) nil) (list "slots" (mapcar #'slotd-name (%cls-slots obj)) nil)))
    ((structp obj)
     (let ((d (%struct-type obj)) (acc nil))
       (if (classp d)
           (dolist (sd (%cls-slots d))
             (let ((n (slotd-name sd)))
               (setq acc (cons (list (symbol-name n) (if (slot-boundp obj n) (slot-value obj n) '#:unbound) (lambda (v) (%set-slot-value obj n v))) acc))))
           (let ((i 1)) (dolist (n (cdr d)) (let ((idx i)) (setq acc (cons (list (symbol-name n) (%struct-ref obj idx) (lambda (v) (%struct-set obj idx v))) acc))) (setq i (+ i 1)))))
       (nreverse acc)))
    ((stringp obj) (list (list "length" (length obj) nil)))
    ((integerp obj) (list (list "binary" (%number-to-string obj 2) nil) (list "hex" (%number-to-string obj 16) nil) (list "bits" (integer-length obj) nil)))
    ((ratiop obj) (list (list "numerator" (numerator obj) nil) (list "denominator" (denominator obj) nil) (list "as float" (float obj) nil)))
    (t nil)))

(defun inspector-producer (obj)
  (lambda (w out)
    (with-style (out :bold)
      (format out "~A: " (string-downcase (symbol-name (presentation-type-of obj))))
      (present obj :stream out))
    (terpri out)
    (let ((entries (inspector-entries obj)) (i 0))
      (setf (rw-entries w) entries)
      (dolist (e entries)
        (with-style (out :dim) (format out "~4D " i))
        (format out "~A~A: " (car e) (if (caddr e) "" " "))
        (present (cadr e) :stream out)
        (terpri out)
        (setq i (+ i 1)))
      (when (null entries) (with-style (out :dim) (format out "  (no components)~%"))))
    (with-style (out :dim)
      (format out "~%click a value to descend; BACKSPACE goes back; g refreshes; q closes; :set-entry N EXPR edits~%"))))

(defmethod window-mouse ((w inspector-window) kind lx ly button mods)
  (if (and (eq kind :press) (= button 0))
      (let ((p (%pres-at w lx ly)))
        (if p
            (progn (report-navigate w (inspector-producer (pres-object p)) (pres-object p)
                                    (format nil "Inspector: ~A" (%abbrev (pres-object p) 40)))
                   t)
            (call-next-method)))
      (call-next-method)))

(defun open-inspector (wm obj)
  (if wm
      (open-report wm (format nil "Inspector: ~A" (%abbrev obj 40)) (inspector-producer obj)
                   :class 'inspector-window :subject obj :w 76 :h 22)
      (describe obj)))

(defun inspect (obj) (open-inspector *wm* obj) (values))

(defun find-inspector (wm) (dolist (w (wm-windows wm) nil) (when (typep w 'inspector-window) (return w))))

;;; ---- browsers ---------------------------------------------------------------------------------------------------------

(defun package-browser-producer (pkg)
  (lambda (w out)
    (with-style (out :bold) (format out "Package ~A~%" (package-name pkg)))
    (format out "  uses: ~{~A~^ ~}~%" (mapcar #'package-name (package-use-list pkg)))
    (let ((syms (sort (copy-list (%package-symbols pkg t)) (lambda (a b) (string< (symbol-name a) (symbol-name b))))))
      (with-style (out :bold) (format out "~%~D external symbols~%" (length syms)))
      (dolist (s syms)
        (write-string "  " out) (present-symbol s out (if (fboundp s) 'function-name 'symbol))
        (with-style (out :dim) (format out "~A~A" (if (fboundp s) "  function" "") (if (boundp s) "  variable" "")))
        (terpri out)))
    (declare (ignorable w))))

(defun open-package-browser (wm pkg)
  (let ((p (if (packagep pkg) pkg (find-package pkg))))
    (when wm (open-report wm (format nil "Package ~A" (package-name p)) (package-browser-producer p)))))

(defun packages-producer ()
  (lambda (w out)
    (declare (ignore w))
    (with-style (out :bold) (format out "Packages~%"))
    (dolist (p (sort (copy-list (list-all-packages)) (lambda (a b) (string< (package-name a) (package-name b)))))
      (write-string "  " out) (present p :stream out) (terpri out))))

(defun function-browser-producer (pkg)
  (lambda (w out)
    (report-symbols w out (format nil "Functions in ~A" (if pkg (package-name (find-package pkg)) "all packages"))
                    (all-functions pkg))))

(defun class-browser-producer (c)
  (lambda (w out)
    (declare (ignore w))
    (with-style (out :bold) (format out "Class ") (present c :stream out) (terpri out))
    (format out "  superclasses: ") (dolist (s (%cls-supers c)) (present s :stream out) (write-string " " out)) (terpri out)
    (format out "  subclasses:   ") (dolist (s (%cls-subclasses c)) (present s :stream out) (write-string " " out)) (terpri out)
    (format out "  precedence:   ") (dolist (s (%cls-cpl c)) (present s :stream out) (write-string " " out)) (terpri out)
    (with-style (out :bold) (format out "~%Slots~%"))
    (dolist (sd (%cls-slots c))
      (format out "  ~A~@[  initargs ~S~]~%" (symbol-name (slotd-name sd)) (slotd-initargs sd)))
    (with-style (out :bold) (format out "~%Methods specialized on this class~%"))
    (dolist (m (who-specializes (%cls-name c)))
      (format out "  ") (present-symbol (let ((n (gf-name (method-gf m)))) (if (consp n) (%fn-symbol n) n)) out 'function-name)
      (format out "~{ ~S~}~%" (method-qualifiers m)))))

(defun open-class-browser (wm c)
  (let ((cls (if (classp c) c (find-class c))))
    (when wm (open-report wm (format nil "Class ~A" (symbol-name (%cls-name cls))) (class-browser-producer cls)))))

;;; ---- commands ---------------------------------------------------------------------------------------------------------

(defun %resolve-symbol-arg (text)
  (or (%find-symbol-named text) (error "No symbol named ~A" text)))

(define-command (edit :documentation "Edit a file or the definition of a function") ((target word :prompt "File or function"))
  (let ((sym (unless (probe-file target) (ignore-errors (%find-symbol-named target))))
        (path-like (or (find #\. target) (find #\/ target))))
    (cond ((probe-file target) (open-editor *wm* :file target))
          ((and sym (edit-definition sym)))
          ((or path-like (not sym))                     ; a file that doesn't exist yet: a new, empty buffer
           (open-editor *wm* :file target)
           (let ((ed (find-editor-window *wm*))) (when ed (ed-message* ed "(New file)"))))
          (t (error "No source recorded for ~A" target)))))
(define-command (inspect :documentation "Inspect the value of an expression") ((object expression :prompt "Expression"))
  (open-inspector *wm* (eval object)))
(define-command (set-entry :documentation "Set an entry of the topmost Inspector to the value of an expression")
    ((n integer :prompt "Entry number") (expr expression :prompt "New value"))
  (let ((w (find-inspector *wm*)))
    (unless w (error "No Inspector window"))
    (let ((e (nth n (rw-entries w))))
      (unless e (error "No entry ~D" n))
      (unless (caddr e) (error "Entry ~D cannot be set" n))
      (funcall (caddr e) (eval expr))
      (report-refresh w))))
(define-command (who-calls :documentation "Windows listing the callers of a function") ((name word :prompt "Function"))
  (let ((sym (%resolve-symbol-arg name))) (%open-symbol-report (format nil "Callers of ~A" (%fname sym)) (who-calls sym))))
(define-command (who-references :documentation "Who references a variable") ((name word :prompt "Variable"))
  (let ((sym (%resolve-symbol-arg name))) (%open-symbol-report (format nil "References to ~A" (%fname sym)) (who-references sym))))
(define-command (who-sets :documentation "Who assigns a variable") ((name word :prompt "Variable"))
  (let ((sym (%resolve-symbol-arg name))) (%open-symbol-report (format nil "Assignments to ~A" (%fname sym)) (who-sets sym))))
(define-command (callees :documentation "Functions called by a function") ((name word :prompt "Function"))
  (let ((sym (%resolve-symbol-arg name))) (%open-symbol-report (format nil "Functions called by ~A" (%fname sym)) (callees sym))))
(define-command (who-defines :documentation "Where a name is defined") ((name word :prompt "Name"))
  (let ((sym (%resolve-symbol-arg name)))
    (dolist (l (definition-locations sym)) (format t "  ~A  ~A  offset ~D~%" (string-downcase (symbol-name (car l))) (cadr l) (caddr l)))
    (unless (definition-locations sym) (format t "  no source recorded~%"))))
(define-command (apropos-window :documentation "Browse symbols matching a substring") ((string string :prompt "Substring"))
  (%open-symbol-report (format nil "Apropos ~A" string) (apropos-list string)))
(define-command (browse-functions :documentation "Browse the functions of a package") ((package word :default "COMMON-LISP-USER"))
  (open-report *wm* "Functions" (function-browser-producer (if (find-package (string-upcase package)) (string-upcase package) nil))))
(define-command (browse-packages :documentation "Browse all packages") ()
  (open-report *wm* "Packages" (packages-producer)))
(define-command (browse-class :documentation "Browse a class") ((name word :prompt "Class"))
  (open-class-browser *wm* (find-class (%resolve-symbol-arg name))))
(define-command (trace :documentation "Trace functions") ((name word :prompt "Function"))
  (trace-function (%resolve-symbol-arg name)) (format t "~&Tracing ~A~%" name))
(define-command (untrace :documentation "Stop tracing a function") ((name word :prompt "Function"))
  (untrace-function (%resolve-symbol-arg name)) (format t "~&Untraced ~A~%" name))
(define-command (step-trace :documentation "Evaluate an expression showing every call") ((form expression :prompt "Expression"))
  (step-trace form))
(define-command (profile :documentation "Run an expression under the statistical profiler") ((form expression :prompt "Expression"))
  (with-profiling (:interval 1000) (eval form))
  (profile-report))
(define-command (arglist :documentation "Show a function's lambda list") ((name word :prompt "Function"))
  (let ((s (arglist-string (%resolve-symbol-arg name)))) (format t "~&~A~%" (or s "no lambda list recorded"))))
(define-command (run-tests :documentation "Run the loaded tests; failures are clickable") ((names word :default ""))
  (run-tests (and (> (length names) 0) (mapcar (lambda (n) (intern (string-upcase n) "COMMON-LISP")) (%split-string names #\,))))
  (let ((out *standard-output*))
    (dolist (f (reverse *test-failures*))
      (with-output-as-presentation (out f 'test-failure)
        (format out "  FAIL ~A: ~A" (car f) (%abbrev (prin1-to-string (cadr f)) 60)))
      (terpri out))))
(define-command (editor :documentation "Open an editor window") ()
  (open-editor *wm*))
(define-command (undo-tree :documentation "Show the undo tree of the editor's current buffer") ()
  (let ((ed (find-editor-window *wm*)))
    (if ed (dolist (l (undo-tree-lines (ed-buffer ed))) (format t "~A~%" l)) (format t "No editor window~%"))))

(defun %install-tool-hooks ()
  "Debugger's :EDIT command: open the editor on the definition, or print where it is defined."
  (setq *edit-hook*
        (lambda (name)
          (cond ((and *wm* (edit-definition name)) nil)
                ((definition-locations name)
                 (let ((l (car (definition-locations name))))
                   (format t "~&~S is defined in ~A at offset ~D~%" name (cadr l) (caddr l))))
                (t (format t "~&No source recorded for ~S~%" name))))))

(%install-tool-hooks)

(define-select-activity #\I "Inspector" (lambda (w) (typep w 'inspector-window)) nil)
