;;;; 40-listener.lisp -- the Listener window (Listener v2).
;;;;
;;;; A scrollable output pane with a multi-line input editor below it.  Features:
;;;; command history (Up/Down, M-p/M-n), Emacs-style line editing, Tab completion of
;;;; commands and symbols, automatic continuation of unbalanced forms, * ** ***,
;;;; results shown as presentations (click = default action, right = menu),
;;;; post-mortem error display with a backtrace of presentations (:BT, :FRAME),
;;;; mouse-wheel/PageUp scrolling, and a mouse-documentation line.

(in-package :cl)

(defvar *result-history* nil)
(defun result (n) (nth (- n 1) (reverse *result-history*)))

(defclass listener-window (window)
  ((obuf :initform (make-obuf) :accessor lw-obuf)
   (stream :accessor lw-stream)
   (input :initform "" :accessor lw-input)
   (cursor-pos :initform 0 :accessor lw-cursor-pos)
   (history :initform nil :accessor lw-history)
   (hist-pos :initform nil :accessor lw-hist-pos)
   (kill :initform "" :accessor lw-kill)
   (pending :initform nil :accessor lw-pending)
   (scroll-back :initform 0 :accessor lw-scroll-back)
   (hover :initform nil :accessor lw-hover)
   (pkg :initform nil :accessor lw-pkg)
   (rows :initform nil :accessor lw-rows)           ; display rows from the last draw
   (vis-start :initform 0 :accessor lw-vis-start)
   (vis-count :initform 0 :accessor lw-vis-count)
   (input-top :initform 0 :accessor lw-input-top)
   (last-error :initform nil :accessor lw-last-error)
   (read-only :initform nil :initarg :read-only :accessor lw-read-only)
   (lesson :initform nil :accessor lw-lesson)))

(defmethod initialize-instance :after ((w listener-window) &rest args)
  (declare (ignore args))
  (setf (lw-stream w) (make-instance 'pane-stream :obuf (lw-obuf w)))
  (setf (lw-pkg w) (find-package "COMMON-LISP-USER"))
  (with-style ((lw-stream w) :dim)
    (format (lw-stream w) "NeoGenera ~A listener.  Type :help for commands; :tutorial to learn; :doc for the manual; Tab completes; click results.~%" *ng-version*)))

(defun %pending-prompt (pending)
  ;; PENDING = (:prompt command done specs rest); the prompt text is the 4th element of the first missing spec
  (let ((spec (car (cadddr pending)))) (cadddr spec)))

(defun %prompt-string (w)
  (if (lw-pending w)
      (%string-concat (%pending-prompt (lw-pending w)) ": ")
      (%string-concat (let ((n (package-name (lw-pkg w))))
                        (cond ((string= n "COMMON-LISP-USER") "CL-USER") ((string= n "COMMON-LISP") "CL") (t n)))
                      "> ")))

;;; ---- drawing -----------------------------------------------------------------------------------------------

(defun %style-colors (style hover)
  "Returns (values fg bg attr) for a segment style."
  (if hover
      (values (tc :hi-fg) (tc :hi-bg) (if (= -1 (tc :hi-bg)) +reverse+ 0))
      (case style
        (:prompt (values (tc :prompt) (tc :bg) +bold+))
        (:value (values (tc :value) (tc :bg) 0))
        (:error (values (tc :error) (tc :bg) +bold+))
        (:link (values (tc :link) (tc :bg) +underline+))
        (:dim (values (tc :dim) (tc :bg) (if (= -1 (tc :dim)) +dim+ 0)))
        (:bold (values (tc :fg) (tc :bg) +bold+))
        (:em (values (tc :fg) (tc :bg) +underline+))
        (t (values (tc :fg) (tc :bg) 0)))))

(defun %input-rows (w iw)
  "The input as a list of display rows (strings), each at most IW wide; the first starts after the prompt."
  (let* ((prompt (%prompt-string w)) (text (%string-concat prompt (lw-input w))) (rows nil) (start 0))
    (loop
      (let* ((nl (%string-position-char text #\Newline start))
             (line-end (or nl (length text))) (pos start))
        (loop
          (let ((end (utf8-prefix-end text pos (max 1 iw))))
            (when (> end line-end) (setq end line-end))
            (setq rows (cons (subseq text pos end) rows))
            (setq pos end)
            (when (>= pos line-end) (return))))
        (if nl (setq start (+ nl 1)) (return))))
    (nreverse rows)))

(defun %cursor-row-col (w iw)
  "Row and column of the input cursor within the input rows."
  (let* ((prompt (%prompt-string w)) (text (%string-concat prompt (lw-input w)))
         (target (+ (length prompt) (lw-cursor-pos w))) (start 0) (row 0))
    (loop
      (let* ((nl (%string-position-char text #\Newline start)) (line-end (or nl (length text))) (pos start))
        (loop
          (let ((end (min line-end (utf8-prefix-end text pos (max 1 iw)))))
            (when (and (>= target pos) (<= target end) (or (< target end) (>= end line-end)))
              (return-from %cursor-row-col (values row (utf8-length (subseq text pos target)))))
            (setq row (+ row 1))
            (setq pos end)
            (when (>= pos line-end) (return))))
        (if nl (setq start (+ nl 1)) (return))))
    (values row 0)))


(defmethod window-draw-content ((w listener-window) screen ix iy iw ih focused)
  (when (and (> iw 0) (> ih 0))
    (let* ((rows (ob-layout (lw-obuf w) iw)) (nrows (length rows))
           (in-rows (if (lw-read-only w) nil (%input-rows w iw))) (n-in (if (null in-rows) 0 (min (length in-rows) (max 1 (floor ih 2)))))
           (out-h (max 0 (- ih n-in)))
           (back (max 0 (min (lw-scroll-back w) (max 0 (- nrows out-h)))))
           (end (- nrows back)) (start (max 0 (- end out-h))) (count (- end start)))
      (setf (lw-scroll-back w) back (lw-rows w) rows (lw-vis-start w) start (lw-vis-count w) count)
      (dotimes (i count)
        (dolist (ch (aref rows (+ start i)))
          (multiple-value-bind (fg bg attr) (%style-colors (second ch) (and (third ch) (eq (third ch) (lw-hover w))))
            (screen-draw-string screen (+ iy i) (+ ix (fourth ch)) (first ch) fg bg attr))))
      (let ((top (+ iy (min count out-h))))
        (setf (lw-input-top w) (- top iy))
        (let ((shown (if (> (length in-rows) n-in) (nthcdr (- (length in-rows) n-in) in-rows) in-rows)) (r 0)
              (prompt-len (length (%prompt-string w))))
          (dolist (line shown)
            (if (and (= r 0) (eq shown in-rows))
                (progn (screen-draw-string screen (+ top r) ix line (tc :prompt) (tc :bg) +bold+ 0 (min prompt-len (length line)))
                       (screen-draw-string screen (+ top r) (+ ix prompt-len) line (tc :fg) (tc :bg) 0 prompt-len))
                (screen-draw-string screen (+ top r) ix line (tc :fg) (tc :bg) 0))
            (setq r (+ r 1))))
        (unless (lw-read-only w)
          (multiple-value-bind (crow ccol) (%cursor-row-col w iw)
            (let ((skip (max 0 (- (length in-rows) n-in))))
              (when focused (setf (window-cursor w) (cons (+ top (max 0 (- crow skip))) (+ ix (min ccol (max 0 (- iw 1)))))))))))
      (setf (window-content-height w) (+ nrows n-in) (window-scroll w) start))))

(defmethod window-scroll-by ((w listener-window) n)
  (setf (lw-scroll-back w) (max 0 (+ (lw-scroll-back w) n))))

(defmethod window-resized ((w listener-window)) (setf (lw-scroll-back w) 0))
(defmethod window-package ((w listener-window)) (lw-pkg w))

;;; ---- hover and clicks --------------------------------------------------------------------------------------------

(defun %pres-at (w lx ly)
  (let ((rows (lw-rows w)))
    (when (and rows (>= ly 0) (< ly (lw-vis-count w)) (>= lx 0))
      (let* ((row (aref rows (+ (lw-vis-start w) ly))) (ch (row-chunk-at row lx)))
        (and ch (third ch))))))

(defmethod window-hover-doc ((w listener-window) lx ly)
  (let ((p (%pres-at w lx ly)))
    (setf (lw-hover w) p)
    (and p (presentation-doc p))))

(defun %run-pcmd (w cmd obj)
  (%in-listener w (lambda () (funcall (pcmd-fn cmd) obj)) (format nil "~A" (pcmd-label cmd))))

(defmethod window-mouse ((w listener-window) kind lx ly button mods)
  (declare (ignore mods))
  (when (eq kind :press)
    (let ((p (%pres-at w lx ly)))
      (cond (p (cond ((= button 0) (let ((c (default-pcommand (pres-type p)))) (when c (%run-pcmd w c (pres-object p)))))
                     ((= button 1) (%insert-text w (%input-text-for (pres-object p))))
                     (t (let ((cmds (applicable-pcommands (pres-type p))) (wm (window-wm w)))
                          (wm-popup-menu wm (mapcar (lambda (c) (cons (pcmd-label c) c)) cmds)
                                         (+ (window-x w) lx 1) (+ (window-y w) ly 1)
                                         (lambda (c) (%run-pcmd w c (pres-object p)))
                                         :title (string-downcase (symbol-name (pres-type p))))))))
            ((>= ly (lw-input-top w))
             (let ((col (- lx (length (%prompt-string w)))))
               (when (and (= ly (lw-input-top w)) (>= col 0)) (setf (lw-cursor-pos w) (min col (length (lw-input w)))))))))
    t))

;;; ---- editing ---------------------------------------------------------------------------------------------------------

(defun %insert-text (w text)
  (let ((in (lw-input w)) (pos (lw-cursor-pos w)))
    (setf (lw-input w) (%string-concat (subseq in 0 pos) text (subseq in pos)))
    (setf (lw-cursor-pos w) (+ pos (length text)))
    (setf (lw-scroll-back w) 0)))

(defun %input-text-for (obj)
  (let ((s (prin1-to-string obj)))
    (if (or (and (> (length s) 1) (string= (subseq s 0 2) "#<")) (%string-search "#<" s 0))
        (progn (setq *result-history* (cons obj *result-history*))
               (format nil "(result ~D)" (length *result-history*)))
        (if (or (consp obj) (and (symbolp obj) obj (not (keywordp obj)) (not (eq obj t)))) (%string-concat "'" s) s))))

(defun %delete-range (w from to)
  (let ((in (lw-input w)))
    (setf (lw-input w) (%string-concat (subseq in 0 from) (subseq in to)))
    (setf (lw-cursor-pos w) from)))

(defun %char-start (in pos)
  "Move POS back by one character (skipping UTF-8 continuation bytes)."
  (let ((p (max 0 (- pos 1))))
    (loop (when (or (<= p 0) (/= (logand (char-code (char in p)) #xC0) #x80)) (return)) (setq p (- p 1)))
    p))
(defun %char-end (in pos) (utf8-prefix-end in pos 1))

(defun %word-back (in pos)
  (let ((p pos))
    (loop (when (or (<= p 0) (alphanumericp (char in (- p 1)))) (return)) (setq p (- p 1)))
    (loop (when (or (<= p 0) (not (alphanumericp (char in (- p 1))))) (return)) (setq p (- p 1)))
    p))
(defun %word-forward (in pos)
  (let ((p pos) (n (length in)))
    (loop (when (or (>= p n) (alphanumericp (char in p))) (return)) (setq p (+ p 1)))
    (loop (when (or (>= p n) (not (alphanumericp (char in p)))) (return)) (setq p (+ p 1)))
    p))

(defun %balanced-p (text)
  "True when TEXT has no unclosed parenthesis or string (comments and #\\ handled)."
  (let ((depth 0) (in-string nil) (i 0) (n (length text)))
    (loop
      (when (>= i n) (return))
      (let ((c (char text i)))
        (cond (in-string (cond ((char= c #\\) (setq i (+ i 1))) ((char= c #\") (setq in-string nil))))
              ((char= c #\") (setq in-string t))
              ((char= c #\;) (loop (when (or (>= i n) (char= (char text i) #\Newline)) (return)) (setq i (+ i 1))))
              ((and (char= c #\#) (< (+ i 1) n) (char= (char text (+ i 1)) #\\)) (setq i (+ i 2)))
              ((char= c #\() (setq depth (+ depth 1)))
              ((char= c #\)) (setq depth (- depth 1)))))
      (setq i (+ i 1)))
    (and (<= depth 0) (not in-string))))

(defun %complete (w)
  (let* ((in (lw-input w)) (pos (lw-cursor-pos w)) (before (subseq in 0 pos)) (out (lw-stream w)))
    (cond
      ((and (> (length before) 0) (char= (char before 0) #\:) (not (%string-position-char before #\Space 0)))
       (let* ((word (string-upcase (subseq before 1))) (cands (complete-command-words (list word))))
         (%apply-completion w cands 1 (length before) out)))
      ((and (> (length before) 0) (char= (char before 0) #\:))
       (let* ((toks (%split-tokens (subseq before 1)))
              (trailing (char= (char before (- (length before) 1)) #\Space))
              (tokens (if trailing (append toks (list "")) toks))
              (cands (complete-command-words (mapcar #'string-upcase tokens))))
         (if cands
             (%apply-completion w cands (- pos (length (car (last tokens)))) pos out)
             (%complete-symbol w before pos out))))
      (t (%complete-symbol w before pos out)))))

(defun %complete-symbol (w before pos out)
  (let ((start pos))
    (loop (when (or (<= start 0) (member (char before (- start 1)) '(#\Space #\( #\) #\' #\" #\` #\, #\Newline))) (return))
          (setq start (- start 1)))
    (let ((prefix (subseq before start pos)))
      (when (> (length prefix) 0)
        (%apply-completion w (complete-symbol-names prefix) start pos out)))))

(defun %apply-completion (w cands start end out)
  (cond ((null cands) nil)
        (t (let* ((cp (common-prefix cands)) (in (lw-input w)) (typed (- end start)))
             (when (> (length cp) typed)
               (setf (lw-input w) (%string-concat (subseq in 0 start) cp (subseq in end)))
               (setf (lw-cursor-pos w) (+ start (length cp))))
             (when (cdr cands)
               (with-style (out :dim)
                 (format out "~A~A~%" (%prompt-string w) (lw-input w))
                 (let ((col 0))
                   (dolist (c cands)
                     (when (> (+ col (length c) 2) 70) (terpri out) (setq col 0))
                     (format out "~A  " c) (setq col (+ col (length c) 2))))
                 (terpri out)))))))

(defmethod window-key ((w listener-window) key)
  (let* ((c (key-code key)) (m (key-mods key)) (ctrl (/= 0 (logand m +ctrl+))) (meta (/= 0 (logand m +meta+)))
         (in (lw-input w)) (pos (lw-cursor-pos w)))
    (cond
      ((and (integerp c) (not ctrl) (not meta) (>= c 32))
       (setf (lw-hist-pos w) nil)
       (%insert-text w (if (< c 128) (string (code-char c)) (%utf8-encode c))) t)
      ((eq c :return)
       (cond ((or (lw-pending w) (= (length in) 0) (char= (char (string-left-trim " " (%string-concat in " ")) 0) #\:)
                  (%balanced-p in))
              (%submit w))
             (t (%insert-text w (string #\Newline)))) t)
      ((eq c :backspace) (when (> pos 0) (%delete-range w (%char-start in pos) pos)) t)
      ((or (eq c :delete) (and ctrl (eql c 100))) (when (< pos (length in)) (%delete-range w pos (%char-end in pos))) t)
      ((or (eq c :left) (and ctrl (eql c 98))) (setf (lw-cursor-pos w) (%char-start in pos)) t)
      ((or (eq c :right) (and ctrl (eql c 102))) (setf (lw-cursor-pos w) (min (length in) (%char-end in pos))) t)
      ((and meta (eql c 98)) (setf (lw-cursor-pos w) (%word-back in pos)) t)
      ((and meta (eql c 102)) (setf (lw-cursor-pos w) (%word-forward in pos)) t)
      ((or (eq c :home) (and ctrl (eql c 97))) (setf (lw-cursor-pos w) 0) t)
      ((or (eq c :end) (and ctrl (eql c 101))) (setf (lw-cursor-pos w) (length in)) t)
      ((and ctrl (eql c 107)) (setf (lw-kill w) (subseq in pos)) (%delete-range w pos (length in)) t)
      ((and ctrl (eql c 117)) (setf (lw-kill w) in) (%delete-range w 0 (length in)) t)
      ((and ctrl (eql c 119)) (let ((p (%word-back in pos))) (setf (lw-kill w) (subseq in p pos)) (%delete-range w p pos)) t)
      ((and ctrl (eql c 121)) (%insert-text w (lw-kill w)) t)
      ((and ctrl (eql c 108)) (ob-clear (lw-obuf w)) t)
      ((and ctrl (eql c 103)) (setf (lw-pending w) nil) (%delete-range w 0 (length in)) t)
      ((or (eq c :up) (and meta (eql c 112))) (%history-step w 1) t)
      ((or (eq c :down) (and meta (eql c 110))) (%history-step w -1) t)
      ((eq c :tab) (%complete w) t)
      ((eq c :pgup) (window-scroll-by w (max 1 (- (window-h w) 4))) t)
      ((eq c :pgdn) (window-scroll-by w (- (max 1 (- (window-h w) 4)))) t)
      ((and meta (eql c 60)) (window-scroll-by w 100000) t)
      ((and meta (eql c 62)) (setf (lw-scroll-back w) 0) t)
      ((eq c :escape) (%delete-range w 0 (length in)) t)
      (t nil))))

(defun %history-step (w dir)
  (let* ((h (lw-history w)) (n (length h)) (p (lw-hist-pos w)))
    (when (> n 0)
      (let ((np (cond ((null p) (if (> dir 0) 0 nil)) (t (let ((x (+ p (if (> dir 0) 1 -1)))) (cond ((< x 0) nil) ((>= x n) (- n 1)) (t x)))))))
        (setf (lw-hist-pos w) np)
        (setf (lw-input w) (if np (nth np h) ""))
        (setf (lw-cursor-pos w) (length (lw-input w)))))))

;;; ---- evaluation --------------------------------------------------------------------------------------------------------

(defvar *internal-error-frames* '(signal error %signal-error invoke-debugger cerror warn))

(defun %capture-error-frames ()
  "Backtrace at the point of an error, with the signalling machinery removed."
  (let* ((frames (%backtrace 60)) (last-internal nil) (i 0))
    (dolist (f frames) (when (member (cadr f) *internal-error-frames*) (setq last-internal i)) (setq i (+ i 1)))
    (if last-internal (nthcdr (+ last-internal 1) frames) frames)))

(defun %print-error-block (w condition frames)
  (let ((out (lw-stream w)))
    (with-style (out :error)
      (with-output-as-presentation (out condition 'condition)
        (format out "Error: ~A" (condition-report-string condition)))
      (terpri out))
    (with-style (out :dim)
      (format out "  [~A]  :BT shows the backtrace~%" (string-downcase (symbol-name (%cls-name (class-of condition)))))
      (let ((i 0))
        (dolist (f frames)
          (when (>= i 4) (return))
          (with-output-as-presentation (out f 'frame)
            (format out "  ~D: (~A~{ ~A~})" i (%frame-name f) (mapcar #'%abbrev (caddr f))))
          (terpri out)
          (setq i (+ i 1)))))))

(defun %in-listener (w thunk &optional (what ""))
  "Run THUNK with output going to listener W.  Errors are reported in the pane and abort THUNK.
Returns (values list-of-values ok-p)."
  (declare (ignorable what))
  (let ((out (lw-stream w)) (*current-listener* w) (result nil) (ok nil))
    (setf (wm-busy (window-wm w)) t)
    (catch 'listener-abort
      (handler-bind ((serious-condition
                      (lambda (c)
                        (let ((frames (%capture-error-frames)))
                          (setf (lw-last-error w) (cons c frames))
                          (%print-error-block w c frames)
                          (throw 'listener-abort nil)))))
        (let ((*standard-output* out) (*error-output* out) (*standard-input* (make-string-input-stream ""))
              (*package* (lw-pkg w)) (*debugger-hook* nil))
          (setq result (multiple-value-list (funcall thunk)))
          (setq ok t)
          (setf (lw-pkg w) *package*))))
    (setf (wm-busy (window-wm w)) nil)
    (values result ok)))


(defun %show-values (w vals)
  (let ((out (lw-stream w)))
    (if (null vals)
        (with-style (out :dim) (format out "; No values~%"))
        (dolist (v vals)
          (with-style (out :value)
            (write-string "=> " out)
            (present v :stream out)
            (terpri out))))))

(defun %fresh-line (w) (unless (= 0 (ob-current-column (lw-obuf w))) (terpri (lw-stream w))))

(defun %eval-text (w text)
  (let ((pos 0))
    (loop
      (let ((rest (string-left-trim " " (subseq text pos))))
        (when (= (length rest) 0) (return))
        (setq pos (- (length text) (length rest))))
      (multiple-value-bind (read-result ok) (%in-listener w (lambda () (multiple-value-list (%read-from-string text pos))))
        (unless ok (return))
        (let* ((pair (car read-result)) (form (car pair)))
          (when (eq form (%eof-object)) (return))
          (setq pos (cadr pair))
          (multiple-value-bind (eval-result ok2) (%in-listener w (lambda () (multiple-value-list (eval form))))
            (unless ok2 (return))
            (let ((vals (car eval-result)))
              (%fresh-line w)
              (setq *** ** ** * * (car vals))
              (dolist (v vals) (setq *result-history* (cons v *result-history*)))
              (%show-values w vals)
              (when (lw-lesson w) (tutorial-observe w form vals)))))))))


(defun %submit (w)
  (let ((text (lw-input w)) (out (lw-stream w)))
    (unless (= (length text) 0)
      (setf (lw-history w) (cons text (remove text (lw-history w) :test #'string=))))
    (setf (lw-hist-pos w) nil (lw-input w) "" (lw-cursor-pos w) 0 (lw-scroll-back w) 0)
    (with-style (out :prompt) (write-string (%prompt-string w) out))
    (write-string text out)
    (terpri out)
    (let ((trimmed (string-trim " " text)))
      (cond ((lw-pending w)
             (let ((pending (lw-pending w)) (result nil))
               (setf (lw-pending w) nil)
               (%in-listener w (lambda () (setq result (continue-command pending trimmed))))
               (when (and (consp result) (eq (car result) :prompt)) (setf (lw-pending w) result))))
            ((= (length trimmed) 0) nil)
            ((char= (char trimmed 0) #\:)
             (let ((result nil))
               (%in-listener w (lambda () (setq result (execute-command-line (subseq trimmed 1)))))
               (when (and (consp result) (eq (car result) :prompt)) (setf (lw-pending w) result))))
            (t (%eval-text w text))))))
