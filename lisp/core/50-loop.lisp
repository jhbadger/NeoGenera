;;;; 50-loop.lisp -- the LOOP macro (an ANSI subset).
;;;;
;;;; Supported: for/as (in on across from/upfrom/downfrom to/upto below above
;;;; downto by = then, hash-keys/hash-values), repeat, with, while, until,
;;;; always, never, thereis, collect/append/nconc/sum/count/maximize/minimize
;;;; (with INTO), do, when/if/unless/else/end, return, initially, finally, named.

(in-package :cl)

(defun %lk (x name) (and (symbolp x) (string= (symbol-name x) name)))
(defun %lk-any (x &rest names)
  (and (symbolp x) (member (symbol-name x) names :test #'string=) t))

(defun %loop-pattern-vars (pattern)
  (cond ((null pattern) nil)
        ((symbolp pattern) (list pattern))
        (t (append (%loop-pattern-vars (car pattern)) (%loop-pattern-vars (cdr pattern))))))

(defun %loop-assign (pattern form)
  (cond ((null pattern) nil)
        ((symbolp pattern) (list `(setq ,pattern ,form)))
        (t (let ((tmp (gensym)))
             (list `(let ((,tmp ,form))
                      ,@(%loop-assign (car pattern) `(car ,tmp))
                      ,@(%loop-assign (cdr pattern) `(cdr ,tmp))))))))

(defmacro loop (&rest forms)
  (if (and forms (consp (car forms)))
      (let ((top (gensym)))
        `(block nil (tagbody ,top ,@forms (go ,top))))
      (%loop-expand forms)))

(defun %loop-expand (forms)
  (let ((rest forms)
        (name nil)
        (bindings nil)      ; reversed list of (var init)
        (prologue nil)      ; reversed
        (tests nil)         ; reversed forms run at top of every iteration
        (steps nil)         ; reversed forms run at end of every iteration
        (body nil)          ; reversed
        (epilogue nil)      ; reversed
        (result nil) (result-set nil)
        (end-tag (gensym)) (top-tag (gensym))
        (acc-default nil)
        (always-seen nil))
    (labels ((peek () (car rest))
             (next () (let ((x (car rest))) (setq rest (cdr rest)) x))
             (bind (var init) (setq bindings (cons (list var init) bindings)))
             (add-body (f) (setq body (cons f body)))
             (add-test (f) (setq tests (cons f tests)))
             (add-step (f) (setq steps (cons f steps)))
             (block-name () name)
             (acc-var (into kind)
               (cond (into into)
                     (t (unless acc-default
                          (setq acc-default (gensym))
                          (bind acc-default (if (eq kind :sum) 0 nil))
                          (unless result-set (setq result-set t) (setq result acc-default)))
                        acc-default)))
             (parse-for ()
               (let ((var (next)))
                 (when (%lk (peek) "BEING") (next)
                   (when (or (%lk (peek) "THE") (%lk (peek) "EACH")) (next))
                   (let ((kind (next)))
                     (next)                       ; OF / IN
                     (let ((ht (next)) (pairs (gensym)) (v2 nil))
                       (when (%lk (peek) "USING") (next)
                         (let ((u (next))) (setq v2 (cadr u))))
                       (bind pairs `(%ht-pairs ,ht))
                       (dolist (v (%loop-pattern-vars var)) (bind v nil))
                       (when v2 (bind v2 nil))
                       (add-test `(when (null ,pairs) (go ,end-tag)))
                       (cond ((%lk-any kind "HASH-KEYS" "HASH-KEY")
                              (add-test `(setq ,var (car (car ,pairs))))
                              (when v2 (add-test `(setq ,v2 (cdr (car ,pairs))))))
                             (t (add-test `(setq ,var (cdr (car ,pairs))))
                                (when v2 (add-test `(setq ,v2 (car (car ,pairs)))))))
                       (add-step `(setq ,pairs (cdr ,pairs)))
                       (return-from parse-for nil))))
                 (let ((kw (next)))
                   (cond
                     ((%lk-any kw "IN")
                      (let ((tail (gensym)) (lst (next)) (by nil))
                        (when (%lk (peek) "BY") (next) (setq by (next)))
                        (bind tail lst)
                        (dolist (v (%loop-pattern-vars var)) (bind v nil))
                        (add-test `(when (atom ,tail) (go ,end-tag)))
                        (dolist (f (%loop-assign var `(car ,tail))) (add-test f))
                        (add-step `(setq ,tail ,(if by `(funcall ,by ,tail) `(cdr ,tail))))))
                     ((%lk-any kw "ON")
                      (let ((lst (next)) (by nil))
                        (when (%lk (peek) "BY") (next) (setq by (next)))
                        (if (symbolp var)
                            (progn (bind var lst)
                                   (add-test `(when (atom ,var) (go ,end-tag)))
                                   (add-step `(setq ,var ,(if by `(funcall ,by ,var) `(cdr ,var)))))
                            (let ((tail (gensym)))
                              (bind tail lst)
                              (dolist (v (%loop-pattern-vars var)) (bind v nil))
                              (add-test `(when (atom ,tail) (go ,end-tag)))
                              (dolist (f (%loop-assign var tail)) (add-test f))
                              (add-step `(setq ,tail (cdr ,tail)))))))
                     ((%lk-any kw "ACROSS")
                      (let ((vec (gensym)) (idx (gensym)) (v (next)))
                        (bind vec v) (bind idx 0)
                        (dolist (x (%loop-pattern-vars var)) (bind x nil))
                        (add-test `(when (>= ,idx (length ,vec)) (go ,end-tag)))
                        (add-test `(setq ,var (aref ,vec ,idx)))
                        (add-step `(setq ,idx (+ ,idx 1)))))
                     ((%lk-any kw "=")
                      (let ((init (next)))
                        (if (%lk (peek) "THEN")
                            (progn (next)
                                   (let ((then (next)))
                                     (dolist (x (%loop-pattern-vars var)) (bind x nil))
                                     (let ((first (gensym)))
                                       (bind first t)
                                       (add-test `(if ,first (progn (setq ,first nil) ,@(%loop-assign var init)) (progn ,@(%loop-assign var then)))))))
                            (progn (dolist (x (%loop-pattern-vars var)) (bind x nil))
                                   (dolist (f (%loop-assign var init)) (add-test f))))))
                     (t
                      ;; arithmetic: from/upfrom/downfrom/to/upto/below/above/downto/by
                      (let ((start 0) (limit nil) (by 1) (down nil) (inclusive t) (limit-var nil))
                        (setq rest (cons kw rest))
                        (block nil
                          (tagbody scan
                             (let ((k (peek)))
                               (cond ((%lk-any k "FROM" "UPFROM") (next) (setq start (next)) (go scan))
                                     ((%lk k "DOWNFROM") (next) (setq start (next)) (setq down t) (go scan))
                                     ((%lk-any k "TO" "UPTO") (next) (setq limit (next)) (go scan))
                                     ((%lk k "DOWNTO") (next) (setq limit (next)) (setq down t) (go scan))
                                     ((%lk k "BELOW") (next) (setq limit (next)) (setq inclusive nil) (go scan))
                                     ((%lk k "ABOVE") (next) (setq limit (next)) (setq inclusive nil) (setq down t) (go scan))
                                     ((%lk k "BY") (next) (setq by (next)) (go scan))))))
                        (bind var start)
                        (when limit
                          (if (%constant-form-p limit)
                              (setq limit-var limit)
                              (progn (setq limit-var (gensym)) (bind limit-var limit))))
                        (let ((byv (if (%constant-form-p by) by (let ((g (gensym))) (bind g by) g))))
                          (when limit
                            (add-test `(when ,(if down
                                                  (if inclusive `(< ,var ,limit-var) `(<= ,var ,limit-var))
                                                  (if inclusive `(> ,var ,limit-var) `(>= ,var ,limit-var)))
                                         (go ,end-tag))))
                          (add-step `(setq ,var ,(if down `(- ,var ,byv) `(+ ,var ,byv)))))))))))
             (parse-clause ()
               ;; returns a list of body forms for one clause
               (let ((k (next)))
                 (cond
                   ((%lk-any k "DO" "DOING")
                    (let ((fs nil))
                      (block nil
                        (tagbody more
                           (when (consp (peek)) (setq fs (cons (next) fs)) (go more))))
                      (nreverse fs)))
                   ((%lk-any k "COLLECT" "COLLECTING" "APPEND" "APPENDING" "NCONC" "NCONCING")
                    (let* ((form (next)) (into (when (%lk (peek) "INTO") (next) (next)))
                           (acc (acc-var into :list)) (tail (gensym)) (v (gensym))
                           (app (%lk-any k "APPEND" "APPENDING" "NCONC" "NCONCING")))
                      (bind tail nil)
                      (when into (unless (member into (mapcar #'car bindings)) (bind into nil)))
                      (list `(let ((,v ,(if app `(copy-list ,form) `(list ,form))))
                               (if ,acc
                                   (setq ,tail (last (rplacd ,tail ,v)))
                                   (setq ,acc ,v ,tail (last ,v)))
                               nil))))
                   ((%lk-any k "SUM" "SUMMING")
                    (let* ((form (next)) (into (when (%lk (peek) "INTO") (next) (next)))
                           (acc (acc-var into :sum)))
                      (when (and into (not (member into (mapcar #'car bindings)))) (bind into 0))
                      (list `(setq ,acc (+ ,acc ,form)))))
                   ((%lk-any k "COUNT" "COUNTING")
                    (let* ((form (next)) (into (when (%lk (peek) "INTO") (next) (next)))
                           (acc (acc-var into :sum)))
                      (when (and into (not (member into (mapcar #'car bindings)))) (bind into 0))
                      (list `(when ,form (setq ,acc (+ ,acc 1))))))
                   ((%lk-any k "MAXIMIZE" "MAXIMIZING" "MINIMIZE" "MINIMIZING")
                    (let* ((form (next)) (into (when (%lk (peek) "INTO") (next) (next)))
                           (acc (acc-var into :list)) (v (gensym))
                           (op (if (%lk-any k "MAXIMIZE" "MAXIMIZING") '> '<)))
                      (when (and into (not (member into (mapcar #'car bindings)))) (bind into nil))
                      (list `(let ((,v ,form)) (when (or (null ,acc) (,op ,v ,acc)) (setq ,acc ,v))))))
                   ((%lk-any k "WHEN" "IF" "UNLESS")
                    (let* ((test (next)) (then (parse-clause-group)) (else nil))
                      (when (%lk (peek) "ELSE") (next) (setq else (parse-clause-group)))
                      (when (%lk (peek) "END") (next))
                      (if (%lk k "UNLESS")
                          (list `(if ,test (progn ,@else) (progn ,@then)))
                          (list `(if ,test (progn ,@then) (progn ,@else))))))
                   ((%lk k "RETURN") (list `(return-from ,(block-name) ,(next))))
                   ((%lk k "WHILE") (list `(unless ,(next) (go ,end-tag))))
                   ((%lk k "UNTIL") (list `(when ,(next) (go ,end-tag))))
                   ((%lk k "ALWAYS") (setq always-seen t) (setq result-set t) (setq result t)
                    (list `(unless ,(next) (return-from ,(block-name) nil))))
                   ((%lk k "NEVER") (setq always-seen t) (setq result-set t) (setq result t)
                    (list `(when ,(next) (return-from ,(block-name) nil))))
                   ((%lk k "THEREIS")
                    (let ((v (gensym)))
                      (list `(let ((,v ,(next))) (when ,v (return-from ,(block-name) ,v))))))
                   (t (error "LOOP: unknown clause ~S" k)))))
             (parse-clause-group ()
               (let ((fs (parse-clause)))
                 (block nil
                   (tagbody more
                      (when (%lk (peek) "AND") (next) (setq fs (append fs (parse-clause))) (go more))))
                 fs)))
      (block parse
        (tagbody top
           (when (null rest) (return-from parse nil))
           (let ((k (peek)))
             (cond
               ((%lk k "NAMED") (next) (setq name (next)))
               ((%lk-any k "FOR" "AS") (next) (parse-for)
                (block nil (tagbody more (when (%lk (peek) "AND") (next) (parse-for) (go more)))))
               ((%lk k "WITH") (next)
                (let ((var (next)) (init nil))
                  (when (%lk (peek) "=") (next) (setq init (next)))
                  (bind var init)
                  (block nil
                    (tagbody more
                       (when (%lk (peek) "AND") (next)
                         (let ((v2 (next)) (i2 nil))
                           (when (%lk (peek) "=") (next) (setq i2 (next)))
                           (bind v2 i2))
                         (go more))))))
               ((%lk k "REPEAT") (next)
                (let ((g (gensym)))
                  (bind g (next))
                  (add-test `(when (<= ,g 0) (go ,end-tag)))
                  (add-step `(setq ,g (- ,g 1)))))
               ((%lk k "INITIALLY") (next)
                (block nil (tagbody more (when (consp (peek)) (setq prologue (cons (next) prologue)) (go more)))))
               ((%lk k "FINALLY") (next)
                (cond ((%lk (peek) "RETURN") (next) (setq result-set t) (setq result (next)))
                      (t (block nil (tagbody more (when (consp (peek)) (setq epilogue (cons (next) epilogue)) (go more)))))))
               (t (dolist (f (parse-clause-group)) (add-body f)))))
           (go top))))
    (let ((blk-name name))
      `(block ,blk-name
         (let* ,(nreverse bindings)
           ,@(nreverse prologue)
           (tagbody ,top-tag
              ,@(nreverse tests)
              ,@(nreverse body)
              ,@(nreverse steps)
              (go ,top-tag)
              ,end-tag)
           ,@(nreverse epilogue)
           ,(if result-set result nil))))))
