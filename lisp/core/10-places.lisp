;;;; 10-places.lisp -- SETF and friends.

(in-package :cl)

(defun %def-setf (accessor setter)
  (%put accessor '%setf-fn setter)
  accessor)

(defun %setcar (x v) (rplaca x v) v)
(defun %setcdr (x v) (rplacd x v) v)
(defun %setnth (n l v) (rplaca (nthcdr n l) v) v)
(defun %setelt (s i v) (if (listp s) (%setnth i s v) (%aset s i v)))
(defun %set-cadr (x v) (rplaca (cdr x) v) v)
(defun %set-cddr (x v) (rplacd (cdr x) v) v)
(defun %set-caddr (x v) (rplaca (cddr x) v) v)
(defun %set-caar (x v) (rplaca (car x) v) v)
(defun %set-cdar (x v) (rplacd (car x) v) v)
(defun %set-symbol-value (s v) (set s v))
(defun %set-getf (plist key v)
  (do-list-tails (l plist) (when (eq (car l) key) (rplaca (cdr l) v) (return-from %set-getf v)) (setq l (cdr l)))
  v)

(%def-setf 'car '%setcar) (%def-setf 'cdr '%setcdr) (%def-setf 'first '%setcar)
(%def-setf 'rest '%setcdr) (%def-setf 'nth '%setnth) (%def-setf 'elt '%setelt)
(%def-setf 'cadr '%set-cadr) (%def-setf 'second '%set-cadr) (%def-setf 'cddr '%set-cddr)
(%def-setf 'caddr '%set-caddr) (%def-setf 'third '%set-caddr)
(%def-setf 'caar '%set-caar) (%def-setf 'cdar '%set-cdar)
(%def-setf 'aref '%aset) (%def-setf 'svref '%aset) (%def-setf 'char '%aset) (%def-setf 'schar '%aset)
(%def-setf 'symbol-value '%set-symbol-value) (%def-setf 'symbol-function '%set-symbol-function)
(%def-setf 'symbol-plist '%set-symbol-plist) (%def-setf 'get '%put)
(%def-setf 'macro-function '%set-macro-function)
(%def-setf 'fill-pointer '%set-fill-pointer)

(defun %constant-form-p (x)
  (or (numberp x) (stringp x) (characterp x) (keywordp x) (null x) (eq x t)
      (and (consp x) (eq (car x) 'quote))))

;;; Returns (bindings getter-form setter-builder)
(defun %place-parts (place)
  (cond ((symbolp place) (list nil place (lambda (v) (list 'setq place v))))
        ((not (consp place)) (error "Bad SETF place: ~S" place))
        ((eq (car place) 'getf)          ; (getf place key [default]): the plist itself is the place
         (let* ((inner (%place-parts (cadr place))) (k (gensym)) (tmp (gensym)))
           (list (append (car inner) (list (list k (caddr place))))
                 `(getf ,(cadr inner) ,k ,@(cdddr place))
                 (lambda (v) `(let ((,tmp ,v)) ,(funcall (caddr inner) `(%plist-put ,(cadr inner) ,k ,tmp)) ,tmp)))))
        (t (let* ((head (car place))
                  (macro (and (symbolp head) (macro-function head)))
                  (setter (get head '%setf-fn)))
             (cond ((and macro (not setter))
                    (%place-parts (funcall macro place nil)))
                   (t (let ((temps nil) (bindings nil))
                        (dolist (a (cdr place))
                          (if (%constant-form-p a)
                              (setq temps (cons a temps))
                              (let ((g (gensym)))
                                (setq temps (cons g temps))
                                (setq bindings (cons (list g a) bindings)))))
                        (setq temps (nreverse temps))
                        (list (nreverse bindings)
                              (cons head temps)
                              (lambda (v)
                                (if setter
                                    `(,setter ,@temps ,v)
                                    `(funcall (function (setf ,head)) ,v ,@temps)))))))))))

(defmacro setf (&rest pairs)
  (cond ((null pairs) nil)
        ((null (cddr pairs)) (%setf-1 (car pairs) (cadr pairs)))
        (t (let ((forms nil))
             (do-list-tails (p pairs)
               (setq forms (cons (%setf-1 (car p) (cadr p)) forms))
               (setq p (cdr p)))
             `(progn ,@(nreverse forms))))))

(defun %setf-1 (place value)
  (if (symbolp place)
      `(setq ,place ,value)
      (let ((parts (%place-parts place)))
        (if (null (car parts))
            (funcall (caddr parts) value)
            `(let* ,(car parts) ,(funcall (caddr parts) value))))))

(defmacro incf (place &optional (delta 1))
  (let ((parts (%place-parts place)))
    `(let* ,(car parts) ,(funcall (caddr parts) `(+ ,(cadr parts) ,delta)))))
(defmacro decf (place &optional (delta 1))
  (let ((parts (%place-parts place)))
    `(let* ,(car parts) ,(funcall (caddr parts) `(- ,(cadr parts) ,delta)))))
(defmacro push (item place)
  (let ((g (gensym)) (parts (%place-parts place)))
    `(let* ((,g ,item) ,@(car parts)) ,(funcall (caddr parts) `(cons ,g ,(cadr parts))))))
(defmacro pushnew (item place &rest keys)
  (let ((g (gensym)) (parts (%place-parts place)))
    `(let* ((,g ,item) ,@(car parts))
       ,(funcall (caddr parts) `(adjoin ,g ,(cadr parts) ,@keys)))))
(defmacro pop (place)
  (let ((parts (%place-parts place)) (g (gensym)))
    `(let* (,@(car parts) (,g ,(cadr parts)))
       ,(funcall (caddr parts) `(cdr ,g))
       (car ,g))))
(defmacro rotatef (&rest places)
  (if (null (cdr places))
      nil
      (let ((temps (mapcar (lambda (p) (gensym)) places)))
        `(let ,(mapcar (lambda (tmp p) (list tmp p)) temps places)
           ,@(%rotate-sets places (cdr temps) (car temps))
           nil))))
(defun %rotate-sets (places temps first)
  (if (null (cdr places))
      (list `(setf ,(car places) ,first))
      (cons `(setf ,(car places) ,(car temps)) (%rotate-sets (cdr places) (cdr temps) first))))
(defmacro shiftf (&rest args)
  (let ((places (butlast args)) (new (car (last args))) (tmp (gensym)))
    `(let ((,tmp ,(car places)))
       ,@(%shift-sets places new)
       ,tmp)))
(defun %shift-sets (places new)
  (if (null (cdr places))
      (list `(setf ,(car places) ,new))
      (cons `(setf ,(car places) ,(cadr places)) (%shift-sets (cdr places) new))))
(defmacro psetf (&rest pairs)
  (let ((bindings nil) (sets nil))
    (do-list-tails (p pairs)
      (let ((g (gensym)))
        (setq bindings (cons (list g (cadr p)) bindings))
        (setq sets (cons `(setf ,(car p) ,g) sets))
        (setq p (cdr p))))
    `(let ,(nreverse bindings) ,@(nreverse sets) nil)))
(defmacro remf (place key)
  `(%remf-place ,place ,key))
(defmacro defsetf (accessor setter) `(%def-setf ',accessor ',setter))

(defmacro check-type (place type &rest r)
  (declare (ignore r))
  `(unless (typep ,place ',type) (error "The value ~S is not of type ~S" ,place ',type)))
