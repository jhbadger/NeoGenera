;;;; 00-base.lisp -- bootstrap macros and list utilities.
;;;;
;;;; Loaded by the stage-0 evaluator.  Everything here uses only the
;;;; evaluator's native special forms plus macros defined earlier in this file.
;;;; Top-level forms are limited to definitions so that load order only
;;;; matters at call time.

(setq *package* (find-package "COMMON-LISP"))

(defvar *gensym-counter* 0)

(defun gensym (&optional (prefix "G"))
  (setq *gensym-counter* (+ *gensym-counter* 1))
  (make-symbol (%string-concat (if (stringp prefix) prefix "G")
                               (%number-to-string *gensym-counter*))))

(defun caadr (x) (car (car (cdr x))))
(defun cdadr (x) (cdr (car (cdr x))))
(defun cadar (x) (car (cdr (car x))))
(defun cddar (x) (cdr (cdr (car x))))
(defun caaar (x) (car (car (car x))))
(defun cdaar (x) (cdr (car (car x))))
(defun cdddar (x) (cdr (cdr (cdr (car x)))))
(defun fourth (l) (cadddr l))
(defun fifth (l) (car (cddddr l)))
(defun sixth (l) (cadr (cddddr l)))

(defun %fn-symbol (name)
  (if (and (consp name) (eq (car name) 'setf))
      (intern (%string-concat "(SETF " (symbol-name (cadr name)) ")") (symbol-package (cadr name)))
      name))

(defmacro in-package (name)
  (list 'setq '*package* (list 'find-package (list 'quote name))))

(defmacro lambda (&rest r) (list 'function (cons 'lambda r)))

(defmacro return (&optional v) (list 'return-from nil v))

;;; Macro versions of operators that the evaluator implements natively.  The
;;; compiler (lisp/compiler) relies on these expansions.
(defmacro when (test &body body) `(if ,test (progn ,@body) nil))
(defmacro unless (test &body body) `(if ,test nil (progn ,@body)))
(defmacro and (&rest forms)
  (cond ((null forms) t)
        ((null (cdr forms)) (car forms))
        (t `(if ,(car forms) (and ,@(cdr forms)) nil))))
(defmacro or (&rest forms)
  (cond ((null forms) nil)
        ((null (cdr forms)) (car forms))
        (t (let ((g (gensym)))
             `(let ((,g ,(car forms))) (if ,g ,g (or ,@(cdr forms))))))))
(defmacro cond (&rest clauses)
  (if (null clauses)
      nil
      (let ((c (car clauses)))
        (if (null (cdr c))
            `(or ,(car c) (cond ,@(cdr clauses)))
            `(if ,(car c) (progn ,@(cdr c)) (cond ,@(cdr clauses)))))))

(defmacro prog1 (first &rest rest)
  (let ((g (gensym))) `(let ((,g ,first)) ,@rest ,g)))
(defmacro prog2 (first second &rest rest)
  `(progn ,first (prog1 ,second ,@rest)))

(defmacro dolist ((var list &optional result) &body body)
  (let ((l (gensym)) (top (gensym)))
    `(block nil
       (let ((,l ,list))
         (tagbody ,top
            (if (null ,l) (return-from nil (let ((,var nil)) ,result)))
            (let ((,var (car ,l))) ,@body)
            (setq ,l (cdr ,l))
            (go ,top))))))

(defmacro dotimes ((var count &optional result) &body body)
  (let ((n (gensym)) (top (gensym)))
    `(block nil
       (let ((,n ,count) (,var 0))
         (tagbody ,top
            (if (>= ,var ,n) (return-from nil ,result))
            (let ((,var ,var)) ,@body)
            (setq ,var (+ ,var 1))
            (go ,top))))))

(defmacro declaim (&rest specs) (list 'progn (list '%declaim (list 'quote specs))))
(defmacro proclaim (spec) (list '%declaim spec))
(defun %declaim (specs)
  (dolist (s specs)
    (when (and (consp s) (eq (car s) 'special))
      (dolist (v (cdr s)) (%proclaim-special v))))
  nil)

;;; ---- basic list utilities -------------------------------------------------

(defun mapcar (fn list &rest more)
  (if (null more)
      (let ((acc nil))
        (dolist (x list) (setq acc (cons (funcall fn x) acc)))
        (nreverse acc))
      (let ((lists (cons list more)) (acc nil))
        (block done
          (tagbody top
             (let ((args nil) (rests nil))
               (dolist (l lists)
                 (if (null l) (return-from done nil))
                 (setq args (cons (car l) args))
                 (setq rests (cons (cdr l) rests)))
               (setq acc (cons (apply fn (nreverse args)) acc))
               (setq lists (nreverse rests)))
             (go top)))
        (nreverse acc))))

(defun mapc (fn list &rest more)
  (if (null more)
      (dolist (x list) (funcall fn x))
      (apply #'mapcar fn list more))
  list)

(defun mapcan (fn list &rest more)
  (apply #'nconc (apply #'mapcar fn list more)))

(defun maplist (fn list)
  (let ((acc nil))
    (do-list-tails (l list) (setq acc (cons (funcall fn l) acc)))
    (nreverse acc)))

(defmacro do-list-tails ((var list) &body body)
  (let ((top (gensym)))
    `(let ((,var ,list))
       (block nil
         (tagbody ,top
            (if (null ,var) (return-from nil nil))
            ,@body
            (setq ,var (cdr ,var))
            (go ,top))))))

(defun %test-fn (test test-not)
  (cond (test (if (symbolp test) (symbol-function test) test))
        (test-not (let ((f (if (symbolp test-not) (symbol-function test-not) test-not)))
                    (lambda (a b) (not (funcall f a b)))))
        (t #'eql)))

(defun member (item list &key key test test-not)
  (cond ((and (null key) (null test) (null test-not)) (memql item list))
        (t (let ((f (%test-fn test test-not)))
             (do-list-tails (l list)
               (when (funcall f item (if key (funcall key (car l)) (car l)))
                 (return-from member l)))
             nil))))

(defun member-if (pred list &key key)
  (do-list-tails (l list) (when (funcall pred (if key (funcall key (car l)) (car l))) (return-from member-if l)))
  nil)
(defun member-if-not (pred list &key key) (member-if (lambda (x) (not (funcall pred x))) list :key key))
(defun assoc-if (pred alist &key key)
  (dolist (e alist nil) (when (and (consp e) (funcall pred (if key (funcall key (car e)) (car e)))) (return e))))

(defun assoc (item alist &key key test test-not)
  (cond ((and (null key) (null test) (null test-not)) (assql item alist))
        (t (let ((f (%test-fn test test-not)))
             (dolist (e alist nil)
               (when (and (consp e) (funcall f item (if key (funcall key (car e)) (car e))))
                 (return-from assoc e)))))))

(defun rassoc (item alist &key key test)
  (let ((f (%test-fn test nil)))
    (dolist (e alist nil)
      (when (and (consp e) (funcall f item (if key (funcall key (cdr e)) (cdr e))))
        (return-from rassoc e)))))

(defun acons (k v alist) (cons (cons k v) alist))
(defun pairlis (keys vals &optional alist)
  (let ((acc alist))
    (loop-pairs keys vals (lambda (k v) (setq acc (cons (cons k v) acc))))
    acc))
(defun loop-pairs (a b fn)
  (do-list-tails (x a) (when (null b) (return-from loop-pairs nil))
    (funcall fn (car x) (car b)) (setq b (cdr b))))

(defun identity-fn (x) x)

(defun remove-if (pred seq &key key from-end count)
  (declare (ignore from-end))
  (if (listp seq)
      (let ((acc nil) (n 0))
        (dolist (x seq)
          (if (and (funcall pred (if key (funcall key x) x)) (or (null count) (< n count)))
              (setq n (+ n 1))
              (setq acc (cons x acc))))
        (nreverse acc))
      (coerce (remove-if pred (%vector-to-list seq) :key key :count count)
              (if (stringp seq) 'string 'vector))))

(defun remove-if-not (pred seq &key key)
  (remove-if (lambda (x) (not (funcall pred x))) seq :key key))

(defun remove (item seq &key key test test-not count from-end)
  (let ((f (%test-fn test test-not)))
    (remove-if (lambda (x) (funcall f item x)) seq :key key :count count :from-end from-end)))

(defun delete (item seq &rest keys) (apply #'remove item seq keys))
(defun delete-if (pred seq &rest keys) (apply #'remove-if pred seq keys))
(defun delete-if-not (pred seq &rest keys) (apply #'remove-if-not pred seq keys))

(defun %elt-list (seq) (if (listp seq) seq (%vector-to-list seq)))

(defun find-if (pred seq &key key from-end)
  (let ((r nil) (found nil))
    (dolist (x (%elt-list seq))
      (when (funcall pred (if key (funcall key x) x))
        (setq r x found t)
        (unless from-end (return))))
    r))
(defun find-if-not (pred seq &key key) (find-if (lambda (x) (not (funcall pred x))) seq :key key))
(defun find (item seq &key key test test-not from-end)
  (let ((f (%test-fn test test-not)))
    (find-if (lambda (x) (funcall f item x)) seq :key key :from-end from-end)))

(defun position-if (pred seq &key key from-end start end)
  (let ((i 0) (r nil))
    (dolist (x (%elt-list seq))
      (when (and (or (null start) (>= i start)) (or (null end) (< i end))
                 (funcall pred (if key (funcall key x) x)))
        (setq r i)
        (unless from-end (return)))
      (setq i (+ i 1)))
    r))
(defun position-if-not (pred seq &key key) (position-if (lambda (x) (not (funcall pred x))) seq :key key))
(defun position (item seq &key key test test-not from-end start end)
  (let ((f (%test-fn test test-not)))
    (position-if (lambda (x) (funcall f item x)) seq :key key :from-end from-end :start start :end end)))

(defun count-if (pred seq &key key)
  (let ((n 0))
    (dolist (x (%elt-list seq)) (when (funcall pred (if key (funcall key x) x)) (setq n (+ n 1))))
    n))
(defun count (item seq &key key test test-not)
  (let ((f (%test-fn test test-not)))
    (count-if (lambda (x) (funcall f item x)) seq :key key)))

(defun some (pred seq &rest more)
  (if (null more)
      (dolist (x (%elt-list seq) nil)
        (let ((v (funcall pred x))) (when v (return v))))
      (let ((lists (mapcar #'%elt-list (cons seq more))))
        (block done
          (tagbody top
             (dolist (l lists) (when (null l) (return-from done nil)))
             (let ((v (apply pred (mapcar #'car lists))))
               (when v (return-from done v)))
             (setq lists (mapcar #'cdr lists))
             (go top))))))
(defun every (pred seq &rest more)
  (if (null more)
      (dolist (x (%elt-list seq) t) (unless (funcall pred x) (return nil)))
      (let ((lists (mapcar #'%elt-list (cons seq more))))
        (block done
          (tagbody top
             (dolist (l lists) (when (null l) (return-from done t)))
             (unless (apply pred (mapcar #'car lists)) (return-from done nil))
             (setq lists (mapcar #'cdr lists))
             (go top))))))
(defun notany (pred seq &rest more) (not (apply #'some pred seq more)))
(defun notevery (pred seq &rest more) (not (apply #'every pred seq more)))

(defun reduce (fn seq &key key from-end (initial-value nil iv-p))
  (let ((items (%elt-list seq)))
    (when key (setq items (mapcar key items)))
    (when from-end (setq items (reverse items)))
    (cond ((and (null items) (not iv-p)) (funcall fn))
          (t (let ((acc (if iv-p initial-value (car items)))
                   (rest (if iv-p items (cdr items))))
               (dolist (x rest acc)
                 (setq acc (if from-end (funcall fn x acc) (funcall fn acc x)))))))))

(defun copy-seq (s) (if (listp s) (copy-list s) (subseq s 0)))
(defun revappend (a b) (nconc (reverse a) b))
(defun nreconc (a b) (nconc (nreverse a) b))
(defun butlast (list &optional (n 1))
  (let ((len (length list)))
    (if (<= len n) nil (subseq list 0 (- len n)))))
(defun nbutlast (list &optional (n 1)) (butlast list n))
(defun list-length (l) (length l))
(defun endp (x) (null x))
(defun tailp (sub list) (do-list-tails (l list) (when (eq l sub) (return-from tailp t))) (eq sub nil))
(defun ldiff (list sub)
  (let ((acc nil))
    (do-list-tails (l list) (when (eq l sub) (return-from ldiff (nreverse acc))) (setq acc (cons (car l) acc)))
    (nreverse acc)))
(defun make-list (n &key initial-element)
  (let ((acc nil)) (dotimes (i n) (setq acc (cons initial-element acc))) acc))
(defun iota (n &optional (start 0) (step 1))
  (let ((acc nil) (v start)) (dotimes (i n) (setq acc (cons v acc)) (setq v (+ v step))) (nreverse acc)))

(defun %plist-put (plist key value)
  "PLIST with KEY set to VALUE: the cell is changed in place when KEY is present, otherwise a new pair is added in front."
  (do-list-tails (l plist)
    (when (eq (car l) key) (setf (car (cdr l)) value) (return-from %plist-put plist))
    (setq l (cdr l)))
  (cons key (cons value plist)))

(defun getf (plist key &optional default)
  (do-list-tails (l plist)
    (when (eq (car l) key) (return-from getf (cadr l)))
    (setq l (cdr l)))
  default)

(defun union (a b &key key test)
  (let ((r b))
    (dolist (x a) (unless (member (if key (funcall key x) x) b :key key :test test) (setq r (cons x r))))
    r))
(defun intersection (a b &key key test)
  (let ((r nil))
    (dolist (x a) (when (member (if key (funcall key x) x) b :key key :test test) (setq r (cons x r))))
    (nreverse r)))
(defun set-difference (a b &key key test)
  (let ((r nil))
    (dolist (x a) (unless (member (if key (funcall key x) x) b :key key :test test) (setq r (cons x r))))
    (nreverse r)))
(defun subsetp (a b &key key test)
  (every (lambda (x) (member (if key (funcall key x) x) b :key key :test test)) a))
(defun adjoin (item list &key key test)
  (if (member (if key (funcall key item) item) list :key key :test test) list (cons item list)))
(defun remove-duplicates (seq &key key test from-end)
  "Remove duplicates from SEQ.  By default the last of equal elements is kept (as in Common Lisp); with FROM-END the first."
  (let* ((f (%test-fn test nil)) (items (%elt-list seq)) (acc nil))
    (if from-end
        (dolist (x items) (unless (member-by f (if key (funcall key x) x) acc key) (setq acc (cons x acc))))
        (do-list-tails (l items)
          (let ((x (car l)))
            (unless (member-by f (if key (funcall key x) x) (cdr l) key) (setq acc (cons x acc))))))
    (let ((r (nreverse acc)))
      (if (listp seq) r (coerce r (if (stringp seq) 'string 'vector))))))
(defun member-by (f item list key)
  (dolist (y list nil)
    (when (funcall f item (if key (funcall key y) y)) (return t))))

(defun subst (new old tree &key test)
  (let ((f (%test-fn test nil)))
    (labels ((walk (x) (cond ((funcall f old x) new)
                             ((consp x) (cons (walk (car x)) (walk (cdr x))))
                             (t x))))
      (walk tree))))
(defun tree-equal (a b) (equal a b))

(defun %merge-lists (a b pred key)
  (let ((acc nil))
    (block done
      (tagbody top
         (cond ((null a) (return-from done (nreconc acc b)))
               ((null b) (return-from done (nreconc acc a)))
               ((funcall pred (if key (funcall key (car b)) (car b)) (if key (funcall key (car a)) (car a)))
                (setq acc (cons (car b) acc)) (setq b (cdr b)))
               (t (setq acc (cons (car a) acc)) (setq a (cdr a))))
         (go top)))))
(defun %sort-list (list pred key)
  (let ((n (length list)))
    (if (< n 2)
        list
        (let* ((half (floor n 2)) (a (subseq list 0 half)) (b (subseq list half)))
          (%merge-lists (%sort-list a pred key) (%sort-list b pred key) pred key)))))
(defun sort (seq pred &key key)
  (cond ((listp seq) (%sort-list (copy-list seq) pred key))
        (t (let ((sorted (%sort-list (%vector-to-list seq) pred key)) (i 0))
             (dolist (x sorted) (%aset seq i x) (setq i (+ i 1)))
             seq))))
(defun stable-sort (seq pred &key key) (sort seq pred :key key))
(defun merge-lists (a b pred &key key) (%merge-lists a b pred key))

(defun %string-designator (x) (if (stringp x) x (string x)))

(defun %pairs-to-bindings (pairs) pairs)

;;; ---- macros ---------------------------------------------------------------

(defmacro case (key &rest clauses)
  (let ((k (gensym)))
    `(let ((,k ,key))
       (cond ,@(mapcar (lambda (clause)
                         (let ((keys (car clause)) (body (or (cdr clause) '(nil))))
                           (cond ((or (eq keys t) (eq keys 'otherwise)) `(t ,@body))
                                 ((null keys) `(nil ,@body))
                                 ((listp keys) `((memql ,k ',keys) ,@body))
                                 (t `((eql ,k ',keys) ,@body)))))
                       clauses)))))

(defmacro ecase (key &rest clauses)
  (let ((k (gensym)))
    `(let ((,k ,key))
       (case ,k ,@clauses (t (error "~S fell through an ECASE expression" ,k))))))

(defmacro psetq (&rest pairs)
  (let ((bindings nil) (assigns nil))
    (do-list-tails (p pairs)
      (let ((g (gensym)))
        (setq bindings (cons (list g (cadr p)) bindings))
        (setq assigns (cons (list 'setq (car p) g) assigns))
        (setq p (cdr p))))
    `(let ,(nreverse bindings) ,@(nreverse assigns) nil)))

(defmacro do (varlist (test &rest result) &body body)
  (let ((top (gensym)))
    `(block nil
       (let ,(mapcar (lambda (v) (if (consp v) (list (car v) (cadr v)) v)) varlist)
         (tagbody ,top
            (when ,test (return-from nil (progn ,@result)))
            ,@body
            (psetq ,@(%do-steps varlist))
            (go ,top))))))
(defmacro do* (varlist (test &rest result) &body body)
  (let ((top (gensym)))
    `(block nil
       (let* ,(mapcar (lambda (v) (if (consp v) (list (car v) (cadr v)) v)) varlist)
         (tagbody ,top
            (when ,test (return-from nil (progn ,@result)))
            ,@body
            (setq ,@(%do-steps varlist))
            (go ,top))))))
(defun %do-steps (varlist)
  (let ((acc nil))
    (dolist (v varlist)
      (when (and (consp v) (cddr v)) (setq acc (cons (caddr v) (cons (car v) acc)))))
    (nreverse acc)))

(defmacro multiple-value-bind (vars form &body body)
  (let ((rest (gensym)))
    `(multiple-value-call (lambda (&optional ,@vars &rest ,rest) (declare (ignore ,rest)) ,@body) ,form)))
(defmacro multiple-value-list (form) `(multiple-value-call #'list ,form))
(defmacro multiple-value-setq (vars form)
  (let ((temps (mapcar (lambda (v) (gensym)) vars)))
    `(multiple-value-bind ,temps ,form ,@(mapcar (lambda (v tmp) `(setq ,v ,tmp)) vars temps) ,(car temps))))
(defmacro nth-value (n form) `(nth ,n (multiple-value-list ,form)))

(defmacro prog (bindings &body body) `(block nil (let ,bindings (tagbody ,@body))))
(defmacro prog* (bindings &body body) `(block nil (let* ,bindings (tagbody ,@body))))

(defmacro unwind-protect* (&rest r) `(unwind-protect ,@r))

(defmacro assert (test &rest r)
  (declare (ignore r))
  `(unless ,test (error "Assertion failed: ~S" ',test)))

(defmacro destructuring-bind (pattern expr &body body)
  (let ((g (gensym)))
    (let ((bindings (%dbind-bindings pattern g)))
      `(let* ((,g ,expr) ,@bindings)
         (declare (ignorable ,@(mapcar #'car bindings)))
         ,@body))))

(defun %dbind-bindings (pattern g)
  ;; Returns a flat list of (var init) for LET* that destructures the list
  ;; held in variable G according to the lambda list PATTERN.
  (let ((bindings nil) (mode :req) (p pattern) (cur g))
    (flet ((add (var init) (setq bindings (cons (list var init) bindings)))
           (advance ()
             (let ((nxt (gensym)))
               (setq bindings (cons (list nxt (list 'cdr cur)) bindings))
               (setq cur nxt))))
      (when (and (consp p) (eq (car p) '&whole))
        (add (cadr p) g)
        (setq p (cddr p)))
      (block parse
        (tagbody top
           (cond ((null p) (return-from parse nil))
                 ((symbolp p) (add p cur) (return-from parse nil)))
           (let ((item (car p)))
             (setq p (cdr p))
             (cond ((eq item '&optional) (setq mode :opt))
                   ((or (eq item '&rest) (eq item '&body)) (add (car p) cur) (setq p (cdr p)))
                   ((eq item '&key) (setq mode :key))
                   ((eq item '&aux) (setq mode :aux))
                   ((eq item '&allow-other-keys) nil)
                   ((eq item '&environment) (setq p (cdr p)))
                   ((eq mode :req)
                    (if (consp item)
                        (let ((sub (gensym)))
                          (add sub (list 'car cur))
                          (dolist (b (%dbind-bindings item sub)) (setq bindings (cons b bindings))))
                        (add item (list 'if cur (list 'car cur)
                                        (list 'error "Too few arguments to destructuring-bind"))))
                    (advance))
                   ((eq mode :opt)
                    (let ((var (if (consp item) (car item) item))
                          (def (if (consp item) (cadr item) nil))
                          (svar (if (consp item) (caddr item) nil)))
                      (when svar (add svar (list 'if cur t nil)))
                      (add var (list 'if cur (list 'car cur) def))
                      (advance)))
                   ((eq mode :key)
                    (let* ((spec (if (consp item) (car item) item))
                           (var (if (consp spec) (cadr spec) spec))
                           (kw (if (consp spec) (car spec) (intern (symbol-name var) "KEYWORD")))
                           (def (if (consp item) (cadr item) nil))
                           (svar (if (consp item) (caddr item) nil))
                           (probe (gensym)))
                      (add probe (list '%getf-key cur (list 'quote kw)))
                      (when svar (add svar (list 'not (list '%unsupplied-p probe))))
                      (add var (list 'if (list '%unsupplied-p probe) def probe))))
                   ((eq mode :aux)
                    (add (if (consp item) (car item) item) (if (consp item) (cadr item) nil)))))
           (go top))))
    (nreverse bindings)))
