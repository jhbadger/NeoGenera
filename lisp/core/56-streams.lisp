;;;; 56-streams.lisp -- Gray-style extensible streams and composite streams.
;;;;
;;;; The C kernel only knows native streams (stdio, files, string streams).  The
;;;; standard stream functions are redefined here as wrappers: a native stream
;;;; takes the fast path into the kernel (%C-* primitives), anything else is
;;;; treated as a CLOS stream and dispatched through the STREAM-* protocol.
;;;; Limitation: READ on a Gray stream consumes whole lines until a form parses.

(in-package :cl)

(%put 'end-of-file '%report (lambda (c s) (declare (ignore c)) (write-string "End of file" s)))

(defclass fundamental-stream () ())
(defclass fundamental-input-stream (fundamental-stream) ())
(defclass fundamental-output-stream (fundamental-stream) ())
(defclass fundamental-character-input-stream (fundamental-input-stream) ())
(defclass fundamental-character-output-stream (fundamental-output-stream) ((column :initform 0)))

(defgeneric stream-read-char (stream))
(defgeneric stream-unread-char (stream char))
(defgeneric stream-peek-char (stream))
(defgeneric stream-read-line (stream))
(defgeneric stream-listen (stream))
(defgeneric stream-write-char (stream char))
(defgeneric stream-write-string (stream string &optional start end))
(defgeneric stream-terpri (stream))
(defgeneric stream-fresh-line (stream))
(defgeneric stream-line-column (stream))
(defgeneric stream-finish-output (stream))
(defgeneric stream-close (stream))

(defmethod stream-peek-char ((s fundamental-character-input-stream))
  (let ((c (stream-read-char s)))
    (unless (eq c :eof) (stream-unread-char s c))
    c))

(defmethod stream-read-line ((s fundamental-character-input-stream))
  (let ((acc nil) (c nil))
    (loop
      (setq c (stream-read-char s))
      (cond ((eq c :eof)
             (return (if acc (values (coerce (nreverse acc) 'string) t) (values :eof t))))
            ((eql c #\Newline) (return (values (coerce (nreverse acc) 'string) nil)))
            (t (setq acc (cons c acc)))))))

(defmethod stream-listen ((s fundamental-character-input-stream))
  (not (eq (stream-peek-char s) :eof)))

(defmethod stream-write-string ((s fundamental-character-output-stream) string &optional start end)
  (let ((e (or end (length string))))
    (do ((i (or start 0) (+ i 1))) ((>= i e))
      (stream-write-char s (char string i)))
    string))

(defmethod stream-write-char :after ((s fundamental-character-output-stream) ch)
  (setf (slot-value s 'column) (if (eql ch #\Newline) 0 (+ 1 (slot-value s 'column)))))

(defmethod stream-write-string :after ((s fundamental-character-output-stream) string &optional start end)
  (let* ((e (or end (length string))) (b (or start 0)) (nl (position #\Newline string :from-end t :end e :start b)))
    (when (and nl (>= nl b))
      (setf (slot-value s 'column) (- e nl 1)))
    (unless nl (setf (slot-value s 'column) (+ (slot-value s 'column) 0)))))

(defmethod stream-terpri ((s fundamental-character-output-stream)) (stream-write-char s #\Newline) nil)
(defmethod stream-line-column ((s fundamental-character-output-stream)) (slot-value s 'column))
(defmethod stream-fresh-line ((s fundamental-character-output-stream))
  (let ((col (stream-line-column s)))
    (if (and col (= col 0)) nil (progn (stream-terpri s) t))))
(defmethod stream-finish-output ((s fundamental-stream)) nil)
(defmethod stream-close ((s fundamental-stream)) nil)

;;; ---- standard functions as wrappers ---------------------------------------------------

(defun %out (s) (cond ((null s) *standard-output*) ((eq s t) *standard-output*) (t s)))
(defun %in (s) (cond ((null s) *standard-input*) ((eq s t) *standard-input*) (t s)))
(defun %to-simple-string (s) (if (stringp s) s (coerce s 'string)))

(defun streamp (x) (or (%native-stream-p x) (typep x 'fundamental-stream)))
(defun input-stream-p (x) (or (%native-stream-p x) (typep x 'fundamental-input-stream)))
(defun output-stream-p (x) (or (%native-stream-p x) (typep x 'fundamental-output-stream)))
(defun open-stream-p (x) (declare (ignore x)) t)

(defun write-string (string &optional stream start end)
  (let ((s (%out stream)))
    (if (%native-stream-p s)
        (%c-write-string string s start end)
        (stream-write-string s (%to-simple-string string) start end))
    string))
(defun write-char (ch &optional stream)
  (let ((s (%out stream)))
    (if (%native-stream-p s) (%c-write-char ch s) (stream-write-char s ch))
    ch))
(defun terpri (&optional stream)
  (let ((s (%out stream)))
    (if (%native-stream-p s) (%c-terpri s) (stream-terpri s))
    nil))
(defun fresh-line (&optional stream)
  (let ((s (%out stream)))
    (if (%native-stream-p s) (%c-fresh-line s) (stream-fresh-line s))))
(defun prin1 (x &optional stream)
  (let ((s (%out stream)))
    (if (%native-stream-p s) (%c-prin1 x s) (stream-write-string s (prin1-to-string x) nil nil))
    x))
(defun princ (x &optional stream)
  (let ((s (%out stream)))
    (if (%native-stream-p s) (%c-princ x s) (stream-write-string s (princ-to-string x) nil nil))
    x))
(defun print (x &optional stream)
  (let ((s (%out stream)))
    (if (%native-stream-p s)
        (%c-print x s)
        (progn (stream-terpri s) (stream-write-string s (prin1-to-string x) nil nil) (stream-write-char s #\Space)))
    x))
(defun write-line (string &optional stream)
  (let ((s (%out stream)))
    (if (%native-stream-p s)
        (%c-write-line string s)
        (progn (stream-write-string s (%to-simple-string string) nil nil) (stream-terpri s)))
    string))
(defun finish-output (&optional stream)
  (let ((s (%out stream))) (if (%native-stream-p s) (%c-finish-output s) (stream-finish-output s)) nil))
(defun force-output (&optional stream) (finish-output stream))
(defun %stream-column (stream)
  (let ((s (%out stream)))
    (if (%native-stream-p s) (%c-stream-column s) (or (stream-line-column s) 0))))
(defun close (stream &rest keys)
  (declare (ignore keys))
  (if (%native-stream-p stream) (%c-close stream) (stream-close stream))
  t)

(defun %eof-result (s eof-error-p eof-value)
  (if eof-error-p (error 'end-of-file :stream s) eof-value))

(defun read-char (&optional stream (eof-error-p t) eof-value recursive)
  (declare (ignore recursive))
  (let ((s (%in stream)))
    (if (%native-stream-p s)
        (%c-read-char s eof-error-p eof-value)
        (let ((c (stream-read-char s)))
          (if (eq c :eof) (%eof-result s eof-error-p eof-value) c)))))
(defun unread-char (ch &optional stream)
  (let ((s (%in stream)))
    (if (%native-stream-p s) (%c-unread-char ch s) (stream-unread-char s ch))
    nil))
(defun peek-char (&optional peek-type stream (eof-error-p t) eof-value recursive)
  (declare (ignore recursive))
  (let ((s (%in stream)))
    (if (%native-stream-p s)
        (%c-peek-char peek-type s eof-error-p eof-value)
        (progn
          (when (eq peek-type t)
            (loop
              (let ((c (stream-read-char s)))
                (cond ((eq c :eof) (return))
                      ((whitespace-char-p c) nil)
                      (t (stream-unread-char s c) (return))))))
          (let ((c (stream-peek-char s)))
            (if (eq c :eof) (%eof-result s eof-error-p eof-value) c))))))
(defun read-line (&optional stream (eof-error-p t) eof-value recursive)
  (declare (ignore recursive))
  (let ((s (%in stream)))
    (if (%native-stream-p s)
        (%c-read-line s eof-error-p eof-value)
        (multiple-value-bind (line missing) (stream-read-line s)
          (if (eq line :eof) (values (%eof-result s eof-error-p eof-value) t) (values line missing))))))
(defun listen (&optional stream)
  (let ((s (%in stream))) (if (%native-stream-p s) t (stream-listen s))))
(defun read (&optional stream (eof-error-p t) eof-value recursive)
  (declare (ignore recursive))
  (let ((s (%in stream)))
    (if (%native-stream-p s)
        (%c-read s eof-error-p eof-value)
        (let ((acc ""))
          (loop
            (multiple-value-bind (line missing) (stream-read-line s)
              (declare (ignore missing))
              (when (eq line :eof)
                (return (if (every #'whitespace-char-p acc)
                            (%eof-result s eof-error-p eof-value)
                            (error "End of file while reading"))))
              (setq acc (concatenate 'string acc line (string #\Newline)))
              (let ((r (handler-case (multiple-value-list (%read-from-string acc 0)) (error () nil))))
                (when (and r (not (eq (car r) (%eof-object))))
                  (return (car r))))))))))

;;; ---- composite streams ------------------------------------------------------------------

(defclass synonym-stream (fundamental-character-output-stream fundamental-character-input-stream)
  ((symbol :initarg :symbol :reader synonym-stream-symbol)))
(defun make-synonym-stream (symbol) (make-instance 'synonym-stream :symbol symbol))
(defmethod stream-write-char ((s synonym-stream) ch) (write-char ch (symbol-value (synonym-stream-symbol s))))
(defmethod stream-write-string ((s synonym-stream) string &optional start end)
  (write-string string (symbol-value (synonym-stream-symbol s)) start end))
(defmethod stream-line-column ((s synonym-stream)) (%stream-column (symbol-value (synonym-stream-symbol s))))
(defmethod stream-finish-output ((s synonym-stream)) (finish-output (symbol-value (synonym-stream-symbol s))))
(defmethod stream-read-char ((s synonym-stream)) (read-char (symbol-value (synonym-stream-symbol s)) nil :eof))
(defmethod stream-unread-char ((s synonym-stream) ch) (unread-char ch (symbol-value (synonym-stream-symbol s))))

(defclass broadcast-stream (fundamental-character-output-stream)
  ((streams :initarg :streams :reader broadcast-stream-streams)))
(defun make-broadcast-stream (&rest streams) (make-instance 'broadcast-stream :streams streams))
(defmethod stream-write-char ((s broadcast-stream) ch)
  (dolist (x (broadcast-stream-streams s)) (write-char ch x)))
(defmethod stream-write-string ((s broadcast-stream) string &optional start end)
  (dolist (x (broadcast-stream-streams s)) (write-string string x start end)))
(defmethod stream-line-column ((s broadcast-stream))
  (let ((l (car (last (broadcast-stream-streams s))))) (if l (%stream-column l) 0)))
(defmethod stream-finish-output ((s broadcast-stream))
  (dolist (x (broadcast-stream-streams s)) (finish-output x)))

(defclass two-way-stream (fundamental-character-output-stream fundamental-character-input-stream)
  ((in :initarg :in :reader two-way-stream-input-stream)
   (out :initarg :out :reader two-way-stream-output-stream)))
(defun make-two-way-stream (in out) (make-instance 'two-way-stream :in in :out out))
(defmethod stream-write-char ((s two-way-stream) ch) (write-char ch (two-way-stream-output-stream s)))
(defmethod stream-write-string ((s two-way-stream) string &optional start end)
  (write-string string (two-way-stream-output-stream s) start end))
(defmethod stream-line-column ((s two-way-stream)) (%stream-column (two-way-stream-output-stream s)))
(defmethod stream-finish-output ((s two-way-stream)) (finish-output (two-way-stream-output-stream s)))
(defmethod stream-read-char ((s two-way-stream)) (read-char (two-way-stream-input-stream s) nil :eof))
(defmethod stream-unread-char ((s two-way-stream) ch) (unread-char ch (two-way-stream-input-stream s)))

(defclass echo-stream (two-way-stream) ())
(defun make-echo-stream (in out) (make-instance 'echo-stream :in in :out out))
(defmethod stream-read-char ((s echo-stream))
  (let ((c (read-char (two-way-stream-input-stream s) nil :eof)))
    (unless (eq c :eof) (write-char c (two-way-stream-output-stream s)))
    c))

(defclass concatenated-stream (fundamental-character-input-stream)
  ((streams :initarg :streams :accessor concatenated-stream-streams)
   (current :initform nil)))
(defun make-concatenated-stream (&rest streams) (make-instance 'concatenated-stream :streams streams))
(defmethod stream-read-char ((s concatenated-stream))
  (loop
    (let ((streams (concatenated-stream-streams s)))
      (when (null streams) (return :eof))
      (let ((c (read-char (car streams) nil :eof)))
        (if (eq c :eof)
            (setf (concatenated-stream-streams s) (cdr streams))
            (progn (setf (slot-value s 'current) (car streams)) (return c)))))))
(defmethod stream-unread-char ((s concatenated-stream) ch)
  (unread-char ch (slot-value s 'current)))

(defvar *terminal-io* (make-two-way-stream *standard-input* *standard-output*))
(defvar *query-io* *terminal-io*)
(defvar *debug-io* *terminal-io*)
(defvar *trace-output* *standard-output*)
