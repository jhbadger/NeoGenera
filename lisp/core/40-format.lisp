;;;; 40-format.lisp -- FORMAT, string streams, errors, FILE I/O macros, LOAD.

(in-package :cl)

;;; ---- bootstrap error (replaced by the condition system in 54-conditions.lisp) ----

(defun error (fmt &rest args)
  (%error-to-top (if (stringp fmt) (apply #'format nil fmt args) (format nil "~A~{ ~S~}" fmt args))))

(defun warn (fmt &rest args)
  (format *error-output* "~&WARNING: ~A~%" (apply #'format nil fmt args))
  nil)

;;; ---- time ---------------------------------------------------------------------

(defmacro time (form) `(%time-it (lambda () ,form)))
(defun %time-it (thunk)
  (let* ((start (get-internal-real-time))
         (gcs (%gc-count))
         (r (multiple-value-list (funcall thunk)))
         (us (- (get-internal-real-time) start)))
    (format *error-output* "~&; Evaluation took ~D.~3,'0D seconds (~D GCs)~%"
            (floor us 1000000) (floor (mod us 1000000) 1000) (- (%gc-count) gcs))
    (values-list r)))

;;; ---- streams and file I/O -------------------------------------------------------

(defmacro with-output-to-string ((var) &body body)
  `(let ((,var (make-string-output-stream)))
     ,@body
     (get-output-stream-string ,var)))
(defmacro with-input-from-string ((var string) &body body)
  `(let ((,var (make-string-input-stream ,string))) ,@body))

(defun %native-namestring (x) (if (stringp x) x (string x)))   ; the full version (pathnames) is in 64-pathnames.lisp

(defun open (path &key (direction :input) (if-exists :supersede) (if-does-not-exist :default) element-type)
  (declare (ignore element-type))
  (let ((p (%native-namestring path)))
    (when (and (eq direction :input) (not (probe-file p)))
      (if (eq if-does-not-exist :create) nil (error "File not found: ~A" p)))
    (let ((s (%open p (if (and (eq direction :output) (eq if-exists :append)) :append direction) if-exists)))
      (unless s (error "Cannot open file: ~A" p))
      s)))

(defmacro with-open-file ((var path &rest options) &body body)
  `(let ((,var (open ,path ,@options)))
     (unwind-protect (progn ,@body) (close ,var))))

(defun read-from-string (string &optional (eof-error-p t) eof-value &key (start 0) end)
  (declare (ignore end))
  (multiple-value-bind (obj pos) (%read-from-string string start)
    (if (eq obj (%eof-object))
        (if eof-error-p (error "End of file in READ-FROM-STRING") eof-value)
        (values obj pos))))
(defun %eof-object () (%read-from-string "" 0))

(defun write-to-string (obj &rest r) (declare (ignore r)) (prin1-to-string obj))
(defun write (obj &key stream escape &allow-other-keys)
  (if (or escape (null escape))
      (prin1 obj stream)
      (princ obj stream))
  obj)

(defvar *load-pathname* nil)
(defvar *load-verbose* nil)

(defun eval (form) (%eval form))

(defun load (path &key verbose print if-does-not-exist)
  (declare (ignore if-does-not-exist))
  (let ((*package* *package*) (*load-pathname* (if (fboundp 'pathname) (funcall 'pathname path) path)))
    (with-open-file (s path)
      (let ((eof (list nil)))
        (block nil
          (tagbody top
             (let ((form (read s nil eof)))
               (when (eq form eof) (return))
               (let ((v (eval form)))
                 (when print (format t "~&; ~S~%" v))))
             (go top))))))
  (when verbose (format *error-output* "~&; loaded ~A~%" path))
  t)

(defun %read-all-forms (path)
  (with-open-file (s path)
    (let ((eof (list nil)) (acc nil))
      (block nil
        (tagbody top
           (let ((form (read s nil eof)))
             (when (eq form eof) (return))
             (setq acc (cons form acc)))
           (go top)))
      (nreverse acc))))

;;; ---- FORMAT ----------------------------------------------------------------------

(defun format (dest control &rest args)
  (let ((stream (cond ((null dest) (make-string-output-stream))
                      ((eq dest t) *standard-output*)
                      ((stringp dest) (make-string-output-stream))
                      (t dest))))
    (%format-run stream control args)
    (if (or (null dest) (stringp dest)) (get-output-stream-string stream) nil)))

(defun %fmt-pad (stream s mincol padchar left)
  (let ((n (length s)))
    (if (and mincol (< n mincol))
        (if left
            (progn (write-string s stream) (dotimes (i (- mincol n)) (write-char padchar stream)))
            (progn (dotimes (i (- mincol n)) (write-char padchar stream)) (write-string s stream)))
        (write-string s stream))))

(defun %fmt-find-close (control start open close)
  ;; index of the directive character matching CLOSE, scanning from START
  (let ((depth 1) (i start) (n (length control)))
    (block nil
      (tagbody top
         (when (>= i n) (error "FORMAT: unmatched ~~~A" open))
         (if (char= (char control i) #\~)
             (let ((j (+ i 1)))
               (block skip
                 (tagbody skiploop
                    (when (and (< j n) (or (digit-char-p (char control j)) (find (char control j) ",:@'v#")))
                      (when (char= (char control j) #\') (setq j (+ j 1)))
                      (setq j (+ j 1)) (go skiploop))))
               (when (< j n)
                 (let ((c (char control j)))
                   (cond ((char= c open) (setq depth (+ depth 1)))
                         ((char= c close) (setq depth (- depth 1))
                          (when (= depth 0) (return (list i j))))
                         ((and (char= c #\;) (= depth 1) nil) nil)))
                 (setq i (+ j 1)))
               (when (>= j n) (setq i n)))                 ; a ~ at the very end
             (setq i (+ i 1)))
         (go top)))))

(defvar *fmt-default* nil "Index of the ~:; default clause found by the last %FMT-SPLIT-CLAUSES, or NIL.")

(defun %fmt-split-clauses (s)
  ;; split on ~; and ~:; at nesting depth 0; ~:; marks the clause after it as the default
  (setq *fmt-default* nil)
  (let ((parts nil) (start 0) (i 0) (n (length s)) (depth 0))
    (block nil
      (tagbody top
         (when (>= i n) (return))
         (if (and (char= (char s i) #\~) (< (+ i 1) n))
             (let ((c (char s (+ i 1))))
               (cond ((find c "[{(<") (setq depth (+ depth 1)))
                     ((find c "]})>") (setq depth (- depth 1)))
                     ((and (char= c #\;) (= depth 0))
                      (setq parts (cons (subseq s start i) parts))
                      (setq start (+ i 2)))
                     ((and (char= c #\:) (= depth 0) (< (+ i 2) n) (char= (char s (+ i 2)) #\;))
                      (setq parts (cons (subseq s start i) parts))
                      (setq start (+ i 3) *fmt-default* (length parts))
                      (setq i (+ i 1))))
               (setq i (+ i 2)))
             (setq i (+ i 1)))
         (go top)))
    (nreverse (cons (subseq s start) parts))))

(defun %format-run (stream control args)
  (let ((i 0) (n (length control)) (prev nil) (start-args nil))
    (block run
      (tagbody top
         (when (>= i n) (return-from run args))
         (let ((c (char control i)))
           (if (not (char= c #\~))
               (progn (write-char c stream) (setq i (+ i 1)))
               (let ((params nil) (colon nil) (at nil) (j (+ i 1)) (dchar nil))
                 ;; parse prefix parameters
                 (block parse
                   (tagbody ploop
                      (let ((ch (char control j)) (val :none))
                        (cond ((or (digit-char-p ch) (and (char= ch #\-) (digit-char-p (char control (+ j 1)))))
                               (let ((k j) (neg nil) (v 0))
                                 (when (char= ch #\-) (setq neg t) (setq k (+ k 1)))
                                 (block nil
                                   (tagbody dl
                                      (when (and (< k n) (digit-char-p (char control k)))
                                        (setq v (+ (* v 10) (digit-char-p (char control k))))
                                        (setq k (+ k 1)) (go dl))))
                                 (setq val (if neg (- v) v))
                                 (when (> v 1000000) (error "FORMAT: parameter ~D is too large" val))
                                 (setq j k)))
                              ((char= ch #\') (setq val (char control (+ j 1))) (setq j (+ j 2)))
                              ((char= ch #\v) (setq val (car args)) (setq args (cdr args)) (setq j (+ j 1)))
                              ((char= ch #\#) (setq val (length args)) (setq j (+ j 1))))
                        (cond ((eq val :none)
                               (if (char= ch #\,)
                                   (progn (setq params (cons nil params)) (setq j (+ j 1)) (go ploop))
                                   (return-from parse nil)))
                              (t (setq params (cons val params))
                                 (if (char= (char control j) #\,)
                                     (progn (setq j (+ j 1)) (go ploop))
                                     (return-from parse nil)))))))
                 (setq params (nreverse params))
                 (block mods
                   (tagbody mloop
                      (let ((ch (char control j)))
                        (cond ((char= ch #\:) (setq colon t) (setq j (+ j 1)) (go mloop))
                              ((char= ch #\@) (setq at t) (setq j (+ j 1)) (go mloop))))))
                 (setq dchar (char-upcase (char control j)))
                 (setq i (+ j 1))
                 (setq start-args args)
                 (case dchar
                   (#\A (let ((s (if (and colon (null (car args))) "()" (princ-to-string (car args)))))
                          (setq args (cdr args))
                          (%fmt-pad-ac stream s params (not at))))
                   (#\S (let ((s (if (and colon (null (car args))) "()" (prin1-to-string (car args)))))
                          (setq args (cdr args))
                          (%fmt-pad-ac stream s params (not at))))
                   (#\W (let ((v (car args))) (setq args (cdr args))
                          (if (and colon (listp v) v) (pprint-fill stream v t) (write v :stream stream))))
                   (#\_ (pprint-newline (cond ((and colon at) :mandatory) (colon :fill) (at :miser) (t :linear)) stream))
                   (#\I (pprint-indent (if colon :current :block) (or (car params) 0) stream))
                   (#\/ (let* ((close (or (position #\/ control :start i) (error "FORMAT: ~~/ without a closing /"))) (name (string-upcase (subseq control i close)))
                               (colon2 (position #\: name))
                               (sym (if colon2
                                        (intern (string-left-trim ":" (subseq name colon2)) (subseq name 0 colon2))
                                        (intern name "COMMON-LISP-USER")))
                               (v (car args)))
                          (setq args (cdr args) i (+ close 1))
                          (apply sym stream v colon at params)))
                   ((#\D #\B #\O #\X)
                    (let* ((v (car args))
                           (radix (case dchar (#\D 10) (#\B 2) (#\O 8) (t 16)))
                           (s (if (integerp v) (%number-to-string v radix) (princ-to-string v))))
                      (setq args (cdr args))
                      (when (and at (integerp v) (>= v 0)) (setq s (%string-concat "+" s)))
                      (when (and colon (integerp v))
                        (setq s (%fmt-commas s (or (caddr params) #\,) (or (cadddr params) 3))))
                      (when (and (eq dchar #\X)) (setq s (string-upcase s)))
                      (%fmt-pad stream s (car params) (or (cadr params) #\Space) nil)))
                   (#\C (let ((ch (car args))) (setq args (cdr args))
                          (if at (prin1 ch stream) (write-char ch stream))))
                   (#\F (let ((v (car args)))
                          (setq args (cdr args))
                          (write-string (%fmt-f v (nth 0 params) (nth 1 params) (nth 2 params) (nth 3 params) (nth 4 params) at) stream)))
                   (#\G (let ((v (car args)))
                          (setq args (cdr args))
                          (write-string (%fmt-g v (nth 0 params) (nth 1 params) (nth 2 params) (nth 3 params) (nth 4 params) (nth 5 params) (nth 6 params) at) stream)))
                   (#\? (let ((ctl (car args)) (sub (cadr args))) (setq args (cddr args)) (%format-run stream ctl sub)))
                   (#\R (let ((v (car args)))
                          (setq args (cdr args))
                          (if (car params)
                              (let ((s (%fmt-radix v (car params))))
                                (when (and at (integerp v) (>= v 0)) (setq s (%string-concat "+" s)))
                                (when (and colon (integerp v)) (setq s (%fmt-commas s (or (nth 3 params) #\,) (or (nth 4 params) 3))))
                                (%fmt-pad stream s (nth 1 params) (or (nth 2 params) #\Space) nil))
                              (write-string (cond ((and at colon) (%roman v t)) (at (%roman v)) (colon (%ordinal-words v)) (t (%cardinal-words v)))
                                            stream))))
                   (#\$ (let ((v (car args)))
                          (setq args (cdr args))
                          (write-string (%fmt-dollars v (nth 0 params) (nth 1 params) (nth 2 params) (nth 3 params) colon at) stream)))
                   (#\E (let ((v (car args))) (setq args (cdr args))
                          (write-string (%fmt-e v (nth 0 params) (nth 1 params) (nth 2 params) (nth 3 params) (nth 4 params) (nth 5 params) (nth 6 params) at) stream)))
                   (#\P (let ((v (if colon (car prev) (let ((x (car args))) (setq args (cdr args)) x))))
                          (if at
                              (write-string (if (eql v 1) "y" "ies") stream)
                              (unless (eql v 1) (write-char #\s stream)))))
                   (#\% (dotimes (k (or (car params) 1)) (write-char #\Newline stream)))
                   (#\& (fresh-line stream) (dotimes (k (- (or (car params) 1) 1)) (write-char #\Newline stream)))
                   (#\~ (dotimes (k (or (car params) 1)) (write-char #\~ stream)))
                   (#\| (write-char #\Page stream))
                   (#\* (if colon
                            (setq args (nthcdr (- (length args) 1) args))
                            (setq args (nthcdr (or (car params) 1) args))))
                   (#\T (cond ((typep stream '%pretty-stream)
                               (if at (pprint-tab (if colon :section-relative :line-relative) (or (car params) 1) (or (cadr params) 1) stream)
                                   (pprint-tab (if colon :section :line) (or (car params) 1) (or (cadr params) 1) stream)))
                              (at (let* ((col (%stream-column stream)) (target (+ col (or (car params) 1))) (inc (or (cadr params) 1)))
                                    (when (> inc 1) (setq target (* inc (ceiling target inc))))
                                    (dotimes (k (- target col)) (write-char #\Space stream))))
                              (t (let ((col (%stream-column stream)) (colnum (or (car params) 1)) (inc (or (cadr params) 1)))
                                   (dotimes (k (cond ((< col colnum) (- colnum col)) ((> inc 0) (- inc (mod (- col colnum) inc))) (t 0)))
                                     (write-char #\Space stream))))))
                   (#\< (let* ((m (%fmt-find-close control i #\< #\>)) (body (subseq control i (car m)))
                               (mods (subseq control (+ (car m) 1) (cadr m))))
                          (setq i (+ (cadr m) 1))
                          (if (find #\: mods)
                              (setq args (%fmt-logical-block stream body args colon at (find #\@ mods)))
                              (setq args (%fmt-justify stream body args params colon at)))))
                   (#\Newline (when at (write-char #\Newline stream))
                    (block nil (tagbody sk (when (and (< i n) (whitespace-char-p (char control i))) (setq i (+ i 1)) (go sk)))))
                   (#\^ (when (null args) (return-from run (cons '%fmt-terminate args))))
                   (#\( (let* ((m (%fmt-find-close control i #\( #\))) (body (subseq control i (car m)))
                               (tmp (make-string-output-stream)))
                          (setq args (%format-run tmp body args))
                          (let ((s (get-output-stream-string tmp)))
                            (write-string (cond ((and colon at) (string-upcase s))
                                                (colon (string-capitalize s))
                                                (at (%capitalize-first s))
                                                (t (string-downcase s)))
                                          stream))
                          (setq i (+ (cadr m) 1))))
                   (#\{ (let* ((m (%fmt-find-close control i #\{ #\})) (body (subseq control i (car m)))
                               (body (if (string= body "") (progn (let ((a (car args))) (setq args (cdr args)) a)) body)))
                          (setq i (+ (cadr m) 1))
                          (let ((lst (if at args (car args))))
                            (unless at (setq args (cdr args)))
                            (let ((count 0) (maxn (car params)))
                              (block iter
                                (tagbody it
                                   (when (or (null lst) (and maxn (>= count maxn))) (return-from iter nil))
                                   (if colon
                                       (let ((r (%format-run stream body (car lst))))
                                         (setq lst (cdr lst))
                                         (when (and (consp r) (eq (car r) '%fmt-terminate)) (return-from iter nil)))
                                       (let ((r (%format-run stream body lst)))
                                         (when (and (consp r) (eq (car r) '%fmt-terminate)) (return-from iter nil))
                                         (setq lst r)))
                                   (setq count (+ count 1))
                                   (go it))))
                            (when at (setq args nil)))))
                   (#\[ (let* ((m (%fmt-find-close control i #\[ #\])) (body (subseq control i (car m)))
                               (clauses (%fmt-split-clauses body)) (dflt *fmt-default*))
                          (setq i (+ (cadr m) 1))
                          (let ((sel (cond (at (if (car args) 0 1))
                                           (colon (if (car args) 1 0))
                                           (t (let ((v (or (car params) (car args)))) v)))))
                            (unless (or at (car params)) nil)
                            (unless (car params) (unless at (setq args (cdr args))))
                            (when (and at (= sel 1)) (setq args (cdr args)))   ; ~@[ consumes a false argument
                            (let ((clause (cond ((and (integerp sel) (< sel (length clauses)) (>= sel 0) (not (eql sel dflt))) (nth sel clauses))
                                                (dflt (nth dflt clauses))
                                                (t (and (> (length clauses) 0)
                                                        (let ((last (car (last clauses))))
                                                          (and (> (length last) 0) (char= (char last 0) #\:) nil)))))))
                              (when clause
                                (setq args (let ((r (%format-run stream clause args))) r)))))))
                   (t (error "FORMAT: unknown directive ~~~A" dchar)))
                 (setq prev start-args)))
           (go top))))))

(defun %capitalize-first (s)
  (if (= (length s) 0) s (%string-concat (string (char-upcase (char s 0))) (subseq s 1))))

(defun %fmt-commas (s ch &optional (interval 3))
  (let* ((neg (and (> (length s) 0) (find (char s 0) "-+")))
         (digits (if neg (subseq s 1) s)) (acc nil) (k 0))
    (dolist (c (reverse (%vector-to-list digits)))
      (when (and (> k 0) (= (mod k interval) 0)) (setq acc (cons ch acc)))
      (setq acc (cons c acc))
      (setq k (+ k 1)))
    (%string-concat (if neg (string (char s 0)) "") (coerce acc 'string))))

(defun %fmt-exp (v digits)
  "V in exponential notation with DIGITS digits after the decimal point, e.g. 3.594e-12."
  (let ((x (float v)))
    (if (zerop x)
        (format nil "0.~Ae0" (make-string digits #\0))
        (let* ((a (abs x)) (e (floor (log a 10.0))) (scale (expt 10 digits)))
          (when (>= (/ a (expt 10.0 e)) 10.0) (setq e (+ e 1)))
          (when (< (/ a (expt 10.0 e)) 1.0) (setq e (- e 1)))
          (let ((n (round (* (/ a (expt 10.0 e)) scale))))
            (when (>= n (* 10 scale)) (setq n (round n 10) e (+ e 1)))
            (let ((ds (princ-to-string n)))
              (concatenate 'string (if (< x 0) "-" "") (subseq ds 0 1) (if (> digits 0) "." "") (subseq ds 1) "e" (princ-to-string e))))))))

(defun %fmt-fixed (v d)
  (let* ((x (float v)) (d (or d 6))
         (scale (expt 10 d))
         (r (round (* (abs x) scale)))
         (int (floor r scale)) (frac (mod r scale))
         (fs (%number-to-string frac)))
    (%string-concat (if (< x 0) "-" "") (%number-to-string int)
                    (if (> d 0) "." "")
                    (if (> d 0) (%string-concat (make-string (- d (length fs)) #\0) fs) ""))))

;;; ---- ~R: English cardinals and ordinals, Roman numerals, other radixes -----------------------------

(defvar %small-numbers '("zero" "one" "two" "three" "four" "five" "six" "seven" "eight" "nine" "ten" "eleven" "twelve" "thirteen"
                          "fourteen" "fifteen" "sixteen" "seventeen" "eighteen" "nineteen"))
(defvar %tens-words '("" "" "twenty" "thirty" "forty" "fifty" "sixty" "seventy" "eighty" "ninety"))
(defvar %scale-words '("" " thousand" " million" " billion" " trillion" " quadrillion" " quintillion"))

(defun %below-thousand (n)
  (let ((h (floor n 100)) (r (mod n 100)) (parts nil))
    (when (> h 0) (push (format nil "~A hundred" (nth h %small-numbers)) parts))
    (cond ((zerop r) nil)
          ((< r 20) (push (nth r %small-numbers) parts))
          (t (push (let ((t10 (nth (floor r 10) %tens-words)) (u (mod r 10))) (if (zerop u) t10 (format nil "~A-~A" t10 (nth u %small-numbers)))) parts)))
    (%join-strings (reverse parts) " ")))

(defun %cardinal-words (n)
  "N (an integer) spelled in English: 123 gives \"one hundred twenty-three\"."
  (cond ((not (integerp n)) (princ-to-string n))
        ((< n 0) (concatenate 'string "minus " (%cardinal-words (- n))))
        ((zerop n) "zero")
        (t (let ((groups nil) (k 0))
             (loop while (> n 0) do (let ((g (mod n 1000))) (when (> g 0) (push (concatenate 'string (%below-thousand g) (nth k %scale-words)) groups))) (setq n (floor n 1000) k (+ k 1)))
             (%join-strings groups " ")))))

(defun %ordinal-words (n)
  "N spelled as an English ordinal: 4 gives \"fourth\"."
  (let* ((c (%cardinal-words n)) (sp (position #\Space c :from-end t)) (hy (position #\- c :from-end t)) (cut (max (or sp -1) (or hy -1)))
         (head (subseq c 0 (+ cut 1))) (last (subseq c (+ cut 1))))
    (concatenate 'string head
                 (cond ((string= last "one") "first") ((string= last "two") "second") ((string= last "three") "third") ((string= last "five") "fifth")
                       ((string= last "eight") "eighth") ((string= last "nine") "ninth") ((string= last "twelve") "twelfth")
                       ((and (> (length last) 1) (char= (char last (- (length last) 1)) #\y)) (concatenate 'string (subseq last 0 (- (length last) 1)) "ieth"))
                       (t (concatenate 'string last "th"))))))

(defun %roman (n &optional old)
  "N (1 to 3999) in Roman numerals; OLD-style (IIII for 4) if OLD."
  (if (or (not (integerp n)) (< n 1) (> n (if old 4999 3999))) (princ-to-string n)
      (let ((out nil))
        (dolist (p (if old '((1000 . "M") (500 . "D") (100 . "C") (50 . "L") (10 . "X") (5 . "V") (1 . "I"))
                       '((1000 . "M") (900 . "CM") (500 . "D") (400 . "CD") (100 . "C") (90 . "XC") (50 . "L") (40 . "XL") (10 . "X") (9 . "IX") (5 . "V") (4 . "IV") (1 . "I"))))
          (loop while (>= n (car p)) do (push (cdr p) out) (setq n (- n (car p)))))
        (apply #'concatenate 'string (reverse out)))))

(defun %fmt-radix (n radix)
  (if (integerp n)
      (let ((digits "0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZ") (neg (< n 0)) (m (abs n)) (out nil))
        (if (zerop m) "0"
            (progn (loop while (> m 0) do (push (char digits (mod m radix)) out) (setq m (floor m radix)))
                   (concatenate 'string (if neg "-" "") (coerce out 'string)))))
      (princ-to-string n)))

;;; ---- padding, ~F ~E ~G ~$ --------------------------------------------------------------------------------

(defun %fmt-pad-ac (stream s params left)
  "Write S padded per ~mincol,colinc,minpad,padcharA: on the right when LEFT, else on the left."
  (let* ((mincol (or (nth 0 params) 0)) (colinc (max 1 (or (nth 1 params) 1))) (minpad (or (nth 2 params) 0))
         (padchar (or (nth 3 params) #\Space)) (n (length s)) (pad minpad))
    (when (< (+ n pad) mincol) (setq pad (+ pad (* colinc (ceiling (- mincol n pad) colinc)))))
    (if left
        (progn (write-string s stream) (dotimes (i pad) (write-char padchar stream)))
        (progn (dotimes (i pad) (write-char padchar stream)) (write-string s stream)))))

(defun %fmt-fit (s w ovf pad)
  "S padded on the left to W with PAD, or W copies of OVF if it is longer and OVF is given."
  (cond ((null w) s)
        ((> (length s) w) (if ovf (make-string w :initial-element ovf) s))
        (t (%string-concat (make-string (- w (length s)) :initial-element (or pad #\Space)) s))))

(defun %fmt-sign (x at) (cond ((minusp x) "-") (at "+") (t "")))

(defun %check-digits (d) (when (and d (> d 1000)) (error "FORMAT: ~D digits is too many" d)) d)

(defun %fixed-digits (r d)
  "The non-negative rational R rounded to D decimals: (values integer-part-string fraction-string)."
  (%check-digits d)
  (let* ((scale (expt 10 d)) (n (round (* r scale))))
    (multiple-value-bind (ip fp) (floor n scale)
      (let ((fs (%number-to-string fp)))
        (values (%number-to-string ip) (if (> d 0) (%string-concat (make-string (- d (length fs)) :initial-element #\0) fs) ""))))))

(defun %float-shortest (x)
  "The shortest digits that print the float X: (values digits exponent) with |X| = 0.DIGITS x 10^EXPONENT."
  (if (zerop x)
      (values "0" 0)
      (let* ((s (princ-to-string (abs (float x)))) (epos (position #\e s))
             (mant (if epos (subseq s 0 epos) s)) (ex (if epos (parse-integer (subseq s (+ epos 1))) 0))
             (dot (position #\. mant)) (ip (subseq mant 0 dot)) (fp (subseq mant (+ dot 1)))
             (digits (%string-concat ip fp)) (point (+ (length ip) ex)))
        (let ((lead 0)) (loop (when (or (>= lead (length digits)) (char/= (char digits lead) #\0)) (return)) (setq lead (+ lead 1)))
          (setq digits (subseq digits lead) point (- point lead)))
        (let ((end (length digits))) (loop (when (or (<= end 1) (char/= (char digits (- end 1)) #\0)) (return)) (setq end (- end 1)))
          (setq digits (subseq digits 0 end)))
        (values digits point))))

(defun %fmt-real (v) (if (floatp v) v (float v)))

(defun %fmt-f (v w d k ovf pad at)
  "~w,d,k,overflowchar,padcharF."
  (if (not (realp v))
      (%fmt-fit (princ-to-string v) w nil pad)
      (let* ((x (* (%fmt-real v) (expt 10 (or k 0)))) (sign (%fmt-sign x at)) (r (rational (abs x))))
        (multiple-value-bind (ip fp)
            (cond (d (%fixed-digits r d))
                  (t (multiple-value-bind (digits point) (%float-shortest x)
                       (let ((free-frac (max 1 (- (length digits) (max point 0)))))
                         (if (null w)
                             (%fixed-digits r free-frac)
                             (let ((ipw (length (%fixed-digits r 0))))
                               (%fixed-digits r (max 0 (min free-frac (- w (length sign) ipw 1))))))))))
          (let ((s (%string-concat sign ip "." fp)))
            (when (and w (> (length s) w) (string= ip "0")) (setq s (%string-concat sign "." fp)))
            (%fmt-fit s w ovf pad))))))

(defun %decimal-exponent (r)
  "The integer E with 10^E <= R < 10^(E+1), for a positive rational R."
  (let ((e (floor (log (float r) 10))))
    (loop (cond ((< r (expt 10 e)) (setq e (- e 1)))
                ((>= r (expt 10 (+ e 1))) (setq e (+ e 1)))
                (t (return e))))))

(defun %significant-digits (r n)
  "R (positive rational) rounded to N significant digits: (values digit-string exponent), R ~ 0.DIGITS x 10^(EXPONENT)."
  (%check-digits n)
  (let* ((e (%decimal-exponent r)) (q (round (/ r (expt 10 (- (+ e 1) n))))))
    (when (>= q (expt 10 n)) (setq q (round q 10) e (+ e 1)))
    (values (%number-to-string q) (+ e 1))))

(defun %fmt-e (v w d e k ovf pad expchar at)
  "~w,d,e,k,overflowchar,padchar,exptcharE."
  (if (not (realp v))
      (%fmt-fit (princ-to-string v) w nil pad)
      (let* ((x (%fmt-real v)) (k (or k 1)) (sign (%fmt-sign x at)) (r (rational (abs x))) (ec (or expchar #\e)))
        (when (and (null d) w) (setq d (max (if (> k 0) (- k 1) 1) (- w (length sign) (+ 2 (or e 1)) 2))))
        (multiple-value-bind (digits point)
            (cond ((zerop r) (values (make-string (max 1 (if d (if (> k 0) (+ d 1) d) (+ (max k 0) 1))) :initial-element #\0) (if (> k 0) k 0)))
                  (d (%significant-digits r (max 1 (if (> k 0) (+ d 1) (+ d k)))))
                  (t (%float-shortest x)))
          (when (and (null d) (not (zerop r)) (< (length digits) (+ k 1)))
            (setq digits (%string-concat digits (make-string (- (+ k 1) (length digits)) :initial-element #\0))))
          (let* ((mantissa (cond ((> k 0) (%string-concat (subseq digits 0 (min k (length digits)))
                                                           (make-string (max 0 (- k (length digits))) :initial-element #\0)
                                                           "." (if (> (length digits) k) (subseq digits k) "")))
                                 (t (%string-concat "0." (make-string (- k) :initial-element #\0) digits))))
                 (expo (if (zerop r) 0 (- point k)))
                 (es (%number-to-string (abs expo)))
                 (es (if (and e (< (length es) e)) (%string-concat (make-string (- e (length es)) :initial-element #\0) es) es))
                 (s (%string-concat sign mantissa (string ec) (if (minusp expo) "-" "+") es)))
            (if (and e ovf (> (length es) e))
                (make-string (or w (length s)) :initial-element ovf)
                (progn
                  (when (and w (> (length s) w) (string= (subseq mantissa 0 2) "0.")) (setq s (%string-concat sign (subseq mantissa 1) (string ec) (if (minusp expo) "-" "+") es)))
                  (%fmt-fit s w ovf pad))))))))

(defun %fmt-g (v w d e k ovf pad expchar at)
  "~w,d,e,k,overflowchar,padchar,exptcharG: ~F (and spaces) for numbers of moderate size, else ~E."
  (if (not (realp v))
      (%fmt-fit (princ-to-string v) w nil pad)
      (let* ((x (%fmt-real v)) (r (rational (abs x)))
             (n (if (zerop r) 0 (+ 1 (%decimal-exponent r))))
             (ee (if e (+ e 2) 4)) (ww (and w (- w ee)))
             (d (or d (max (length (%float-shortest x)) (min n 7))))
             (dd (- d n)))
        (if (<= 0 dd d)
            (%string-concat (%fmt-f x ww dd nil ovf pad at) (make-string ee :initial-element #\Space))
            (%fmt-e x w d e k ovf pad expchar at)))))

(defun %fmt-dollars (v d n w pad colon at)
  "~d,n,w,padchar$: monetary format with D decimals and at least N integer digits."
  (if (not (realp v))
      (%fmt-fit (princ-to-string v) w nil pad)
      (let* ((x (%fmt-real v)) (sign (%fmt-sign x at)))
        (multiple-value-bind (ip fp) (%fixed-digits (rational (abs x)) (or d 2))
          (let* ((n (or n 1)) (ip (if (< (length ip) n) (%string-concat (make-string (- n (length ip)) :initial-element #\0) ip) ip))
                 (num (%string-concat ip "." fp)) (w (or w 0)) (padn (max 0 (- w (length sign) (length num))))
                 (padding (make-string padn :initial-element (or pad #\Space))))
            (if colon (%string-concat sign padding num) (%string-concat padding sign num)))))))

;;; ---- ~< justification and logical blocks -----------------------------------------------------------------

(defun %fmt-split-segments (s)
  "Split the body of ~<...~> on ~; at depth 0: (values segments separators), each separator a list
(modifiers params-text)."
  (let ((segs nil) (seps nil) (start 0) (i 0) (n (length s)) (depth 0))
    (loop
      (when (>= i n) (return))
      (if (char= (char s i) #\~)
          (let ((j (+ i 1)))
            (loop (when (or (>= j n) (not (or (digit-char-p (char s j)) (find (char s j) ",'vV#")))) (return))
                  (when (char= (char s j) #\') (setq j (+ j 1)))
                  (setq j (+ j 1)))
            (let ((pend j))
              (loop (when (or (>= j n) (not (find (char s j) ":@"))) (return)) (setq j (+ j 1)))
              (when (< j n)
                (let ((c (char s j)))
                  (cond ((find c "<[{(") (setq depth (+ depth 1)))
                        ((find c ">]})") (setq depth (- depth 1)))
                        ((and (char= c #\;) (= depth 0))
                         (setq segs (cons (subseq s start i) segs)
                               seps (cons (list (subseq s pend j) (subseq s (+ i 1) pend)) seps)
                               start (+ j 1)))))
                (setq i (+ j 1)))
              (when (>= j n) (setq i n))))
          (setq i (+ i 1))))
    (values (nreverse (cons (subseq s start) segs)) (nreverse seps))))

(defun %fmt-run-to-string (body args)
  (let ((out (make-string-output-stream)))
    (let ((r (%format-run out body args)))
      (values (get-output-stream-string out) r))))

(defun %fmt-justify (stream body args params colon at)
  "~mincol,colinc,minpad,padchar<seg~;seg~>: justify the segments within the field."
  (multiple-value-bind (segs seps) (%fmt-split-segments body)
    (let* ((mincol (or (nth 0 params) 0)) (colinc (max 1 (or (nth 1 params) 1))) (minpad (or (nth 2 params) 0))
           (padchar (or (nth 3 params) #\Space))
           (overflow (and seps (find #\: (car (car seps)))))
           (ovf-params (and overflow (mapcar (lambda (p) (and (> (length p) 0) (parse-integer p))) (%split-string (cadr (car seps)) #\,))))
           (ovf-text nil) (texts nil))
      (when overflow
        (multiple-value-bind (s r) (%fmt-run-to-string (car segs) args) (setq ovf-text s args r))
        (setq segs (cdr segs)))
      (dolist (seg segs)
        (multiple-value-bind (s r) (%fmt-run-to-string seg args)
          (when (and (consp r) (eq (car r) '%fmt-terminate)) (return))
          (setq texts (cons s texts) args r)))
      (setq texts (nreverse texts))
      (let* ((total (reduce #'+ (mapcar #'length texts) :initial-value 0))
             (gaps (+ (max 0 (- (length texts) 1)) (if colon 1 0) (if at 1 0)))
             (right (and (= gaps 0)))
             (gaps (max gaps 1))
             (width (max mincol (+ total (* gaps minpad)))))
        (when (> width mincol) (setq width (+ mincol (* colinc (ceiling (- width mincol) colinc)))))
        (let* ((pad (- width total)) (each (floor pad gaps)) (extra (- pad (* each gaps))) (out (make-string-output-stream)) (g 0))
          (flet ((gap () (dotimes (i (+ each (if (< g extra) 1 0))) (write-char padchar out)) (setq g (+ g 1))))
            (when (or colon right) (gap))
            (let ((first t))
              (dolist (tx texts) (unless first (gap)) (write-string tx out) (setq first nil)))
            (when at (gap)))
          (let ((s (get-output-stream-string out)))
            (when (and ovf-text (> (+ (%stream-column stream) (length s)) (- (or (cadr ovf-params) 72) (or (car ovf-params) 0))))
              (write-string ovf-text stream))
            (write-string s stream)))))
    (if (and (consp args) (eq (car args) '%fmt-terminate)) (cdr args) args)))

(defun %fmt-fill-body (body)
  "BODY with a fill newline (~:_) after each run of spaces in its literal text, for ~<...~:@>."
  (let ((out (make-string-output-stream)) (i 0) (n (length body)))
    (loop
      (when (>= i n) (return))
      (let ((c (char body i)))
        (cond ((char= c #\~)
               (let ((j (+ i 1)))
                 (loop (when (or (>= j n) (not (or (digit-char-p (char body j)) (find (char body j) ",'vV#:@")))) (return))
                       (when (char= (char body j) #\') (setq j (+ j 1)))
                       (setq j (+ j 1)))
                 (write-string (subseq body i (min n (+ j 1))) out)
                 (setq i (+ j 1))))
              ((char= c #\Space)
               (let ((j i)) (loop (when (or (>= j n) (char/= (char body j) #\Space)) (return)) (setq j (+ j 1)))
                 (write-string (subseq body i j) out) (write-string "~:_" out) (setq i j)))
              (t (write-char c out) (setq i (+ i 1))))))
    (get-output-stream-string out)))

(defun %fmt-logical-block (stream body args colon at fill)
  "~<prefix~;body~;suffix~:>: print the next argument (all the rest, with @) as a logical block."
  (multiple-value-bind (segs seps) (%fmt-split-segments body)
    (let* ((prefix (if colon "(" "")) (suffix (if colon ")" "")) (plp nil) (inner (car segs)))
      (case (length segs)
        (2 (setq prefix (car segs) inner (cadr segs)))
        (3 (setq prefix (car segs) inner (cadr segs) suffix (caddr segs))))
      (when (and (> (length segs) 1) (find #\@ (car (car seps)))) (setq plp prefix prefix ""))
      (when fill (setq inner (%fmt-fill-body inner)))
      (let ((list (if at args (car args))))
        (%pprint-logical-block stream list prefix plp suffix (lambda (s) (%format-run s inner list)))
        (if at nil (cdr args))))))
