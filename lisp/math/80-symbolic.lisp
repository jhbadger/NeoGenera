;;;; 80-symbolic.lisp -- a small computer-algebra layer in the Macsyma tradition.
;;;;
;;;; Expressions are Lisp forms: numbers, symbols and lists (+ ...) (* ...) (- ...) (/ a b) (expt a b) (exp x)
;;;; (log x) (sin x) (cos x) (tan x) (sqrt x).  Polynomials are coefficient lists, lowest degree first.

(in-package :cl)

(defun %free-of (expr var)
  (cond ((eq expr var) nil) ((atom expr) t) (t (every (lambda (e) (%free-of e var)) (cdr expr)))))

(defun %expr-key (e) (prin1-to-string e))
(defun %expr< (a b)
  (cond ((and (numberp a) (numberp b)) (< a b)) ((numberp a) t) ((numberp b) nil)
        ((and (symbolp a) (symbolp b)) (string< (symbol-name a) (symbol-name b)))
        ((symbolp a) t) ((symbolp b) nil)
        (t (string< (%expr-key a) (%expr-key b)))))

(defun %split-coef (term)
  "Returns (values coefficient rest) where TERM = coefficient * rest."
  (cond ((numberp term) (values term 1))
        ((and (consp term) (eq (car term) '*) (numberp (cadr term)))
         (values (cadr term) (if (= (length (cddr term)) 1) (caddr term) (cons '* (cddr term)))))
        (t (values 1 term))))

(defun %make-sum (terms)
  (cond ((null terms) 0) ((null (cdr terms)) (car terms)) (t (cons '+ terms))))
(defun %make-product (coef factors)
  (cond ((zerop coef) 0)
        ((null factors) coef)
        ((and (= coef 1) (null (cdr factors))) (car factors))
        ((= coef 1) (cons '* factors))
        (t (cons '* (cons coef factors)))))

(defun %simp-sum (args)
  (let ((const 0) (terms nil))
    (labels ((add (a) (cond ((numberp a) (setq const (+ const a)))
                            ((and (consp a) (eq (car a) '+)) (mapc #'add (cdr a)))
                            (t (multiple-value-bind (c rest) (%split-coef a)
                                 (let ((cell (assoc rest terms :test #'equal)))
                                   (if cell (setf (cdr cell) (+ (cdr cell) c)) (setq terms (append terms (list (cons rest c)))))))))))
      (mapc #'add args))
    (let* ((ts (remove-if (lambda (c) (zerop (cdr c))) terms))
           (sorted (sort (copy-list ts) (lambda (a b) (%expr< (car a) (car b)))))
           (built (mapcar (lambda (c) (if (= (cdr c) 1) (car c) (%simp-prod (list (cdr c) (car c))))) sorted)))
      (%make-sum (if (zerop const) built (cons const built))))))

(defun %base-exp (f) (if (and (consp f) (eq (car f) 'expt) (= (length f) 3)) (values (cadr f) (caddr f)) (values f 1)))

(defun %simp-prod (args)
  (let ((const 1) (factors nil))
    (labels ((add (a) (cond ((numberp a) (setq const (* const a)))
                            ((and (consp a) (eq (car a) '*)) (mapc #'add (cdr a)))
                            (t (multiple-value-bind (b e) (%base-exp a)
                                 (let ((cell (assoc b factors :test #'equal)))
                                   (if cell (setf (cdr cell) (%simp-sum (list (cdr cell) e))) (setq factors (append factors (list (cons b e)))))))))))
      (mapc #'add args))
    (if (zerop const) 0
        (let* ((built (mapcar (lambda (c) (%simp-expt (car c) (cdr c))) factors))
               (consts (remove-if-not #'numberp built)) (others (remove-if #'numberp built)))
          (dolist (c consts) (setq const (* const c)))
          (cond ((zerop const) 0)
                ((and (= (length others) 1) (consp (car others)) (eq (car (car others)) '+) (not (= const 1)) nil) nil)
                (t (%make-product const (sort (copy-list others) #'%expr<))))))))

(defun %simp-expt (base ex)
  (cond ((and (numberp ex) (zerop ex)) 1)
        ((and (numberp ex) (= ex 1)) base)
        ((and (numberp base) (zerop base)) (if (and (numberp ex) (> ex 0)) 0 (list 'expt base ex)))
        ((and (numberp base) (= base 1)) 1)
        ((and (numberp base) (integerp ex) (or (>= ex 0) (/= base 0))) (expt base ex))
        ((and (numberp base) (rationalp base) (rationalp ex) (not (integerp ex)) (let ((r (%exact-root base (denominator ex)))) (and r (expt r (numerator ex)))))
         (%exact-root-power base ex))
        ((and (numberp base) (numberp ex)) (if (or (floatp base) (floatp ex)) (expt base ex) (list 'expt base ex)))
        ((and (consp base) (eq (car base) 'expt) (integerp ex) (= (length base) 3)) (%simp-expt (cadr base) (%simp-prod (list (caddr base) ex))))
        ((and (consp base) (eq (car base) '*) (integerp ex)) (%simp-prod (mapcar (lambda (f) (%simp-expt f ex)) (cdr base))))
        (t (list 'expt base ex))))

(defun %exact-root (r n)
  (if (< r 0) nil
      (let ((num (round (expt (float (numerator r)) (/ 1.0 n)))) (den (round (expt (float (denominator r)) (/ 1.0 n)))))
        (and (= (expt num n) (numerator r)) (= (expt den n) (denominator r)) (/ num den)))))
(defun %exact-root-power (base ex) (expt (%exact-root base (denominator ex)) (numerator ex)))

(defun simplify (expr)
  "Algebraic simplification: flattening, constant folding, like-term collection, identities."
  (if (atom expr) expr
      (let ((op (car expr)) (args (mapcar #'simplify (cdr expr))))
        (case op
          (+ (%simp-sum args))
          (* (%simp-prod args))
          (- (if (null (cdr args)) (%simp-prod (list -1 (car args)))
                 (%simp-sum (cons (car args) (mapcar (lambda (a) (%simp-prod (list -1 a))) (cdr args))))))
          (/ (if (null (cdr args)) (%simp-expt (car args) -1)
                 (%simp-prod (cons (car args) (mapcar (lambda (a) (%simp-expt a -1)) (cdr args))))))
          (expt (%simp-expt (car args) (cadr args)))
          (sqrt (let ((a (car args))) (if (and (rationalp a) (%exact-root a 2)) (%exact-root a 2) (list 'expt a 1/2))))
          (exp (let ((a (car args))) (cond ((floatp a) (exp a)) ((and (numberp a) (zerop a)) 1) ((and (consp a) (eq (car a) 'log)) (cadr a)) (t (list 'exp a)))))
          (log (let ((a (car args))) (cond ((and (floatp a) (> a 0)) (log a)) ((and (numberp a) (= a 1)) 0) ((and (consp a) (eq (car a) 'exp)) (cadr a)) (t (list 'log a)))))
          (sin (let ((a (car args))) (cond ((and (numberp a) (zerop a)) 0) ((floatp a) (sin a)) (t (list 'sin a)))))
          (cos (let ((a (car args))) (cond ((and (numberp a) (zerop a)) 1) ((floatp a) (cos a)) (t (list 'cos a)))))
          (tan (let ((a (car args))) (cond ((and (numberp a) (zerop a)) 0) ((floatp a) (tan a)) (t (list 'tan a)))))
          (t (cons op args))))))

(defun %expand-product (a b)
  (cond ((and (consp a) (eq (car a) '+)) (%simp-sum (mapcar (lambda (x) (%expand-product x b)) (cdr a))))
        ((and (consp b) (eq (car b) '+)) (%simp-sum (mapcar (lambda (y) (%expand-product a y)) (cdr b))))
        (t (%simp-prod (list a b)))))

(defun expand (expr)
  "Multiply out products of sums and positive integer powers of sums."
  (let ((e (simplify expr)))
    (cond ((atom e) e)
          ((eq (car e) '+) (simplify (cons '+ (mapcar #'expand (cdr e)))))
          ((eq (car e) '*) (simplify (reduce #'%expand-product (mapcar #'expand (cdr e)) :initial-value 1)))
          ((and (eq (car e) 'expt) (integerp (caddr e)) (> (caddr e) 1))
           (let ((b (expand (cadr e))) (r 1)) (dotimes (i (caddr e)) (setq r (%expand-product r b))) (simplify r)))
          (t (simplify (cons (car e) (mapcar #'expand (cdr e))))))))

(defun substitute-expr (expr var value)
  "EXPR with every occurrence of VAR replaced by VALUE (simplified)."
  (simplify (labels ((sub (e) (cond ((eq e var) value) ((atom e) e) (t (cons (car e) (mapcar #'sub (cdr e))))))) (sub expr))))

(defun evaluate-expr (expr &optional bindings)
  "Numeric value of EXPR given BINDINGS, an alist of (symbol . number)."
  (cond ((numberp expr) expr)
        ((symbolp expr) (let ((b (assoc expr bindings))) (cond (b (cdr b)) ((eq expr 'pi) pi) ((eq expr 'e) (exp 1.0)) (t (error "No value for ~A" expr)))))
        (t (let ((a (mapcar (lambda (x) (evaluate-expr x bindings)) (cdr expr))))
             (ecase (car expr)
               (+ (apply #'+ a)) (* (apply #'* a)) (- (apply #'- a)) (/ (apply #'/ a)) (expt (apply #'expt a))
               (exp (exp (car a))) (log (log (car a))) (sin (sin (car a))) (cos (cos (car a))) (tan (tan (car a))) (sqrt (sqrt (car a))))))))

(defun differentiate (expr var)
  "The derivative of EXPR with respect to VAR, simplified."
  (labels ((d (e)
             (cond ((numberp e) 0) ((eq e var) 1) ((atom e) 0)
                   (t (case (car e)
                        (+ (cons '+ (mapcar #'d (cdr e))))
                        (- (cons '- (mapcar #'d (cdr e))))
                        (* (cons '+ (loop for i from 0 below (length (cdr e))
                                          collect (cons '* (loop for f in (cdr e) for k from 0 collect (if (= k i) (d f) f))))))
                        (/ (let ((u (cadr e)) (v (caddr e))) (list '/ (list '- (list '* (d u) v) (list '* u (d v))) (list 'expt v 2))))
                        (expt (let ((b (cadr e)) (n (caddr e)))
                                (if (%free-of n var)
                                    (list '* n (list 'expt b (list '- n 1)) (d b))
                                    (list '* e (list '+ (list '* (d n) (list 'log b)) (list '/ (list '* n (d b)) b))))))
                        (exp (list '* e (d (cadr e))))
                        (log (list '/ (d (cadr e)) (cadr e)))
                        (sin (list '* (list 'cos (cadr e)) (d (cadr e))))
                        (cos (list '* -1 (list 'sin (cadr e)) (d (cadr e))))
                        (tan (list '* (list '+ 1 (list 'expt e 2)) (d (cadr e))))
                        (sqrt (list '/ (d (cadr e)) (list '* 2 e)))
                        (t (error "Cannot differentiate ~S" e)))))))
    (simplify (d (simplify expr)))))

(defun integrate (expr var)
  "An antiderivative of EXPR with respect to VAR (polynomials, powers, exp, sin, cos, 1/x, and linear arguments)."
  (labels ((linear-coef (inner) (let ((d (differentiate inner var))) (and (numberp d) (not (zerop d)) d)))
           (int (e)
             (cond ((%free-of e var) (list '* e var))
                   ((eq e var) (list '/ (list 'expt var 2) 2))
                   ((atom e) (error "Cannot integrate ~S" e))
                   (t (case (car e)
                        (+ (cons '+ (mapcar #'int (cdr e))))
                        (* (let ((consts (remove-if-not (lambda (f) (%free-of f var)) (cdr e))) (rest (remove-if (lambda (f) (%free-of f var)) (cdr e))))
                             (cond ((null rest) (list '* e var))
                                   (consts (list '* (cons '* consts) (int (if (cdr rest) (cons '* rest) (car rest)))))
                                   (t (error "Cannot integrate ~S" e)))))
                        (expt (let ((b (cadr e)) (n (caddr e)))
                                (cond ((and (eq b var) (numberp n)) (if (= n -1) (list 'log var) (list '/ (list 'expt var (+ n 1)) (+ n 1))))
                                      ((and (%free-of n var) (linear-coef b) (numberp n))
                                       (if (= n -1) (list '/ (list 'log b) (linear-coef b)) (list '/ (list 'expt b (+ n 1)) (list '* (+ n 1) (linear-coef b)))))
                                      (t (error "Cannot integrate ~S" e)))))
                        (exp (let ((a (linear-coef (cadr e)))) (if a (list '/ e a) (error "Cannot integrate ~S" e))))
                        (sin (let ((a (linear-coef (cadr e)))) (if a (list '/ (list '- (list 'cos (cadr e))) a) (error "Cannot integrate ~S" e))))
                        (cos (let ((a (linear-coef (cadr e)))) (if a (list '/ (list 'sin (cadr e)) a) (error "Cannot integrate ~S" e))))
                        (t (error "Cannot integrate ~S" e)))))))
    (simplify (int (expand expr)))))

(defun definite-integral (expr var lo hi)
  "The definite integral of EXPR over [LO, HI] from the antiderivative."
  (let ((anti (integrate expr var))) (simplify (list '- (substitute-expr anti var hi) (substitute-expr anti var lo)))))

(defun taylor-series (expr var point order)
  "Taylor polynomial of EXPR about POINT up to degree ORDER."
  (let ((terms nil) (d (simplify expr)) (fact 1))
    (dotimes (k (+ order 1))
      (when (> k 0) (setq fact (* fact k)))
      (let ((c (substitute-expr d var point)))
        (push (list '* (list '/ c fact) (list 'expt (list '- var point) k)) terms))
      (setq d (differentiate d var)))
    (simplify (cons '+ (reverse terms)))))

(defun expr->string (expr)
  "EXPR in conventional infix notation."
  (labels ((prec (e) (if (atom e) 10 (case (car e) (+ 1) (- 1) (* 2) (/ 2) (expt 3) (t 10))))
           (paren (e p) (if (< (prec e) p) (format nil "(~A)" (str e)) (str e)))
           (str (e)
             (cond ((atom e) (if (and (rationalp e) (not (integerp e))) (format nil "~D/~D" (numerator e) (denominator e)) (format nil "~A" (if (symbolp e) (string-downcase (symbol-name e)) e))))
                   (t (case (car e)
                        (+ (let ((out (str (cadr e)))) (dolist (x (cddr e)) (setq out (if (and (numberp x) (< x 0)) (format nil "~A - ~A" out (str (- x))) (format nil "~A + ~A" out (str x))))) out))
                        (* (let ((cs (cdr e))) (if (and (numberp (car cs)) (= (car cs) -1)) (format nil "-~A" (paren (cons '* (cdr cs)) 2))
                                                   (%join-strings (mapcar (lambda (f) (paren f 3)) cs) "*"))))
                        (expt (format nil "~A^~A" (paren (cadr e) 4) (paren (caddr e) 4)))
                        (t (format nil "~A(~{~A~^, ~})" (string-downcase (symbol-name (car e))) (mapcar #'str (cdr e)))))))))
    (str (simplify expr))))

;;; ---- polynomials as coefficient lists (lowest degree first) -------------------------------------------------

(defun %poly-trim (p) (let ((r (reverse p))) (loop while (and r (zerop (car r))) do (setq r (cdr r))) (reverse r)))
(defun poly+ (a b) "Sum of polynomials." (%poly-trim (let ((n (max (length a) (length b)))) (loop for i from 0 below n collect (+ (or (nth i a) 0) (or (nth i b) 0))))))
(defun poly- (a b) "Difference of polynomials." (poly+ a (mapcar #'- b)))
(defun poly* (a b) "Product of polynomials."
  (if (or (null a) (null b)) nil
      (let ((r (make-list (+ (length a) (length b) -1) :initial-element 0)))
        (loop for x in a for i from 0 do (loop for y in b for j from 0 do (incf (nth (+ i j) r) (* x y))))
        (%poly-trim r))))
(defun poly-eval (p x) "Value of the polynomial P at X (Horner)." (let ((v 0)) (dolist (c (reverse p)) (setq v (+ (* v x) c))) v))
(defun poly-derivative (p) "Derivative of P." (%poly-trim (loop for c in (cdr p) for i from 1 collect (* c i))))
(defun poly-integral (p) "Antiderivative of P with zero constant term." (cons 0 (loop for c in p for i from 1 collect (/ c i))))
(defun poly-divide (a b)
  "Polynomial division: returns (values quotient remainder)."
  (let ((a (%poly-trim a)) (b (%poly-trim b)) (q nil))
    (when (null b) (error "Division by the zero polynomial"))
    (let ((r (copy-list a)) (db (- (length b) 1)))
      (setq q (make-list (max 0 (- (length a) db)) :initial-element 0))
      (loop while (>= (- (length r) 1) db)
            do (let* ((k (- (length r) 1 db)) (c (/ (car (last r)) (car (last b)))))
                 (setf (nth k q) c)
                 (setq r (%poly-trim (poly- r (poly* (append (make-list k :initial-element 0) (list c)) b))))
                 (when (null r) (return))))
      (values (%poly-trim q) r))))
(defun poly-gcd (a b) "Monic greatest common divisor of two polynomials."
  (let ((x (%poly-trim a)) (y (%poly-trim b)))
    (loop while y do (multiple-value-bind (q r) (poly-divide x y) (declare (ignore q)) (setq x y y r)))
    (if x (mapcar (lambda (c) (/ c (car (last x)))) x) nil)))

(defun expr->poly (expr var)
  "The coefficient list of EXPR as a polynomial in VAR (an error if it is not one)."
  (let ((e (expand expr)))
    (labels ((term-poly (term)
               (multiple-value-bind (c rest) (%split-coef term)
                 (cond ((eql rest 1) (list c))
                       ((eq rest var) (list 0 c))
                       ((and (consp rest) (eq (car rest) 'expt) (eq (cadr rest) var) (integerp (caddr rest)) (>= (caddr rest) 0))
                        (append (make-list (caddr rest) :initial-element 0) (list c)))
                       ((%free-of rest var) (list (list '* c rest)))
                       (t (error "~S is not a polynomial in ~A" expr var))))))
      (let ((terms (if (and (consp e) (eq (car e) '+)) (cdr e) (list e))))
        (%poly-trim (let ((acc nil)) (dolist (tm terms) (setq acc (poly+ acc (term-poly tm)))) acc))))))

(defun poly->expr (p var)
  "The expression for the coefficient list P in VAR."
  (simplify (cons '+ (loop for c in p for i from 0 collect (list '* c (list 'expt var i))))))

(defun solve-linear (a b) "The solution x of A x + B = 0." (/ (- b) a))
(defun solve-quadratic (a b c)
  "The roots of A x^2 + B x + C = 0 as a list (real numbers or complex numbers)."
  (let ((disc (- (* b b) (* 4 a c))))
    (list (c/ (c+ (- b) (sqrt disc)) (* 2 a)) (c/ (c- (- b) (sqrt disc)) (* 2 a)))))
