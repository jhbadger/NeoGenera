;;;; 25-pl-builtins.lisp -- the Prolog Tool Kit: control constructs and the built-in predicates written in Lisp.
;;;;
;;;; Deterministic built-ins are Lisp functions of the argument terms returning true or false; non-deterministic ones
;;;; return NIL (fail) or a generator closure which the machine calls once per solution (it returns :LAST for the final
;;;; one, true for "more may follow", NIL when exhausted).  Built-ins marked LIBRARY may be redefined by user programs.

(in-package :cl)

(defmacro pl-def (name arity params &body body)
  `(%pl-register ,name ,arity :fn (lambda ,params ,@body)))
(defmacro pl-deflib (name arity params &body body)
  `(%pl-register ,name ,arity :fn (lambda ,params ,@body) :library t))
(defmacro pl-defnd (name arity params &body body)
  `(%pl-register ,name ,arity :fn (lambda ,params ,@body) :kind :nondet))
(defmacro pl-defndlib (name arity params &body body)
  `(%pl-register ,name ,arity :fn (lambda ,params ,@body) :kind :nondet :library t))

;;; ---- control ----------------------------------------------------------------------------------------------------------------------

(%pl-register "true" 0 :ctl :true)
(%pl-register "otherwise" 0 :ctl :true)
(%pl-register "fail" 0 :ctl :fail)
(%pl-register "false" 0 :ctl :fail)
(%pl-register "!" 0 :ctl :cut)
(%pl-register "," 2 :ctl :conj)
(%pl-register ";" 2 :ctl :disj)
(%pl-register "|" 2 :ctl :disj)
(%pl-register "->" 2 :ctl :ite)
(%pl-register "*->" 2 :ctl :softite)
(%pl-register "\\+" 1 :ctl :not)
(%pl-register "not" 1 :ctl :not)
(%pl-register "once" 1 :ctl :once)
(%pl-register "ignore" 1 :ctl :ignore)
(%pl-register "forall" 2 :ctl :forall)
(%pl-register "catch" 3 :ctl :catch)
(%pl-register ":" 2 :ctl :colon)
(dotimes (i 8) (%pl-register "call" (+ i 1) :ctl :call))

(pl-def "throw" 1 (ball)
  (let ((b (%deref ball)))
    (when (plv-p b) (pl-instantiation-error))
    (pl-throw b)))

(pl-def "halt" 0 () (error 'pl-halt :code 0))
(pl-def "halt" 1 (code) (error 'pl-halt :code (%deref code)))

;;; ---- argument helpers -------------------------------------------------------------------------------------------------------------------

(defun %pl-int-arg (x)
  (setq x (%deref x))
  (cond ((integerp x) x) ((plv-p x) (pl-instantiation-error)) (t (pl-type-error "integer" x))))

(defun %pl-atom-arg (x)
  (setq x (%deref x))
  (cond ((and x (symbolp x)) x) ((plv-p x) (pl-instantiation-error)) (t (pl-type-error "atom" x))))

(defun %pl-callable-arg (x)
  (setq x (%deref x))
  (cond ((pl-callable-p x) x) ((plv-p x) (pl-instantiation-error)) (t (pl-type-error "callable" x))))

(defun %pl-list-arg (x)
  "The Lisp list of the elements of the proper Prolog list X; errors for partial and non-lists."
  (multiple-value-bind (items status) (pl-list-to-lisp x)
    (case status
      (:proper items)
      (:partial (pl-instantiation-error))
      (t (pl-type-error "list" (%deref x))))))

(defun %pl-atomic-text (x)
  "The text of the atomic X (an atom, string or number): [] is the atom '[]'."
  (setq x (%deref x))
  (cond ((stringp x) x) ((symbolp x) (and x (symbol-name x))) ((numberp x) (pl-number-string x)) (t nil)))

(defun %pl-text-arg (x &optional (what "atomic"))
  (setq x (%deref x))
  (cond ((plv-p x) (pl-instantiation-error))
        (t (or (%pl-atomic-text x) (pl-text x) (pl-type-error what x)))))

(defun %pl-undo-unify (a b)
  "Unify A and B; on failure undo any bindings made.  True on success."
  (let ((mark *pl-tn*) (saved *pl-hb*))
    (setq *pl-hb* most-positive-fixnum)
    (let ((ok (unwind-protect (pl-unify a b) (setq *pl-hb* saved))))
      (unless ok (%pl-undo-to mark))
      ok)))

(defun %pl-can-unify (a b)
  "True when A and B unify; no bindings are kept."
  (let ((mark *pl-tn*) (saved *pl-hb*))
    (setq *pl-hb* most-positive-fixnum)
    (let ((ok (unwind-protect (pl-unify a b) (setq *pl-hb* saved))))
      (%pl-undo-to mark)
      ok)))

(defun %pl-last-gen () (lambda () :last))

(defun %pl-alternatives (items try)
  "A generator that tries each of the Lisp list ITEMS with the function TRY until it succeeds."
  (lambda ()
    (loop
      (when (null items) (return nil))
      (let ((item (car items)) (mark *pl-tn*))
        (setq items (cdr items))
        (if (funcall try item)
            (return (if items t :last))
            (%pl-undo-to mark))))))

;;; ---- unification and comparison ------------------------------------------------------------------------------------------------------

(pl-def "=" 2 (a b) (pl-unify a b))
(pl-def "\\=" 2 (a b) (not (%pl-can-unify a b)))
(pl-def "unify_with_occurs_check" 2 (a b) (pl-unify-oc a b))
(pl-def "==" 2 (a b) (= 0 (pl-compare a b)))
(pl-def "\\==" 2 (a b) (/= 0 (pl-compare a b)))
(pl-def "@<" 2 (a b) (< (pl-compare a b) 0))
(pl-def "@>" 2 (a b) (> (pl-compare a b) 0))
(pl-def "@=<" 2 (a b) (<= (pl-compare a b) 0))
(pl-def "@>=" 2 (a b) (>= (pl-compare a b) 0))
(pl-def "compare" 3 (o a b)
  (let ((od (%deref o)))
    (unless (or (plv-p od) (member od (list (pl-atom "<") (pl-atom ">") (pl-atom "="))))
      (if (symbolp od) (pl-domain-error "order" od) (pl-type-error "atom" od))))
  (let ((c (pl-compare a b))) (pl-unify o (pl-atom (cond ((< c 0) "<") ((> c 0) ">") (t "="))))))

(defun pl-variant-p (a b)
  "True when A and B are equal up to a renaming of variables."
  (let ((ab nil) (ba nil))
    (labels ((walk (x y)
               (loop
                 (setq x (%deref x) y (%deref y))
                 (cond ((and (plv-p x) (plv-p y))
                        (let ((p (assq x ab)) (q (assq y ba)))
                          (cond ((and (null p) (null q)) (push (cons x y) ab) (push (cons y x) ba) (return t))
                                ((and p q (eq (cdr p) y) (eq (cdr q) x)) (return t))
                                (t (return nil)))))
                       ((or (plv-p x) (plv-p y)) (return nil))
                       ((pls-p x)
                        (unless (and (pls-p y) (eq (pls-name x) (pls-name y)) (= (length (pls-args x)) (length (pls-args y)))) (return nil))
                        (let* ((xa (pls-args x)) (ya (pls-args y)) (n (length xa)))
                          (dotimes (i (- n 1)) (unless (walk (svref xa i) (svref ya i)) (return-from walk nil)))
                          (setq x (svref xa (- n 1)) y (svref ya (- n 1)))))
                       (t (return (= 0 (pl-compare x y))))))))
      (walk a b))))

(pl-def "=@=" 2 (a b) (pl-variant-p a b))
(pl-def "\\=@=" 2 (a b) (not (pl-variant-p a b)))
(pl-def "?=" 2 (a b) (or (= 0 (pl-compare a b)) (not (%pl-can-unify a b))))

;;; ---- type checking --------------------------------------------------------------------------------------------------------------------

(pl-def "var" 1 (x) (plv-p (%deref x)))
(pl-def "nonvar" 1 (x) (not (plv-p (%deref x))))
(pl-def "atom" 1 (x) (let ((v (%deref x))) (and v (symbolp v))))
(pl-def "number" 1 (x) (numberp (%deref x)))
(pl-def "integer" 1 (x) (integerp (%deref x)))
(pl-def "float" 1 (x) (floatp (%deref x)))
(pl-def "rational" 1 (x) (integerp (%deref x)))
(pl-def "atomic" 1 (x) (let ((v (%deref x))) (not (or (plv-p v) (pls-p v)))))
(pl-def "compound" 1 (x) (pls-p (%deref x)))
(pl-def "callable" 1 (x) (pl-callable-p (%deref x)))
(pl-def "is_list" 1 (x) (pl-list-p x))
(pl-def "string" 1 (x) (stringp (%deref x)))
(pl-def "blob" 2 (x type) (let ((v (%deref x))) (and (not (or (plv-p v) (pls-p v) (symbolp v) (numberp v) (stringp v))) (pl-unify type (pl-atom "blob")))))
(pl-def "ground" 1 (x) (pl-ground-p x))
(pl-def "is_dict" 1 (x) (declare (ignore x)) nil)
(pl-def "is_assoc" 1 (x) (let ((v (%deref x))) (or (eq v (pl-atom "t")) (pl-functor-p v (pl-atom "t") 5))))

;;; ---- arithmetic -------------------------------------------------------------------------------------------------------------------------

(pl-def "is" 2 (x e) (pl-unify x (pl-eval e)))
(pl-def "=:=" 2 (a b) (= 0 (pl-compare-values (pl-eval a) (pl-eval b))))
(pl-def "=\\=" 2 (a b) (/= 0 (pl-compare-values (pl-eval a) (pl-eval b))))
(pl-def "<" 2 (a b) (< (pl-eval a) (pl-eval b)))
(pl-def ">" 2 (a b) (> (pl-eval a) (pl-eval b)))
(pl-def "=<" 2 (a b) (<= (pl-eval a) (pl-eval b)))
(pl-def ">=" 2 (a b) (>= (pl-eval a) (pl-eval b)))

(pl-def "succ" 2 (a b)
  (let ((x (%deref a)) (y (%deref b)))
    (cond ((integerp x) (when (< x 0) (pl-type-error "not_less_than_zero" x))
           (unless (or (plv-p y) (integerp y)) (pl-type-error "integer" y))
           (pl-unify y (+ x 1)))
          ((plv-p x)
           (cond ((integerp y) (when (< y 0) (pl-type-error "not_less_than_zero" y)) (and (> y 0) (pl-unify x (- y 1))))
                 ((plv-p y) (pl-instantiation-error))
                 (t (pl-type-error "integer" y))))
          (t (pl-type-error "integer" x)))))

(pl-def "plus" 3 (a b c)
  (let ((x (%deref a)) (y (%deref b)) (z (%deref c)))
    (cond ((and (integerp x) (integerp y)) (pl-unify z (+ x y)))
          ((and (integerp x) (integerp z)) (pl-unify y (- z x)))
          ((and (integerp y) (integerp z)) (pl-unify x (- z y)))
          (t (pl-instantiation-error)))))

(pl-defnd "between" 3 (lo hi x)
  (let* ((l (%pl-int-arg lo)) (hv (%deref hi))
         (h (cond ((integerp hv) hv) ((member hv (list (pl-atom "inf") (pl-atom "infinite"))) nil)
                  ((plv-p hv) (pl-instantiation-error)) (t (pl-type-error "integer" hv))))
         (xv (%deref x)))
    (cond ((integerp xv) (and (>= xv l) (or (null h) (<= xv h)) (%pl-last-gen)))
          ((plv-p xv)
           (let ((i l))
             (and (or (null h) (<= i h))
                  (lambda () (pl-unify xv i) (setq i (+ i 1)) (if (and h (> i h)) :last t)))))
          (t (pl-type-error "integer" xv)))))

;;; ---- term construction and inspection -----------------------------------------------------------------------------------------------------

(pl-def "functor" 3 (term name arity)
  (let ((tm (%deref term)))
    (cond ((plv-p tm)
           (let ((n (%deref name)) (a (%deref arity)))
             (cond ((or (plv-p n) (plv-p a)) (pl-instantiation-error))
                   ((not (integerp a)) (pl-type-error "integer" a))
                   ((< a 0) (pl-domain-error "not_less_than_zero" a))
                   ((= a 0) (if (pls-p n) (pl-type-error "atomic" n) (pl-unify tm n)))
                   ((pls-p n) (pl-type-error "atomic" n))
                   ((not (and n (symbolp n))) (pl-type-error "atom" n))
                   (t (let ((args (make-array (%pl-check-size a)))) (dotimes (i a) (setf (svref args i) (pl-new-var)))
                        (pl-unify tm (%make-pls n args)))))))
          ((pls-p tm) (and (pl-unify name (pls-name tm)) (pl-unify arity (length (pls-args tm)))))
          (t (and (pl-unify name tm) (pl-unify arity 0))))))

(pl-defnd "arg" 3 (n term arg)
  (let ((tm (%deref term)) (nv (%deref n)))
    (unless (pls-p tm) (if (plv-p tm) (pl-instantiation-error) (pl-type-error "compound" tm)))
    (let ((args (pls-args tm)))
      (cond ((integerp nv) (and (>= nv 1) (<= nv (length args)) (pl-unify arg (svref args (- nv 1))) (%pl-last-gen)))
            ((plv-p nv)
             (%pl-alternatives (let ((acc nil)) (dotimes (i (length args)) (push (+ i 1) acc)) (nreverse acc))
                               (lambda (i) (and (pl-unify nv i) (pl-unify arg (svref args (- i 1)))))))
            (t (pl-type-error "integer" nv))))))

(pl-def "=.." 2 (term list)
  (let ((tm (%deref term)))
    (cond ((pls-p tm) (pl-unify list (pl-cons (pls-name tm) (lisp-to-pl-list (coerce (pls-args tm) 'list)))))
          ((plv-p tm)
           (let ((items (%pl-list-arg list)))
             (when (null items) (pl-domain-error "non_empty_list" *pl-nil*))
             (let ((h (%deref (car items))))
               (cond ((null (cdr items)) (if (plv-p h) (pl-instantiation-error) (if (pls-p h) (pl-type-error "atomic" h) (pl-unify tm h))))
                     ((plv-p h) (pl-instantiation-error))
                     ((pls-p h) (pl-type-error "atomic" h))
                     ((not (and h (symbolp h))) (pl-type-error "atom" h))
                     (t (pl-unify tm (%make-pls h (coerce (cdr items) 'simple-vector))))))))
          (t (pl-unify list (pl-cons tm *pl-nil*))))))

(pl-def "copy_term" 2 (a b) (pl-unify b (pl-copy-term a)))
(pl-def "term_variables" 2 (term vars) (pl-unify vars (lisp-to-pl-list (pl-variables-of term))))
(pl-def "term_variables" 3 (term vars tail) (pl-unify vars (lisp-to-pl-list (pl-variables-of term) tail)))
(pl-def "numbervars" 3 (term start end)
  (let ((n (pl-numbervars term (%pl-int-arg start)))) (pl-unify end n)))
(pl-def "numbervars" 1 (term) (pl-numbervars term 0) t)
(pl-def "setarg" 3 (n term value)
  (let ((tm (%deref term)) (i (%pl-int-arg n)))
    (unless (pls-p tm) (pl-type-error "compound" tm))
    (and (>= i 1) (<= i (length (pls-args tm)))
         (let* ((args (pls-args tm)) (old (svref args (- i 1))) (v (%deref value)))
           (setf (svref args (- i 1)) v)
           (pl-trail-undo-function (lambda () (setf (svref args (- i 1)) old)))
           t))))
(pl-def "nb_setarg" 3 (n term value)
  (let ((tm (%deref term)) (i (%pl-int-arg n)))
    (unless (pls-p tm) (pl-type-error "compound" tm))
    (and (>= i 1) (<= i (length (pls-args tm)))
         (progn (setf (svref (pls-args tm) (- i 1)) (pl-copy-term value)) t))))

;;; ---- atoms and strings ------------------------------------------------------------------------------------------------------------------------

(defun %pl-text-to-number (text)
  "The number written in TEXT (leading layout and a sign allowed), or NIL."
  (let* ((s (string-left-trim '(#\Space #\Tab #\Newline) text)) (n (length s)) (neg nil) (i 0))
    (when (and (> n 0) (member (char s 0) '(#\- #\+))) (setq neg (char= (char s 0) #\-) i 1))
    (when (and (< i n) (digit-char-p (char s i)))
      (multiple-value-bind (v e) (handler-case (%pl-lex-number s i) (pl-error () (values nil 0)))
        (when (and v (= e n)) (if neg (- v) v))))))

(defun %pl-syntax-number-error (text)
  (pl-syntax-error (format nil "illegal_number: ~A" text)))

(pl-def "atom_codes" 2 (a l)
  (let ((av (%deref a)))
    (if (plv-p av)
        (let ((s (pl-text l))) (unless s (if (plv-p (%deref l)) (pl-instantiation-error) (pl-type-error "list" (%deref l)))) (pl-unify av (pl-atom s)))
        (pl-unify l (pl-string-codes (%pl-text-arg av))))))
(pl-def "atom_chars" 2 (a l)
  (let ((av (%deref a)))
    (if (plv-p av)
        (let ((s (pl-text l))) (unless s (if (plv-p (%deref l)) (pl-instantiation-error) (pl-type-error "list" (%deref l)))) (pl-unify av (pl-atom s)))
        (pl-unify l (pl-string-chars (%pl-text-arg av))))))
(pl-def "char_code" 2 (c code)
  (let ((cv (%deref c)))
    (if (and cv (symbolp cv) (= (length (symbol-name cv)) 1))
        (pl-unify code (char-code (char (symbol-name cv) 0)))
        (let ((n (%deref code)))
          (cond ((integerp n) (pl-unify c (pl-atom (string (code-char n)))))
                ((and (plv-p cv) (plv-p n)) (pl-instantiation-error))
                (t (pl-type-error "character" cv)))))))
(pl-def "atom_length" 2 (a n)
  (let ((len (length (%pl-text-arg a))) (nv (%deref n)))
    (unless (or (plv-p nv) (integerp nv)) (pl-type-error "integer" nv))
    (when (and (integerp nv) (< nv 0)) (pl-domain-error "not_less_than_zero" nv))
    (pl-unify n len)))
(pl-def "string_length" 2 (a n) (pl-unify n (length (%pl-text-arg a))))
(pl-def "atom_number" 2 (a n)
  (let ((av (%deref a)))
    (if (plv-p av)
        (let ((nv (%deref n))) (if (numberp nv) (pl-unify av (pl-atom (pl-number-string nv))) (pl-instantiation-error)))
        (let ((v (%pl-text-to-number (%pl-text-arg av)))) (and v (pl-unify n v))))))
(pl-def "number_codes" 2 (n l)
  (let ((nv (%deref n)))
    (if (plv-p nv)
        (let* ((s (pl-text l)) (v (and s (%pl-text-to-number s))))
          (unless s (pl-instantiation-error))
          (unless v (%pl-syntax-number-error s))
          (pl-unify nv v))
        (progn (unless (numberp nv) (pl-type-error "number" nv)) (pl-unify l (pl-string-codes (pl-number-string nv)))))))
(pl-def "number_chars" 2 (n l)
  (let ((nv (%deref n)))
    (if (plv-p nv)
        (let* ((s (pl-text l)) (v (and s (%pl-text-to-number s))))
          (unless s (pl-instantiation-error))
          (unless v (%pl-syntax-number-error s))
          (pl-unify nv v))
        (progn (unless (numberp nv) (pl-type-error "number" nv)) (pl-unify l (pl-string-chars (pl-number-string nv)))))))
(pl-def "atom_string" 2 (a s)
  (let ((av (%deref a)))
    (if (plv-p av) (pl-unify av (pl-atom (%pl-text-arg s))) (pl-unify s (copy-seq (%pl-text-arg av))))))
(pl-def "number_string" 2 (n s)
  (let ((sv (%deref s)))
    (if (plv-p sv)
        (pl-unify sv (pl-number-string (let ((v (%deref n))) (if (numberp v) v (pl-type-error "number" v)))))
        (let ((v (%pl-text-to-number (string-trim '(#\Space #\Tab #\Newline) (%pl-text-arg sv))))) (and v (pl-unify n v))))))
(pl-def "string_chars" 2 (s l)
  (let ((sv (%deref s)))
    (if (plv-p sv) (pl-unify sv (or (pl-text l) (pl-instantiation-error))) (pl-unify l (pl-string-chars (%pl-text-arg sv))))))
(pl-def "string_codes" 2 (s l)
  (let ((sv (%deref s)))
    (if (plv-p sv) (pl-unify sv (copy-seq (or (pl-text l) (pl-instantiation-error)))) (pl-unify l (pl-string-codes (%pl-text-arg sv))))))
(pl-def "string_to_atom" 2 (s a)
  (let ((sv (%deref s)))
    (if (plv-p sv) (pl-unify sv (copy-seq (%pl-text-arg a))) (pl-unify a (pl-atom (%pl-text-arg sv))))))
(pl-def "string_code" 3 (i s c)
  (let ((k (%pl-int-arg i)) (txt (%pl-text-arg s)))
    (and (>= k 1) (<= k (length txt)) (pl-unify c (char-code (char txt (- k 1)))))))
(pl-def "text_to_string" 2 (x s) (pl-unify s (copy-seq (%pl-text-arg x))))
(pl-def "string_lower" 2 (s l) (pl-unify l (string-downcase (%pl-text-arg s))))
(pl-def "string_upper" 2 (s u) (pl-unify u (string-upcase (%pl-text-arg s))))
(pl-def "upcase_atom" 2 (a u) (pl-unify u (pl-atom (string-upcase (%pl-text-arg a)))))
(pl-def "downcase_atom" 2 (a l) (pl-unify l (pl-atom (string-downcase (%pl-text-arg a)))))
(pl-def "term_to_atom" 2 (term atom)
  (let ((tv (%deref term)))
    (if (and (plv-p tv) (not (plv-p (%deref atom))))
        (pl-unify tv (pl-parse-string (%pl-text-arg atom)))
        (pl-unify atom (pl-atom (pl-term-to-string tv :quoted t :numbervars t))))))
(pl-def "term_string" 2 (term s)
  (let ((tv (%deref term)))
    (if (and (plv-p tv) (not (plv-p (%deref s))))
        (pl-unify tv (pl-parse-string (%pl-text-arg s)))
        (pl-unify s (pl-term-to-string tv :quoted t :numbervars t)))))
(pl-def "sformat" 3 (s fmt args) (pl-unify s (pl-format-to-string (%pl-text-arg fmt) (%pl-format-args args))))

(defun %pl-format-args (args)
  (multiple-value-bind (items status) (pl-list-to-lisp args)
    (if (eq status :proper) items (list args))))

(defun %pl-make-text (kind string)
  "The Prolog term of KIND (:atom :string :codes :chars) for STRING."
  (ecase kind (:atom (pl-atom string)) (:string string) (:codes (pl-string-codes string)) (:chars (pl-string-chars string))))

(pl-defnd "atom_concat" 3 (a b c)
  (let ((av (%deref a)) (bv (%deref b)))
    (cond ((and (not (plv-p av)) (not (plv-p bv)))
           (and (pl-unify c (pl-atom (concatenate 'string (%pl-text-arg av) (%pl-text-arg bv)))) (%pl-last-gen)))
          (t (let ((cv (%deref c)))
               (when (plv-p cv) (pl-instantiation-error))
               (let* ((txt (%pl-text-arg cv)) (n (length txt)))
                 (%pl-alternatives (let ((acc nil)) (dotimes (i (+ n 1)) (push i acc)) (nreverse acc))
                                   (lambda (i) (and (pl-unify av (pl-atom (subseq txt 0 i))) (pl-unify bv (pl-atom (subseq txt i))))))))))))

(pl-defnd "string_concat" 3 (a b c)
  (let ((av (%deref a)) (bv (%deref b)))
    (cond ((and (not (plv-p av)) (not (plv-p bv)))
           (and (pl-unify c (concatenate 'string (%pl-text-arg av) (%pl-text-arg bv))) (%pl-last-gen)))
          (t (let ((cv (%deref c)))
               (when (plv-p cv) (pl-instantiation-error))
               (let* ((txt (%pl-text-arg cv)) (n (length txt)))
                 (%pl-alternatives (let ((acc nil)) (dotimes (i (+ n 1)) (push i acc)) (nreverse acc))
                                   (lambda (i) (and (pl-unify av (subseq txt 0 i)) (pl-unify bv (subseq txt i)))))))))))

(defconstant +pl-max-size+ 1000000)

(defun %pl-check-size (n)
  "N, a count that will be allocated: a resource error when it is absurdly large (the heap is finite and exhausting it is fatal)."
  (if (and (integerp n) (<= n +pl-max-size+)) n (pl-resource-error "memory")))

(defun %pl-sub-text (kind text b l a sub)
  "The generator behind sub_atom/5 and sub_string/5; candidates are produced lazily and only within the text."
  (let* ((n (length text)) (bv (%deref b)) (lv (%deref l)) (av (%deref a)) (sv (%deref sub))
         (mk (lambda (s) (%pl-make-text kind s))))
    (dolist (x (list bv lv av)) (unless (or (plv-p x) (integerp x)) (pl-type-error "integer" x)))
    (dolist (x (list bv lv av)) (when (and (integerp x) (or (< x 0) (> x n))) (return-from %pl-sub-text nil)))
    (cond
      ((not (plv-p sv))
       (let* ((st (%pl-text-arg sv)) (m (length st)) (positions nil))
         (loop for i from 0 to (- n m)
               do (when (string= (subseq text i (+ i m)) st) (push i positions)))
         (%pl-alternatives (nreverse positions)
                           (lambda (i) (and (pl-unify bv i) (pl-unify lv m) (pl-unify av (- n i m)))))))
      (t
       (let ((bi (if (integerp bv) bv 0)) (bmax (if (integerp bv) bv n)) (li nil))
         (flet ((lmin (bb) (cond ((integerp lv) lv) ((integerp av) (- n bb av)) (t 0)))
                (lmax (bb) (cond ((integerp lv) lv) ((integerp av) (- n bb av)) (t (- n bb)))))
           (lambda ()
             (loop
               (when (> bi bmax) (return nil))
               (when (null li) (setq li (lmin bi)))
               (cond ((or (< li 0) (> li (lmax bi)) (> (+ bi li) n))
                      (setq bi (+ bi 1) li nil))
                     (t (let ((cb bi) (cl li) (mark *pl-tn*))
                          (if (< li (lmax bi)) (setq li (+ li 1)) (setq bi (+ bi 1) li nil))
                          (if (and (pl-unify bv cb) (pl-unify lv cl) (pl-unify av (- n cb cl)) (pl-unify sv (funcall mk (subseq text cb (+ cb cl)))))
                              (return t)
                              (%pl-undo-to mark)))))))))))))

(pl-defnd "sub_atom" 5 (atom b l a sub) (%pl-sub-text :atom (%pl-text-arg atom) b l a sub))
(pl-defnd "sub_string" 5 (s b l a sub) (%pl-sub-text :string (%pl-text-arg s) b l a sub))

(pl-def "atomic_list_concat" 2 (list atom)
  (let ((items (%pl-list-arg list)) (out (make-string-output-stream)))
    (dolist (x items)
      (let ((v (%deref x))) (when (plv-p v) (pl-instantiation-error))
        (write-string (or (%pl-atomic-text v) (pl-type-error "atomic" v)) out)))
    (pl-unify atom (pl-atom (get-output-stream-string out)))))

(defun %pl-split-text (text sep)
  (let ((parts nil) (start 0) (m (length sep)))
    (loop
      (let ((p (search sep text :start2 start)))
        (cond (p (push (subseq text start p) parts) (setq start (+ p m)))
              (t (push (subseq text start) parts) (return)))))
    (nreverse parts)))

(pl-def "atomic_list_concat" 3 (list sep atom)
  (let ((sepstr (%pl-text-arg sep)))
    (multiple-value-bind (items status) (pl-list-to-lisp list)
      (if (and (eq status :proper) (notany (lambda (x) (plv-p (%deref x))) items))
          (let ((out (make-string-output-stream)) (first t))
            (dolist (x items)
              (unless first (write-string sepstr out))
              (setq first nil)
              (write-string (or (%pl-atomic-text (%deref x)) (pl-type-error "atomic" (%deref x))) out))
            (pl-unify atom (pl-atom (get-output-stream-string out))))
          (progn
            (when (plv-p (%deref atom)) (pl-instantiation-error))
            (when (= (length sepstr) 0) (pl-domain-error "non_empty_atom" sep))
            (pl-unify list (lisp-to-pl-list (mapcar #'pl-atom (%pl-split-text (%pl-text-arg atom) sepstr)))))))))

(pl-def "split_string" 4 (str seps pad result)
  (let* ((text (%pl-text-arg str)) (sepchars (%pl-text-arg seps)) (padchars (%pl-text-arg pad)) (fields nil) (start 0))
    (dotimes (i (length text))
      (when (find (char text i) sepchars) (push (subseq text start i) fields) (setq start (+ i 1))))
    (push (subseq text start) fields)
    (pl-unify result (lisp-to-pl-list
                      (mapcar (lambda (f)
                                (let ((s 0) (e (length f)))
                                  (loop (when (or (>= s e) (not (find (char f s) padchars))) (return)) (setq s (+ s 1)))
                                  (loop (when (or (<= e s) (not (find (char f (- e 1)) padchars))) (return)) (setq e (- e 1)))
                                  (subseq f s e)))
                              (nreverse fields))))))

(defun %pl-char-types (code)
  "The types of the character CODE as for char_type/2: a list of terms."
  (let* ((c (code-char code)) (acc nil))
    (when (or (alpha-char-p c) (digit-char-p c) (char= c #\_)) (push (pl-atom "alnum_") acc))
    (when (alpha-char-p c) (push (pl-atom "alpha") acc) (push (pl-atom "csymf") acc))
    (when (or (alpha-char-p c) (digit-char-p c)) (push (pl-atom "alnum") acc))
    (when (or (alpha-char-p c) (digit-char-p c) (char= c #\_)) (push (pl-atom "csym") acc))
    (when (digit-char-p c) (push (pl-s "digit" (digit-char-p c)) acc) (push (pl-atom "digit") acc))
    (when (digit-char-p c 16) (push (pl-s "xdigit" (digit-char-p c 16)) acc))
    (when (%pl-layout-p c) (push (pl-atom "space") acc) (push (pl-atom "white") acc))
    (when (upper-case-p c) (push (pl-atom "upper") acc) (push (pl-s "upper" (pl-atom (string (char-downcase c)))) acc))
    (when (and (alpha-char-p c) (not (upper-case-p c))) (push (pl-atom "lower") acc) (push (pl-s "lower" (pl-atom (string (char-upcase c)))) acc))
    (when (and (> code 32) (< code 127) (not (alpha-char-p c)) (not (digit-char-p c))) (push (pl-atom "punct") acc))
    (when (and (> code 32) (< code 127)) (push (pl-atom "graph") acc))
    (when (>= code 32) (push (pl-atom "print") acc))
    (when (< code 128) (push (pl-atom "ascii") acc))
    (when (or (= code 10) (= code 13)) (push (pl-atom "end_of_line") acc))
    (when (or (< code 32) (= code 127)) (push (pl-atom "cntrl") acc))
    (push (pl-s "to_lower" (pl-atom (string (char-downcase c)))) acc)
    (push (pl-s "to_upper" (pl-atom (string (char-upcase c)))) acc)
    (nreverse acc)))

(defun %pl-char-type-gen (x type codep)
  (let ((xv (%deref x)))
    (flet ((code-of (v) (cond ((integerp v) v) ((and v (symbolp v) (= (length (symbol-name v)) 1)) (char-code (char (symbol-name v) 0))) (t nil)))
           (fix (term) (if codep (if (and (pls-p term) (member (symbol-name (pls-name term)) '("upper" "lower" "to_lower" "to_upper") :test #'string=))
                                     (%make-pls (pls-name term) (vector (let ((a (%deref (pl-arg term 0)))) (if (and a (symbolp a)) (char-code (char (symbol-name a) 0)) a))))
                                     term)
                           term)))
      (if (plv-p xv)
          (%pl-alternatives (let ((acc nil)) (dotimes (i 256) (push i acc)) (nreverse acc))
                            (lambda (code) (and (some (lambda (ty) (%pl-can-unify type (fix ty))) (%pl-char-types code))
                                                (pl-unify xv (if codep code (pl-atom (string (code-char code)))))
                                                (let ((ty (find-if (lambda (ty) (%pl-can-unify type (fix ty))) (%pl-char-types code))))
                                                  (pl-unify type (fix ty))))))
          (let ((code (code-of xv)))
            (unless code (pl-type-error "character" xv))
            (%pl-alternatives (%pl-char-types code) (lambda (ty) (pl-unify type (fix ty)))))))))

(pl-defnd "char_type" 2 (x type) (%pl-char-type-gen x type nil))
(pl-defnd "code_type" 2 (x type) (%pl-char-type-gen x type t))

;;; ---- lists -------------------------------------------------------------------------------------------------------------------------------------

(pl-defnd "length" 2 (list n)
  (multiple-value-bind (items status) (pl-list-to-lisp list)
    (let ((nv (%deref n)))
      (unless (or (plv-p nv) (integerp nv)) (pl-type-error "integer" nv))
      (case status
        (:proper (and (pl-unify nv (length items)) (%pl-last-gen)))
        ((:improper :cyclic) (pl-type-error "list" (%deref list)))
        (t ;; partial list: find the tail variable
         (let ((tail (%deref list)))
           (loop (if (pl-is-cons tail) (setq tail (%deref (pl-tail tail))) (return)))
           (let ((have (length items)))
             (cond ((integerp nv)
                    (cond ((< nv 0) nil)
                          ((< nv have) nil)
                          (t (let ((fresh nil)) (dotimes (i (- (%pl-check-size nv) have)) (push (pl-new-var) fresh))
                               (and (pl-unify tail (lisp-to-pl-list fresh)) (%pl-last-gen))))))
                   (t (let ((extra 0))
                        (lambda ()
                          (let ((fresh nil)) (dotimes (i extra) (push (pl-new-var) fresh))
                            (pl-unify tail (lisp-to-pl-list fresh))
                            (pl-unify nv (+ have extra))
                            (setq extra (+ extra 1))
                            t))))))))))))

(defun %pl-sort-list (items &optional (dedupe t))
  (let ((sorted (stable-sort (copy-list items) (lambda (a b) (< (pl-compare a b) 0)))))
    (if dedupe
        (let ((acc nil))
          (dolist (x sorted) (unless (and acc (= 0 (pl-compare (car acc) x))) (push x acc)))
          (nreverse acc))
        sorted)))

(pl-def "msort" 2 (list sorted) (pl-unify sorted (lisp-to-pl-list (%pl-sort-list (%pl-list-arg list) nil))))
(pl-def "sort" 2 (list sorted) (pl-unify sorted (lisp-to-pl-list (%pl-sort-list (%pl-list-arg list) t))))
(pl-def "sort" 4 (key order list sorted)
  (let* ((k (%pl-int-arg key)) (o (%pl-atom-arg order)) (items (%pl-list-arg list)) (on (symbol-name o)))
    (unless (member on '("@<" "@>" "@=<" "@>=") :test #'string=) (pl-domain-error "order" o))
    (flet ((keyof (x) (if (= k 0) x (let ((v (%deref x))) (unless (and (pls-p v) (<= k (length (pls-args v)))) (pl-type-error "compound" v)) (svref (pls-args v) (- k 1))))))
      (let* ((desc (or (string= on "@>") (string= on "@>=")))
             (sorted-items (stable-sort (copy-list items)
                                        (lambda (a b) (let ((c (pl-compare (keyof a) (keyof b)))) (if desc (> c 0) (< c 0))))))
             (dedupe (or (string= on "@<") (string= on "@>"))))
        (when dedupe
          (let ((acc nil))
            (dolist (x sorted-items) (unless (and acc (= 0 (pl-compare (keyof (car acc)) (keyof x)))) (push x acc)))
            (setq sorted-items (nreverse acc))))
        (pl-unify sorted (lisp-to-pl-list sorted-items))))))

(pl-def "keysort" 2 (list sorted)
  (let ((items (%pl-list-arg list)))
    (dolist (x items) (let ((v (%deref x))) (cond ((plv-p v) (pl-instantiation-error)) ((not (pl-functor-p v *pl-minus* 2)) (pl-type-error "pair" v)))))
    (pl-unify sorted (lisp-to-pl-list (stable-sort (copy-list items) (lambda (a b) (< (pl-compare (pl-arg (%deref a) 0) (pl-arg (%deref b) 0)) 0)))))))

(pl-deflib "list_to_set" 2 (list set)
  (let ((acc nil))
    (dolist (x (%pl-list-arg list)) (unless (some (lambda (y) (= 0 (pl-compare x y))) acc) (push x acc)))
    (pl-unify set (lisp-to-pl-list (nreverse acc)))))

(pl-deflib "memberchk" 2 (x list)
  (let ((l (%deref list)))
    (loop
      (cond ((pl-is-cons l) (when (%pl-undo-unify x (pl-head l)) (return t)) (setq l (%deref (pl-tail l))))
            ((plv-p l) (return (pl-unify l (pl-cons x (pl-new-var)))))
            (t (return nil))))))

(pl-deflib "reverse" 2 (list rev)
  (multiple-value-bind (items status) (pl-list-to-lisp list)
    (unless (eq status :proper) (if (eq status :partial) (pl-instantiation-error) (pl-type-error "list" (%deref list))))
    (pl-unify rev (lisp-to-pl-list (reverse items)))))

(pl-deflib "sum_list" 2 (list sum)
  (let ((s 0)) (dolist (x (%pl-list-arg list)) (setq s (+ s (pl-eval x)))) (pl-unify sum s)))
(pl-deflib "sumlist" 2 (list sum)
  (let ((s 0)) (dolist (x (%pl-list-arg list)) (setq s (+ s (pl-eval x)))) (pl-unify sum s)))
(pl-deflib "max_list" 2 (list m)
  (let ((items (mapcar #'pl-eval (%pl-list-arg list)))) (and items (pl-unify m (reduce (lambda (a b) (if (< a b) b a)) items)))))
(pl-deflib "min_list" 2 (list m)
  (let ((items (mapcar #'pl-eval (%pl-list-arg list)))) (and items (pl-unify m (reduce (lambda (a b) (if (> a b) b a)) items)))))
(pl-deflib "numlist" 3 (lo hi list)
  (let ((l (%pl-int-arg lo)) (h (%pl-int-arg hi)))
    (and (<= l h) (<= (- h l) +pl-max-size+) (pl-unify list (lisp-to-pl-list (loop for i from l to h collect i))))))

;;; ---- global variables ------------------------------------------------------------------------------------------------------------------------------

(defvar *pl-globals* (make-hash-table :test 'eq))
(pl-def "nb_setval" 2 (k v) (setf (gethash (%pl-atom-arg k) *pl-globals*) (pl-copy-term v)) t)
(pl-def "b_setval" 2 (k v)
  (let* ((key (%pl-atom-arg k)) (old (gethash key *pl-globals*)) (had (nth-value 1 (gethash key *pl-globals*))))
    (setf (gethash key *pl-globals*) (%deref v))
    (pl-trail-undo-function (lambda () (if had (setf (gethash key *pl-globals*) old) (remhash key *pl-globals*))))
    t))
(pl-def "nb_getval" 2 (k v)
  (let ((key (%pl-atom-arg k)))
    (multiple-value-bind (val found) (gethash key *pl-globals*)
      (unless found (pl-existence-error "variable" key))
      (pl-unify v val))))
(pl-def "b_getval" 2 (k v)
  (let ((key (%pl-atom-arg k)))
    (multiple-value-bind (val found) (gethash key *pl-globals*)
      (unless found (pl-existence-error "variable" key))
      (pl-unify v val))))

;;; ---- all solutions ------------------------------------------------------------------------------------------------------------------------------------

(defun %pl-collect (template goal)
  "The list of copies of TEMPLATE for every solution of GOAL."
  (let ((acc nil))
    (pl-do-solutions goal (lambda () (push (pl-copy-term template) acc) nil))
    (nreverse acc)))

(pl-def "findall" 3 (template goal result)
  (%pl-callable-arg goal)
  (pl-unify result (lisp-to-pl-list (%pl-collect template goal))))
(pl-def "findall" 4 (template goal result tail)
  (%pl-callable-arg goal)
  (pl-unify result (lisp-to-pl-list (%pl-collect template goal) tail)))

(defun %pl-strip-carets (goal)
  "(values goal bound-variables-term) for Var^Goal."
  (let ((vars nil))
    (loop
      (setq goal (%deref goal))
      (if (pl-functor-p goal *pl-caret* 2)
          (progn (push (pl-arg goal 0) vars) (setq goal (pl-arg goal 1)))
          (return)))
    (values goal vars)))

(defun %pl-bagof (template goal result setp)
  (multiple-value-bind (g bound) (%pl-strip-carets goal)
    (%pl-callable-arg g)
    (let* ((tvars (pl-term-variables template (pl-term-variables (lisp-to-pl-list bound) nil)))
           (gvars (pl-variables-of g))
           (free (remove-if (lambda (v) (memq v tvars)) gvars)))
      (cond
        ((null free)
         (let ((items (%pl-collect template g)))
           (and items (pl-unify result (lisp-to-pl-list (if setp (%pl-sort-list items t) items))) (%pl-last-gen))))
        (t
         (let* ((witness (lisp-to-pl-list free))
                (pairs (%pl-collect (pl-s "-" witness template) g)))
           (if (null pairs) nil
               (let* ((sorted (stable-sort (copy-list pairs) (lambda (a b) (< (pl-compare (pl-arg a 0) (pl-arg b 0)) 0))))
                      (groups nil))
                 ;; group consecutive pairs with variant witnesses
                 (dolist (p sorted)
                   (if (and groups (pl-variant-p (pl-arg (car (car groups)) 0) (pl-arg p 0)))
                       (push p (car groups))
                       (push (list p) groups)))
                 (setq groups (nreverse (mapcar #'reverse groups)))
                 (%pl-alternatives groups
                                   (lambda (group)
                                     (let ((w (pl-arg (car group) 0)) (items (mapcar (lambda (p) (pl-arg p 1)) group)))
                                       ;; unify the witnesses of every pair in the group (they are variants)
                                       (and (every (lambda (p) (pl-unify (pl-arg p 0) w)) group)
                                            (pl-unify witness w)
                                            (pl-unify result (lisp-to-pl-list (if setp (%pl-sort-list items t) items)))))))))))))))

(pl-defnd "bagof" 3 (template goal result) (%pl-bagof template goal result nil))
(pl-defnd "setof" 3 (template goal result) (%pl-bagof template goal result t))

(pl-def "aggregate_all" 3 (spec goal result)
  (let ((s (%deref spec)))
    (cond
      ((eq s (pl-atom "count")) (let ((n 0)) (pl-do-solutions goal (lambda () (setq n (+ n 1)) nil)) (pl-unify result n)))
      ((pl-functor-p s (pl-atom "count") 1) (let ((n 0)) (pl-do-solutions goal (lambda () (setq n (+ n 1)) nil)) (pl-unify result n)))
      ((pl-functor-p s (pl-atom "sum") 1)
       (let ((sum 0)) (pl-do-solutions goal (lambda () (setq sum (+ sum (pl-eval (pl-arg s 0)))) nil)) (pl-unify result sum)))
      ((pl-functor-p s (pl-atom "bag") 1) (pl-unify result (lisp-to-pl-list (%pl-collect (pl-arg s 0) goal))))
      ((pl-functor-p s (pl-atom "set") 1) (pl-unify result (lisp-to-pl-list (%pl-sort-list (%pl-collect (pl-arg s 0) goal) t))))
      ((or (pl-functor-p s (pl-atom "max") 1) (pl-functor-p s (pl-atom "min") 1))
       (let ((best nil) (maxp (eq (pls-name s) (pl-atom "max"))))
         (pl-do-solutions goal (lambda () (let ((v (pl-eval (pl-arg s 0)))) (when (or (null best) (if maxp (> v best) (< v best))) (setq best v))) nil))
         (and best (pl-unify result best))))
      ((or (pl-functor-p s (pl-atom "max") 2) (pl-functor-p s (pl-atom "min") 2))
       (let ((best nil) (witness nil) (maxp (eq (pls-name s) (pl-atom "max"))))
         (pl-do-solutions goal (lambda () (let ((v (pl-eval (pl-arg s 0))))
                                            (when (or (null best) (if maxp (> v best) (< v best))) (setq best v witness (pl-copy-term (pl-arg s 1)))))
                                 nil))
         (and best (pl-unify result (%make-pls (pls-name s) (vector best witness))))))
      ((plv-p s) (pl-instantiation-error))
      (t (pl-domain-error "aggregate_spec" s)))))

;;; ---- the database ------------------------------------------------------------------------------------------------------------------------------------

(defun %pl-pred-of-head (head &optional create)
  (let ((h (%deref head)))
    (cond ((plv-p h) (pl-instantiation-error))
          ((not (pl-callable-p h)) (pl-type-error "callable" h))
          (t (let ((p (pl-find-pred (pl-name h) (pl-arity h))))
               (cond (p p) (create (pl-ensure-pred (pl-name h) (pl-arity h))) (t nil)))))))

(pl-def "assert" 1 (c) (pl-assert-clause (pl-copy-term c)) t)
(pl-def "assertz" 1 (c) (pl-assert-clause (pl-copy-term c)) t)
(pl-def "asserta" 1 (c) (pl-assert-clause (pl-copy-term c) :at-end nil) t)

(defun %pl-visible-clauses (pred)
  (let ((gen *pl-generation*))
    (remove-if-not (lambda (c) (and (<= (plclause-born c) gen) (> (plclause-died c) gen))) (copy-list (plpred-clauses pred)))))

(defun %pl-check-modifiable (pred head)
  (when (and pred (or (plpred-ctl pred) (and (plpred-fn pred) (not (plpred-library pred)))))
    (pl-permission-error "modify" "static_procedure" (pl-indicator (pl-name (%deref head)) (pl-arity (%deref head))))))

(pl-defnd "retract" 1 (clause)
  (multiple-value-bind (head body) (pl-split-clause clause)
    (let ((pred (%pl-pred-of-head head)))
      (%pl-check-modifiable pred head)
      (and pred
           (%pl-alternatives (%pl-visible-clauses pred)
                             (lambda (c)
                               (multiple-value-bind (h b) (pl-clause-terms c)
                                 (and (pl-unify head h) (pl-unify body b)
                                      (progn (pl-remove-clause pred c) t)))))))))

(pl-def "retractall" 1 (head)
  (let ((pred (%pl-pred-of-head head t)))
    (%pl-check-modifiable pred head)
    (unless (plpred-defined pred) (setf (plpred-dynamic pred) t (plpred-defined pred) t))
    (dolist (c (%pl-visible-clauses pred))
      (multiple-value-bind (h b) (pl-clause-terms c)
        (declare (ignore b))
        (when (%pl-can-unify head h) (pl-remove-clause pred c))))
    t))

(pl-defnd "clause" 2 (head body)
  (let ((pred (%pl-pred-of-head head)))
    (when (and pred (or (plpred-ctl pred) (and (plpred-fn pred) (not (plpred-library pred)))))
      (pl-permission-error "access" "private_procedure" (pl-indicator (pl-name (%deref head)) (pl-arity (%deref head)))))
    (let ((bv (%deref body)))
      (unless (or (plv-p bv) (pl-callable-p bv)) (pl-type-error "callable" bv)))
    (and pred
         (%pl-alternatives (%pl-visible-clauses pred)
                           (lambda (c) (multiple-value-bind (h b) (pl-clause-terms c) (and (pl-unify head h) (pl-unify body b))))))))

(defun %pl-parse-indicator (spec)
  "(values name arity) of a Name/Arity term."
  (let ((s (%deref spec)))
    (cond ((plv-p s) (pl-instantiation-error))
          ((pl-functor-p s *pl-slash* 2)
           (let ((n (%deref (pl-arg s 0))) (a (%deref (pl-arg s 1))))
             (cond ((or (plv-p n) (plv-p a)) (pl-instantiation-error))
                   ((not (and n (symbolp n))) (pl-type-error "atom" n))
                   ((not (integerp a)) (pl-type-error "integer" a))
                   (t (values n a)))))
          (t (pl-type-error "predicate_indicator" s)))))

(defun %pl-map-specs (spec fn)
  "Call FN on the (name arity) of each indicator in SPEC: a Name/Arity, a conjunction or a list of them."
  (let ((s (%deref spec)))
    (cond ((plv-p s) (pl-instantiation-error))
          ((or (pl-functor-p s *pl-comma* 2)) (%pl-map-specs (pl-arg s 0) fn) (%pl-map-specs (pl-arg s 1) fn))
          ((eq s *pl-nil*) nil)
          ((pl-is-cons s) (%pl-map-specs (pl-head s) fn) (%pl-map-specs (pl-tail s) fn))
          ((pl-functor-p s (pl-atom "as") 2) (%pl-map-specs (pl-arg s 0) fn))
          ((pl-functor-p s *pl-colon* 2) (%pl-map-specs (pl-arg s 1) fn))
          (t (multiple-value-bind (n a) (%pl-parse-indicator s) (funcall fn n a))))))

(defvar *pl-load-file* nil "The file being consulted, or NIL.")

(pl-def "dynamic" 1 (spec)
  (%pl-map-specs spec (lambda (n a)
                        (let ((p (pl-ensure-pred n a)))
                          (when (or (plpred-ctl p) (and (plpred-fn p) (not (plpred-library p))))
                            (pl-permission-error "modify" "static_procedure" (pl-indicator n a)))
                          (when (plpred-library p) (pl-wipe-pred p) (setf (plpred-fn p) nil (plpred-kind p) nil (plpred-library p) nil))
                          (setf (plpred-dynamic p) t (plpred-defined p) t))))
  t)
(pl-def "discontiguous" 1 (spec) (%pl-map-specs spec (lambda (n a) (setf (plpred-discontiguous (pl-ensure-pred n a)) t))) t)
(pl-def "multifile" 1 (spec) (%pl-map-specs spec (lambda (n a) (declare (ignore n a)) nil)) t)
(pl-def "module_transparent" 1 (spec) (declare (ignore spec)) t)
(pl-def "meta_predicate" 1 (spec) (declare (ignore spec)) t)
(pl-def "public" 1 (spec) (declare (ignore spec)) t)
(pl-def "table" 1 (spec) (declare (ignore spec)) t)

(pl-def "abolish" 1 (spec)
  (multiple-value-bind (n a) (%pl-parse-indicator spec)
    (let ((p (pl-find-pred n a)))
      (when p
        (when (or (plpred-ctl p) (and (plpred-fn p) (not (plpred-library p))))
          (pl-permission-error "modify" "static_procedure" (pl-indicator n a)))
        (pl-wipe-pred p)
        (setf (plpred-defined p) nil (plpred-dynamic p) nil))
      t)))

(defun %pl-user-pred-p (p)
  (and (not (plpred-ctl p)) (or (not (plpred-fn p)) (plpred-library p))
       (or (plpred-clauses p) (plpred-dynamic p))))
