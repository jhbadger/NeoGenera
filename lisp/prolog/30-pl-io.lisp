;;;; 30-pl-io.lisp -- the Prolog Tool Kit: streams, term input and output, format/2,3, messages, flags, operators, tracing.

(in-package :cl)

;;; ---- streams -------------------------------------------------------------------------------------------------------------------------

(defstruct (plstream (:constructor %make-plstream (id lisp mode)) (:copier nil)) id lisp mode (alias nil) (file nil) (kind :file))

(defvar *pl-streams* (make-hash-table :test 'eql) "Open streams: id -> PLSTREAM.")
(defvar *pl-stream-counter* 2)
(defvar *pl-cur-out* 1 "The id of the current output stream (0-2 are the standard streams).")
(defvar *pl-cur-in* 0 "The id of the current input stream.")
(defvar *pl-stream-functor* (pl-atom "$stream"))
(defvar *pl-aliases* nil "User stream aliases: alist (atom . id).")

(defun %pl-stream-term (id) (%make-pls *pl-stream-functor* (vector id)))

(defun %pl-register-stream (lisp mode &key file alias (kind :file))
  (let* ((id (setq *pl-stream-counter* (+ *pl-stream-counter* 1))) (ps (%make-plstream id lisp mode)))
    (setf (plstream-file ps) file (plstream-alias ps) alias (plstream-kind ps) kind)
    (setf (gethash id *pl-streams*) ps)
    (when alias (push (cons alias id) *pl-aliases*))
    ps))

(defun %pl-stream-id (term)
  "The id of the stream or alias TERM."
  (let ((s (%deref term)))
    (cond ((plv-p s) (pl-instantiation-error))
          ((and (pls-p s) (eq (pls-name s) *pl-stream-functor*) (= (length (pls-args s)) 1))
           (let ((id (%deref (pl-arg s 0))))
             (if (or (member id '(0 1 2)) (gethash id *pl-streams*)) id (pl-existence-error "stream" s))))
          ((and s (symbolp s))
           (let ((name (symbol-name s)))
             (cond ((string= name "user_input") 0) ((string= name "user_output") 1) ((string= name "user_error") 2)
                   ((assoc s *pl-aliases*) (cdr (assoc s *pl-aliases*)))
                   (t (pl-existence-error "stream" s)))))
          (t (pl-domain-error "stream_or_alias" s)))))

(defun %pl-lisp-stream (id)
  (case id
    (0 *standard-input*) (1 *standard-output*) (2 *error-output*)
    (t (let ((ps (gethash id *pl-streams*))) (if ps (plstream-lisp ps) (pl-existence-error "stream" (%pl-stream-term id)))))))

(defun %pl-out-stream (term)
  (let ((id (%pl-stream-id term)))
    (when (and (> id 2) (eq (plstream-mode (gethash id *pl-streams*)) :read)) (pl-permission-error "output" "stream" (%deref term)))
    (%pl-lisp-stream id)))

(defun %pl-in-stream (term)
  (let ((id (%pl-stream-id term)))
    (when (and (> id 2) (not (eq (plstream-mode (gethash id *pl-streams*)) :read))) (pl-permission-error "input" "stream" (%deref term)))
    (%pl-lisp-stream id)))

(defun %pl-cur-out () (%pl-lisp-stream *pl-cur-out*))
(defun %pl-cur-in () (%pl-lisp-stream *pl-cur-in*))

(defun %pl-close-stream (id)
  (let ((ps (gethash id *pl-streams*)))
    (when ps
      (when (eq (plstream-kind ps) :file) (ignore-errors (close (plstream-lisp ps))))
      (remhash id *pl-streams*)
      (setq *pl-aliases* (remove id *pl-aliases* :key #'cdr))
      (when (eql *pl-cur-out* id) (setq *pl-cur-out* 1))
      (when (eql *pl-cur-in* id) (setq *pl-cur-in* 0)))))

(pl-def "current_output" 1 (s) (pl-unify s (%pl-stream-term *pl-cur-out*)))
(pl-def "current_input" 1 (s) (pl-unify s (%pl-stream-term *pl-cur-in*)))
(pl-def "set_output" 1 (s) (setq *pl-cur-out* (%pl-stream-id s)) t)
(pl-def "set_input" 1 (s) (setq *pl-cur-in* (%pl-stream-id s)) t)

(defun %pl-open (file mode stream options)
  (let* ((fv (%deref file)) (name (or (%pl-atomic-text fv) (if (plv-p fv) (pl-instantiation-error) (pl-domain-error "source_sink" fv))))
         (m (symbol-name (%pl-atom-arg mode))) (alias nil))
    (dolist (o (%pl-list-arg options))
      (let ((ov (%deref o))) (when (pl-functor-p ov (pl-atom "alias") 1) (setq alias (%pl-atom-arg (pl-arg ov 0))))))
    (let ((lisp (cond ((string= m "read")
                       (unless (probe-file name) (pl-existence-error "source_sink" fv))
                       (open name :direction :input))
                      ((string= m "write") (handler-case (open name :direction :output :if-exists :supersede :if-does-not-exist :create)
                                             (error () (pl-permission-error "open" "source_sink" fv))))
                      ((or (string= m "append") (string= m "update"))
                       (handler-case (open name :direction :output :if-exists :append :if-does-not-exist :create)
                         (error () (pl-permission-error "open" "source_sink" fv))))
                      (t (pl-domain-error "io_mode" (%deref mode))))))
      (let ((ps (%pl-register-stream lisp (if (string= m "read") :read :write) :file name :alias alias)))
        (pl-unify stream (%pl-stream-term (plstream-id ps)))))))

(pl-def "open" 3 (file mode stream) (%pl-open file mode stream *pl-nil*))
(pl-def "open" 4 (file mode stream options) (%pl-open file mode stream options))
(pl-def "close" 1 (s) (let ((id (%pl-stream-id s))) (when (> id 2) (%pl-close-stream id)) t))
(pl-def "close" 2 (s opts) (declare (ignore opts)) (let ((id (%pl-stream-id s))) (when (> id 2) (%pl-close-stream id)) t))
(pl-def "flush_output" 0 () (finish-output (%pl-cur-out)) t)
(pl-def "flush_output" 1 (s) (finish-output (%pl-out-stream s)) t)

(pl-def "exists_file" 1 (f) (let ((p (probe-file (%pl-text-arg f)))) (and p (not (equal (namestring p) (concatenate 'string (%pl-text-arg f) "/"))) t)))
(pl-def "exists_directory" 1 (f) (let ((p (probe-file (%pl-text-arg f)))) (and p (let ((n (namestring p))) (and (> (length n) 0) (char= (char n (- (length n) 1)) #\/))))))
(pl-def "delete_file" 1 (f)
  (let ((name (%pl-text-arg f)))
    (unless (probe-file name) (pl-existence-error "file" (%deref f)))
    (delete-file name) t))

;;; Edinburgh-style file switching: see/seen/tell/told
(defvar *pl-see-files* nil "Alist (file-name . id) of files opened by see/1.")
(defvar *pl-tell-files* nil "Alist (file-name . id) of files opened by tell/1 and append/1.")

(defun %pl-see (spec)
  (let ((s (%deref spec)))
    (cond ((or (pls-p s) (and s (symbolp s) (member (symbol-name s) '("user_input" "user") :test #'string=) ))
           (setq *pl-cur-in* (if (and (symbolp s) (string= (symbol-name s) "user")) 0 (%pl-stream-id s))))
          (t (let* ((name (%pl-text-arg s)) (e (assoc name *pl-see-files* :test #'string=)))
               (if e (setq *pl-cur-in* (cdr e))
                   (progn (unless (probe-file name) (pl-existence-error "source_sink" s))
                          (let ((ps (%pl-register-stream (open name :direction :input) :read :file name)))
                            (push (cons name (plstream-id ps)) *pl-see-files*)
                            (setq *pl-cur-in* (plstream-id ps))))))))
    t))

(defun %pl-tell (spec mode)
  (let ((s (%deref spec)))
    (cond ((or (pls-p s) (and s (symbolp s) (member (symbol-name s) '("user_output" "user") :test #'string=)))
           (setq *pl-cur-out* (if (and (symbolp s) (string= (symbol-name s) "user")) 1 (%pl-stream-id s))))
          (t (let* ((name (%pl-text-arg s)) (e (assoc name *pl-tell-files* :test #'string=)))
               (if e (setq *pl-cur-out* (cdr e))
                   (let ((ps (%pl-register-stream (open name :direction :output :if-exists (if (eq mode :append) :append :supersede) :if-does-not-exist :create)
                                                  :write :file name)))
                     (push (cons name (plstream-id ps)) *pl-tell-files*)
                     (setq *pl-cur-out* (plstream-id ps)))))))
    t))

(pl-def "see" 1 (f) (%pl-see f))
(pl-def "seen" 0 ()
  (let ((id *pl-cur-in*))
    (when (> id 2) (%pl-close-stream id) (setq *pl-see-files* (remove id *pl-see-files* :key #'cdr)))
    (setq *pl-cur-in* 0) t))
(pl-def "seeing" 1 (s) (pl-unify s (let ((e (rassoc *pl-cur-in* *pl-see-files*))) (if e (pl-atom (car e)) (pl-atom "user")))))
(pl-def "tell" 1 (f) (%pl-tell f :write))
(pl-def "append" 1 (f) (%pl-tell f :append))
(pl-def "told" 0 ()
  (let ((id *pl-cur-out*))
    (when (> id 2) (%pl-close-stream id) (setq *pl-tell-files* (remove id *pl-tell-files* :key #'cdr)))
    (setq *pl-cur-out* 1) t))
(pl-def "telling" 1 (s) (pl-unify s (let ((e (rassoc *pl-cur-out* *pl-tell-files*))) (if e (pl-atom (car e)) (pl-atom "user")))))

(pl-defnd "stream_property" 2 (s prop)
  (let ((sv (%deref s)))
    (unless (plv-p sv)
      (let* ((id (%pl-stream-id sv)) (ps (gethash id *pl-streams*)) (props nil))
        (push (if (or (= id 0) (and ps (eq (plstream-mode ps) :read))) (pl-atom "input") (pl-atom "output")) props)
        (push (pl-s "mode" (cond ((= id 0) (pl-atom "read")) ((<= id 2) (pl-atom "append")) (t (pl-atom (string-downcase (symbol-name (plstream-mode ps))))))) props)
        (when (<= id 2) (push (pl-s "alias" (pl-atom (case id (0 "user_input") (1 "user_output") (t "user_error")))) props))
        (when (and ps (plstream-file ps)) (push (pl-s "file_name" (pl-atom (plstream-file ps))) props))
        (when (and ps (plstream-alias ps)) (push (pl-s "alias" (plstream-alias ps)) props))
        (%pl-alternatives (nreverse props) (lambda (p) (pl-unify prop p)))))))

;;; ---- character and line input -----------------------------------------------------------------------------------------------------------

(defun %pl-in-for (&optional stream) (if stream (%pl-in-stream stream) (%pl-cur-in)))

(defun %pl-char-term (c) (if c (pl-atom (string c)) *pl-eof*))

(pl-def "get_char" 1 (c) (pl-unify c (%pl-char-term (read-char (%pl-in-for) nil nil))))
(pl-def "get_char" 2 (s c) (pl-unify c (%pl-char-term (read-char (%pl-in-for s) nil nil))))
(pl-def "peek_char" 1 (c) (pl-unify c (%pl-char-term (peek-char nil (%pl-in-for) nil nil))))
(pl-def "peek_char" 2 (s c) (pl-unify c (%pl-char-term (peek-char nil (%pl-in-for s) nil nil))))
(pl-def "get_code" 1 (c) (pl-unify c (let ((ch (read-char (%pl-in-for) nil nil))) (if ch (char-code ch) -1))))
(pl-def "get_code" 2 (s c) (pl-unify c (let ((ch (read-char (%pl-in-for s) nil nil))) (if ch (char-code ch) -1))))
(pl-def "peek_code" 1 (c) (pl-unify c (let ((ch (peek-char nil (%pl-in-for) nil nil))) (if ch (char-code ch) -1))))
(pl-def "peek_code" 2 (s c) (pl-unify c (let ((ch (peek-char nil (%pl-in-for s) nil nil))) (if ch (char-code ch) -1))))
(pl-def "get0" 1 (c) (pl-unify c (let ((ch (read-char (%pl-in-for) nil nil))) (if ch (char-code ch) -1))))
(pl-def "get" 1 (c)
  (pl-unify c (loop (let ((ch (read-char (%pl-in-for) nil nil))) (cond ((null ch) (return -1)) ((not (%pl-layout-p ch)) (return (char-code ch))))))))
(pl-def "at_end_of_stream" 0 () (null (peek-char nil (%pl-cur-in) nil nil)))
(pl-def "at_end_of_stream" 1 (s) (null (peek-char nil (%pl-in-for s) nil nil)))
(pl-def "read_line_to_string" 2 (s str)
  (let ((line (read-line (%pl-in-for s) nil nil)))
    (pl-unify str (if line (string-right-trim '(#\Return) line) *pl-eof*))))
(pl-def "read_line_to_codes" 2 (s codes)
  (let ((line (read-line (%pl-in-for s) nil nil)))
    (pl-unify codes (if line (pl-string-codes (string-right-trim '(#\Return) line)) -1))))
(pl-def "read_string" 3 (s len str)
  (let ((out (make-string-output-stream)) (n 0) (in (%pl-in-for s)))
    (loop (let ((ch (read-char in nil nil))) (if ch (progn (write-char ch out) (setq n (+ n 1))) (return))))
    (and (pl-unify len n) (pl-unify str (get-output-stream-string out)))))

;;; ---- term input -----------------------------------------------------------------------------------------------------------------------------

(defun %pl-read-term (stream-term term options)
  (let* ((in (%pl-in-for stream-term)) (text (pl-read-clause-text in)))
    (if (null text)
        (and (pl-unify term *pl-eof*) (%pl-read-options options nil))
        (multiple-value-bind (tm varinfo)
            (let ((src (concatenate 'string text " ")))
              (multiple-value-bind (tm2 vi) (pl-read-term-from-string src 0)
                (when (eq tm2 :eof) (setq tm2 *pl-eof*))
                (values tm2 vi)))
          (and (pl-unify term tm) (%pl-read-options options varinfo))))))

(defun %pl-read-options (options varinfo)
  (dolist (o (%pl-list-arg options) t)
    (let ((ov (%deref o)))
      (cond ((pl-functor-p ov (pl-atom "variable_names") 1)
             (unless (pl-unify (pl-arg ov 0) (lisp-to-pl-list (mapcar (lambda (e) (%make-pls *pl-equals* (vector (pl-atom (first e)) (second e)))) varinfo)))
               (return nil)))
            ((pl-functor-p ov (pl-atom "variables") 1)
             (unless (pl-unify (pl-arg ov 0) (lisp-to-pl-list (mapcar #'second varinfo))) (return nil)))
            ((pl-functor-p ov (pl-atom "singletons") 1)
             (unless (pl-unify (pl-arg ov 0) (lisp-to-pl-list (mapcar (lambda (e) (%make-pls *pl-equals* (vector (pl-atom (first e)) (second e))))
                                                                      (remove-if-not (lambda (e) (= (third e) 1)) varinfo))))
               (return nil)))))))

(pl-def "read" 1 (term) (%pl-read-term nil term *pl-nil*))
(pl-def "read" 2 (s term) (%pl-read-term s term *pl-nil*))
(pl-def "read_term" 2 (term options) (%pl-read-term nil term options))
(pl-def "read_term" 3 (s term options) (%pl-read-term s term options))
(pl-def "read_term_from_atom" 3 (atom term options)
  (declare (ignore options)) (pl-unify term (pl-parse-string (%pl-text-arg atom))))

;;; ---- term output -------------------------------------------------------------------------------------------------------------------------------

(defun %pl-out (s &optional stream-term)
  (write-string s (if stream-term (%pl-out-stream stream-term) (%pl-cur-out)))
  t)

(defun %pl-print-string (term)
  "TERM as print/1 writes it: through portray/1 when the user defines it, else quoted with numbervars."
  (let ((p (pl-find-pred (pl-atom "portray") 1)))
    (if (and p (plpred-clauses p))
        (let* ((handled nil)
               (text (%pl-with-captured-output (lambda () (setq handled (pl-solve-once (pl-s "portray" term)))))))
          (if handled text (pl-term-to-string term :quoted t :numbervars t)))
        (pl-term-to-string term :quoted t :numbervars t))))

(defun %pl-with-captured-output (thunk)
  "Run THUNK with the current output captured: the text written."
  (let* ((out (make-string-output-stream)) (ps (%pl-register-stream out :write :kind :string)) (saved *pl-cur-out*))
    (setq *pl-cur-out* (plstream-id ps))
    (unwind-protect (funcall thunk)
      (setq *pl-cur-out* saved)
      (%pl-close-stream (plstream-id ps)))
    (get-output-stream-string out)))

(setq *pl-print-hook* (lambda (term stream) (write-string (%pl-print-string term) stream)))

(defun %pl-write-opts (options)
  "(values quoted ignore-ops numbervars max-depth spacing names) from a write_term option list."
  (let ((quoted nil) (ignore nil) (nv nil) (md 0) (spacing nil) (names nil))
    (dolist (o (%pl-list-arg options))
      (let ((ov (%deref o)))
        (flet ((bool (term) (eq (%deref term) *pl-true*)))
          (cond ((pl-functor-p ov (pl-atom "quoted") 1) (setq quoted (bool (pl-arg ov 0))))
                ((pl-functor-p ov (pl-atom "ignore_ops") 1) (setq ignore (bool (pl-arg ov 0))))
                ((pl-functor-p ov (pl-atom "numbervars") 1) (setq nv (bool (pl-arg ov 0))))
                ((pl-functor-p ov (pl-atom "max_depth") 1) (setq md (%pl-int-arg (pl-arg ov 0))))
                ((pl-functor-p ov (pl-atom "spacing") 1) (setq spacing (eq (%deref (pl-arg ov 0)) (pl-atom "next_argument"))))
                ((pl-functor-p ov (pl-atom "variable_names") 1)
                 (dolist (e (%pl-list-arg (pl-arg ov 0)))
                   (let ((ev (%deref e)))
                     (when (pl-functor-p ev *pl-equals* 2)
                       (let ((v (%deref (pl-arg ev 1)))) (when (plv-p v) (push (cons v (%pl-text-arg (pl-arg ev 0))) names)))))))))))
    (values quoted ignore nv md spacing names)))

(defun %pl-write-term (term options)
  (multiple-value-bind (quoted ignore nv md spacing names) (%pl-write-opts options)
    (pl-term-to-string term :quoted quoted :ignore-ops ignore :numbervars nv :max-depth md :spacing spacing :names names)))

(pl-def "write" 1 (x) (%pl-out (pl-term-to-string x :numbervars t)))
(pl-def "write" 2 (s x) (%pl-out (pl-term-to-string x :numbervars t) s))
(pl-def "print" 1 (x) (%pl-out (%pl-print-string x)))
(pl-def "print" 2 (s x) (%pl-out (%pl-print-string x) s))
(pl-def "writeln" 1 (x) (%pl-out (concatenate 'string (pl-term-to-string x :numbervars t) (string #\Newline))))
(pl-def "writeln" 2 (s x) (%pl-out (concatenate 'string (pl-term-to-string x :numbervars t) (string #\Newline)) s))
(pl-def "writeq" 1 (x) (%pl-out (pl-term-to-string x :quoted t :numbervars t)))
(pl-def "writeq" 2 (s x) (%pl-out (pl-term-to-string x :quoted t :numbervars t) s))
(pl-def "write_canonical" 1 (x) (%pl-out (pl-term-to-string x :quoted t :ignore-ops t)))
(pl-def "write_canonical" 2 (s x) (%pl-out (pl-term-to-string x :quoted t :ignore-ops t) s))
(pl-def "write_term" 2 (x o) (%pl-out (%pl-write-term x o)))
(pl-def "write_term" 3 (s x o) (%pl-out (%pl-write-term x o) s))
(pl-def "portray_clause" 1 (x) (%pl-out (pl-portray-clause-string x)))
(pl-def "portray_clause" 2 (s x) (%pl-out (pl-portray-clause-string x) s))
(pl-def "nl" 0 () (%pl-out (string #\Newline)))
(pl-def "nl" 1 (s) (%pl-out (string #\Newline) s))
(pl-def "tab" 1 (n) (%pl-out (make-string (%pl-check-size (max 0 (pl-eval n))) :initial-element #\Space)))
(pl-def "tab" 2 (s n) (%pl-out (make-string (%pl-check-size (max 0 (pl-eval n))) :initial-element #\Space) s))
(pl-def "put_char" 1 (c) (%pl-out (%pl-char-from-term c)))
(pl-def "put_char" 2 (s c) (%pl-out (%pl-char-from-term c) s))
(pl-def "put" 1 (c) (%pl-out (%pl-char-from-term c)))

(defun %pl-char-from-term (c)
  (let ((v (%deref c)))
    (cond ((plv-p v) (pl-instantiation-error))
          ((integerp v) (string (code-char v)))
          ((and v (symbolp v) (= (length (symbol-name v)) 1)) (symbol-name v))
          (t (pl-type-error "character" v)))))

(pl-def "format" 1 (f) (%pl-out (pl-format-to-string (%pl-text-arg f) nil)))
(pl-def "format" 2 (f args) (%pl-out (pl-format-to-string (%pl-text-arg f) (%pl-format-args args))))
(pl-def "format" 3 (sink f args)
  (let ((s (%deref sink)) (text (pl-format-to-string (%pl-text-arg f) (%pl-format-args args))))
    (cond ((and (pls-p s) (= (length (pls-args s)) 1) (member (symbol-name (pls-name s)) '("atom" "string" "codes" "chars") :test #'string=))
           (pl-unify (pl-arg s 0) (%pl-make-text (intern (string-upcase (symbol-name (pls-name s))) "KEYWORD") text)))
          (t (%pl-out text sink)))))

(pl-def "with_output_to" 2 (sink goal)
  (let ((s (%deref sink)))
    (unless (and (pls-p s) (= (length (pls-args s)) 1) (member (symbol-name (pls-name s)) '("atom" "string" "codes" "chars") :test #'string=))
      (pl-domain-error "output_sink" s))
    (let* ((ok nil)
           (text (%pl-with-captured-output (lambda () (setq ok (pl-solve-once goal))))))
      (and ok (pl-unify (pl-arg s 0) (%pl-make-text (intern (string-upcase (symbol-name (pls-name s))) "KEYWORD") text))))))


;;; ---- messages -------------------------------------------------------------------------------------------------------------------------------

(defun %pl-kind-of (v)
  (cond ((integerp v) "an integer") ((floatp v) "a float") ((stringp v) "a string") ((plv-p v) "a variable")
        ((pl-is-cons v) "a list") ((pls-p v) "a compound") ((symbolp v) "an atom") (t "an object")))

(defun pl-error-message (ball)
  "A readable message for the exception term BALL."
  (let ((b (%deref ball)))
    (flet ((w (x) (pl-term-to-string x :quoted t :numbervars t :max-depth 12)))
      (cond
        ((pl-functor-p b *pl-error* 2)
         (let ((f (%deref (pl-arg b 0))) (ctx (%deref (pl-arg b 1))) (where ""))
           (when (and (pl-functor-p ctx (pl-atom "context") 2)
                      (not (pl-functor-p (%deref (pl-arg ctx 0)) (pl-atom "position") 3))
                      (not (and (pl-functor-p f (pl-atom "existence_error") 2) (eq (%deref (pl-arg f 0)) (pl-atom "procedure")))))
             (let ((pind (%deref (pl-arg ctx 0)))) (unless (plv-p pind) (setq where (format nil "~A: " (w pind))))))
           (concatenate 'string where
             (cond
               ((eq f (pl-atom "instantiation_error")) "Arguments are not sufficiently instantiated")
               ((and (pl-functor-p f (pl-atom "type_error") 2) (eq (%deref (pl-arg f 0)) (pl-atom "evaluable")))
                (format nil "Arithmetic: evaluable `~A' does not exist" (w (pl-arg f 1))))
               ((pl-functor-p f (pl-atom "type_error") 2)
                (let ((v (%deref (pl-arg f 1))))
                  (format nil "Type error: `~A' expected, found `~A' (~A)" (w (pl-arg f 0)) (w v) (%pl-kind-of v))))
               ((pl-functor-p f (pl-atom "domain_error") 2)
                (format nil "Domain error: `~A' expected, found `~A'" (w (pl-arg f 0)) (w (pl-arg f 1))))
               ((and (pl-functor-p f (pl-atom "existence_error") 2) (eq (%deref (pl-arg f 0)) (pl-atom "procedure")))
                (format nil "Unknown procedure: ~A" (w (pl-arg f 1))))
               ((pl-functor-p f (pl-atom "existence_error") 2)
                (format nil "~A `~A' does not exist" (w (pl-arg f 0)) (w (pl-arg f 1))))
               ((pl-functor-p f (pl-atom "permission_error") 3)
                (format nil "No permission to ~A ~A `~A'" (w (pl-arg f 0)) (w (pl-arg f 1)) (w (pl-arg f 2))))
               ((pl-functor-p f (pl-atom "evaluation_error") 1)
                (format nil "Arithmetic: evaluation error: ~A" (w (pl-arg f 0))))
               ((pl-functor-p f (pl-atom "representation_error") 1)
                (format nil "Cannot represent due to `~A'" (w (pl-arg f 0))))
               ((pl-functor-p f (pl-atom "resource_error") 1)
                (format nil "Not enough resources: ~A" (w (pl-arg f 0))))
               ((pl-functor-p f (pl-atom "syntax_error") 1)
                (let ((pos (if (pl-functor-p ctx (pl-atom "context") 2) (%deref (pl-arg ctx 0)) nil)))
                  (format nil "Syntax error: ~A~A" (let ((m (%deref (pl-arg f 0)))) (or (%pl-atomic-text m) (w m)))
                          (if (and pos (pl-functor-p pos (pl-atom "position") 3))
                              (format nil " (line ~A, column ~A)" (w (pl-arg pos 1)) (w (pl-arg pos 2))) ""))))
               ((pl-functor-p f (pl-atom "system_error") 1) (format nil "System error: ~A" (let ((m (%deref (pl-arg f 0)))) (or (%pl-atomic-text m) (w m)))))
               ((pl-functor-p f (pl-atom "format") 1) (format nil "Format error: ~A" (let ((m (%deref (pl-arg f 0)))) (or (%pl-atomic-text m) (w m)))))
               (t (format nil "Unknown error term: ~A" (w f)))))))
        (t (format nil "Unhandled exception: Unknown message: ~A" (w b)))))))

(defun pl-print-message (kind term)
  (let ((k (if (symbolp kind) (symbol-name kind) "error")))
    (cond ((string= k "silent") nil)
          ((member k '("error") :test #'string=)
           (format *error-output* "~&ERROR: ~A~%" (let ((v (%deref term))) (if (or (pl-functor-p v *pl-error* 2) t) (pl-error-message v) ""))))
          ((member k '("warning") :test #'string=)
           (format *error-output* "~&Warning: ~A~%" (let ((v (%deref term))) (or (%pl-atomic-text v) (pl-error-message v)))))
          (t (format *error-output* "~&% ~A~%" (let ((v (%deref term))) (or (%pl-atomic-text v) (pl-term-to-string v :quoted t))))))
    t))

(pl-deflib "print_message" 2 (kind term) (pl-print-message (%deref kind) term))
(pl-def "print_message_lines" 3 (s prefix lines) (declare (ignore s prefix lines)) t)
(pl-def "message_to_codes" 3 (m k c) (declare (ignore m k c)) nil)

;;; ---- flags, operators, statistics ------------------------------------------------------------------------------------------------------------

(pl-def "set_prolog_flag" 2 (flag value)
  (let ((f (%pl-atom-arg flag)) (v (%deref value)))
    (when (plv-p v) (pl-instantiation-error))
    (let ((name (symbol-name f)))
      (cond ((string= name "double_quotes")
             (unless (member v (list (pl-atom "codes") (pl-atom "chars") (pl-atom "atom") (pl-atom "string"))) (pl-domain-error "flag_value" v))
             (pl-set-flag name v))
            ((member name '("bounded" "max_integer" "min_integer" "version" "dialect") :test #'string=)
             (pl-permission-error "modify" "flag" f))
            (t (pl-set-flag name v))))
    t))

(pl-defnd "current_prolog_flag" 2 (flag value)
  (let ((f (%deref flag)))
    (if (and f (symbolp f))
        (let ((e (assoc (symbol-name f) *pl-flags* :test #'string=))) (and e (pl-unify value (cdr e)) (%pl-last-gen)))
        (%pl-alternatives (copy-list *pl-flags*) (lambda (e) (and (pl-unify flag (pl-atom (car e))) (pl-unify value (cdr e))))))))

(defun %pl-op-type-keyword (name)
  (let ((n (symbol-name name)))
    (cond ((string= n "xfx") :xfx) ((string= n "xfy") :xfy) ((string= n "yfx") :yfx) ((string= n "fy") :fy) ((string= n "fx") :fx)
          ((string= n "xf") :xf) ((string= n "yf") :yf) (t (pl-domain-error "operator_specifier" name)))))

(pl-def "op" 3 (priority type names)
  (let ((p (%pl-int-arg priority)) (ty (%pl-op-type-keyword (%pl-atom-arg type))))
    (unless (<= 0 p 1200) (pl-domain-error "operator_priority" p))
    (flet ((def1 (name)
             (let ((n (%pl-atom-arg name)))
               (when (eq n *pl-comma*) (pl-permission-error "modify" "operator" n))
               (when (member n (list *pl-nil* *pl-curly*)) (pl-permission-error "create" "operator" n))
               (pl-add-op p ty n))))
      (let ((nv (%deref names)))
        (if (or (pl-is-cons nv) (eq nv *pl-nil*)) (dolist (x (%pl-list-arg nv)) (def1 x)) (def1 nv))))
    t))

(pl-defnd "current_op" 3 (priority type name)
  (let ((all nil))
    (maphash (lambda (n entry) (dolist (e entry) (when e (push (list (car e) (cdr e) n) all)))) *pl-ops*)
    (setq all (sort all (lambda (a b) (string< (symbol-name (third a)) (symbol-name (third b))))))
    (%pl-alternatives all (lambda (e) (and (pl-unify priority (first e)) (pl-unify type (pl-atom (string-downcase (symbol-name (second e))))) (pl-unify name (third e)))))))

(defvar *pl-start-time* nil "The clock reading at the first call of statistics/2 (not at load: the image must not depend on when it was built).")
(defvar *pl-last-runtime* 0)
(defvar *pl-last-walltime* 0)

(pl-def "statistics" 2 (key value)
  (let* ((k (symbol-name (%pl-atom-arg key)))
         (ms (floor (- (get-internal-real-time) (or *pl-start-time* (setq *pl-start-time* (get-internal-real-time)))) 1000)))
    (cond ((or (string= k "runtime") (string= k "cputime_ms") (string= k "process_cputime"))
           (let ((d (- ms *pl-last-runtime*))) (setq *pl-last-runtime* ms)
             (if (string= k "runtime") (pl-unify value (lisp-to-pl-list (list ms d))) (pl-unify value ms))))
          ((or (string= k "walltime") (string= k "real_time"))
           (let ((d (- ms *pl-last-walltime*))) (setq *pl-last-walltime* ms) (pl-unify value (lisp-to-pl-list (list ms d)))))
          ((string= k "cputime") (pl-unify value (/ (float ms 1d0) 1000d0)))
          ((string= k "inferences") (pl-unify value *pl-inferences*))
          ((string= k "epoch") (pl-unify value (float (- (get-universal-time) 2208988800) 1d0)))
          (t (pl-domain-error "statistics_key" (%deref key))))))
(pl-def "statistics" 0 () (format *standard-output* "~&% ~D inferences, ~D clauses~%" *pl-inferences* (let ((n 0)) (dolist (p *pl-all-preds* n) (setq n (+ n (plpred-nclauses p)))))) t)
(pl-def "get_time" 1 (tm) (pl-unify tm (+ (float (- (get-universal-time) 2208988800) 1d0) (/ (float (mod (get-internal-real-time) 1000000) 1d0) 1000000d0))))
(pl-def "sleep" 1 (n) (let ((v (pl-eval n))) (when (> v 0) (sleep v)) t))
(pl-def "garbage_collect" 0 () t)
(pl-def "prompt" 2 (old new) (declare (ignore new)) (pl-unify old (pl-atom "|: ")))
(pl-def "style_check" 1 (x) (declare (ignore x)) t)
(pl-def "use_module" 1 (x) (declare (ignore x)) t)
(pl-def "use_module" 2 (x y) (declare (ignore x y)) t)
(pl-def "module" 2 (x y) (declare (ignore x y)) t)
(pl-def "set_stream" 2 (x y) (declare (ignore x y)) t)
(pl-def "license" 1 (x) (declare (ignore x)) t)
(pl-def "getenv" 2 (name value) (let ((v (getenv-string (%pl-text-arg name)))) (and v (pl-unify value (pl-atom v)))))

(defun getenv-string (name) (ignore-errors (let ((v (getenv name))) (and (stringp v) v))))

;;; ---- predicates about predicates ------------------------------------------------------------------------------------------------------------

(pl-defnd "current_predicate" 1 (spec)
  (let ((s (%deref spec)))
    (unless (or (plv-p s) (pl-functor-p s *pl-slash* 2)) (pl-type-error "predicate_indicator" s))
    (let* ((name (if (plv-p s) (pl-new-var) (pl-arg s 0))) (arity (if (plv-p s) (pl-new-var) (pl-arg s 1)))
           (nv (%deref name)) (av (%deref arity)))
      (if (and (symbolp nv) nv (integerp av))
          (let ((p (pl-find-pred nv av))) (and p (%pl-user-pred-p p) (%pl-last-gen)))
          (%pl-alternatives (remove-if-not #'%pl-user-pred-p (copy-list *pl-all-preds*))
                            (lambda (p) (and (pl-unify name (plpred-name p)) (pl-unify arity (plpred-arity p)))
                                        (or (plv-p s) t)
                                        (or (not (plv-p s)) (pl-unify s (pl-indicator (plpred-name p) (plpred-arity p))))))))))

(pl-defnd "current_predicate" 2 (name head)
  (let ((h (%deref head)))
    (if (not (plv-p h))
        (let ((p (and (pl-callable-p h) (pl-find-pred (pl-name h) (pl-arity h)))))
          (and p (%pl-user-pred-p p) (pl-unify name (pl-name h)) (%pl-last-gen)))
        (%pl-alternatives (remove-if-not #'%pl-user-pred-p (copy-list *pl-all-preds*))
                          (lambda (p)
                            (and (pl-unify name (plpred-name p))
                                 (pl-unify h (if (= (plpred-arity p) 0) (plpred-name p)
                                                 (let ((args (make-array (plpred-arity p)))) (dotimes (i (plpred-arity p)) (setf (svref args i) (pl-new-var)))
                                                   (%make-pls (plpred-name p) args))))))))))

(pl-defnd "predicate_property" 2 (head prop)
  (let ((h (%deref head)))
    (cond ((plv-p h) nil)
          (t (let ((p (and (pl-callable-p h) (pl-find-pred (pl-name h) (pl-arity h)))))
               (and p (or (plpred-defined p) (plpred-clauses p) (plpred-fn p) (plpred-ctl p))
                    (let ((props nil))
                      (push (pl-atom "defined") props)
                      (cond ((or (plpred-ctl p) (and (plpred-fn p) (not (plpred-library p))))
                             (push (pl-atom "built_in") props) (push (pl-atom "static") props))
                            (t (push (if (plpred-dynamic p) (pl-atom "dynamic") (pl-atom "static")) props)
                               (push (pl-s "number_of_clauses" (plpred-nclauses p)) props)))
                      (%pl-alternatives (nreverse props) (lambda (x) (pl-unify prop x))))))))))

;;; ---- listing ---------------------------------------------------------------------------------------------------------------------------------

(defun pl-listing-string (pred)
  "The listing of PRED: a dynamic declaration if it is one, and its clauses in portray_clause layout."
  (let ((out (make-string-output-stream)))
    (when (plpred-dynamic pred)
      (format out ":- dynamic ~A/~D.~%~%" (pl-atom-text (plpred-name pred) t) (plpred-arity pred)))
    (dolist (c (%pl-visible-clauses pred))
      (multiple-value-bind (h b) (pl-clause-terms c)
        (write-string (pl-portray-clause-string (if (eq (%deref b) *pl-true*) h (%make-pls *pl-neck* (vector h b)))) out)))
    (terpri out)
    (get-output-stream-string out)))

(defun %pl-user-preds-named (name arity)
  (remove-if-not (lambda (p) (and (eq (plpred-name p) name) (or (null arity) (= (plpred-arity p) arity)) (%pl-user-pred-p p)))
                 (reverse *pl-all-preds*)))

(pl-def "listing" 1 (spec)
  (%pl-map-listing spec)
  t)

(defun %pl-map-listing (spec)
  (let ((s (%deref spec)))
    (cond ((plv-p s) (pl-instantiation-error))
          ((or (pl-is-cons s) (eq s *pl-nil*)) (dolist (x (%pl-list-arg s)) (%pl-map-listing x)))
          ((pl-functor-p s *pl-slash* 2)
           (dolist (p (%pl-user-preds-named (%pl-atom-arg (pl-arg s 0)) (%pl-int-arg (pl-arg s 1)))) (%pl-out (pl-listing-string p))))
          ((and s (symbolp s)) (dolist (p (%pl-user-preds-named s nil)) (%pl-out (pl-listing-string p))))
          (t (pl-type-error "predicate_indicator" s)))))

(pl-def "listing" 0 ()
  (dolist (p (reverse *pl-all-preds*)) (when (and (%pl-user-pred-p p) (not (plpred-library p))) (%pl-out (pl-listing-string p))))
  t)

;;; ---- tracing ---------------------------------------------------------------------------------------------------------------------------------

(pl-def "trace" 0 () (setq *pl-trace* t *pl-trace-counter* 0) t)
(pl-def "notrace" 0 () (setq *pl-trace* nil) t)
(pl-def "debug" 0 () (setq *pl-trace* t) t)
(pl-def "nodebug" 0 () (setq *pl-trace* nil) t)
(pl-def "tracing" 0 () *pl-trace*)
(pl-def "leash" 1 (x) (declare (ignore x)) t)
(pl-def "visible" 1 (x) (declare (ignore x)) t)
(pl-def "spy" 1 (spec)
  (setq *pl-trace-counter* 0)
  (%pl-map-specs spec (lambda (n a) (let ((p (pl-ensure-pred n a))) (setf (plpred-spy p) t)))) t)
(pl-def "nospy" 1 (spec)
  (%pl-map-specs spec (lambda (n a) (let ((p (pl-find-pred n a))) (when p (setf (plpred-spy p) nil))))) t)
(pl-def "nospyall" 0 () (dolist (p *pl-all-preds*) (setf (plpred-spy p) nil)) t)
