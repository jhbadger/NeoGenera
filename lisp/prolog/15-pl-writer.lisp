;;;; 15-pl-writer.lisp -- the Prolog Tool Kit: writing terms (write, writeq, print, write_canonical, portray_clause) and
;;;; the format/2 directive engine.

(in-package :cl)

;;; ---- atoms that need quotes ---------------------------------------------------------------------------------------------

(defun pl-atom-needs-quotes-p (name)
  (let ((n (length name)))
    (cond ((= n 0) t)
          ((member name '("[]" "!" ";" "{}") :test #'string=) nil)
          ((member name '("," "|") :test #'string=) t)
          ((%pl-lower-start-p (char name 0)) (not (every #'%pl-alnum-p name)))
          ((every #'%pl-symch-p name) (string= name "."))
          (t t))))

(defun %pl-quote-text (s q)
  "S in quotes Q with the escapes the reader understands."
  (let ((out (make-string-output-stream)))
    (write-char q out)
    (dotimes (i (length s))
      (let ((c (char s i)))
        (cond ((char= c q) (write-char #\\ out) (write-char c out))
              ((char= c #\\) (write-string "\\\\" out))
              ((char= c #\Newline) (write-string "\\n" out))
              ((char= c #\Tab) (write-string "\\t" out))
              ((char= c #\Return) (write-string "\\r" out))
              ((< (char-code c) 32) (format out "\\x~X\\" (char-code c)))
              (t (write-char c out)))))
    (write-char q out)
    (get-output-stream-string out)))

(defun pl-atom-text (atom quoted)
  (let ((name (symbol-name atom)))
    (if (and quoted (pl-atom-needs-quotes-p name)) (%pl-quote-text name #\') name)))

;;; ---- the writer -----------------------------------------------------------------------------------------------------------

(defstruct (plwo (:constructor %make-plwo ()) (:copier nil))
  (quoted nil) (ignore-ops nil) (numbervars nil) (max-depth 0) (spacing nil) (out nil) (last nil) (names nil) (after-prefix nil))

(defun %plw-emit (w s)
  (when (> (length s) 0)
    (let ((last (plwo-last w)) (out (plwo-out w)))
      (let ((ap (plwo-after-prefix w)))
        (when (and ap (or (char= (char s 0) #\() (and (digit-char-p (char s 0)) (member ap (list *pl-minus* *pl-plus*)))))
          (write-char #\Space out) (setq last #\Space)))
      (setf (plwo-after-prefix w) nil)
      (when (and last (let ((f (char s 0))) (or (and (%pl-alnum-p last) (%pl-alnum-p f)) (and (%pl-symch-p last) (%pl-symch-p f))
                                              (and (char= last #\,) (char= f #\,))
                                              (and (char= f #\') (or (%pl-alnum-p last) (char= last #\'))))))
        (write-char #\Space out))
      (write-string s out)
      (setf (plwo-last w) (char s (- (length s) 1))))))

(defun %plw-raw (w s)
  (when (> (length s) 0)
    (when (and (plwo-after-prefix w) (char= (char s 0) #\()) (write-char #\Space (plwo-out w)))
    (setf (plwo-after-prefix w) nil)
    (write-string s (plwo-out w))
    (setf (plwo-last w) (char s (- (length s) 1)))))

(defun %pl-var-letter-name (n)
  (multiple-value-bind (q r) (floor n 26)
    (if (= q 0) (string (code-char (+ 65 r))) (format nil "~C~D" (code-char (+ 65 r)) q))))

(defun %pl-float-text (x)
  (let ((inf (pl-infinity)))
    (cond ((= x inf) "inf")
          ((= x (- inf)) "-inf")
          ((/= x x) "nan")
          (t (pl-format-float x)))))

(defun %plw-write (w term prec depth &optional argp)
  (setq term (%deref term))
  (let ((md (plwo-max-depth w)))
    (when (and (> md 0) (> depth md)) (%plw-emit w "...") (return-from %plw-write nil)))
  (cond
    ((plv-p term) (%plw-emit w (let ((c (assq term (plwo-names w)))) (if c (cdr c) (format nil "_G~D" (pl-var-id term))))))
    ((integerp term) (%plw-emit w (format nil "~D" term)))
    ((floatp term) (%plw-emit w (%pl-float-text term)))
    ((stringp term) (%plw-emit w (if (plwo-quoted w) (%pl-quote-text term #\") term)))
    ((symbolp term)
     (let ((txt (pl-atom-text term (plwo-quoted w))))
       (if (and (not argp) (> prec 0) (< prec 1200) (pl-any-op-p term) (not (eq term *pl-nil*)) (not (eq term *pl-curly*)))
           (progn (%plw-raw-open w) (%plw-emit w txt) (%plw-raw w ")"))
           (%plw-emit w txt))))
    ((pls-p term) (%plw-compound w term prec depth))
    (t (%plw-emit w (format nil "<~A>" (princ-to-string term))))))

(defun %plw-raw-open (w)
  (let ((last (plwo-last w)))
    (when (and last (%pl-alnum-p last)) nil)
    (%plw-raw w "(")))

(defun %plw-args (w args depth)
  (dotimes (i (length args))
    (when (> i 0) (%plw-raw w (if (plwo-spacing w) ", " ",")))
    (%plw-write w (svref args i) 999 (+ depth 1) t)))

(defun %plw-list (w term depth)
  (%plw-raw w "[")
  (let ((first t) (count 0) (md (plwo-max-depth w)))
    (loop
      (setq term (%deref term))
      (cond ((pl-is-cons term)
             (unless first (%plw-raw w (if (plwo-spacing w) ", " ",")))
             (setq first nil)
             (when (and (> md 0) (>= count md)) (%plw-raw w "...") (setq term *pl-nil*) (return))
             (when (> count 5000000) (%plw-raw w "...") (setq term *pl-nil*) (return))
             (%plw-write w (pl-head term) 999 (+ depth 1) t)
             (setq count (+ count 1))
             (setq term (pl-tail term)))
            ((eq term *pl-nil*) (return))
            (t (%plw-raw w "|") (%plw-write w term 999 (+ depth 1) t) (return)))))
  (%plw-raw w "]"))

(defun %plw-compound (w term prec depth)
  (let* ((name (pls-name term)) (args (pls-args term)) (n (length args)))
    (cond
      ((pl-is-cons term) (%plw-list w term depth))
      ((and (plwo-numbervars w) (eq name *pl-var-functor*) (= n 1) (integerp (%deref (svref args 0))) (>= (%deref (svref args 0)) 0))
       (%plw-emit w (%pl-var-letter-name (%deref (svref args 0)))))
      ((and (plwo-numbervars w) (eq name *pl-var-functor*) (= n 1) (let ((a (%deref (svref args 0)))) (and a (symbolp a))))
       (%plw-emit w (symbol-name (%deref (svref args 0)))))
      ((and (eq name *pl-curly*) (= n 1) (not (plwo-ignore-ops w)))
       (%plw-raw w "{") (%plw-write w (svref args 0) 1200 (+ depth 1)) (%plw-raw w "}"))
      ((and (= n 2) (not (plwo-ignore-ops w)) (pl-infix-op name))
       (let* ((op (pl-infix-op name)) (pri (car op)) (type (cdr op))
              (lp (if (eq type :yfx) pri (- pri 1))) (rp (if (eq type :xfy) pri (- pri 1)))
              (paren (> pri prec)) (text (pl-atom-text name (plwo-quoted w))))
         (when paren (%plw-raw w "("))
         (%plw-write w (svref args 0) lp (+ depth 1))
         (cond ((eq name *pl-comma*) (%plw-raw w (if (plwo-spacing w) ", " ",")))
               ((or (%pl-alnum-p (char text (- (length text) 1))) (member name (list *pl-neck* *pl-dcg-arrow* *pl-arrow* *pl-softarrow*)))
                (if (and (plwo-spacing w) (not (%pl-alnum-p (char text 0))) (not (eq name *pl-semi*)))
                    (progn (%plw-raw w " ") (%plw-raw w text) (%plw-raw w " "))
                    (if (%pl-alnum-p (char text (- (length text) 1)))
                        (progn (%plw-raw w " ") (%plw-raw w text) (%plw-raw w " "))
                        (%plw-emit w text))))
               (t (%plw-emit w text)))
         (%plw-write w (svref args 1) rp (+ depth 1))
         (when paren (%plw-raw w ")"))))
      ((and (= n 1) (not (plwo-ignore-ops w)) (pl-prefix-op name) (not (eq name *pl-minus*)) (not (eq name *pl-plus*)))
       (%plw-prefix w term prec depth))
      ((and (= n 1) (not (plwo-ignore-ops w)) (pl-prefix-op name))
       (%plw-prefix w term prec depth))
      ((and (= n 1) (not (plwo-ignore-ops w)) (pl-postfix-op name))
       (let* ((op (pl-postfix-op name)) (pri (car op)) (paren (> pri prec)))
         (when paren (%plw-raw w "("))
         (%plw-write w (svref args 0) (if (eq (cdr op) :yf) pri (- pri 1)) (+ depth 1))
         (%plw-emit w (pl-atom-text name (plwo-quoted w)))
         (when paren (%plw-raw w ")"))))
      (t
       (%plw-emit w (pl-atom-text name (plwo-quoted w)))
       (%plw-raw w "(")
       (%plw-args w args depth)
       (%plw-raw w ")")))))

(defun %plw-prefix (w term prec depth)
  (let* ((name (pls-name term)) (arg (%deref (svref (pls-args term) 0))) (op (pl-prefix-op name)) (pri (car op))
         (ap (if (eq (cdr op) :fy) pri (- pri 1))) (paren (> pri prec)) (text (pl-atom-text name (plwo-quoted w))))
    (when paren (%plw-raw w "("))
    (%plw-emit w text)
    (cond ((and (numberp arg) (or (eq name *pl-minus*) (eq name *pl-plus*))) (%plw-raw w " ") (%plw-write w arg ap (+ depth 1)))
          ((and arg (symbolp arg) (pl-any-op-p arg) (not (eq arg *pl-nil*)) (not (eq arg *pl-curly*)))
           (%plw-raw w "(") (%plw-write w arg 999 (+ depth 1) t) (%plw-raw w ")"))
          ((and (pls-p arg) (not (pl-is-cons arg)) (let ((o (or (and (= (length (pls-args arg)) 2) (pl-infix-op (pls-name arg)))
                                                            (and (= (length (pls-args arg)) 1) (pl-prefix-op (pls-name arg))))))
                                                    (and o (> (car o) ap))))
           (%plw-raw w " ") (%plw-write w arg ap (+ depth 1)))
          ((%pl-alnum-p (char text (- (length text) 1))) (%plw-raw w " ") (%plw-write w arg ap (+ depth 1)))
          (t (setf (plwo-after-prefix w) name) (%plw-write w arg ap (+ depth 1))))
    (setf (plwo-after-prefix w) nil)
    (when paren (%plw-raw w ")"))))

(defun pl-term-to-string (term &key quoted ignore-ops numbervars (max-depth 0) spacing names (priority 1200))
  "The text of TERM written with the given options."
  (let ((w (%make-plwo)) (out (make-string-output-stream)))
    (setf (plwo-quoted w) quoted (plwo-ignore-ops w) ignore-ops (plwo-numbervars w) numbervars (plwo-max-depth w) max-depth
          (plwo-spacing w) spacing (plwo-out w) out (plwo-names w) names)
    (%plw-write w term priority 0)
    (get-output-stream-string out)))

(defmethod print-object ((x pls) s)
  (write-string (handler-case (pl-term-to-string x :quoted t :numbervars t) (error () "#<prolog term>")) s))
(defmethod print-object ((x plv) s)
  (format s "_G~D" (pl-var-id x)))

;;; ---- numbervars ---------------------------------------------------------------------------------------------------------------

(defun pl-numbervars (term start)
  "Bind each variable of TERM to '$VAR'(N) from START: the next free number."
  (let ((n start))
    (dolist (v (pl-variables-of term) n)
      (pl-bind v (%make-pls *pl-var-functor* (vector n)))
      (setq n (+ n 1)))))

;;; ---- portray_clause ----

(defun %pl-var-occurrences (term table)
  "Count the occurrences of each variable of TERM in the eq hash TABLE."
  (loop
    (setq term (%deref term))
    (cond ((plv-p term) (setf (gethash term table) (+ 1 (or (gethash term table) 0))) (return))
          ((pls-p term)
           (let* ((args (pls-args term)) (n (length args)))
             (dotimes (i (- n 1)) (%pl-var-occurrences (svref args i) table))
             (setq term (svref args (- n 1)))))
          (t (return)))))

(defun %pl-name-clause-variables (term)
  "Bind the variables of TERM for printing as a clause: those occurring once to '$VAR'('_'), the others to A, B, ..."
  (let ((table (make-hash-table :test 'eq)) (n 0))
    (%pl-var-occurrences term table)
    (dolist (v (pl-variables-of term))
      (if (= (gethash v table) 1)
          (pl-bind v (%make-pls *pl-var-functor* (vector (pl-atom "_"))))
          (progn (pl-bind v (%make-pls *pl-var-functor* (vector n))) (setq n (+ n 1)))))
    n))

(defun %plp-write (term prec)
  (pl-term-to-string term :quoted t :numbervars t :spacing t :priority prec))

(defun %plp-body (term indent prec out)
  "Write the body TERM at column INDENT (the clause layout of listing)."
  (setq term (%deref term))
  (let ((pad (make-string indent :initial-element #\Space)))
    (cond
      ((pl-functor-p term *pl-comma* 2)
       (%plp-body (pl-arg term 0) indent 999 out)
       (format out ",~%")
       (%plp-body (pl-arg term 1) indent 1000 out))
      ((or (pl-functor-p term *pl-semi* 2) (pl-functor-p term *pl-arrow* 2) (pl-functor-p term *pl-softarrow* 2))
       (write-string pad out) (write-string "(   " out)
       (%plp-disj term indent out)
       (format out "~%~A)" pad))
      ((and (pls-p term) (eq (pls-name term) (pl-atom "\\+")) (= (length (pls-args term)) 1)
            (let ((a (%deref (pl-arg term 0)))) (or (pl-functor-p a *pl-comma* 2) (pl-functor-p a *pl-semi* 2) (pl-functor-p a *pl-arrow* 2))))
       (write-string pad out) (write-string "\\+ ( " out)
       (let ((inner (make-string-output-stream)))
         (%plp-body (pl-arg term 0) (+ indent 5) 1200 inner)
         (write-string (string-left-trim " " (get-output-stream-string inner)) out))
       (format out "~%~A  )" pad))
      (t (write-string pad out) (write-string (%plp-write term prec) out)))))

(defun %plp-inline (term indent out)
  (let ((inner (make-string-output-stream)))
    (%plp-body term (+ indent 4) 999 inner)
    (write-string (string-left-trim " " (get-output-stream-string inner)) out)))

(defun %plp-disj (term indent out)
  (setq term (%deref term))
  (cond ((pl-functor-p term *pl-semi* 2)
         (let ((l (%deref (pl-arg term 0))))
           (cond ((pl-functor-p l *pl-arrow* 2) (%plp-ite l indent out "->  "))
                 ((pl-functor-p l *pl-softarrow* 2) (%plp-ite l indent out "*-> "))
                 (t (%plp-inline l indent out))))
         (format out "~%~A;   " (make-string indent :initial-element #\Space))
         (%plp-disj (pl-arg term 1) indent out))
        ((pl-functor-p term *pl-arrow* 2) (%plp-ite term indent out "->  "))
        ((pl-functor-p term *pl-softarrow* 2) (%plp-ite term indent out "*-> "))
        (t (%plp-inline term indent out))))

(defun %plp-ite (term indent out arrow)
  (%plp-inline (pl-arg term 0) indent out)
  (format out "~%~A~A" (make-string indent :initial-element #\Space) arrow)
  (%plp-inline (pl-arg term 1) indent out))

(defun pl-portray-clause-string (term)
  "TERM as a clause in listing layout, ending with a full stop and a newline; variables are named A, B, ..."
  (let* ((mark *pl-tn*) (saved-hb *pl-hb*) (out (make-string-output-stream)))
    (setq *pl-hb* (+ *pl-epoch* 1))
    (unwind-protect
         (let ((copy (pl-copy-term term)))
           (%pl-name-clause-variables copy)
           (setq copy (%deref copy))
           (cond ((and (pl-functor-p copy *pl-neck* 2) (not (eq (%deref (pl-arg copy 1)) *pl-true*)))
                  (write-string (%plp-write (pl-arg copy 0) 1199) out)
                  (format out " :-~%")
                  (%plp-body (pl-arg copy 1) 4 1199 out))
                 ((pl-functor-p copy *pl-neck* 2) (write-string (%plp-write (pl-arg copy 0) 1199) out))
                 ((and (pl-functor-p copy *pl-neck* 1))
                  (write-string ":- " out) (write-string (%plp-write (pl-arg copy 0) 1199) out))
                 (t (write-string (%plp-write copy 1199) out)))
           (format out ".~%")
           (get-output-stream-string out))
      (%pl-undo-to mark)
      (setq *pl-hb* saved-hb))))

;;; ---- format/2 ------------------------------------------------------------------------------------------------------------------

(defun pl-format-fixed (x digits)
  "X (a number) in fixed notation with DIGITS decimals, exactly rounded."
  (let* ((r (if (integerp x) x (rational x))) (scaled (round (* r (expt 10 digits)))) (neg (< scaled 0)) (s (format nil "~D" (abs scaled))))
    (when (and (= scaled 0) (floatp x) (< x 0)) (setq neg t))
    (when (<= (length s) digits) (setq s (concatenate 'string (make-string (- (+ digits 1) (length s)) :initial-element #\0) s)))
    (let ((int (subseq s 0 (- (length s) digits))) (frac (subseq s (- (length s) digits))))
      (concatenate 'string (if neg "-" "") int (if (> digits 0) "." "") frac))))

(defun pl-format-exp (x digits &optional (e-char #\e))
  "X in exponent notation with DIGITS decimals (like C's %e)."
  (let* ((r (rational x)))
    (if (= r 0)
        (format nil "~A~A~Ae+00" (if (> digits 0) "0." "0") (make-string digits :initial-element #\0) e-char)
        (let* ((a (abs r)) (e (let ((g (floor (log (float a 1d0) 10)))) g)))
          (loop (cond ((>= a (expt 10 (+ e 1))) (setq e (+ e 1))) ((< a (expt 10 e)) (setq e (- e 1))) (t (return))))
          (let ((m (round (* (/ a (expt 10 e)) (expt 10 digits)))))
            (when (>= m (expt 10 (+ digits 1))) (setq e (+ e 1) m (round (* (/ a (expt 10 e)) (expt 10 digits)))))
            (let* ((s (format nil "~D" m)) (head (subseq s 0 1)) (tail (subseq s 1)))
              (format nil "~A~A~A~A~A~A~2,'0D" (if (< r 0) "-" "") head (if (> digits 0) "." "") tail e-char (if (< e 0) "-" "+") (abs e))))))))

(defun %pl-group-digits (s sep)
  (let* ((neg (and (> (length s) 0) (char= (char s 0) #\-))) (d (if neg (subseq s 1) s)) (out nil) (n (length d)))
    (dotimes (i n)
      (when (and (> i 0) (= (mod (- n i) 3) 0)) (push sep out))
      (push (char d i) out))
    (concatenate 'string (if neg "-" "") (coerce (nreverse out) 'string))))

(defun pl-format-error (fmt &rest args)
  (pl-throw (pl-error-term (pl-s "format" (apply #'format nil fmt args)))))

(defvar *pl-print-hook* nil "Function of (term stream) used by ~p and print/1, or NIL to use writeq.")

(defun pl-format-to-string (control args &optional (start-column 0))
  "Expand the format CONTROL (a string) with the Lisp list ARGS of Prolog terms; returns the text."
  (let ((out (make-string-output-stream)) (line (make-array 0 :adjustable t :fill-pointer 0)) (i 0) (n (length control))
        (fills nil) (seg-start 0) (stop-col start-column) (done nil))
    ;; LINE holds the current line (since the last newline); SEG-START the index where the current column segment begins
    (labels ((col () (+ (if done 0 0) (length line) (if (> start-column 0) 0 0)))
             (put-char (c) (if (char= c #\Newline)
                               (progn (flush-line) (write-char c out) (setq stop-col 0 seg-start 0 fills nil))
                               (vector-push-extend c line)))
             (put-string (s) (dotimes (k (length s)) (put-char (char s k))))
             (flush-line ()
               (dotimes (k (length line)) (write-char (aref line k) out))
               (setf (fill-pointer line) 0) (setq seg-start 0))
             (next-arg ()
               (when (null args) (pl-format-error "not enough arguments"))
               (pop args))
             (column-stop (target)
               (let* ((width (- (length line) seg-start)) (pad (- target (+ stop-col width))))
                 (when (> pad 0)
                   (let* ((fs (reverse fills)) (text (let ((tx (make-string (- (length line) seg-start)))) (dotimes (k (length tx)) (setf (char tx k) (aref line (+ seg-start k)))) tx)))
                     (if (null fs)
                         (setq text (concatenate 'string text (make-string pad :initial-element #\Space)))
                         (let* ((k (length fs)) (each (floor pad k)) (extra (- pad (* each k))) (pieces nil) (prev 0) (idx 0))
                           (dolist (f fs)
                             (push (subseq text prev (car f)) pieces)
                             (push (make-string (+ each (if (= idx (- k 1)) extra 0)) :initial-element (cdr f)) pieces)
                             (setq prev (car f) idx (+ idx 1)))
                           (push (subseq text prev) pieces)
                           (setq text (apply #'concatenate 'string (nreverse pieces)))))
                     (setf (fill-pointer line) seg-start)
                     (dotimes (j (length text)) (vector-push-extend (char text j) line))))
                 (setq stop-col (max target (+ stop-col width)) seg-start (length line) fills nil)))
             (int-arg (term what)
               (setq term (%deref term))
               (cond ((integerp term) term)
                     ((plv-p term) (pl-instantiation-error))
                     (t (pl-format-error "~A expects an integer argument, found ~A" what (pl-term-to-string term :quoted t))))))
      (loop
        (when (>= i n) (return))
        (let ((c (char control i)))
          (cond
            ((char/= c #\~) (put-char c) (setq i (+ i 1)))
            (t
             (setq i (+ i 1))
             (when (>= i n) (pl-format-error "truncated format specification"))
             ;; numeric argument: digits, `c (a character) or * (from the arguments)
             (let ((num nil))
               (cond ((char= (char control i) #\*) (setq num (int-arg (next-arg) "~*")) (setq i (+ i 1)))
                     ((char= (char control i) #\`) (setq num (char-code (char control (+ i 1))) i (+ i 2)))
                     ((digit-char-p (char control i))
                      (setq num 0)
                      (loop (when (or (>= i n) (not (digit-char-p (char control i)))) (return))
                            (setq num (+ (* num 10) (digit-char-p (char control i))) i (+ i 1)))))
               (when (>= i n) (pl-format-error "truncated format specification"))
               (let ((d (char control i)))
                 (setq i (+ i 1))
                 (case d
                   (#\w (put-string (pl-term-to-string (next-arg) :numbervars t)))
                   (#\p (put-string (if *pl-print-hook*
                                        (let ((s (make-string-output-stream))) (funcall *pl-print-hook* (next-arg) s) (get-output-stream-string s))
                                        (pl-term-to-string (next-arg) :quoted t :numbervars t))))
                   (#\q (put-string (pl-term-to-string (next-arg) :quoted t :numbervars t)))
                   (#\a (let* ((a (%deref (next-arg))) (txt (pl-text a)))
                          (when (plv-p a) (pl-instantiation-error))
                          (put-string (or txt (pl-term-to-string a)))))
                   (#\d (let* ((a (%deref (next-arg))))
                          (unless (integerp a)
                            (if (plv-p a) (pl-instantiation-error)
                                (pl-format-error "~~d expects an integer argument, found ~A" (pl-term-to-string a :quoted t))))
                          (let* ((s (format nil "~D" (abs a))) (k (or num 0)))
                            (when (> k 0)
                              (when (<= (length s) k) (setq s (concatenate 'string (make-string (- (+ k 1) (length s)) :initial-element #\0) s)))
                              (setq s (concatenate 'string (subseq s 0 (- (length s) k)) "." (subseq s (- (length s) k)))))
                            (put-string (concatenate 'string (if (< a 0) "-" "") s)))))
                   (#\D (let* ((a (%deref (next-arg))))
                          (unless (integerp a)
                            (if (plv-p a) (pl-instantiation-error)
                                (pl-format-error "~~D expects an integer argument, found ~A" (pl-term-to-string a :quoted t))))
                          (let* ((s (format nil "~D" (abs a))) (k (or num 0)) (frac ""))
                            (when (> k 0)
                              (when (<= (length s) k) (setq s (concatenate 'string (make-string (- (+ k 1) (length s)) :initial-element #\0) s)))
                              (setq frac (concatenate 'string "." (subseq s (- (length s) k))) s (subseq s 0 (- (length s) k))))
                            (put-string (concatenate 'string (if (< a 0) "-" "") (%pl-group-digits s ",") frac)))))
                   (#\s (let* ((a (%deref (next-arg))) (txt (if (stringp a) a (pl-code-list-string a))))
                          (unless txt (pl-format-error "~~s expects a list of character codes"))
                          (put-string txt)))
                   ((#\e #\f #\g)
                    (let ((a (%deref (next-arg))))
                      (when (plv-p a) (pl-instantiation-error))
                      (unless (realp a) (pl-format-error "~~~A expects a numeric argument, found ~A" d (pl-term-to-string a :quoted t)))
                      (put-string (case d
                                    (#\f (pl-format-fixed a (min (or num 6) 1000)))
                                    (#\e (pl-format-exp a (min (or num 6) 1000)))
                                    (t (let ((s (format nil "~A" (pl-format-float (float a 1d0))))) s))))))
                   (#\n (dotimes (k (min (or num 1) 1000000)) (put-char #\Newline)))
                   (#\c (let ((code (int-arg (next-arg) "~c"))) (unless (<= 0 code 1114111) (pl-format-error "~~c needs a character code")) (dotimes (k (min (or num 1) 1000000)) (put-char (code-char code)))))
                   (#\r (let ((a (int-arg (next-arg) "~r")))
                          (unless num (pl-format-error "~~r requires a numeric argument"))
                          (put-string (string-downcase (%pl-radix-string a num)))))
                   (#\R (let ((a (int-arg (next-arg) "~R")))
                          (unless num (pl-format-error "~~R requires a numeric argument"))
                          (put-string (string-upcase (%pl-radix-string a num)))))
                   (#\~ (put-char #\~))
                   (#\i (next-arg))
                   (#\t (push (cons (- (length line) seg-start) (if num (code-char num) #\Space)) fills))
                   (#\| (column-stop (min (or num (+ stop-col (- (length line) seg-start))) 100000)))
                   (#\+ (column-stop (min (+ stop-col (or num 8)) 100000)))
                   (t (pl-format-error "unknown directive ~~~A" d)))))))))
      (when args (pl-format-error "too many arguments"))
      (flush-line)
      (get-output-stream-string out))))

(defun %pl-radix-string (n radix)
  "N in the given RADIX (2..36), lower case, with a leading minus."
  (cond ((= n 0) "0")
        (t (let ((digits nil) (a (abs n)))
             (loop (when (= a 0) (return)) (multiple-value-bind (q r) (floor a radix) (push (char "0123456789abcdefghijklmnopqrstuvwxyz" r) digits) (setq a q)))
             (concatenate 'string (if (< n 0) "-" "") (coerce digits 'string))))))
