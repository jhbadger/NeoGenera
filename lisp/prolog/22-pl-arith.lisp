;;;; 22-pl-arith.lisp -- the Prolog Tool Kit: arithmetic (is/2 and the comparison predicates).
;;;;
;;;; Integers are Lisp integers of any size; floats are double-floats.  A / B is an integer when both are integers and B
;;;; divides A, else a float (as SWI-Prolog does with iso=false); ** on integers is an integer and ^ requires a
;;;; non-negative exponent.  Results that overflow or leave the reals raise evaluation errors.

(in-package :cl)

(defvar *pl-arith0* (make-hash-table :test 'eq) "Evaluable atoms: name -> thunk.")
(defvar *pl-arith1* (make-hash-table :test 'eq) "Unary evaluable functors: name -> function.")
(defvar *pl-arith2* (make-hash-table :test 'eq) "Binary evaluable functors: name -> function.")

(defun %pl-def-arith (table name fn) (setf (gethash (pl-atom name) table) fn))

(defun %pl-int-check (x)
  (if (integerp x) x (pl-type-error "integer" x)))

(defun %pl-float-of (x)
  (let ((r (handler-case (float x 1d0) (error () nil))))
    (if r r (pl-evaluation-error "float_overflow"))))

(defun %pl-finite-p (x)
  (or (not (floatp x)) (and (= x x) (let ((inf (pl-infinity))) (and (/= x inf) (/= x (- inf)))))))

(defun %pl-fcheck (r &rest inputs)
  "R, or an evaluation error when it is infinite or not a number although INPUTS were finite."
  (cond ((complexp r) (pl-evaluation-error "undefined"))
        ((and (floatp r) (not (%pl-finite-p r)) (every #'%pl-finite-p inputs))
         (if (/= r r) (pl-evaluation-error "undefined") (pl-evaluation-error "float_overflow")))
        (t r)))

(defun %pl-round-half-away (x)
  (if (integerp x) x
      (let ((r (rational x))) (if (>= r 0) (floor (+ r 1/2)) (ceiling (- r 1/2))))))

(defun %pl-intdiv-check (b)
  (when (and (numberp b) (zerop b)) (pl-evaluation-error "zero_divisor")))

(defun pl-eval (x)
  "The value of the arithmetic expression X."
  (setq x (%deref x))
  (cond ((integerp x) x)
        ((floatp x) x)
        ((plv-p x) (pl-instantiation-error))
        ((pls-p x)
         (let* ((name (pls-name x)) (args (pls-args x)) (n (length args)))
           (cond ((= n 2)
                  (let ((f (gethash name *pl-arith2*)))
                    (cond (f (funcall f (pl-eval (svref args 0)) (pl-eval (svref args 1))))
                          ((eq name *pl-dot*)
                           (if (eq (%deref (svref args 1)) *pl-nil*) (pl-eval (svref args 0))
                               (pl-type-error "evaluable" (pl-indicator name 2))))
                          (t (pl-type-error "evaluable" (pl-indicator name 2))))))
                 ((= n 1)
                  (let ((f (gethash name *pl-arith1*)))
                    (if f (funcall f (pl-eval (svref args 0))) (pl-type-error "evaluable" (pl-indicator name 1)))))
                 (t (pl-type-error "evaluable" (pl-indicator name n))))))
        ((symbolp x)
         (let ((f (gethash x *pl-arith0*)))
           (cond (f (funcall f))
                 ((eq x *pl-nil*) (pl-type-error "evaluable" x))
                 (t (pl-type-error "evaluable" (pl-indicator x 0))))))
        ((stringp x) (if (= (length x) 1) (char-code (char x 0)) (pl-type-error "evaluable" x)))
        (t (pl-type-error "evaluable" x))))

(defmacro %pl-arith1 (name (v) &body body) `(%pl-def-arith *pl-arith1* ,name (lambda (,v) ,@body)))
(defmacro %pl-arith2 (name (a b) &body body) `(%pl-def-arith *pl-arith2* ,name (lambda (,a ,b) ,@body)))

(%pl-def-arith *pl-arith0* "pi" (lambda () 3.141592653589793d0))
(%pl-def-arith *pl-arith0* "e" (lambda () 2.718281828459045d0))
(%pl-def-arith *pl-arith0* "epsilon" (lambda () 2.220446049250313d-16))
(%pl-def-arith *pl-arith0* "inf" (lambda () (pl-infinity)))
(%pl-def-arith *pl-arith0* "infinite" (lambda () (pl-infinity)))
(%pl-def-arith *pl-arith0* "nan" (lambda () (pl-nan)))
(%pl-def-arith *pl-arith0* "max_tagged_integer" (lambda () 1152921504606846975))
(%pl-def-arith *pl-arith0* "min_tagged_integer" (lambda () -1152921504606846976))
(%pl-def-arith *pl-arith0* "max_integer" (lambda () 9223372036854775807))
(%pl-def-arith *pl-arith0* "min_integer" (lambda () -9223372036854775808))
(%pl-def-arith *pl-arith0* "random" (lambda () (random 1d0)))
(%pl-def-arith *pl-arith0* "random_float" (lambda () (random 1d0)))
(%pl-def-arith *pl-arith0* "cputime" (lambda () (/ (float (get-internal-real-time) 1d0) 1000000d0)))
(%pl-def-arith *pl-arith0* "realtime" (lambda () (- (get-universal-time) 2208988800)))

(%pl-arith2 "+" (a b) (%pl-fcheck (+ a b) a b))
(%pl-arith2 "-" (a b) (%pl-fcheck (- a b) a b))
(%pl-arith2 "*" (a b) (%pl-fcheck (* a b) a b))
(%pl-arith2 "/" (a b)
  (cond ((and (integerp a) (integerp b))
         (%pl-intdiv-check b)
         (if (= 0 (rem a b)) (truncate a b) (/ (%pl-float-of a) (%pl-float-of b))))
        (t (when (zerop b) (pl-evaluation-error "zero_divisor"))
           (%pl-fcheck (/ (%pl-float-of a) (%pl-float-of b)) a b))))
(%pl-arith2 "//" (a b) (%pl-int-check a) (%pl-int-check b) (%pl-intdiv-check b) (values (truncate a b)))
(%pl-arith2 "div" (a b) (%pl-int-check a) (%pl-int-check b) (%pl-intdiv-check b) (values (floor a b)))
(%pl-arith2 "mod" (a b) (%pl-int-check a) (%pl-int-check b) (%pl-intdiv-check b) (mod a b))
(%pl-arith2 "rem" (a b) (%pl-int-check a) (%pl-int-check b) (%pl-intdiv-check b) (rem a b))
(%pl-arith2 "min" (a b) (if (< (pl-compare-numbers a b) 0) a (if (> (pl-compare-numbers a b) 0) b a)))
(%pl-arith2 "max" (a b) (if (> (pl-compare-numbers a b) 0) a (if (< (pl-compare-numbers a b) 0) b a)))
(%pl-arith2 ">>" (a b) (%pl-int-check a) (%pl-int-check b) (ash a (- b)))
(%pl-arith2 "<<" (a b) (%pl-int-check a) (%pl-int-check b) (ash a b))
(%pl-arith2 "/\\" (a b) (%pl-int-check a) (%pl-int-check b) (logand a b))
(%pl-arith2 "\\/" (a b) (%pl-int-check a) (%pl-int-check b) (logior a b))
(%pl-arith2 "xor" (a b) (%pl-int-check a) (%pl-int-check b) (logxor a b))
(%pl-arith2 "gcd" (a b) (%pl-int-check a) (%pl-int-check b) (gcd a b))
(%pl-arith2 "atan2" (a b) (atan (%pl-float-of a) (%pl-float-of b)))
(%pl-arith2 "atan" (a b) (atan (%pl-float-of a) (%pl-float-of b)))
(%pl-arith2 "log" (a b)
  (when (or (<= a 0) (<= b 0)) (pl-evaluation-error "undefined"))
  (/ (log (%pl-float-of b)) (log (%pl-float-of a))))


(defun %pl-int-power (a b)
  (cond ((>= b 0) (expt a b))
        ((= a 1) 1)
        ((= a -1) (if (evenp b) 1 -1))
        ((= a 0) (pl-evaluation-error "zero_divisor"))
        (t (pl-type-error "float" a))))

(%pl-arith2 "^" (a b)
  (cond ((and (integerp a) (integerp b)) (%pl-int-power a b))
        (t (let ((fa (%pl-float-of a)) (fb (%pl-float-of b)))
             (when (and (zerop fa) (< fb 0)) (pl-evaluation-error "zero_divisor"))
             (when (and (< fa 0) (/= fb (ffloor fb))) (pl-evaluation-error "undefined"))
             (%pl-fcheck (expt fa fb) a b)))))
(%pl-arith2 "**" (a b)
  (cond ((and (integerp a) (integerp b))
         (if (>= b 0) (expt a b)
             (cond ((= a 1) 1) ((= a -1) (if (evenp b) 1 -1))
                   ((= a 0) (pl-evaluation-error "zero_divisor"))
                   (t (/ 1d0 (%pl-float-of (expt a (- b))))))))
        (t (let ((fa (%pl-float-of a)) (fb (%pl-float-of b)))
             (when (and (zerop fa) (< fb 0)) (pl-evaluation-error "zero_divisor"))
             (when (and (< fa 0) (/= fb (ffloor fb))) (pl-evaluation-error "undefined"))
             (%pl-fcheck (expt fa fb) a b)))))

(%pl-arith1 "-" (a) (- a))
(%pl-arith1 "+" (a) a)
(%pl-arith1 "abs" (a) (abs a))
(%pl-arith1 "sign" (a) (if (integerp a) (signum a) (float (signum a) 1d0)))
(%pl-arith1 "min" (a) a)
(%pl-arith1 "max" (a) a)
(%pl-arith1 "succ" (a) (+ (%pl-int-check a) 1))
(%pl-arith1 "\\" (a) (lognot (%pl-int-check a)))
(%pl-arith1 "msb" (a) (- (integer-length (%pl-int-check a)) 1))
(%pl-arith1 "float" (a) (%pl-float-of a))
(%pl-arith1 "integer" (a) (%pl-round-half-away a))
(%pl-arith1 "float_integer_part" (a) (let ((f (%pl-float-of a))) (ftruncate f)))
(%pl-arith1 "float_fractional_part" (a) (if (integerp a) 0 (- a (ftruncate a))))
(%pl-arith1 "truncate" (a) (if (integerp a) a (values (truncate a))))
(%pl-arith1 "round" (a) (%pl-round-half-away a))
(%pl-arith1 "ceiling" (a) (if (integerp a) a (values (ceiling a))))
(%pl-arith1 "floor" (a) (if (integerp a) a (values (floor a))))
(%pl-arith1 "sqrt" (a) (when (< a 0) (pl-evaluation-error "undefined")) (sqrt (%pl-float-of a)))
(%pl-arith1 "sin" (a) (sin (%pl-float-of a)))
(%pl-arith1 "cos" (a) (cos (%pl-float-of a)))
(%pl-arith1 "tan" (a) (tan (%pl-float-of a)))
(%pl-arith1 "asin" (a) (when (or (< a -1) (> a 1)) (pl-evaluation-error "undefined")) (asin (%pl-float-of a)))
(%pl-arith1 "acos" (a) (when (or (< a -1) (> a 1)) (pl-evaluation-error "undefined")) (acos (%pl-float-of a)))
(%pl-arith1 "atan" (a) (atan (%pl-float-of a)))
(%pl-arith1 "sinh" (a) (%pl-fcheck (sinh (%pl-float-of a)) a))
(%pl-arith1 "cosh" (a) (%pl-fcheck (cosh (%pl-float-of a)) a))
(%pl-arith1 "tanh" (a) (tanh (%pl-float-of a)))
(%pl-arith1 "asinh" (a) (asinh (%pl-float-of a)))
(%pl-arith1 "acosh" (a) (when (< a 1) (pl-evaluation-error "undefined")) (acosh (%pl-float-of a)))
(%pl-arith1 "atanh" (a) (when (or (<= a -1) (>= a 1)) (pl-evaluation-error "undefined")) (atanh (%pl-float-of a)))
(%pl-arith1 "exp" (a) (%pl-fcheck (exp (%pl-float-of a)) a))
(%pl-arith1 "log" (a) (when (<= a 0) (if (zerop a) (pl-evaluation-error "undefined") (pl-evaluation-error "undefined"))) (log (%pl-float-of a)))
(%pl-arith1 "log2" (a) (when (<= a 0) (pl-evaluation-error "undefined")) (/ (log (%pl-float-of a)) (log 2d0)))
(%pl-arith1 "random" (a) (%pl-int-check a) (when (<= a 0) (pl-evaluation-error "undefined")) (random a))
(%pl-arith1 "random_float" (a) (declare (ignore a)) (random 1d0))
(%pl-arith1 "cot" (a) (/ 1d0 (tan (%pl-float-of a))))
(%pl-arith1 "acot" (a) (atan (/ 1d0 (%pl-float-of a))))

;;; ---- the predicates ---------------------------------------------------------------------------------------------------------------------

(defun pl-compare-values (a b)
  "Compare the numbers A and B arithmetically: -1, 0 or 1 (no float-before-integer tie break)."
  (cond ((= a b) 0) ((< a b) -1) (t 1)))
