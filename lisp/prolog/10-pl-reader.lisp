;;;; 10-pl-reader.lisp -- the Prolog Tool Kit: Edinburgh/ISO syntax: operators, flags, tokens and the term parser.
;;;;
;;;; Reading works on strings.  PL-READ-TERM-FROM-STRING reads the next clause (up to its end token, a full stop followed by
;;;; layout) at an offset, so the editor and the consulter can say exactly where each clause starts and ends; reading from a
;;;; stream first cuts one clause's text out of the stream (PL-READ-CLAUSE-TEXT).  A syntax error skips the rest of the
;;;; clause so that reading can continue.

(in-package :cl)

;;; ---- flags -----------------------------------------------------------------------------------------------------------

(defvar *pl-flags* nil "The Prolog flags: an alist (name-string . value-atom-or-integer).")

(defun pl-flag (name)
  (cdr (assoc name *pl-flags* :test #'string=)))

(defun pl-set-flag (name value)
  (let ((c (assoc name *pl-flags* :test #'string=)))
    (if c (rplacd c value) (setq *pl-flags* (cons (cons name value) *pl-flags*)))
    value))

(defun %pl-reset-flags ()
  (setq *pl-flags* nil)
  (pl-set-flag "double_quotes" (pl-atom "string"))
  (pl-set-flag "unknown" (pl-atom "error"))
  (pl-set-flag "occurs_check" (pl-atom "false"))
  (pl-set-flag "bounded" (pl-atom "false"))
  (pl-set-flag "max_integer" 9223372036854775807)
  (pl-set-flag "min_integer" -9223372036854775808)
  (pl-set-flag "max_tagged_integer" 1152921504606846975)
  (pl-set-flag "integer_rounding_function" (pl-atom "toward_zero"))
  (pl-set-flag "char_conversion" (pl-atom "false"))
  (pl-set-flag "debug" (pl-atom "false"))
  (pl-set-flag "last_call_optimisation" (pl-atom "true"))
  (pl-set-flag "stack_limit" 134217728)
  (pl-set-flag "version" 90000)
  (pl-set-flag "dialect" (pl-atom "neogenera"))
  (pl-set-flag "verbose" (pl-atom "normal"))
  (pl-set-flag "answer_write_options" *pl-nil*))
(%pl-reset-flags)

;;; ---- operators --------------------------------------------------------------------------------------------------------

(defvar *pl-ops* (make-hash-table :test 'eq) "Operator definitions: atom -> (prefix infix postfix), each NIL or (priority . type).")
(defvar *pl-default-ops* nil "The operator table as of the end of loading (for RESET).")

(defun %pl-op-slot (type)
  (cond ((member type '(:fx :fy)) 0) ((member type '(:xfx :xfy :yfx)) 1) (t 2)))

(defun pl-add-op (priority type name)
  "Define NAME (an atom) as an operator of PRIORITY (0 removes it) and TYPE (:XFX :XFY :YFX :FY :FX :XF :YF)."
  (let ((entry (or (gethash name *pl-ops*) (setf (gethash name *pl-ops*) (list nil nil nil))))
        (slot (%pl-op-slot type)))
    (setf (nth slot entry) (if (= priority 0) nil (cons priority type)))
    priority))

(defun pl-prefix-op (name) (and (symbolp name) (first (gethash name *pl-ops*))))
(defun pl-infix-op (name) (and (symbolp name) (second (gethash name *pl-ops*))))
(defun pl-postfix-op (name) (and (symbolp name) (third (gethash name *pl-ops*))))
(defun pl-any-op-p (name) (let ((e (and (symbolp name) (gethash name *pl-ops*)))) (and e (or (first e) (second e) (third e)) t)))

(defun %pl-install-default-ops ()
  (clrhash *pl-ops*)
  (dolist (spec '((1200 :xfx ":-" "-->") (1200 :fx ":-" "?-") (1100 :xfy ";" "|") (1105 :xfy "|") (1050 :xfy "->" "*->")
                  (1000 :xfy ",") (990 :xfx ":=") (900 :fy "\\+")
                  (700 :xfx "=" "\\=" "==" "\\==" "@<" "@>" "@=<" "@>=" "=.." "is" "=:=" "=\\=" "<" ">" "=<" ">=" ">:<" ":<" "as"
                                "=@=" "\\=@=")
                  (600 :xfy ":") (500 :yfx "+" "-" "/\\" "\\/" "xor") (400 :yfx "*" "/" "//" "mod" "rem" "<<" ">>" "div" "rdiv" "divmod")
                  (200 :xfx "**") (200 :xfy "^") (200 :fy "-" "+" "\\")
                  (1150 :fx "dynamic" "discontiguous" "initialization" "meta_predicate" "module_transparent" "multifile" "public"
                                 "thread_local" "table")
                  (1 :fx "$")))
    (dolist (name (cddr spec)) (pl-add-op (car spec) (cadr spec) (pl-atom name)))))
(%pl-install-default-ops)

;;; ---- characters ---------------------------------------------------------------------------------------------------------

(defun %pl-symch-p (c) (and (find c "+-*/\\^<>=~:.?@#&$") t))
(defun %pl-layout-p (c) (or (char= c #\Space) (char= c #\Tab) (char= c #\Newline) (char= c #\Return) (char= c (code-char 12)) (char= c (code-char 11))
                            (char= c (code-char 160))))
(defun %pl-alnum-p (c) (or (alpha-char-p c) (digit-char-p c) (char= c #\_)))
(defun %pl-upper-start-p (c) (or (char= c #\_) (and (alpha-char-p c) (upper-case-p c))))
(defun %pl-lower-start-p (c) (and (alpha-char-p c) (not (upper-case-p c))))
(defun %pl-solo-p (c) (or (char= c #\!) (char= c #\;)))

(defstruct (pltok (:constructor %make-pltok (type value start end layout)) (:copier nil)) type value start end layout)

(defun %pl-line-col (text offset)
  "The line (from 1) and column (from 0) of OFFSET in TEXT."
  (let ((line 1) (col 0))
    (dotimes (i (min offset (length text)))
      (if (char= (char text i) #\Newline) (setq line (+ line 1) col 0) (setq col (+ col 1))))
    (values line col)))

(defvar *pl-read-file* nil "The file name used in syntax error messages, or NIL.")

(defun %pl-lex-error (text offset message)
  (multiple-value-bind (line col) (%pl-line-col text offset)
    (pl-syntax-error message line col *pl-read-file*)))

;;; ---- tokens ----------------------------------------------------------------------------------------------------------------

(defun %pl-skip-layout (text i)
  "The offset after the layout and comments at I, and whether there was any."
  (let ((n (length text)) (start i))
    (loop
      (cond ((>= i n) (return))
            ((%pl-layout-p (char text i)) (setq i (+ i 1)))
            ((char= (char text i) #\%)
             (loop (when (or (>= i n) (char= (char text i) #\Newline)) (return)) (setq i (+ i 1))))
            ((and (char= (char text i) #\/) (< (+ i 1) n) (char= (char text (+ i 1)) #\*))
             (let ((e (search "*/" text :start2 (+ i 2))))
               (unless e (%pl-lex-error text i "Unterminated block comment"))
               (setq i (+ e 2))))
            (t (return))))
    (values i (> i start))))

(defun %pl-escape (text i)
  "Read the escape sequence after a backslash at I (the char after the backslash): (values char-or-nil next-index);
NIL for a line continuation."
  (let ((n (length text)))
    (when (>= i n) (%pl-lex-error text i "Unterminated escape sequence"))
    (let ((c (char text i)))
      (case c
        (#\n (values #\Newline (+ i 1)))
        (#\t (values #\Tab (+ i 1)))
        (#\r (values #\Return (+ i 1)))
        (#\a (values (code-char 7) (+ i 1)))
        (#\b (values (code-char 8) (+ i 1)))
        (#\f (values (code-char 12) (+ i 1)))
        (#\v (values (code-char 11) (+ i 1)))
        (#\0 (if (and (< (+ i 1) n) (digit-char-p (char text (+ i 1)) 8))
                 (%pl-octal-escape text i)
                 (if (and (< (+ i 1) n) (char= (char text (+ i 1)) #\\)) (values (code-char 0) (+ i 2)) (values (code-char 0) (+ i 1)))))
        (#\e (values (code-char 27) (+ i 1)))
        (#\s (values #\Space (+ i 1)))
        (#\z (values nil (+ i 1)))
        (#\Newline (values nil (+ i 1)))
        (#\x (let ((j (+ i 1)) (v 0))
               (loop (when (or (>= j n) (not (digit-char-p (char text j) 16))) (return))
                     (setq v (+ (* v 16) (digit-char-p (char text j) 16)) j (+ j 1)))
               (when (and (< j n) (char= (char text j) #\\)) (setq j (+ j 1)))
               (values (code-char v) j)))
        (#\u (%pl-hex-escape text (+ i 1) 4))
        (#\U (%pl-hex-escape text (+ i 1) 8))
        ((#\\ #\' #\" #\`) (values c (+ i 1)))
        (t (if (digit-char-p c 8) (%pl-octal-escape text i) (%pl-lex-error text i "Undefined escape sequence")))))))

(defun %pl-octal-escape (text i)
  (let ((j i) (v 0) (n (length text)))
    (loop (when (or (>= j n) (not (digit-char-p (char text j) 8))) (return))
          (setq v (+ (* v 8) (digit-char-p (char text j) 8)) j (+ j 1)))
    (when (and (< j n) (char= (char text j) #\\)) (setq j (+ j 1)))
    (values (code-char v) j)))

(defun %pl-hex-escape (text i count)
  (let ((v 0))
    (dotimes (k count)
      (unless (and (< (+ i k) (length text)) (digit-char-p (char text (+ i k)) 16)) (%pl-lex-error text i "Bad \\u escape"))
      (setq v (+ (* v 16) (digit-char-p (char text (+ i k)) 16))))
    (values (code-char v) (+ i count))))

(defun %pl-read-quoted (text i quote)
  "Read the quoted item whose opening quote is at I: (values string next-index)."
  (let ((n (length text)) (out (make-string-output-stream)) (j (+ i 1)))
    (loop
      (when (>= j n) (%pl-lex-error text i "Unterminated quoted item"))
      (let ((c (char text j)))
        (cond ((char= c quote)
               (if (and (< (+ j 1) n) (char= (char text (+ j 1)) quote))
                   (progn (write-char quote out) (setq j (+ j 2)))
                   (return (values (get-output-stream-string out) (+ j 1)))))
              ((char= c #\\)
               (multiple-value-bind (ch next) (%pl-escape text (+ j 1))
                 (when ch (write-char ch out))
                 (setq j next)))
              (t (write-char c out) (setq j (+ j 1))))))))

(defun %pl-digits-end (text i radix)
  "The end of the run of RADIX digits (with single _ separators between digits) starting at I."
  (let ((n (length text)))
    (loop
      (cond ((and (< i n) (digit-char-p (char text i) radix)) (setq i (+ i 1)))
            ((and (< (+ i 1) n) (char= (char text i) #\_) (> i 0) (digit-char-p (char text (- i 1)) radix)
                  (digit-char-p (char text (+ i 1)) radix))
             (setq i (+ i 1)))
            (t (return i))))))

(defun %pl-parse-digits (text s e radix)
  (let ((v 0))
    (loop for k from s below e do (let ((d (digit-char-p (char text k) radix))) (when d (setq v (+ (* v radix) d)))))
    v))

(defun %pl-lex-number (text i)
  "Read the number at I: (values value next-index type)."
  (let ((n (length text)) (c (char text i)))
    (when (and (char= c #\0) (< (+ i 1) n))
      (let ((d (char text (+ i 1))))
        (cond ((char= d #\')
               (cond ((>= (+ i 2) n) nil)
                     ((char= (char text (+ i 2)) #\\)
                      (multiple-value-bind (ch next) (%pl-escape text (+ i 3))
                        (return-from %pl-lex-number (values (if ch (char-code ch) 0) next :int))))
                     ((and (char= (char text (+ i 2)) #\') (< (+ i 3) n) (char= (char text (+ i 3)) #\'))
                      (return-from %pl-lex-number (values 39 (+ i 4) :int)))
                     ((char= (char text (+ i 2)) #\')
                      nil)
                     (t (return-from %pl-lex-number (values (char-code (char text (+ i 2))) (+ i 3) :int)))))
              ((and (member d '(#\x #\o #\b)) (< (+ i 2) n)
                    (digit-char-p (char text (+ i 2)) (case d (#\x 16) (#\o 8) (t 2))))
               (let* ((radix (case d (#\x 16) (#\o 8) (t 2))) (e (%pl-digits-end text (+ i 2) radix)))
                 (return-from %pl-lex-number (values (%pl-parse-digits text (+ i 2) e radix) e :int)))))))
    (let* ((e (%pl-digits-end text i 10)))
      ;; radix notation R'digits
      (when (and (< (+ e 1) n) (char= (char text e) #\') (<= 2 (%pl-parse-digits text i e 10) 36)
                 (digit-char-p (char text (+ e 1)) (%pl-parse-digits text i e 10)))
        (let* ((radix (%pl-parse-digits text i e 10)) (e2 (%pl-digits-end text (+ e 1) radix)))
          (return-from %pl-lex-number (values (%pl-parse-digits text (+ e 1) e2 radix) e2 :int))))
      (let ((float-p nil) (j e))
        (when (and (< (+ j 1) n) (char= (char text j) #\.) (digit-char-p (char text (+ j 1))))
          (setq float-p t j (%pl-digits-end text (+ j 1) 10)))
        (when (and (< j n) (member (char text j) '(#\e #\E))
                   (or (and (< (+ j 1) n) (digit-char-p (char text (+ j 1))))
                       (and (< (+ j 2) n) (member (char text (+ j 1)) '(#\+ #\-)) (digit-char-p (char text (+ j 2))))))
          (setq float-p t)
          (let ((k (+ j 1)))
            (when (member (char text k) '(#\+ #\-)) (setq k (+ k 1)))
            (setq j (%pl-digits-end text k 10))))
        (cond (float-p
               (let* ((raw (remove #\_ (subseq text i j))) (epos (position-if (lambda (ch) (member ch '(#\e #\E))) raw))
                      (norm (if (and epos (not (find #\. (subseq raw 0 epos)))) (concatenate 'string (subseq raw 0 epos) ".0" (subseq raw epos)) raw)))
                 (when (and (< (+ j 2) n) (string= (subseq text j (+ j 3)) "Inf"))
                   (return-from %pl-lex-number (values (pl-infinity) (+ j 3) :float)))
                 (when (and (< (+ j 2) n) (string= (subseq text j (+ j 3)) "NaN"))
                   (return-from %pl-lex-number (values (pl-nan) (+ j 3) :float)))
                 (let ((v (handler-case (let ((*read-default-float-format* 'double-float)) (read-from-string (substitute #\e #\E norm)))
                            (error () nil))))
                   (unless (floatp v) (%pl-lex-error text i "Illegal number"))
                   (values v j :float))))
              (t (values (%pl-parse-digits text i e 10) e :int)))))))

(defvar *pl-infinity* nil)
(defvar *pl-nan* nil)
(defun pl-infinity ()
  "Positive infinity as a float."
  (or *pl-infinity* (setq *pl-infinity* (* 1d308 10d0))))
(defun pl-nan ()
  "A not-a-number float."
  (or *pl-nan* (setq *pl-nan* (- (pl-infinity) (pl-infinity)))))

(defun %pl-lex-clause (text pos)
  "Tokenize the clause starting at or after POS: (values tokens next-pos).  TOKENS is a list of PLTOKs ending with the
:END token, or NIL at the end of the text.  A lexical error skips to the end of the clause before signalling."
  (let ((n (length text)) (toks nil) (i pos) (prev nil))
    (flet ((emit (type value s e layout)
             (let ((tk (%make-pltok type value s e layout))) (push tk toks) (setq prev tk) tk)))
      (loop
        (multiple-value-bind (j layout) (%pl-skip-layout text i)
          (setq i j)
          (when (>= i n)
            (when toks (%pl-lex-error text (pltok-start (car (last toks))) "Unexpected end of file"))
            (return (values nil n)))
          (let ((c (char text i)))
            (cond
              ((digit-char-p c)
               (multiple-value-bind (v e type) (%pl-lex-number text i)
                 (emit type v i e layout) (setq i e)))
              ((char= c #\_) (let ((e i)) (loop (when (or (>= e n) (not (%pl-alnum-p (char text e)))) (return)) (setq e (+ e 1)))
                               (emit :var (subseq text i e) i e layout) (setq i e)))
              ((alpha-char-p c)
               (let ((e i)) (loop (when (or (>= e n) (not (%pl-alnum-p (char text e)))) (return)) (setq e (+ e 1)))
                 (emit (if (upper-case-p c) :var :atom) (subseq text i e) i e layout) (setq i e)))
              ((char= c #\') (multiple-value-bind (s e) (%pl-read-quoted text i #\') (emit :qatom s i e layout) (setq i e)))
              ((char= c #\") (multiple-value-bind (s e) (%pl-read-quoted text i #\") (emit :string s i e layout) (setq i e)))
              ((char= c #\`) (multiple-value-bind (s e) (%pl-read-quoted text i #\`) (emit :bq s i e layout) (setq i e)))
              ((char= c #\()
               (emit (if (and prev (not layout) (or (member (pltok-type prev) '(:atom :qatom))
                                                    (and (eq (pltok-type prev) :punct) (member (pltok-value prev) '("]" "}") :test #'string=))))
                         :open-ct :punct)
                     "(" i (+ i 1) layout)
               (setq i (+ i 1)))
              ((find c ")[]{},|")
               (emit :punct (string c) i (+ i 1) layout) (setq i (+ i 1)))
              ((%pl-solo-p c) (emit :atom (string c) i (+ i 1) layout) (setq i (+ i 1)))
              ((char= c #\.)
               (if (or (>= (+ i 1) n) (%pl-layout-p (char text (+ i 1))) (char= (char text (+ i 1)) #\%))
                   (progn (emit :end "." i (+ i 1) layout) (return (values (nreverse toks) (+ i 1))))
                   (let ((e i)) (loop (when (or (>= e n) (not (%pl-symch-p (char text e)))) (return)) (setq e (+ e 1)))
                     (emit :atom (subseq text i e) i e layout) (setq i e))))
              ((%pl-symch-p c)
               (let ((e i)) (loop (when (or (>= e n) (not (%pl-symch-p (char text e)))) (return)) (setq e (+ e 1)))
                 (emit :atom (subseq text i e) i e layout) (setq i e)))
              (t (%pl-lex-error text i (format nil "Illegal character ~A" (string c)))))))))))

(defun %pl-skip-clause (text pos)
  "The offset after the end of the clause containing POS (skipping to a full stop followed by layout), for recovery."
  (let ((n (length text)) (i pos))
    (loop
      (when (>= i n) (return n))
      (let ((c (char text i)))
        (cond ((char= c #\%) (loop (when (or (>= i n) (char= (char text i) #\Newline)) (return)) (setq i (+ i 1))))
              ((and (char= c #\/) (< (+ i 1) n) (char= (char text (+ i 1)) #\*))
               (let ((e (search "*/" text :start2 (+ i 2)))) (setq i (if e (+ e 2) n))))
              ((or (char= c #\') (char= c #\") (char= c #\`))
               (let ((j (+ i 1)))
                 (loop (cond ((>= j n) (return))
                             ((char= (char text j) #\\) (setq j (+ j 2)))
                             ((char= (char text j) c) (setq j (+ j 1)) (return))
                             (t (setq j (+ j 1)))))
                 (setq i j)))
              ((and (char= c #\.) (or (>= (+ i 1) n) (%pl-layout-p (char text (+ i 1))) (char= (char text (+ i 1)) #\%))
                    (or (= i 0) (not (%pl-symch-p (char text (- i 1))))))
               (return (+ i 1)))
              (t (setq i (+ i 1))))))))

;;; ---- the parser ----------------------------------------------------------------------------------------------------------------

(defun %pl-term-start-p (tk)
  "True when the token TK can begin a term."
  (case (pltok-type tk)
    ((:atom :qatom :var :int :float :string :bq :open-ct) t)
    (:punct (and (member (pltok-value tk) '("(" "[" "{") :test #'string=) t))
    (t nil)))

(defun %pl-string-term (s)
  (let ((flag (pl-flag "double_quotes")))
    (cond ((eq flag (pl-atom "string")) s)
          ((eq flag (pl-atom "atom")) (pl-atom s))
          ((eq flag (pl-atom "chars")) (pl-string-chars s))
          (t (pl-string-codes s)))))

(defun pl-parse-tokens (text toks)
  "Parse the token list TOKS (of one clause, ending with :END) read from TEXT.  Returns (values term varinfo) where
VARINFO is a list of (name variable count) in order of first appearance, `_' excluded."
  (let* ((v (coerce toks 'simple-vector)) (i 0) (varinfo nil) (argmode nil))
    (labels ((cur () (svref v i))
             (nxt () (and (< (+ i 1) (length v)) (svref v (+ i 1))))
             (fail (tk msg) (%pl-lex-error text (pltok-start tk) msg))
             (punct-p (tk s) (and (eq (pltok-type tk) :punct) (string= (pltok-value tk) s)))
             (expect (s)
               (let ((tk (cur)))
                 (unless (punct-p tk s) (fail tk (format nil "Illegal start of term or missing ~A" s)))
                 (setq i (+ i 1))))
             (make-var (name)
               (if (string= name "_")
                   (pl-new-var)
                   (let ((e (assoc name varinfo :test #'string=)))
                     (if e (progn (setf (third e) (+ (third e) 1)) (second e))
                         (let ((nv (pl-new-var))) (setq varinfo (append varinfo (list (list name nv 1)))) nv)))))
             (parse-arg ()
               ;; an argument: any priority up to 1200 but no top-level comma or bar (as SWI-Prolog reads f(a:-b) and f(a;b))
               (let ((saved argmode))
                 (setq argmode t)
                 (prog1 (parse 1200) (setq argmode saved))))
             (parse-nested ()
               ;; a parenthesized or braced term: the full priority range again
               (let ((saved argmode))
                 (setq argmode nil)
                 (prog1 (parse 1200) (setq argmode saved))))
             (parse-arglist ()
               ;; after the "(": arguments at 999 up to ")"
               (let ((args nil))
                 (loop
                   (push (parse-arg) args)
                   (let ((tk (cur)))
                     (cond ((punct-p tk ",") (setq i (+ i 1)))
                           ((punct-p tk ")") (setq i (+ i 1)) (return))
                           (t (fail tk "Illegal start of term or missing , or )")))))
                 (nreverse args)))
             (parse-list ()
               ;; after "[": items at 999, optional |tail, "]"
               (let ((items nil) (tail *pl-nil*))
                 (loop
                   (push (parse-arg) items)
                   (let ((tk (cur)))
                     (cond ((punct-p tk ",") (setq i (+ i 1)))
                           ((punct-p tk "|") (setq i (+ i 1)) (setq tail (parse-arg)) (expect "]") (return))
                           ((punct-p tk "]") (setq i (+ i 1)) (return))
                           (t (fail tk "Illegal start of term or missing , | or ]")))))
                 (lisp-to-pl-list (nreverse items) tail)))
             (atom-name-term (name) (pl-atom name))
             (parse-primary (maxprec)
               (let* ((tk (cur)) (type (pltok-type tk)))
                 (case type
                   ((:int :float) (setq i (+ i 1)) (values (pltok-value tk) 0))
                   (:var (setq i (+ i 1)) (values (make-var (pltok-value tk)) 0))
                   (:string (setq i (+ i 1)) (values (%pl-string-term (pltok-value tk)) 0))
                   (:bq (setq i (+ i 1)) (values (pl-string-codes (pltok-value tk)) 0))
                   (:punct
                    (let ((s (pltok-value tk)))
                      (cond ((string= s "(") (setq i (+ i 1)) (let ((tm (parse-nested))) (expect ")") (values tm 0)))
                            ((string= s "[")
                             (setq i (+ i 1))
                             (if (punct-p (cur) "]")
                                 (progn (setq i (+ i 1))
                                        (if (eq (pltok-type (cur)) :open-ct)
                                            (progn (setq i (+ i 1)) (values (%make-pls *pl-nil* (coerce (parse-arglist) 'simple-vector)) 0))
                                            (values *pl-nil* 0)))
                                 (values (parse-list) 0)))
                            ((string= s "{")
                             (setq i (+ i 1))
                             (if (punct-p (cur) "}")
                                 (progn (setq i (+ i 1))
                                        (if (eq (pltok-type (cur)) :open-ct)
                                            (progn (setq i (+ i 1)) (values (%make-pls *pl-curly* (coerce (parse-arglist) 'simple-vector)) 0))
                                            (values *pl-curly* 0)))
                                 (let ((tm (parse-nested))) (expect "}") (values (%make-pls *pl-curly* (vector tm)) 0))))
                            (t (fail tk (format nil "Illegal start of term (unexpected ~A)" s))))))
                   (:open-ct (setq i (+ i 1)) (let ((tm (parse-nested))) (expect ")") (values tm 0)))
                   (:end (fail tk "Unexpected end of clause"))
                   (t (parse-atom-term tk maxprec)))))
             (parse-atom-term (tk maxprec)
               (let* ((name (pltok-value tk)) (quoted (eq (pltok-type tk) :qatom)) (atom (atom-name-term name)))
                 (setq i (+ i 1))
                 (cond
                   ;; functional notation
                   ((eq (pltok-type (cur)) :open-ct)
                    (setq i (+ i 1))
                    (values (%make-pls atom (coerce (parse-arglist) 'simple-vector)) 0))
                   ;; negative numbers
                   ((and (not quoted) (string= name "-") (member (pltok-type (cur)) '(:int :float)) (not (pltok-layout (cur))))
                    (let ((num (pltok-value (cur)))) (setq i (+ i 1)) (values (- num) 0)))
                   ((and (not quoted) (pl-prefix-op atom))
                    (let* ((op (pl-prefix-op atom)) (pri (car op)) (type (cdr op)) (next (cur)))
                      (cond
                        ;; an operator standing as an atom: before an infix operator or a closing token
                        ((or (member (pltok-type next) '(:end))
                             (and (eq (pltok-type next) :punct) (member (pltok-value next) '(")" "]" "}" "," "|") :test #'string=))
                             (and (member (pltok-type next) '(:atom)) (pl-infix-op (atom-name-term (pltok-value next)))
                                  (not (pl-prefix-op (atom-name-term (pltok-value next))))
                                  (not (eq (pltok-type (svref v (min (+ i 1) (- (length v) 1)))) :open-ct))))
                         (values atom (if (> pri maxprec) 0 pri)))
                        (t
                         (let* ((pri2 (if (> pri maxprec) 999 pri)) (argmax (if (eq type :fy) pri2 (- pri2 1))) (save i) (save-argmode argmode))
                           (let ((arg (handler-case (parse argmax)
                                        (pl-error (e) (if (%pl-term-start-p next) (progn (setq i save argmode save-argmode) (cons :fail e)) (error e))))))
                             (if (and (consp arg) (eq (car arg) :fail))
                                 (values atom 0)
                                 (values (%make-pls atom (vector arg)) pri2))))))))
                   (t (values atom 0)))))
             (parse (maxprec)
               (multiple-value-bind (left leftprec) (parse-primary maxprec)
                 (loop
                   (let* ((tk (cur)) (type (pltok-type tk)) (name nil))
                     (cond ((eq type :atom) (setq name (pltok-value tk)))
                           ((eq type :qatom) (setq name (pltok-value tk)))
                           ((and (eq type :punct) (string= (pltok-value tk) ",")) (setq name ","))
                           ((and (eq type :punct) (string= (pltok-value tk) "|")) (setq name "|")))
                     (unless name (return))
                     (when (and argmode (or (string= name ",") (string= name "|")) (eq type :punct)) (return))
                     (let* ((atom (atom-name-term name)) (inf (pl-infix-op atom)) (post (pl-postfix-op atom)))
                       (cond
                         ((and inf (<= (car inf) maxprec)
                               (let* ((pri (car inf)) (ty (cdr inf))
                                      (la (if (eq ty :yfx) pri (- pri 1))))
                                 (and (<= leftprec la)
                                      ;; the right side must be able to start
                                      (let ((nt (nxt))) (and nt (%pl-term-start-p nt))))))
                          (let* ((pri (car inf)) (ty (cdr inf)) (ra (if (eq ty :xfy) pri (- pri 1))))
                            (setq i (+ i 1))
                            (let ((right (parse ra)))
                              (setq left (%make-pls (if (and (eq type :punct) (string= name "|")) *pl-semi* atom) (vector left right)) leftprec pri))))
                         ((and post (<= (car post) maxprec) (<= leftprec (if (eq (cdr post) :yf) (car post) (- (car post) 1))))
                          (setq i (+ i 1))
                          (setq left (%make-pls atom (vector left)) leftprec (car post)))
                         (t (return))))))
                 (values left leftprec))))
      (let ((term (parse 1200)))
        (unless (eq (pltok-type (cur)) :end)
          (fail (cur) "Operator expected"))
        (values term varinfo)))))

(defun pl-read-term-from-string (text &optional (pos 0))
  "Read the next clause of TEXT at POS.  Returns (values term varinfo start end next-pos), or :EOF as the term at the end
of the text.  Signals a PL-ERROR for a syntax error after moving past the offending clause (NEXT-POS is returned by
the second value of PL-READ-RECOVER)."
  (let ((toks (handler-case (%pl-lex-clause text pos)
                (pl-error (e) (setf (get '%pl-read 'recover) (%pl-skip-clause text pos)) (error e)))))
    (if (null toks)
        (values :eof nil (length text) (length text) (length text))
        (handler-case
            (multiple-value-bind (term varinfo) (pl-parse-tokens text toks)
              (values term varinfo (pltok-start (car toks)) (pltok-end (car (last toks)))
                      (pltok-end (car (last toks)))))
          (pl-error (e) (setf (get '%pl-read 'recover) (pltok-end (car (last toks)))) (error e))))))

(defun pl-read-recover-position (text pos)
  "Where to continue reading after a syntax error at POS."
  (declare (ignore text))
  (or (get '%pl-read 'recover) pos))

(defun pl-parse-string (text)
  "Parse TEXT, a single term with or without its closing full stop: (values term varinfo)."
  (let ((src (let ((s (string-right-trim '(#\Space #\Tab #\Newline #\Return) text)))
               (if (and (> (length s) 0) (char= (char s (- (length s) 1)) #\.)
                        (not (and (> (length s) 1) (%pl-symch-p (char s (- (length s) 2))))))
                   (concatenate 'string s " ")
                   (concatenate 'string s " . ")))))
    (multiple-value-bind (term varinfo) (pl-read-term-from-string src 0)
      (when (eq term :eof) (pl-syntax-error "Unexpected end of file"))
      (values term varinfo))))

;;; ---- reading a clause's text from a stream --------------------------------------------------------------------------------------

(defun pl-read-clause-text (stream)
  "Read the text of the next clause from the Lisp STREAM (up to and including its full stop), or NIL at the end of the stream."
  (let ((out (make-string-output-stream)) (any nil) (prev nil))
    (flet ((next () (let ((c (read-char stream nil nil))) (when c (write-char c out)) c)))
      (loop
        (let ((c (next)))
          (cond
            ((null c) (return (if any (get-output-stream-string out) nil)))
            ((char= c #\%) (loop (let ((d (next))) (when (or (null d) (char= d #\Newline)) (return)))) (setq prev #\Space))
            ((and (char= c #\/) (eql (peek-char nil stream nil nil) #\*))
             (next)
             (let ((p nil)) (loop (let ((d (next))) (when (or (null d) (and (eql p #\*) (char= d #\/))) (return)) (setq p d))))
             (setq prev #\Space))
            ((or (char= c #\') (char= c #\") (char= c #\`))
             (setq any t)
             (loop (let ((d (next)))
                     (cond ((null d) (return))
                           ((char= d #\\) (next))
                           ((char= d c) (if (eql (peek-char nil stream nil nil) c) (next) (return))))))
             (setq prev #\a))
            ((and (char= c #\.) (not (and prev (%pl-symch-p prev))) any
                  (let ((d (peek-char nil stream nil nil))) (or (null d) (%pl-layout-p d) (char= d #\%))))
             (let ((d (peek-char nil stream nil nil))) (when (and d (%pl-layout-p d)) (read-char stream)))
             (return (get-output-stream-string out)))
            ((%pl-layout-p c) (setq prev c))
            (t (setq any t prev c))))))))
